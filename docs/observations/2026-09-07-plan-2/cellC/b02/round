            python3 - "$RSTATE/session.json" <<'PY' 2>/dev/null
import json, os, shlex, sys
try:
    r = json.load(open(sys.argv[1]))
except Exception as ex:
    print("META_OK=0"); print("META_ERR=" + shlex.quote(str(ex))); raise SystemExit
if not isinstance(r, dict):
