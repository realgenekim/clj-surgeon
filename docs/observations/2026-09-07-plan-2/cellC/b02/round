  # environment. Both refuse. `--session <uuid>` narrows WHICH session, it does not
  # waive the history: an explicit id that disagrees with the persisted one is a
  # refusal naming both, and an explicit id with no metadata at all is a refusal.
  PREV_STATUS=none
  PREV_TERMINAL_VERIFIED="n/a (fresh session, no prior terminal status to carry)"
  if [ "$RESUME" = 1 ]; then
