      nohup setsid --wait "$RESUME_LAUNCHER" "$WT" "$SID" "$BRIEF" "$REPORT" \
      > "$BLOG" 2>&1 </dev/null 9>&- 8>&- 7>&- &
  else
    CODEX_BIN=/home/forge/.local/bin/codex CODEX_MODEL="$MODEL" \
      nohup setsid --wait "$LAUNCHER" "$WT" "$BRIEF" "" "$REPORT" \
      > "$BLOG" 2>&1 </dev/null 9>&- 8>&- 7>&- &
