# ---------------------------------------------------------------------------
# TERMINAL SUPERVISION (item 1) — the defect Astra demonstrated as a false GREEN.
#
# The old code launched the wrapper with `nohup setsid ... &`, then found the codex
# CHILD by /proc and polled `kill -0` until the pid disappeared. Disappearance is
# not a status. A builder that printed "PASS committed" and exited **17** produced
# `builder.status=ok, exits.aggregate=ok, GREEN/0`, because nothing in the round had
# ever asked the kernel what the process's exit code was.
#
# The repair, in three parts:
#
#  1. The wrapper is a SUPERVISED CHILD of this round and its status is collected
#     with `wait`, not inferred. `setsid --wait` keeps the detachment that made the
#     builder survive a hung terminal AND forwards the child's exit status verbatim,
#     so we lose nothing by supervising. (`--wait` is util-linux; checked present.)
#  2. The codex child is identified by an ATTESTED START IDENTITY — boot_id plus
#     /proc/<pid>/stat starttime — so "still running" cannot be answered by a
#     recycled pid, and `/proc` directory mtime (1-second granularity) is not the
#     authority any more.
#  3. FAIL CLOSED. Any termination this round cannot account for — the wrapper gone
#     with a codex child of ours still alive, a wrapper that never produced a child,
#     a non-zero wrapper status, a ceiling kill — is a NAMED build status other than
#     `ok`, and any status other than `ok` is RED regardless of how green every later
#     grade, oracle, witness and audit comes back.
#
# `--launcher` exists so this contract is witnessable: a stub that prints
# "PASS committed" and exits 17 runs through the identical supervision code.
# ---------------------------------------------------------------------------

# DEFECT 2, first live round (2026-09-08): discovery failed after 30 s, the script
# printed REFUSED and exited — releasing the lock and ORPHANING the builder it had
# just spawned.  A failure after launch owns what it launched.  This reaps the
# wrapper and every codex bearing our `-C <worktree>` that started after we did,
# says so in the receipt, and exits non-zero.
reap_launched() {
  local victims p
  [ -n "$WRAPPER" ] && kill "$WRAPPER" 2>/dev/null && say "$(stamp)  reaped wrapper $WRAPPER"
  victims=$(codex_pids_in "$WT" "$LAUNCH_EPOCH")
  for p in $victims; do
    kill "$p" 2>/dev/null && say "$(stamp)  reaped codex $p (launched by this round)"
  done
  [ -z "$victims" ] && say "$(stamp)  reaped: no codex process of ours was running"
  return 0
}
refuse_after_launch() {   # never leave a builder nobody is watching
  say "$(stamp)  post-launch failure — reaping what this round launched"
  reap_launched
  refuse "$*"
}

