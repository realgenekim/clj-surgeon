  # --adopt is disabled, so the honest instruction is "kill it or wait", not a
  # re-attach that would bypass the canonical lease.
  trap 'say "$(stamp)  interrupted while supervising builder ${BUILDER_PID:-?} (wrapper $WRAPPER) — setsid put it in its own session, so it is STILL RUNNING and now unwatched. Its log is $BLOG."; say "        --adopt is disabled pending ownership transfer, so there is no re-attach: let it finish and grade the tip with --no-build under a NEW name, or stop it with  kill ${BUILDER_PID:-<pid>}"; exit 130' INT TERM

  # -------------------------------------------------------------------------
  # THE WAIT. Two things must both end, and only one of them has a collectable
  # status: the WRAPPER (our child, `wait`-able) and the codex CHILD (identified,
  # not ours). Poll until the wrapper is gone or the ceiling is reached, `wait` for
  # the real status, then give the codex child a bounded grace period to follow it.
  # A codex still fenced to the tree after the wrapper has gone is an ORPHAN whose
  # exit nobody will ever see — `unknown-termination`, which is RED.
  # -------------------------------------------------------------------------
  DEADLINE_MS=$(( t + MINUTES * 60 * 1000 ))
  while alive_as "$WRAPPER" "$WRAPPER_START"; do
    if [ "$(now_ms)" -ge "$DEADLINE_MS" ]; then
      # the exact pid, never pkill, never an outer `timeout`; the builder first, then
      # the wrapper, so a ceiling leaves nothing of ours running.
      [ -n "$BUILDER_PID" ] && kill "$BUILDER_PID" 2>/dev/null
      kill "$WRAPPER" 2>/dev/null
      TERMINATION=ceiling-kill
      say "$(stamp)  CEILING: $MINUTES minute(s) reached — killed builder ${BUILDER_PID:-none} and wrapper $WRAPPER"
      break
    fi
    sleep 5
  done
  wait "$WRAPPER" 2>/dev/null; WRAPPER_RC=$?
  say "$(stamp)  TERMINAL RECEIPT: wrapper=$WRAPPER exit=$WRAPPER_RC (collected with wait(2), not inferred from disappearance) boot_id=$BOOT_ID starttime=${WRAPPER_START:-none}"

  # the codex child gets a bounded grace to exit behind its wrapper; if it outlives
  # it, its status is unknowable and this round says so.
  ORPHAN=""
  if [ -n "$BUILDER_PID" ]; then
    for _ in 1 2 3 4 5 6; do
      alive_as "$BUILDER_PID" "$BUILDER_START" || break
      sleep 1
    done
    if alive_as "$BUILDER_PID" "$BUILDER_START"; then
      ORPHAN=$BUILDER_PID
      say "$(stamp)  ORPHAN: codex $BUILDER_PID (starttime $BUILDER_START) is STILL RUNNING after its wrapper exited — its termination status can never be collected"
    fi
  fi

  # -------------------------------------------------------------------------
  # CLASSIFY, IN ASCENDING PRECEDENCE. The last assignment wins, so a collected
  # non-zero exit outranks a missing `model:` line: if the builder died 17, the
  # reason the log is short is that it died 17.
  # -------------------------------------------------------------------------
  LOGMODEL=$(hdr_field 'model')
  [ -n "$SESSION_ID" ] || SESSION_ID=$(hdr_field 'session id')
  case "$LOGMODEL" in
    "$MODEL"*) TERMINATION=collected ;;
    "") say "$(stamp)  FAIL: builder log has no 'model:' line ($BLOG)"; BUILD=wrong-model; TERMINATION=collected ;;
    *)  say "$(stamp)  FAIL: wrong model — asked $MODEL, log says '$LOGMODEL'"; BUILD=wrong-model; TERMINATION=collected ;;
  esac
  if [ -z "$BUILDER_PID" ]; then
    BUILD=no-builder
    TERMINATION=no-child
    say "$(stamp)  FAIL: the wrapper ran and exited but NO codex child fenced to $WT was ever observed — there is no builder whose work this round could be grading"
  fi
  if [ -n "$ORPHAN" ]; then
    BUILD=unknown-termination
    TERMINATION=orphan
  fi
  if [ "$WRAPPER_RC" != 0 ]; then
    BUILD="builder-exit-$WRAPPER_RC"
    TERMINATION=nonzero-exit
    say "$(stamp)  FAIL: the builder exited $WRAPPER_RC. A non-zero terminal status is RED no matter what the builder PRINTED and no matter how green every later check comes back — 'PASS committed' on stdout is a claim, wait(2) is the receipt."
  fi
  if [ "$TERMINATION" = ceiling-kill ]; then
    BUILD=timeout
  fi
  BW=$(( $(now_ms) - t ))
  trap - INT TERM

  # B02d item 3 — the BASIS travels with the label. Only a status this apparatus
  # actually collected with wait(2) may later be reported as a verified previous
  # termination; everything else is a carried label and says so in the record.
  case "$TERMINATION" in
    collected|nonzero-exit) _sb="wait(2) collected by round '$NAME' on wrapper pid $WRAPPER (boot_id $BOOT_ID, starttime ${WRAPPER_START:-none})" ;;
    ceiling-kill)           _sb="ceiling kill by round '$NAME' — the status is this apparatus's, not the builder's own completion" ;;
    *)                      _sb="carried label (termination=$TERMINATION; no wait status was collected by this apparatus)" ;;
  esac
  [ -n "$SESSION_ID" ] && write_session "$BUILD" "$_sb"
  step BUILD "$BW" "$BUILD (termination=$TERMINATION wrapper_exit=$WRAPPER_RC pid=${BUILDER_PID:-none} model='${LOGMODEL:-none}' session=${SESSION_ID:-none} mode=$([ "$RESUME" = 1 ] && echo resume || echo fresh))"
fi

# ===========================================================================
# 4. COMMIT CHECK
# ===========================================================================
t=$(phase_t0)
NEW_TIP=$(git -C "$WT" rev-parse HEAD)
# same definition of dirty as the preflight: tracked modifications anywhere, plus
# untracked files under src/test/resources/deps.edn/.clj-surgeon.edn (item 4).
dirty=$(relevant_dirty "$WT")
# COMMIT is its OWN axis, not an overwrite of BUILD. Before B02b, `BUILD=nocommit`
# here erased a terminal status the supervision phase had just established: a builder
# that exited 17 without committing reported `build=nocommit` and the exit code
# vanished from the receipt. Two questions, two answers, both in the ledger line.
COMMIT=ok
if [ "$NOBUILD" = 1 ]; then
  COMMIT=skipped
  step COMMIT_CHECK $(( $(now_ms) - t )) "skipped (--no-build); grading tip ${NEW_TIP:0:8}"
else
  if [ "$NEW_TIP" = "$OLD_TIP" ]; then
    COMMIT=nocommit
    step COMMIT_CHECK $(( $(now_ms) - t )) "NO COMMIT — tip unchanged at ${OLD_TIP:0:8}"
  elif [ -n "$dirty" ]; then
    COMMIT=dirty
    say "$dirty"
    step COMMIT_CHECK $(( $(now_ms) - t )) "NO COMMIT — tip moved but tree is dirty (tracked changes, or untracked files under src/test/resources/deps.edn/.clj-surgeon.edn)"
  else
    step COMMIT_CHECK $(( $(now_ms) - t )) "ok ${OLD_TIP:0:8} -> ${NEW_TIP:0:8}, tree clean"
  fi
fi

# ===========================================================================
# 5. GRADE
# ===========================================================================
t=$(phase_t0)
FIXTURE_OWNED=0
if [ -z "$FIXTURE" ]; then
  FIXTURE=/var/tmp/forge/plan2/build/round-$NAME-fx
  FIXTURE_OWNED=1
fi

# ---------------------------------------------------------------------------
# THE FIXTURE GETS ITS OWN LEASE, KEYED THE SAME WAY, AND IT IS TAKEN BEFORE THE
# FIRST MUTATION. The reset two lines below is `git checkout -- . && git clean -fdq
# src test`: run inside a fixture another round is mid-grade in, it destroys that
# round's evidence and both rounds report nonsense. Astra: "lock the fixture too …
# test refusal before resetting a non-owned fixture."
# ---------------------------------------------------------------------------
FX_DIGEST=$(printf '%s' "$FIXTURE" | sha256sum | cut -d' ' -f1)
FXSTATE=$OUT/state/$FX_DIGEST
mkdir -p "$FXSTATE" || refuse "cannot create fixture state dir $FXSTATE"
printf '%s\n' "$FIXTURE" > "$FXSTATE/root"
exec 7>"$FXSTATE/lease" || refuse "cannot open fixture lease $FXSTATE/lease"
if ! flock -n 7; then
  fxholder=$(fuser "$FXSTATE/lease" 2>/dev/null | tr -s ' ')
  refuse "fixture-lease-held: $FIXTURE is owned by another round — lease=$FXSTATE/lease holder_pid(s):${fxholder:- unknown}. NOTHING in the fixture has been reset."
fi
if [ "$FIXTURE_OWNED" = 1 ] && [ ! -d "$FIXTURE/.git" ] && [ ! -f "$FIXTURE/.git" ]; then
  git -C "$CC_SRC" worktree add --detach "$FIXTURE" "$CC_SHA" >>"$LOG" 2>&1 </dev/null \
    || refuse "cannot create fixture worktree $FIXTURE"
fi
[ -d "$FIXTURE" ] || refuse "no such fixture: $FIXTURE"

# reset: tracked back to HEAD, untracked split output removed.  The guard test and
# .clj-surgeon.edn are untracked, so they are re-laid AFTER the clean, every time.
git -C "$FIXTURE" checkout -q -- . </dev/null
git -C "$FIXTURE" clean -fdq src test </dev/null
cp "$GUARD_TEST" "$FIXTURE/test/cfp_scheduler_killer/view_architecture_test.clj"
cat > "$FIXTURE/.clj-surgeon.edn" <<EOF
{:verification-profiles {"split-unit" {:commands [["bin/kaocha" "unit" "--fail-fast"]
                                                  ["python3" "$CC_ORACLE" "$FIXTURE"]]}}}
EOF

if [ -z "$REQUEST" ]; then
  REQUEST=$RUNDIR/request.edn
  sed -E "s#:workspace_root \"[^\"]*\"#:workspace_root \"$FIXTURE\"#" "$BASE_REQUEST" > "$REQUEST"
fi

# ---------------------------------------------------------------------------
# THE BASIS, HASHED (item 4). Astra: "The receipt carries Git tips, not a full
# effective source/environment/configuration inventory." Git tips name the source;
# they say nothing about the two files that decide what "verified" MEANS in this
# grade — the fixture's `.clj-surgeon.edn` (which verification profile runs, and
# which commands are in it) and its `deps.edn` (what the suite loads). Both are
# written or laid down by this round and neither is tracked by the fixture's git,
# so without their digests a receipt cannot be replayed and cannot be compared.
# The candidate's own deps.edn is hashed too, at preflight.
# ---------------------------------------------------------------------------
FIXTURE_SHA=$(git -C "$FIXTURE" rev-parse HEAD 2>/dev/null)
REQUEST_SHA=$(sha256sum < "$REQUEST" | cut -d' ' -f1)
ORACLE_SHA=$(sha256sum < "$CC_ORACLE" | cut -d' ' -f1)
PAPERCUT_SHA=$(sha256sum < "$PAPERCUT" | cut -d' ' -f1)
ROUND_SHA=$(sha256sum < "$0" | cut -d' ' -f1)
GUARD_SHA=$(sha256sum < "$GUARD_TEST" | cut -d' ' -f1)
FX_CONFIG=$FIXTURE/.clj-surgeon.edn
FX_CONFIG_SHA=$(sha256sum < "$FX_CONFIG" | cut -d' ' -f1)
FX_DEPS_SHA=$( [ -f "$FIXTURE/deps.edn" ] && sha256sum < "$FIXTURE/deps.edn" | cut -d' ' -f1 || echo "")
say "$(stamp)  basis: fixture_config_sha256=${FX_CONFIG_SHA:0:16} fixture_deps_sha256=${FX_DEPS_SHA:0:16} candidate_deps_sha256=${CAND_DEPS_SHA:0:16} request_sha256=${REQUEST_SHA:0:16}"
step FIXTURE_SETUP $(( $(now_ms) - t )) "fixture=$FIXTURE sha=${FIXTURE_SHA:0:8} lease=$FXSTATE/lease config=${FX_CONFIG_SHA:0:16}"

tw=$(phase_t0)
RECEIPT=$RUNDIR/split-receipt.edn
if [ -n "$SPLIT_RECEIPT" ]; then
  [ -f "$SPLIT_RECEIPT" ] || refuse "no such split receipt: $SPLIT_RECEIPT"
  cp "$SPLIT_RECEIPT" "$RECEIPT"
  CALL_RC=0
  CALL_RC_SRC="supplied"
  say "$(stamp)  split call: NOT RUN — grading the supplied receipt $SPLIT_RECEIPT (--split-receipt). This is a DIAGNOSTIC replay: the producer's own exit status was not observed by this round."
else
  ( cd "$FIXTURE" && bb --classpath "$WT/src" -m clj-surgeon.core \
      :op :split-ns! :request-file "$REQUEST" ) > "$RECEIPT" 2>"$RUNDIR/split-receipt.err" </dev/null 9>&- 8>&- 7>&-
  CALL_RC=$?
  CALL_RC_SRC="exit"
fi
step SPLIT_CALL $(( $(now_ms) - tw )) "rc=$CALL_RC source=$CALL_RC_SRC receipt=$RECEIPT"

# ---------------------------------------------------------------------------
# THE RECEIPT SCHEMA GATE.  Until B02 this was `grep -o ':state "[^"]*"'` and the
# round called itself green whenever that word was "committed". B02 made it a
# structural parse. B02b makes it a CONTRACT, because Astra walked two receipts
# straight through the B02 version:
#
#   {:ok true :committed true :state "committed"
#    :verification_complete false :proof_pending ["cold-suite"]
#    :checks [{:name "warm-only" :exit 0 :status "passed"}]}      -> GREEN/0
#
# The receipt SAID its proof was incomplete and named what was missing, and the
# gate did not read those keys at all. And:
#
#   {:name "failed-cold-suite" :exit 17 :status "failed" :baseline nil}  -> GREEN/0
#
# because the excuse tested `"baseline" in c` — KEY PRESENCE — so a null baseline
# excused an exit-17 "failed" check. An exception that tests for the NAME of the
# evidence rather than the evidence is not an exception, it is a keyword to type.
#
# The five rules now enforced:
#
#  1. `:verification_complete` must be exactly true. Absent, false, or any other
#     value is a refusal. The producer's own statement that it did not finish
#     proving outranks every green thing in the rest of the map.
#  2. `:proof_pending` must be PRESENT and a correctly typed EMPTY list. A missing
#     key is not an empty one — a producer that never populated it is not a
#     producer that had nothing outstanding.
#  3. THE REGISTERED COMPLETE CHECK SET must all be present:
#       * the four fixed checks — captured-reference-analysis, future-source-parse,
#         candidate-lint-delta, verified-snapshot-guard;
#       * one check per COMMAND in the verification profile, read out of the
#         fixture's own `.clj-surgeon.edn` (this round writes that file, and the
#         gate parses it back rather than trusting its own memory of it). A receipt
#         that ran only a warm subset is missing checks and is named for it.
#  4. Every `:status` must be "passed" or "baseline". "failed", "skipped",
#     "pending", nil, or anything else is a refusal by name.
#  5. A non-zero `:exit` or a "baseline" status is excused ONLY for
#     captured-reference-analysis and candidate-lint-delta (the two clj-kondo
#     analyses that exit 3 against this repo's 108-error baseline), and only when
#     the check carries a `:baseline` MAP with introduced_errors in (absent, 0)
#     and no positive `:delta` error count. `:baseline nil` excuses nothing.
# ---------------------------------------------------------------------------
tp=$(phase_t0)
RJSON=$RUNDIR/split-receipt.json
bb -e '(require (quote [cheshire.core :as j])) (println (j/generate-string (clojure.edn/read-string (slurp (first *command-line-args*)))))' \
   "$RECEIPT" > "$RJSON" 2>"$RUNDIR/split-receipt-json.err" </dev/null 9>&- 8>&- 7>&-
EDN_RC=$?

# The REGISTERED command set, read back out of the fixture config this round wrote.
PROFILE_JSON=$RUNDIR/verification-profile.json
bb -e '(require (quote [cheshire.core :as j]))
       (let [cfg (clojure.edn/read-string (slurp (first *command-line-args*)))
             profs (:verification-profiles cfg)]
         (println (j/generate-string {:profiles (into {} (for [[k v] profs] [k (:commands v)]))})))' \
   "$FX_CONFIG" > "$PROFILE_JSON" 2>"$RUNDIR/verification-profile.err" </dev/null 9>&- 8>&- 7>&-
PROFILE_RC=$?
[ "$PROFILE_RC" = 0 ] || refuse "unreadable-verification-profile: could not parse $FX_CONFIG ($RUNDIR/verification-profile.err). The gate's required check set is DERIVED from that file; a gate that cannot read its own contract must not certify anything."

RVARS=$RUNDIR/receipt-vars.sh
python3 - "$RJSON" "$EDN_RC" "$CALL_RC" "$PROFILE_JSON" "$FIXTURE" "${SPLIT_RECEIPT:-}" > "$RVARS" <<'PY'
import json, os, shlex, sys

path, edn_rc, call_rc, profile_path = sys.argv[1], int(sys.argv[2]), int(sys.argv[3]), sys.argv[4]
fixture = sys.argv[5] if len(sys.argv) > 5 else ""
supplied = sys.argv[6] if len(sys.argv) > 6 else ""
def emit(k, v): print(f"{k}={shlex.quote(str(v))}")

# The two checks whose non-zero exit is legitimately pre-existing lint baseline.
# Nothing else may ever be "baseline", and these two only with real evidence.
ANALYSIS_EXCUSABLE = {"captured-reference-analysis", "candidate-lint-delta"}
FIXED_REQUIRED = ["captured-reference-analysis", "future-source-parse",
                  "candidate-lint-delta", "verified-snapshot-guard"]
VALID_STATUS = {"passed", "baseline"}
ANALYSIS_PHASE = {"captured-reference-analysis", "future-source-parse", "candidate-lint-delta"}
SYSTEM_BIN = ("/usr/bin/", "/bin/", "/usr/local/bin/", "/usr/sbin/", "/sbin/")


def _int(x):
    return x if isinstance(x, int) and not isinstance(x, bool) else None


r = None
if edn_rc == 0:
    try:
        r = json.load(open(path))
    except Exception:
        r = None
if not isinstance(r, dict):
    emit("STATE", f"unparseable-receipt(edn_rc={edn_rc},call_rc={call_rc})")
    emit("IN_CALL", 0); emit("CHECKS_N", 0); emit("CHECKS_OKN", 0); emit("ANALYSIS_MS", 0)
    emit("RECEIPT_VERDICT", "FAILED")
    emit("RECEIPT_REASON", "the split receipt is not readable EDN — a round cannot be graded from a receipt it cannot parse")
    raise SystemExit

# --- the registered command set -------------------------------------------
required_cmds = []
try:
    profs = (json.load(open(profile_path)) or {}).get("profiles") or {}
    for _pname, cmds in sorted(profs.items()):
        for cmd in (cmds or []):
            if isinstance(cmd, list) and cmd:
                required_cmds.append([str(x) for x in cmd])
except Exception:
    required_cmds = []


def cmd_matches(want, got):
    """EXACT ARGV, not a bag of basenames [B02d item 2].

    Astra replaced every token of every required command with
    `/unrelated-subject/<basename>` — a program that was never executed, in a
    directory that has nothing to do with the subject — and the receipt was still
    accepted, because the old rule let ANY token match by basename. A basename is
    not a program and it is certainly not an argument: `--fail-fast` and
    `/unrelated-subject/--fail-fast` are different commands.

    So: ARGUMENTS must be equal, character for character. Only argv[0] may be
    resolved, and only in the two ways this apparatus actually resolves it —
      * a repo-relative program (`bin/kaocha`) resolved against the SUBJECT fixture
        (`<fixture>/bin/kaocha`), which also BINDS the command to this subject;
      * a bare program name (`python3`) resolved by PATH to a system bin directory.
    Nothing else. A program resolved to somewhere else is a different program.
    """
    if not isinstance(got, list) or len(got) != len(want):
        return False
    g0, w0 = str(got[0]), want[0]
    ok0 = False
    if g0 == w0:
        ok0 = True
    elif "/" in w0:
        # relative to the subject fixture, or an absolute spelling of the same file
        if fixture and g0 == os.path.join(fixture, w0.lstrip("./")):
            ok0 = True
        elif os.path.isabs(w0) and g0 == w0:
            ok0 = True
    else:
        # a bare name may only resolve into a SYSTEM bin dir, keeping its own name
        if g0.startswith(SYSTEM_BIN) and os.path.basename(g0) == w0:
            ok0 = True
    if not ok0:
        return False
    return [str(x) for x in got[1:]] == [str(x) for x in want[1:]]


state = r.get("state") or f"no-state(call_rc={call_rc})"
emit("STATE", state)
emit("IN_CALL", int(round(float(r.get("elapsed_ms") or 0))))

checks = r.get("checks")
if not isinstance(checks, list):
    checks = []
bad = []
okn = 0
seen_names = set()
analysis_ms = 0.0
excused_baselines = {}     # name -> the baseline map that excused it
comparisons = []           # names of checks that carry a COMPLETE, consistent delta

for n, c in enumerate(checks):
    if not isinstance(c, dict):
        bad.append(f"check[{n}] is not a map"); continue
    name = (c.get("name") or "").strip()
    if not name:
        bad.append(f"check[{n}] has no :name"); continue
    seen_names.add(name)
    if name in ANALYSIS_PHASE:
        try: analysis_ms += float(c.get("duration_ms") or 0)
        except Exception: pass
    ex = c.get("exit")
    st = c.get("status")

    # rule 4 — the status vocabulary is closed.
    if st not in VALID_STATUS:
        bad.append(f"check '{name}' :status {st!r} is not one of passed/baseline")
        continue

    clean = (ex == 0) and (st == "passed")
    if clean:
        okn += 1
        continue

    # rule 5 — the baseline exception, scoped and EVIDENCED [B02d item 1].
    if name not in ANALYSIS_EXCUSABLE:
        bad.append(f"check '{name}' :exit {ex!r} :status {st!r} — only "
                   f"{'/'.join(sorted(ANALYSIS_EXCUSABLE))} may carry a baseline exception; "
                   f"an arbitrary check cannot inherit it")
        continue
    base = c.get("baseline")
    if not isinstance(base, dict):
        bad.append(f"check '{name}' :exit {ex!r} :status {st!r} with :baseline {base!r} — "
                   f"the exception requires a baseline MAP of evidence, not the presence of the key")
        continue
    if not base:
        bad.append(f"check '{name}' :exit {ex!r} :status {st!r} carries an EMPTY :baseline {{}} — "
                   f"an empty map records no pre-mutation state, so nothing in this receipt "
                   f"says the non-zero exit was pre-existing rather than introduced")
        continue
    if _int(base.get("error")) is None:
        bad.append(f"check '{name}' :baseline {base!r} carries no integer :error count — a "
                   f"baseline without the PRE-MUTATION error count is not a measurement and "
                   f"cannot be compared with anything")
        continue
    excused_baselines[name] = base
    introduced = c.get("introduced_errors")
    delta = c.get("delta")
    post = c.get("post")
    if introduced is not None or delta is not None or post is not None:
        # this check claims to BE the comparison; then it must be a complete one
        problems = []
        if _int(introduced) is None:
            problems.append(f":introduced_errors is {introduced!r}, not an integer")
        elif introduced != 0:
            problems.append(f"it introduced {introduced!r} error(s) over its baseline")
        if not isinstance(delta, dict) or _int(delta.get("error")) is None:
            problems.append(f":delta is {delta!r}, not a map carrying an integer :error count")
        elif delta.get("error") != 0:
            problems.append(f":delta reports {delta.get('error')!r} new error(s)")
        if not isinstance(post, dict) or _int(post.get("error")) is None:
            problems.append(f":post is {post!r}, not a map carrying the POST-mutation :error count")
        if not problems:
            arith = post["error"] - base["error"]
            if arith != delta["error"] or arith != introduced:
                problems.append(
                    f"the comparison does not add up: post {post['error']} - baseline "
                    f"{base['error']} = {arith}, but :delta says {delta['error']} and "
                    f":introduced_errors says {introduced}")
        if problems:
            bad.append(f"check '{name}' claims a baseline comparison but " + "; ".join(problems))
            continue
        comparisons.append(name)
    okn += 1

if not checks:
    bad.append("the receipt carries NO :checks — nothing was verified")

# rule 5b — a baseline exception is only evidence WITH a comparison somewhere in the
# receipt. `{}` proved nothing; so does a baseline nobody ever measured against.
if excused_baselines and not comparisons:
    bad.append("check(s) " + ", ".join(sorted(excused_baselines))
               + " carry a baseline exception, but NO check in this receipt compares the "
                 "post-mutation analysis with that baseline (:delta/:introduced_errors/:post "
                 "absent everywhere) — an unexplained non-zero exit with no comparison is not "
                 "evidence that the errors were pre-existing")
_berrs = {n: b.get("error") for n, b in excused_baselines.items()}
if len(set(_berrs.values())) > 1:
    bad.append("the excused checks disagree about the PRE-MUTATION error count "
               + ", ".join(f"{n}={v}" for n, v in sorted(_berrs.items()))
               + " — two different baselines cannot both be this candidate's")

# rule 3 — the complete registered set.
missing_fixed = [n for n in FIXED_REQUIRED if n not in seen_names]
if missing_fixed:
    bad.append("required check(s) absent from the receipt: " + ", ".join(missing_fixed))
receipt_cmds = [c.get("command") for c in checks if isinstance(c, dict)]
missing_cmds = []
for want in required_cmds:
    if not any(cmd_matches(want, got) for got in receipt_cmds):
        missing_cmds.append(" ".join(want))
if missing_cmds:
    bad.append("verification-profile command(s) with no EXACT matching check in the receipt "
               "(argv[0] resolved against the subject fixture or a system bin dir, every "
               "argument equal): " + "; ".join(missing_cmds))
if not required_cmds:
    bad.append("the fixture's verification profile declares NO commands — "
               "a profile that requires nothing cannot certify anything")

# rule 6 — THE SUBJECT [B02d item 2]. A receipt that never names a path inside the
# fixture this round is grading cannot be shown to be about this candidate. Astra
# borrowed a receipt produced against `…/fixture` and had it accepted at
# `…/proof/fixture`: the two roots share only their last path component.
if fixture:
    subject_hits = []
    foreign = []
    for got in receipt_cmds:
        if not isinstance(got, list):
            continue
        for tok in got:
            tok = str(tok)
            if tok.startswith(fixture.rstrip("/") + "/") or tok == fixture:
                subject_hits.append(tok)
    if not subject_hits:
        seen_abs = sorted({str(t) for g in receipt_cmds if isinstance(g, list)
                           for t in g if str(t).startswith("/")})[:4]
        bad.append(f"subject-mismatch: no check command in this receipt names any path under "
                   f"the fixture being graded ({fixture}) — the receipt cannot be shown to be "
                   f"about this candidate"
                   + (f"; the absolute paths it does name are {', '.join(seen_abs)}"
                      if seen_abs else ""))

# rules 1 and 2 — the producer's own completeness statement.
vc = r.get("verification_complete")
if vc is not True:
    bad.append(f":verification_complete is {vc!r}, not true — the producer says its own "
               f"verification did not complete, and no later green check can retroactively "
               f"complete it")
pp = r.get("proof_pending")
if "proof_pending" not in r:
    bad.append(":proof_pending is absent — a receipt that never populated it is not a "
               "receipt with nothing outstanding")
elif not isinstance(pp, list):
    bad.append(f":proof_pending is {pp!r}, not an (empty) vector")
elif pp:
    bad.append(f":proof_pending is non-empty ({len(pp)}): {', '.join(map(str, pp))}")

for key in ("ok", "committed"):
    if r.get(key) is not True:
        bad.append(f":{key} is {r.get(key)!r}, not true")
if state != "committed":
    bad.append(f':state is "{state}", not "committed"')
bl = r.get("blockers")
if bl is None:
    bad.append(":blockers is absent")
elif not isinstance(bl, list):
    bad.append(f":blockers is {bl!r}, not a vector")
elif bl:
    bad.append(f":blockers is non-empty ({len(bl)})")
if call_rc != 0:
    bad.append(f"the split call itself exited {call_rc}")

emit("CHECKS_N", len(checks)); emit("CHECKS_OKN", okn)
emit("ANALYSIS_MS", int(round(analysis_ms)))
emit("RECEIPT_COMPARISONS", ",".join(comparisons))
# A SUPPLIED receipt can never be better than DIAGNOSTIC: this round did not observe
# the producer, its exit, its cwd or its configuration [B02d item 2].
if supplied:
    emit("RECEIPT_VERDICT", "DIAGNOSTIC" if not bad else "FAILED")
    emit("RECEIPT_REASON",
         ("schema ok, but this receipt was SUPPLIED (--split-receipt " + supplied + "): the "
          "producer's exit, cwd and configuration were not observed by this round, so the "
          "strongest honest label is DIAGNOSTIC, never certification"
          if not bad else "; ".join(bad)))
else:
    emit("RECEIPT_VERDICT", "ok" if not bad else "FAILED")
    emit("RECEIPT_REASON", "; ".join(bad) if bad else
         f"{okn}/{len(checks)} checks passed (2 analysis checks may carry evidenced baselines, "
         f"compared by {', '.join(comparisons) or 'no check'}), verification_complete=true, "
         f"proof_pending=[], all {len(FIXED_REQUIRED)} fixed checks and all "
         f"{len(required_cmds)} profile command(s) present with exact argv, every command "
         f"bound to the subject fixture, :ok/:committed true, no blockers")
PY
. "$RVARS"
: "${STATE:=unknown}" "${IN_CALL:=0}" "${CHECKS_N:=0}" "${CHECKS_OKN:=0}" "${ANALYSIS_MS:=0}" "${RECEIPT_VERDICT:=FAILED}" "${RECEIPT_REASON:=unset}"
say "$(stamp)  split call: rc=$CALL_RC($CALL_RC_SRC) state=$STATE in_call_ms=$IN_CALL receipt=$RECEIPT parsed=$RJSON"
say "$(stamp)  receipt schema: $RECEIPT_VERDICT  checks=$CHECKS_OKN/$CHECKS_N  :: $RECEIPT_REASON"
case "$RECEIPT_VERDICT" in
  ok) : ;;
  DIAGNOSTIC) say "$(stamp)  RECEIPT DIAGNOSTIC — the schema holds, but a supplied receipt is a replay: this round never observed the producer, so it cannot certify. $RECEIPT_REASON" ;;
  *) say "$(stamp)  RECEIPT CHECK FAILED — \`:state \"$STATE\"\` does NOT make this round green: $RECEIPT_REASON" ;;
esac
step RECEIPT_SCHEMA $(( $(now_ms) - tp )) "$RECEIPT_VERDICT ($CHECKS_OKN/$CHECKS_N; profile=$PROFILE_JSON)"

# papercut oracle
tb=$(phase_t0)
POUT=$RUNDIR/papercuts.log
python3 "$PAPERCUT" "$FIXTURE" > "$POUT" 2>&1 </dev/null 9>&- 8>&- 7>&-
PAPERCUT_RC=$?
PAPERCUTS=$(grep -m1 '^PAPERCUTS:' "$POUT" | awk '{print $2}')
[ -n "$PAPERCUTS" ] || PAPERCUTS=ERR
say "$(stamp)  PAPERCUTS: $PAPERCUTS (rc=$PAPERCUT_RC)   (full report: $POUT)"
# the non-advisory rows with count > 0, from the oracle's own table
awk '$NF=="yes" && $(NF-2)+0 > 0 {printf "        papercut row: %s = %s %s\n", $1, $(NF-2), $(NF-1)}' "$POUT" | tee -a "$LOG"

# the four fixture oracles — each one's EXIT is now recorded, not just its verdict
O1=fail O2=fail O3=fail O4=fail
[ ! -e "$FIXTURE/src/cfp_scheduler_killer/views.clj" ] && O1=pass
python3 "$CC_ORACLE" "$FIXTURE" > "$RUNDIR/cc-oracle.log" 2>&1 </dev/null 9>&- 8>&- 7>&-
CC_ORACLE_RC=$?
grep -q '^PASS:' "$RUNDIR/cc-oracle.log" && O2=pass
# the unit suite ran INSIDE the call. `committed` alone is NOT the evidence for that
# any more — the receipt schema gate above is, and O3 is now bound to it.
case "$STATE" in committed*) [ "$RECEIPT_VERDICT" = ok ] && O3=pass ;; esac
( cd "$FIXTURE" && bin/kaocha unit --focus cfp-scheduler-killer.view-architecture-test ) \
  > "$RUNDIR/guard.log" 2>&1 </dev/null 9>&- 8>&- 7>&-
GUARD_RC=$?
grep -qE '7 assertions, 0 failures' "$RUNDIR/guard.log" && O4=pass
ORACLES=0
for o in "$O1" "$O2" "$O3" "$O4"; do [ "$o" = pass ] && ORACLES=$((ORACLES+1)); done
say "$(stamp)  oracles: views.clj-gone=$O1 cc-oracle=$O2(rc=$CC_ORACLE_RC) unit-suite-in-call=$O3 arch-guard-7/7=$O4(rc=$GUARD_RC)  => $ORACLES/4"
say "$(stamp)  candidate binding: tip=${NEW_TIP:0:12} fixture=${FIXTURE_SHA:0:12} request_sha256=${REQUEST_SHA:0:16} cc_oracle_sha256=${ORACLE_SHA:0:16} papercut_sha256=${PAPERCUT_SHA:0:16} guard_sha256=${GUARD_SHA:0:16} round_sha256=${ROUND_SHA:0:16} fixture_config_sha256=${FX_CONFIG_SHA:0:16} fixture_deps_sha256=${FX_DEPS_SHA:0:16} candidate_deps_sha256=${CAND_DEPS_SHA:0:16}"
step ORACLES $(( $(now_ms) - tb )) "PAPERCUTS=$PAPERCUTS oracles=$ORACLES/4 (papercut_rc=$PAPERCUT_RC cc_oracle_rc=$CC_ORACLE_RC guard_rc=$GUARD_RC)"
step GRADE $(( $(now_ms) - t )) "state=$STATE in_call=${IN_CALL}ms PAPERCUTS=$PAPERCUTS oracles=$ORACLES/4 receipt_checks=$RECEIPT_VERDICT($CHECKS_OKN/$CHECKS_N)"

# ===========================================================================
# 6. WITNESSES — the namespace-split test namespaces, cold but FOCUSED.
# The lane aliases concatenate their :main-opts, so `--ns` must go through
# :clj-surgeon/test-deps, which carries the deps and names no entry point.
# Measured cheapest correct invocation: ~8 s for all three namespaces.
# ===========================================================================
t=$(phase_t0)
WLOG=$RUNDIR/witnesses.log
( cd "$WT" && clojure -J-Xms64m -J-Xmx512m -M:clj-surgeon/test-deps \
    -m clj-surgeon.mcp-test-runner --ns \
    clj-surgeon.namespace-split-test \
    clj-surgeon.mcp-namespace-split-test \
    clj-surgeon.namespace-split-warm-test ) > "$WLOG" 2>&1 </dev/null 9>&- 8>&- 7>&-
WRC=$?
WLINE=$(grep -m1 -E '^Ran [0-9]+ tests' "$WLOG")
WT_TESTS=$(echo "$WLINE" | awk '{print $2}'); WT_ASSERTS=$(echo "$WLINE" | awk '{print $5}')
WFAIL=$(grep -m1 -E '^[0-9]+ failures, [0-9]+ errors' "$WLOG")
WT_FAILS=$(echo "$WFAIL" | awk '{print $1}'); WT_ERRS=$(echo "$WFAIL" | awk '{print $3}')
: "${WT_TESTS:=?}" "${WT_ASSERTS:=?}" "${WT_FAILS:=?}" "${WT_ERRS:=?}"
step WITNESSES $(( $(now_ms) - t )) "rc=$WRC ${WT_TESTS}t/${WT_ASSERTS}a/${WT_FAILS}f/${WT_ERRS}e ($WLOG)"

# ===========================================================================
# 7. INTENT_AUDIT — the linked-intent ratchet (Gene: "use LID skill to help
# ensure integrity").  Two independent questions, because they fail differently:
#
#   (a) IS THE REPOSITORY'S INTENT CONTRACT INTACT?  Exactly the audit ~/bin/land
#       runs before it will push, so a round cannot bless a tip that the landing
#       gate would then refuse.  A red audit is a hard stop.
#
#   (b) DID THIS ROUND'S OWN COMMITS REGISTER A PROMISE?  A source change that
#       adds no INTENT:/INTENT-TEST: marker is a fix with nothing holding it in
#       place — the exact way a load-bearing promise evaporates in the next
#       refactor.  `intents=UNLINKED-CHANGE` and a non-zero exit.  This can only
#       be asked when a builder actually committed, so --no-build and NO COMMIT
#       report n/a rather than inventing a verdict.
# ===========================================================================
t=$(phase_t0)
ALOG=$RUNDIR/intent-audit.log
( cd "$WT" && clojure -M -e "(require 'clj-surgeon.mcp-intent-contract)(prn (select-keys (clj-surgeon.mcp-intent-contract/audit-current-repository) [:ok :violations]))" ) \
  > "$ALOG" 2>&1 </dev/null 9>&- 8>&- 7>&-
AUDIT_RC=$?
if grep -q ':ok true' "$ALOG"; then AUDIT_OK=true; elif grep -q ':ok false' "$ALOG"; then AUDIT_OK=false; else AUDIT_OK=unknown; fi
# `:violations` is an EDN VECTOR of maps, so the count is the number of maps at
# depth 1 inside it — not a `{`-count over the whole line, which nested maps would
# inflate. An unparseable audit reports `?`, never a comforting 0.
VIOLATIONS=$(python3 - "$ALOG" <<'EOF'
import re,sys
t=open(sys.argv[1]).read()
i=t.find(':violations')
if i<0: print('?'); raise SystemExit
j=t.find('[',i)
if j<0: print('?'); raise SystemExit
d=0;n=0;k=j
while k<len(t):
    c=t[k]
    if c=='[':
        d+=1
    elif c==']':
        d-=1
        if d==0: break
    elif c=='{' and d==1:
        n+=1; b=1; k+=1
        while k<len(t) and b:
            if t[k]=='{': b+=1
            elif t[k]=='}': b-=1
            k+=1
        continue
    k+=1
print(n)
EOF
)
[ -n "$VIOLATIONS" ] || VIOLATIONS='?'
say "$(stamp)  intent audit: $(tail -1 "$ALOG" | cut -c1-300)"

# (b) markers added by THIS round's commits.
#
# COUNT EVERY SPELLING, NOT ONE. `INTENT:`/`INTENT-TEST:` are real in this repo
# (17 src / 22 test occurrences) but they are NOT what the contract enforces:
# mcp_intent_contract.clj scans for `@spec <ID>` — 1520 in src, 1868 in test — and
# the builder brief tells rounds to link with `NS-SPLIT-0xx`, which lands as @spec.
# A rule keyed on one spelling would fail a properly-linked round and teach everyone
# to ignore it. So all three are counted, and UNLINKED-CHANGE requires ZERO of ALL.
# (A source-scanning check still cannot see a link expressed some other way — the
# audit above is the behavioural authority; this is the cheap adjunct.)
SPEC_RE='^\+.*@spec[[:space:]]+(MCP-OP-[A-Z0-9-]+|[A-Z][A-Z0-9-]*-[0-9]{3}[a-z]?)'
NEW_INTENT=n/a; NEW_INTENT_TEST=n/a; NEW_SPEC=n/a; MARKERS=n/a; UNLINKED=no
if [ "$NOBUILD" != 1 ] && [ "$NEW_TIP" != "$OLD_TIP" ]; then
  DIFF=$(git -C "$WT" diff "$OLD_TIP".."$NEW_TIP" 2>/dev/null)
  NEW_INTENT=$(printf '%s\n' "$DIFF" | grep -cE '^\+.*INTENT:')
  NEW_INTENT_TEST=$(printf '%s\n' "$DIFF" | grep -cE '^\+.*INTENT-TEST:')
  NEW_SPEC=$(printf '%s\n' "$DIFF" | grep -cE "$SPEC_RE")
  MARKERS="$NEW_INTENT/$NEW_INTENT_TEST"
  if ! git -C "$WT" diff --quiet "$OLD_TIP".."$NEW_TIP" -- src 2>/dev/null; then
    if [ "$NEW_INTENT" = 0 ] && [ "$NEW_INTENT_TEST" = 0 ] && [ "$NEW_SPEC" = 0 ]; then
      UNLINKED=yes
      say "$(stamp)  UNLINKED-CHANGE: src changed between ${OLD_TIP:0:8} and ${NEW_TIP:0:8} but the commits register NO promise — 0 INTENT:, 0 INTENT-TEST:, 0 @spec <ID>. A fix without a linked intent is not done."
    fi
  fi
fi
say "$(stamp)  new_intent_markers=$MARKERS  new_spec_markers=$NEW_SPEC  (lines added by this round)"

if [ "$UNLINKED" = yes ]; then INTENTS=UNLINKED-CHANGE
elif [ "$AUDIT_OK" = true ]; then INTENTS=ok
else INTENTS=$VIOLATIONS
fi
step INTENT_AUDIT $(( $(now_ms) - t )) "ok=$AUDIT_OK violations=$VIOLATIONS rc=$AUDIT_RC new_intent_markers=$MARKERS new_spec_markers=$NEW_SPEC ($ALOG)"

# ===========================================================================
# 8. RECEIPT
# ===========================================================================
TOTAL_MS=$(( $(now_ms) - T0MS ))
TOTAL=$(( (TOTAL_MS + 500) / 1000 ))

# ---------------------------------------------------------------------------
# EXITS — every command whose success this round's verdict depends on, named with
# its own status. Astra: "required successful command exits including builder /
# CALL_RC / WRC / oracles". Before B02 only WRC and CALL_RC were captured and
# NEITHER could fail the round: a witness runner that died before its first
# assertion left `witnesses=?/?/?` and the round still asked only whether
# PAPERCUTS was 0.
# ---------------------------------------------------------------------------
: "${CALL_RC:=?}" "${CALL_RC_SRC:=none}" "${WRC:=?}" "${AUDIT_RC:=?}" \
  "${PAPERCUT_RC:=?}" "${CC_ORACLE_RC:=?}" "${GUARD_RC:=?}" \
  "${RECEIPT_VERDICT:=FAILED}" "${RECEIPT_REASON:=no receipt was parsed}" \
  "${CHECKS_N:=0}" "${CHECKS_OKN:=0}" "${ANALYSIS_MS:=0}" "${SESSION_ID:=}" "${INSTR_DIGEST:=}" \
  "${FIXTURE_SHA:=}" "${REQUEST_SHA:=}" "${ORACLE_SHA:=}" "${PAPERCUT_SHA:=}" \
  "${GUARD_SHA:=}" "${ROUND_SHA:=}" "${FXSTATE:=}" "${STATE:=unknown}" \
  "${RJSON:=}" "${LOGMODEL:=}" "${O1:=?}" "${O2:=?}" "${O3:=?}" "${O4:=?}" \
  "${FX_CONFIG_SHA:=}" "${FX_DEPS_SHA:=}" "${CAND_DEPS_SHA:=}" "${COMMIT:=skipped}" \
  "${WRAPPER_RC:=}" "${WRAPPER:=}" "${WRAPPER_START:=}" "${BUILDER_START:=}" \
  "${TERMINATION:=not-launched}" "${BUILDER_LAUNCHER:=}" "${PREV_TERMINAL_VERIFIED:=n/a}"
EXITS_BAD=""
add_bad() { EXITS_BAD="$EXITS_BAD${EXITS_BAD:+,}$1"; }
# The builder's own collected terminal status is an EXIT like any other, and the
# first one listed: it is the exit Astra's false-GREEN witness proved was missing.
case "$TERMINATION" in
  not-launched) : ;;
  collected)    [ "$WRAPPER_RC" = 0 ] || add_bad "builder=$WRAPPER_RC" ;;
  *)            add_bad "builder=${WRAPPER_RC:-unknown}($TERMINATION)" ;;
esac
[ "$CALL_RC" = 0 ] || add_bad "split_call=$CALL_RC"
# B02d item 2 — a SUPPLIED receipt is a diagnostic replay, and a diagnostic replay is
# never a certification. The producer's exit was not observed, so `rc=0 source=supplied`
# is an assertion by this round about a command this round did not run.
[ -z "$SPLIT_RECEIPT" ] || add_bad "split_call=diagnostic-replay(producer exit NOT observed)"
[ "$WRC" = 0 ] || add_bad "witnesses=$WRC"
[ "$AUDIT_RC" = 0 ] || add_bad "intent_audit=$AUDIT_RC"
[ "$PAPERCUT_RC" = 0 ] || add_bad "papercut_oracle=$PAPERCUT_RC"
[ "$CC_ORACLE_RC" = 0 ] || add_bad "cc_oracle=$CC_ORACLE_RC"
[ "$GUARD_RC" = 0 ] || add_bad "arch_guard=$GUARD_RC"
EXITS=${EXITS_BAD:-ok}

say ""
say "  $(printf '%-14s %8s %10s  %-9s %s' PHASE 'WALL s' 'WALL ms' CLASS RESULT)"
say "  --------------------------------------------------------------------------------"
for p in "${PHASES[@]}"; do
  _ph=${p%%|*}; _rest=${p#*|}
  _s=${_rest%%|*}; _rest=${_rest#*|}
  _res=${_rest%|*|*}; _rest=${_rest#*|}
  _ms=${_rest%%|*}; _cls=${_rest#*|}
  say "  $(printf '%-14s %8s %10s  %-9s %s' "$_ph" "$_s" "$_ms" "$_cls" "$_res")"
done
say "  --------------------------------------------------------------------------------"
say "  $(printf '%-14s %8s %10s' TOTAL "$TOTAL" "$TOTAL_MS")"
say '  (durations from /proc/uptime — CLOCK_BOOTTIME, monotonic; date(1) is used for labels only)'
say ""

RC=0
case "$BUILD" in ok) : ;; *) RC=1 ;; esac
case "$COMMIT" in ok|skipped) : ;; *) RC=1 ;; esac
case "$STATE" in committed*) : ;; *) RC=1 ;; esac
[ "$PAPERCUTS" = 0 ] || RC=1
[ "$ORACLES" = 4 ] || RC=1
[ "$WT_FAILS" = 0 ] && [ "$WT_ERRS" = 0 ] || RC=1
# a red intent contract, or a source change with no registered promise, is a
# failed round — a fix without a linked intent is not done.
[ "$AUDIT_OK" = true ] || RC=1
[ "$UNLINKED" = no ] || RC=1
# `:state "committed"` NEVER implies green on its own: the receipt's own checks and
# every command exit this verdict rests on have to be clean too.
[ "$RECEIPT_VERDICT" = ok ] || RC=1
[ "$EXITS" = ok ] || RC=1
VERDICT=GREEN; [ "$RC" = 0 ] || VERDICT=RED
# THE DIAGNOSTIC CAP. A replay may be perfectly clean and still prove nothing about a
# producer nobody watched: it exits 2 (non-zero — never certification) and says so by
# name in the ledger line, the receipt and the exit status [B02d item 2].
if [ -n "$SPLIT_RECEIPT" ]; then
  # RED still outranks DIAGNOSTIC: a replay that fails its own schema is a failure we
  # observed, and calling it "diagnostic" would soften a result we are entitled to.
  if [ "$RC" = 0 ]; then VERDICT=DIAGNOSTIC; RC=2; fi
  say "$(stamp)  DIAGNOSTIC: this round graded a SUPPLIED receipt ($SPLIT_RECEIPT). Whatever the schema says, the producer's exit, cwd and effective configuration were not observed here, so this run is a replay for diagnosis and NEVER a certification. exit=$RC"
fi

LINE="ROUND $NAME: tip ${OLD_TIP:0:8}→${NEW_TIP:0:8} build=$BUILD builder_exit=${WRAPPER_RC:-n/a} termination=$TERMINATION commit=$COMMIT state=$STATE in_call=${IN_CALL}ms PAPERCUTS=$PAPERCUTS oracles=$ORACLES/4 witnesses=${WT_TESTS}/${WT_ASSERTS}/${WT_FAILS} intents=$INTENTS new_intent_markers=$MARKERS new_spec_markers=$NEW_SPEC total=${TOTAL}s(${TOTAL_MS}ms) receipt_checks=$RECEIPT_VERDICT($CHECKS_OKN/$CHECKS_N) exits=$EXITS session=${SESSION_ID:-none} lease=$LOCKF runner_sha256=${RUNNER_SHA:0:16} verdict=$VERDICT receipt_json=$RECEIPT_JSON"
say "$LINE"
printf '%s  %s\n' "$(stamp)" "$LINE" >> "$LEDGER"
case "$TERMINATION" in
  collected) [ "$WRAPPER_RC" = 0 ] || say "$(stamp)  RED because the builder's collected terminal status is exit $WRAPPER_RC — 'PASS committed' on stdout is a claim, wait(2) is the receipt" ;;
  orphan)    say "$(stamp)  RED because the builder's termination status is UNKNOWN: codex $BUILDER_PID outlived its wrapper and nobody will ever collect its exit" ;;
  no-child)  say "$(stamp)  RED because no builder was ever observed in $WT — there is nothing whose work this round could be grading" ;;
  ceiling-kill) say "$(stamp)  RED because the builder hit the $MINUTES-minute ceiling and was killed" ;;
esac
[ "$COMMIT" = ok ] || [ "$COMMIT" = skipped ] || say "$(stamp)  RED because the builder left no clean commit: commit=$COMMIT"
case "$RECEIPT_VERDICT" in
  ok) : ;;
  DIAGNOSTIC) say "$(stamp)  NOT GREEN because the receipt was SUPPLIED, not produced here: $RECEIPT_REASON" ;;
  *) say "$(stamp)  RED because the split receipt did not survive its own schema gate: $RECEIPT_REASON" ;;
esac
[ "$EXITS" = ok ] || say "$(stamp)  RED because a command this verdict rests on exited non-zero: $EXITS"

# ---------------------------------------------------------------------------
# THE MACHINE RECEIPT — one JSON per round, written ONCE (O_EXCL), bound to the
# exact candidate it graded: tip sha, fixture sha, request sha256, oracle script
# sha256, round-script sha256. The ledger line is for a human; this is the record
# a later comparison can be held to. Refusing to overwrite is the point: two runs
# called `smoke` must never silently become one.
# ---------------------------------------------------------------------------
if [ -e "$RECEIPT_JSON" ]; then
  say "$(stamp)  REFUSING to overwrite $RECEIPT_JSON — a round receipt is immutable; this round's record is in $LOG only"
else
  NAME="$NAME" WT="$WT" BRANCH="$BRANCH" OLD_TIP="$OLD_TIP" NEW_TIP="$NEW_TIP" \
  FIXTURE="$FIXTURE" FIXTURE_SHA="$FIXTURE_SHA" REQUEST="${REQUEST:-}" REQUEST_SHA="$REQUEST_SHA" \
  ORACLE_SHA="$ORACLE_SHA" PAPERCUT_SHA="$PAPERCUT_SHA" GUARD_SHA="$GUARD_SHA" ROUND_SHA="$ROUND_SHA" \
  MODEL="$MODEL" LOGMODEL="$LOGMODEL" BUILD="$BUILD" SPLIT_STATE="$STATE" IN_CALL="$IN_CALL" \
  PAPERCUTS="$PAPERCUTS" ORACLES="$ORACLES" O1="$O1" O2="$O2" O3="$O3" O4="$O4" \
  WT_TESTS="$WT_TESTS" WT_ASSERTS="$WT_ASSERTS" WT_FAILS="$WT_FAILS" WT_ERRS="$WT_ERRS" \
  INTENTS="$INTENTS" AUDIT_OK="$AUDIT_OK" VIOLATIONS="$VIOLATIONS" UNLINKED="$UNLINKED" \
  MARKERS="$MARKERS" NEW_SPEC="$NEW_SPEC" TOTAL="$TOTAL" TOTAL_MS="$TOTAL_MS" RC="$RC" VERDICT="$VERDICT" \
  COMMIT="$COMMIT" TERMINATION="$TERMINATION" WRAPPER="$WRAPPER" WRAPPER_RC="$WRAPPER_RC" \
  WRAPPER_START="$WRAPPER_START" BUILDER_PID="$BUILDER_PID" BUILDER_START="$BUILDER_START" \
  BOOT_ID="$BOOT_ID" BUILDER_LAUNCHER="$BUILDER_LAUNCHER" ANALYSIS_MS="$ANALYSIS_MS" \
  FX_CONFIG="$FX_CONFIG" FX_CONFIG_SHA="$FX_CONFIG_SHA" FX_DEPS_SHA="$FX_DEPS_SHA" \
  CAND_DEPS_SHA="$CAND_DEPS_SHA" RUNDIR="$RUNDIR" FROZEN="$FROZEN" RUNNER_SHA="$RUNNER_SHA" \
  RUNNER_SRC="$RUNNER_SRC" PREV_TERMINAL_VERIFIED="$PREV_TERMINAL_VERIFIED" \
  SPLIT_RECEIPT_SUPPLIED="${SPLIT_RECEIPT:-}" \
  CALL_RC="$CALL_RC" CALL_RC_SRC="$CALL_RC_SRC" WRC="$WRC" AUDIT_RC="$AUDIT_RC" \
  PAPERCUT_RC="$PAPERCUT_RC" CC_ORACLE_RC="$CC_ORACLE_RC" GUARD_RC="$GUARD_RC" EXITS="$EXITS" \
  RECEIPT_VERDICT="$RECEIPT_VERDICT" RECEIPT_REASON="$RECEIPT_REASON" \
  CHECKS_N="$CHECKS_N" CHECKS_OKN="$CHECKS_OKN" SESSION_ID="$SESSION_ID" \
  INSTR_DIGEST="$INSTR_DIGEST" PREV_STATUS="$PREV_STATUS" RESUME="$RESUME" \
  LOCKF="$LOCKF" RSTATE="$RSTATE" FXSTATE="$FXSTATE" LOGFILE="$LOG" \
  SPLIT_RECEIPT_EDN="${RECEIPT:-}" SPLIT_RECEIPT_JSON="$RJSON" \
  PHASES_STR="$(printf '%s\n' "${PHASES[@]}")" \
  python3 - "$RECEIPT_JSON" <<'PY'
import json, os, sys, time
e = os.environ
def num(k):
    try: return int(e.get(k, ""))
    except Exception: return e.get(k, "")
# "phase|wall_s|result|wall_ms|class" — the result field is written second so a
# human reading the log sees it early; it is parsed from BOTH ends so a result
# containing a "|" cannot shift the numeric fields.
phases = []
durations_ms = {}
for row in e["PHASES_STR"].splitlines():
    if not row.strip():
        continue
    head, sep, tail = row.partition("|")
    if not sep:
        continue
    body, _, klass = tail.rpartition("|")
    body, _, ms = body.rpartition("|")
    wall_s, _, result = body.partition("|")
    def _i(x):
        try: return int(x)
        except Exception: return x
    phases.append({"phase": head, "wall_s": _i(wall_s), "wall_ms": _i(ms),
                   "class": klass, "result": result})
