      "${PREV_MODEL_REQ:=}" "${PREV_STATUS:=}" "${PREV_SID:=}" "${PREV_SETTINGS:=}" \
      "${SET_MISSING:=}" "${SET_DIFFER:=}" "${PREV_BASIS:=none recorded}" \
      "${PREV_STATUS_LABEL:=carried(unverified)}"
    [ "$META_OK" = 1 ] || refuse "resume-bad-metadata: $RSTATE/session.json could not be read as a session record ($META_ERR)"
    [ -n "$PREV_ROOT" ] || refuse "resume-missing-root: $RSTATE/session.json records no root for session $SID. An unknown previous root cannot be compared with '$WT', and an unverifiable scope is not a verified scope."
    [ "$PREV_ROOT" = "$WT" ] || \
      refuse "resume-root-mismatch: session $SID was recorded against root '$PREV_ROOT'; this round owns '$WT'. A scope change gets a deliberate fresh session, never a resume."
    [ -n "$PREV_MODEL$PREV_MODEL_REQ" ] || refuse "resume-missing-model: $RSTATE/session.json records no model for session $SID (neither an observed \`model:\` line nor the model that was requested). Resuming into an unknown model is an unmeasured environment change."
