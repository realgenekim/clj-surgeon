#!/usr/bin/env bash
# round <worktree> <findings.md> <name> [options] — ONE command that runs a complete
# namespace-split builder round and grades it. Gene, 2026-09-08: "It should have taken
# only 4m -- why is this taking so long! We must make this routine perfect".
#
# The routine, end to end, with every gotcha this seat paid for baked in:
#   LOCK -> PREFLIGHT -> BUILD (sol-yolo/codex, bound to the CHILD pid) -> COMMIT CHECK
#   -> GRADE (fresh fixture, branch build, papercut-oracle + 4 fixture oracles)
#   -> WITNESSES (focused cold test namespaces) -> RECEIPT (table + one ledger line).
#
# Options:
#   --minutes N     builder wall ceiling, default 25
#   --fixture PATH  reuse an existing fixture worktree instead of creating one
#   --request EDN   split request, default D1-request.edn repointed at the fixture
#   --model NAME    codex model, default gpt-6-astra (verified against the builder log)
#   --no-build      skip the builder; grade whatever tip the worktree already has
#   --launcher PATH the wrapper this round SUPERVISES (default ~/bin/sol-yolo). It is a
#                   real option, not a test seam: the supervision code below is identical
#                   whatever it names, which is exactly what makes a stub builder a valid
#                   witness for the terminal-status contract.
#   --adopt PID     DISABLED (B02b). Refuses `adopt-disabled: pending ownership transfer`.
#                   Adopt took a SEPARATE lease ($ADOPT_LOCKF), so an adopting round could
#                   enter BUILD while another holder still owned the canonical worktree
#                   lease — demonstrated by Astra 2026-09-08. It stays refused until adopt
#                   acquires the canonical lease through an explicit ownership transfer.
#   --resume        continue the codex session THIS worktree last ran, feeding the new
#                   findings file as the follow-up prompt. Explicit persisted session id
#                   only; `codex exec resume --last` is never used by this apparatus.
#   --session ID    the session uuid to record/resume (overrides the persisted one).
#   --split-receipt PATH
#                   grade an ALREADY-PRODUCED split receipt instead of invoking the split.
#                   For re-grading and for apparatus self-tests of the receipt schema.
#
# STATE lives OUTSIDE the worktree, keyed by canonical worktree path:
#   /var/tmp/forge/round/state/<sha256(worktree)>/{root,lease,session.id,session.json}
# A lock file inside the candidate is a file the builder's own `git status` and
# `git clean` can see; three of them used to be left there every round.
#
# OUTPUT is an IMMUTABLE BUNDLE reserved by name before any work happens:
#   /var/tmp/forge/round/runs/<name>/{round.log,round.frozen,receipt.json,brief.md,...}
# The reservation IS the `mkdir` — atomic, so two rounds cannot share a name and a
# second run can never truncate the first one's log (Astra: the positive `.log` was
# overwritten before `receipt-exists` ever ran). The round then copies itself into the
# bundle and `exec`s THAT copy, so an edit to ~/bin/round mid-run cannot change the
# behaviour being measured.
#
# RATCHETS BAKED IN (each one is a scar, not a preference):
#  * [[sol-yolo-wrapper-pid-is-not-the-run]] the sol-yolo WRAPPER exits while the codex
#    CHILD keeps working. We find the child by scanning /proc for cwd==worktree and
#    "codex exec" in argv, print a START RECEIPT naming it, and wait on THAT pid.
#  * [[waiters-bind-to-pid-not-argv]] no `pgrep -f` anywhere — an unanchored argv match
#    self-matches this script's own bash -c. Every scan is /proc + cwd + argv.
#  * never `pkill`; the only kill is `kill <exact child pid>`.
#  * never wrap the builder in an outer `timeout` — timeout kills your WAIT, not the
#    child, and an unsupervised codex keeps editing the worktree.
#  * a per-worktree flock, so two rounds can never collide in one tree (the collision
#    that cost round 4: two Astra runs, one paused itself, uncommitted merge left behind).
#  * `</dev/null` on every subprocess (a codex/bb/clojure that inherits a tty stdin hangs).
#  * temp under /var/tmp/forge, never /tmp (RAM tmpfs, filled twice).
#  * `date` here is uutils: no %3N. We take %N and cut to milliseconds.
#  * the fixture's suite APPENDS to the tracked 00SERVER-LOGS.txt — excluded from every
#    clean check, in the fixture only.
#  * JAVA_TOOL_OPTIONS prints "Picked up ..." on stderr; never treated as failure.
#  * the model is verified from the builder log's `model:` line, not from the flag we
#    passed — a flag is a request, the log is the receipt.
set -uo pipefail

# ---------------------------------------------------------------------------
# args
# ---------------------------------------------------------------------------
usage() {
  awk 'NR>1 && /^#/ {sub(/^# ?/,""); print; next} NR>1 {exit}' "$0" >&2
  exit 2
}
# The ORIGINAL argv, kept before any shift, because this script re-`exec`s a frozen
# copy of itself with exactly the arguments it was called with (item 11).
ROUND_ARGV=("$@")
[ $# -ge 3 ] || usage
WT=$(readlink -f "${1:?worktree}"); FINDINGS=${2:?findings.md}; NAME=${3:?name}
shift 3
MINUTES=25 FIXTURE="" REQUEST="" MODEL=gpt-6-astra NOBUILD=0 ADOPT=""
RESUME=0 SESSION="" SPLIT_RECEIPT="" LAUNCHER=/home/forge/bin/sol-yolo
RESUME_LAUNCHER=/home/forge/bin/round-resume
while [ $# -gt 0 ]; do
  case "$1" in
    --minutes) MINUTES=${2:?}; shift 2 ;;
    --adopt)   ADOPT=${2:?}; shift 2 ;;
    --fixture) FIXTURE=$(readlink -f "${2:?}"); shift 2 ;;
    --request) REQUEST=$(readlink -f "${2:?}"); shift 2 ;;
    --model)   MODEL=${2:?}; shift 2 ;;
    --no-build) NOBUILD=1; shift ;;
    --resume)  RESUME=1; shift ;;
    --session) SESSION=${2:?}; shift 2 ;;
    --launcher) LAUNCHER=$(readlink -f "${2:?}"); shift 2 ;;
    --split-receipt) SPLIT_RECEIPT=$(readlink -f "${2:?}"); shift 2 ;;
    *) echo "round: unknown option $1" >&2; usage ;;
  esac
done

# --------------------------------------------------------------------------
# ADOPT IS DISABLED — item 2. This refusal is BEFORE the reservation, before the
# lease, before any file is touched, because an adopting round's first observable
# act must be the refusal itself.
#
# Why: `--adopt` took $RSTATE/adopt.lease and deliberately did NOT contend for the
# canonical $RSTATE/lease (the fd-inheritance repair made that seem safe). Astra
# held the canonical lease with an independent descriptor, ran `round --adopt`, and
# it entered BUILD and printed a START RECEIPT anyway. Two ownership protocols is
# no ownership protocol. Re-enabling requires adopt to acquire the CANONICAL lease
# via an explicit transfer from the holder, not a second lock beside it.
# --------------------------------------------------------------------------
if [ -n "$ADOPT" ]; then
  echo "round: REFUSED adopt-disabled: pending ownership transfer — --adopt used a second lease (adopt.lease) beside the canonical worktree lease, so an adopting round could enter BUILD while another round still owned the tree (Astra, 2026-09-08). It will return when adopt acquires the canonical lease through an explicit ownership transfer from its holder. Until then: wait for the holding round, or run a fresh round once the tree is free." >&2
  exit 3
fi

CC_SRC=/home/forge/src/curtaincall-cfp
CC_SHA=d9205abcc9b9f31d93bd4a76537b74fccd583ca6
CELLC=/var/tmp/forge/plan2/cellC
GUARD_TEST=/var/tmp/forge/plan2/split/view_architecture_test.clj
PAPERCUT=$CELLC/papercut-oracle.py
CC_ORACLE=$CELLC/cc-oracle.py
BASE_REQUEST=$CELLC/D1-request.edn
OUT=/var/tmp/forge/round
LEDGER=$OUT/ledger.txt

# ===========================================================================
# 0. RESERVE THE OUTPUT BUNDLE, THEN FREEZE AND RE-EXEC THE RUNNER
#
# Item 5 (immutable output bundle). Astra's finding: the JSON receipt was
# O_EXCL and correctly refused reuse, but `: > "$LOG"` had ALREADY truncated the
# log the earlier receipt pointed at — the referenced evidence was destroyed
# before the immutability check ran. Refusing late is not refusing.
#
# So the FIRST act of a round is `mkdir /var/tmp/forge/round/runs/<name>`, which
# is atomic on every filesystem we use: exactly one round can create it, and a
# duplicate name is refused before a single byte of any prior artefact is opened
# for writing. EVERY artefact of the run — log, brief, builder log, request,
# split receipt, oracle logs, JSON receipt — lives inside that directory.
#
# Item 11 (frozen runner identity). Astra: a mid-run edit to ~/bin/round changes
# the behaviour being measured and nothing records it. The reserving process
# copies itself into the bundle, hashes it, and `exec`s THAT copy with the same
# argv. From here on the executing bytes are read-only, hashed, and retained
# next to the receipt that cites them.
# ===========================================================================
bail() { echo "round: REFUSED $*" >&2; exit 3; }
mkdir -p "$OUT/runs" || bail "cannot create $OUT/runs"
RUNDIR=$OUT/runs/$NAME
FROZEN=$RUNDIR/round.frozen
if [ -z "${ROUND_FROZEN:-}" ]; then
  mkdir "$RUNDIR" 2>/dev/null \
    || bail "run-exists: $RUNDIR already exists — a round's output bundle is reserved by name and immutable, and this refusal happens BEFORE any log, receipt or request of the earlier run is opened. Choose a new <name>, or move the old bundle aside deliberately."
  cp "$0" "$FROZEN" || bail "cannot freeze the runner into $FROZEN"
  chmod 0555 "$FROZEN" || bail "cannot make $FROZEN read-only"
  _rsha=$(sha256sum < "$FROZEN" | cut -d' ' -f1)
  printf '%s  %s  (frozen from %s at %s)\n' "$_rsha" "$FROZEN" "$0" "$(date -u +%FT%TZ)" > "$RUNDIR/round.frozen.sha256"
  export ROUND_FROZEN="$RUNDIR" ROUND_RUNNER_SHA="$_rsha" ROUND_RUNNER_SRC="$0"
  exec "$FROZEN" "${ROUND_ARGV[@]}"
fi
RUNNER_SHA=${ROUND_RUNNER_SHA:-$(sha256sum < "$0" | cut -d' ' -f1)}
RUNNER_SRC=${ROUND_RUNNER_SRC:-$0}

LOG=$RUNDIR/round.log
# The round's own machine receipt. IMMUTABLE: a name is used once, so a re-run can
# never quietly overwrite the evidence of the run it is being compared against
# (Astra: "immutable unique output paths; no reused `smoke` overwrite").
RECEIPT_JSON=$RUNDIR/receipt.json

# ---------------------------------------------------------------------------
# ledger / timing.  `date` on this box is uutils: %3N is NOT supported, %N is.
#
# Item 11 (measurement): wall clock is NOT a duration source. `date +%s` is
# settable and NTP-steppable, and every phase number in this apparatus is meant
# to be compared against a native floor. Elapsed time comes from /proc/uptime,
# which is CLOCK_BOOTTIME in centiseconds and cannot go backwards. `date` is kept
# for human timestamps only, where an absolute UTC label is what is wanted.
# ---------------------------------------------------------------------------
stamp() { date -u +%FT%T.%N | cut -c1-23; }
now_ms() { local u r; read -r u r < /proc/uptime; echo $(( ${u%.*} * 1000 + 10#${u#*.} * 10 )); }
T0MS=$(now_ms)
T0=$(date +%s)
PHASES=()          # "phase|wall_s|result|wall_ms|class"
phase_t0() { now_ms; }
# Astra's §3 phase vocabulary, so a receipt's durations decompose the same way a
# native floor's do. Every `step` carries its class; the receipt sums them.
phase_class() {
  case "$1" in
    LOCK|PREFLIGHT)   echo admission ;;
    BUILD)            echo build ;;
    COMMIT_CHECK)     echo commit ;;
    FIXTURE_SETUP)    echo setup ;;
    SPLIT_CALL)       echo write ;;
    RECEIPT_SCHEMA)   echo proof ;;
    ORACLES)          echo probe ;;
    GRADE)            echo grade ;;
    WITNESSES)        echo witness ;;
    INTENT_AUDIT)     echo audit ;;
    *)                echo other ;;
  esac
}
say() { printf '%s\n' "$*" | tee -a "$LOG"; }
step() {   # step <phase> <wall-ms> <result>
  local ms=$2 s
  s=$(( (ms + 500) / 1000 ))
  PHASES+=("$1|$s|$3|$ms|$(phase_class "$1")")
  say "$(stamp)  [+$(( ($(now_ms) - T0MS) / 1000 ))s]  $1 ${s}s (${ms}ms) :: $3"
}
refuse() { say "$(stamp)  REFUSED: $*"; exit 3; }
: > "$LOG"
say "$(stamp)  ROUND $NAME start  worktree=$WT findings=$FINDINGS model=$MODEL minutes=$MINUTES no_build=$NOBUILD"
say "$(stamp)  bundle=$RUNDIR  runner=$FROZEN (frozen from $RUNNER_SRC) sha256=$RUNNER_SHA"

# ---------------------------------------------------------------------------
# /proc scan for a live codex bound to a given WORKTREE.  NEVER pgrep -f: an
# unanchored argv match self-matches the harness's own `bash -c` and never fires.
#
# DEFECT 1, first live round (2026-09-08): the codex process's cwd is NOT the
# worktree.  sol-yolo passes `-C <worktree>` and codex keeps the LAUNCHER's cwd —
# observed cwd=/home/forge/src/marvin-voice-remote/channel-connector while argv
# read `codex exec ... -C /home/forge/src/clj-surgeon-split ...`.  A cwd-only scan
# is blind to every real builder.  So the AUTHORITY is argv: "codex exec" AND
# `-C <worktree>` (exact, trailing slash accepted).  cwd==worktree is kept as a
# SECONDARY match — it costs nothing and would catch a launcher that does chdir.
# ---------------------------------------------------------------------------
codex_pids_in() {  # codex_pids_in <worktree> [min-start-epoch]  -> pids, numerically sorted
  local dir=${1%/} minstart=${2:-0} p cwd args
  for p in /proc/[0-9]*; do
    p=${p#/proc/}
    # a process can exit between the glob and the read; that is a race, not an error,
    # so the whole read is stderr-silenced (redirecting only `tr` still lets bash
    # print "No such file or directory" for the failed input redirection).
    args=$({ tr '\0' ' ' < "/proc/$p/cmdline"; } 2>/dev/null) || continue
    case "$args" in *"codex exec "*) ;; *) continue ;; esac
    cwd=$(readlink "/proc/$p/cwd" 2>/dev/null)
    case "$args" in
      *" -C $dir "*|*" -C $dir/ "*) ;;                 # primary: the -C fence
      *)  [ "$cwd" = "$dir" ] || continue ;;           # secondary: an actual chdir
    esac
    if [ "$minstart" != 0 ]; then
      [ "$(proc_start "$p")" -ge "$minstart" ] 2>/dev/null || continue
    fi
    echo "$p"
  done | sort -n
}

# One launch shows up as TWO matches: the `node .../codex` shim and the native
# `codex-linux-x64/.../codex` binary it execs as its child. Wait on the PARENT —
# it outlives nothing and dies when the run ends. `sort -n | head -1` picks it
# deterministically; the /proc glob's own order is LEXICOGRAPHIC and would pick
# the wrong one the moment pid width changes (1000001 sorts before 999999).
codex_leader_in() { codex_pids_in "$@" | head -1; }

proc_start() {  # epoch seconds at which <pid> started (the /proc dir's mtime)
  stat -c %Y "/proc/$1" 2>/dev/null || echo 0
}

# ---------------------------------------------------------------------------
# ATTESTED PROCESS-START IDENTITY (item 1).  Astra: "Both paths still use PID
# ordering or /proc directory mtime rather than an attested process-start
# identity."  /proc/<pid> mtime is a second-granularity directory timestamp; two
# processes started in the same second are indistinguishable and a recycled pid
# is invisible.  `starttime` (/proc/<pid>/stat field 22) is the kernel's own
# CLOCK_BOOTTIME jiffy count at exec — unique per (boot_id, pid, starttime), and
# the ONLY thing that makes "is pid N still the process I launched?" answerable.
#
# Parsing: field 2 is `(comm)` and comm may contain spaces AND parentheses, so
# the only correct split is "everything after the LAST ')'".  After that split,
# field 3 (state) is positional 1, so field 22 is positional 20.
# ---------------------------------------------------------------------------
BOOT_ID=$(cat /proc/sys/kernel/random/boot_id 2>/dev/null || echo unknown)
proc_starttime() {  # jiffies-since-boot at which <pid> started; empty if gone
  local s
  s=$(cat "/proc/$1/stat" 2>/dev/null) || return 1
  s=${s##*) }
  # shellcheck disable=SC2086
  set -- $s
  printf '%s' "${20:-}"
}
# alive_as <pid> <starttime> — true only when <pid> is BOTH live and still the
# same process we identified. A bare `kill -0` says "some process has this pid".
alive_as() {
  local pid=$1 want=${2:-} have
  kill -0 "$pid" 2>/dev/null || return 1
  [ -n "$want" ] || return 0
  have=$(proc_starttime "$pid") || return 1
  [ "$have" = "$want" ]
}

# is_ours <pid> — true when <pid> belongs to THIS round: same process group, or a
# PPid chain that walks up to us. Used only to keep our own children out of
# diagnostics; never to decide what to reap.
is_ours() {
  local pid=$1 g n=0
  g=$(ps -o pgid= -p "$pid" 2>/dev/null | tr -d ' ')
  [ -n "$MYPGID" ] && [ "$g" = "$MYPGID" ] && return 0
  while [ "$pid" != 1 ] && [ -n "$pid" ] && [ "$n" -lt 24 ]; do
    [ "$pid" = "$$" ] && return 0
    pid=$(awk '/^PPid:/{print $2}' "/proc/$pid/status" 2>/dev/null)
    n=$((n+1))
  done
  return 1
}

# ===========================================================================
# 1. LOCK
# ===========================================================================
t=$(phase_t0)
[ -d "$WT" ] || refuse "no such worktree: $WT"

# ---------------------------------------------------------------------------
# ONE LEASE, KEYED BY CANONICAL WORKTREE IDENTITY, OUTSIDE THE WORKTREE.
#
# Before B02 the three lock files lived IN the candidate: .round.lock,
# .round.adopt.lock, .round.lock.adopted. Every one of them is visible to the
# builder's own `git status` and removable by its own `git clean -fdq` — an
# apparatus artefact inside the thing under measurement, and a lock whose holder
# the subject can delete is not a lock. They now live under
#   $OUT/state/<sha256(canonical worktree path)>/
# which is (a) outside every candidate, (b) stable across two spellings of the
# same path, and (c) the same directory that carries the persisted session id, so
# "who owns this tree" and "which conversation is this tree's" are one record.
# ---------------------------------------------------------------------------
ROOT_DIGEST=$(printf '%s' "$WT" | sha256sum | cut -d' ' -f1)
RSTATE=$OUT/state/$ROOT_DIGEST
mkdir -p "$RSTATE" || refuse "cannot create state dir $RSTATE"
printf '%s\n' "$WT" > "$RSTATE/root"     # the digest's preimage, for a human
LOCKF=$RSTATE/lease
MYPGID=$(ps -o pgid= -p $$ 2>/dev/null | tr -d ' ')

# Legacy in-tree locks from rounds built before B02: remove them, but ONLY when
# nothing holds them — an old round still running is still entitled to its lock.
for _legacy in "$WT/.round.lock" "$WT/.round.adopt.lock" "$WT/.round.lock.adopted"; do
  [ -e "$_legacy" ] || continue
  if [ -z "$(fuser "$_legacy" 2>/dev/null | tr -d ' ')" ]; then
    rm -f "$_legacy" && say "$(stamp)  removed legacy in-tree lock $_legacy (unheld)"
  else
    say "$(stamp)  WARNING: legacy in-tree lock $_legacy is HELD by another process — left alone"
  fi
done

# The round receipt is immutable: refuse BEFORE any work, not after producing it.
[ -e "$RECEIPT_JSON" ] && refuse "receipt-exists: $RECEIPT_JSON already exists — a round receipt is immutable evidence; choose a new <name> (or move the old receipt aside deliberately)"

# ---------------------------------------------------------------------------
# ONE LEASE. THE CANONICAL ONE. NO SECOND PROTOCOL.
#
# THE ROOT CAUSE, first --adopt attempt (2026-09-08): `exec 9>$LOCKF` puts the
# lock on a descriptor that EVERY child inherits across fork+exec. sol-yolo, its
# bash wrapper, and codex all carried fd 9, so the flock outlived the round that
# took it and was "held" by the very builder we were trying to adopt:
#     REFUSED: round already running (pid 2655184 2655203 2829462 2829483 2829485)
# — 2655184 being the wrapper of the FAILED round, and 2829462+ this round's own
# short-lived children, all of them mere INHERITORS of one fd.
#
# The REPAIR is (a) alone: the builder is launched with `9>&-` (and `8>&-`, `7>&-`),
# so no child ever inherits the lease again — see the BUILD phase.
#
# The old fix (b) — "--adopt takes a SEPARATE lock ($ADOPT_LOCKF)" — was WRONG, and
# Astra proved it: she held this canonical lease with an independent descriptor,
# started `round --adopt`, and it sailed past into BUILD because it never asked for
# this lock at all. A second lease is not a weaker lease, it is a bypass. --adopt
# is refused at argv (item 2) and $ADOPT_LOCKF no longer exists; EVERY round takes
# the canonical lease here or is refused here.
# ---------------------------------------------------------------------------
exec 9>"$LOCKF" || refuse "cannot open lock $LOCKF"
if ! flock -n 9; then
  # A held lock is now genuinely ambiguous no longer — but an OLD leaked fd may
  # still be out there, so name the builder instead of dead-ending.
  # fuser reports every INHERITOR, our own transient children included — which is
  # what made the last refusal unreadable. Drop anything in our own process group.
  holder=""
  for _h in $(fuser "$LOCKF" 2>/dev/null | tr -s ' '); do
    case "$_h" in ''|*[!0-9]*) continue ;; esac
    # a holder that is already gone was one of fuser's own transient siblings —
    # it raced us and cannot be pgid-checked, so it is ours by elimination.
    kill -0 "$_h" 2>/dev/null || continue
    is_ours "$_h" && continue
    holder="$holder $_h"
  done
  [ -n "${holder// /}" ] || holder=" (all holders are our own children — a stale leaked fd)"
  leader=$(codex_leader_in "$WT")
  if [ -n "$leader" ]; then
    refuse "lease-held: another round owns $WT — lease=$LOCKF holder_pid(s):$holder; its builder is pid $leader. Wait for the holding round to finish; --adopt is disabled pending ownership transfer."
  fi
  refuse "lease-held: another round owns $WT — lease=$LOCKF holder_pid(s):$holder; no codex builder is fenced to the tree (a --no-build or grade-only round). Wait for it to finish."
fi
LOCKMODE="flock held on $LOCKF (canonical, the only lease)"

# A codex fenced to this worktree means a round is already building here. With
# --adopt disabled there is no exemption: an unowned builder in the tree is a
# refusal, full stop.
#
# Our OWN process group is excluded here: nothing we have spawned at this point can
# legitimately be a builder, and a stray match on our own children is exactly the
# noise that made the last refusal unreadable. The exclusion is deliberately scoped
# to this pre-launch scan only — post-launch discovery and reaping must NOT filter
# by pgid, or a builder whose `setsid` failed would become both undiscoverable and
# unreapable.
found=""
for _p in $(codex_pids_in "$WT"); do
  _g=$(ps -o pgid= -p "$_p" 2>/dev/null | tr -d ' ')
  [ -n "$MYPGID" ] && [ "$_g" = "$MYPGID" ] && continue
  found="$found $_p"
done
found=${found# }
existing=$found
if [ -n "${existing// /}" ]; then
  refuse "unowned-builder: a codex process already lives in $WT (pid $existing) but this round does not own it. --adopt is disabled pending ownership transfer, so there is nothing safe to do but wait for its round to finish."
fi
step LOCK $(( $(now_ms) - t )) "ok ($LOCKMODE; state=$RSTATE; no lock files in the worktree; no unowned codex fenced to tree)"

# ===========================================================================
# 2. PREFLIGHT
# ===========================================================================
t=$(phase_t0)
git -C "$WT" rev-parse --git-dir >/dev/null 2>&1 || refuse "$WT is not a git worktree"

# ---------------------------------------------------------------------------
# WHAT "DIRTY" MEANS (item 4).  Until B02b both the preflight and the commit check
# ran `git status --porcelain --untracked-files=no`, so an UNTRACKED source file was
# invisible to both. Astra planted `src/astra_acceptance_untracked.clj` in the
# candidate and the round announced a clean preflight over it.
#
# That is not a cosmetic gap. `git diff OLD..NEW` — the basis for every claim this
# round makes about what the builder changed, including the linked-intent check — is
# blind to a file that was never added. A namespace that exists on disk, is on the
# classpath, is loaded by the suite, and is in NO commit is precisely the shape of
# evidence that makes a green round unreproducible.
#
# So the tree is dirty when EITHER a tracked file is modified (any path) OR an
# untracked file appears in a path that can change behaviour: src/, test/,
# resources/, deps.edn, .clj-surgeon.edn. Untracked scratch elsewhere (notes, logs,
# a stray tarball) is still ignored — the filter is what keeps this a real gate
# instead of a nuisance everybody learns to suppress.
# ---------------------------------------------------------------------------
RELEVANT_UNTRACKED_RE='^(src|test|resources)/|^deps[.]edn$|^[.]clj-surgeon[.]edn$'
relevant_dirty() {  # relevant_dirty <repo> -> porcelain lines that count as dirty
  git -C "$1" status --porcelain --untracked-files=all 2>/dev/null | awk -v re="$RELEVANT_UNTRACKED_RE" '
    {
      code = substr($0, 1, 2); path = substr($0, 4)
      if (code == "??") { if (path ~ re) print $0 }
      else print $0
    }'
}
dirty=$(relevant_dirty "$WT")
[ -z "$dirty" ] || { say "$dirty"; refuse "dirty: $WT has uncommitted tracked changes or untracked files under src/test/resources/deps.edn/.clj-surgeon.edn — a round's verdict is only meaningful against a basis that git can name. Commit them, or remove them."; }
OLD_TIP=$(git -C "$WT" rev-parse HEAD)
BRANCH=$(git -C "$WT" rev-parse --abbrev-ref HEAD)
command -v bb >/dev/null || refuse "bb not on PATH"
[ -x /home/forge/bin/clj-kondo ] || refuse "~/bin/clj-kondo missing or not executable"
[ -f "$PAPERCUT" ] || refuse "papercut oracle missing: $PAPERCUT"
[ -f "$CC_ORACLE" ] || refuse "cc oracle missing: $CC_ORACLE"
[ -f "$GUARD_TEST" ] || refuse "guard test missing: $GUARD_TEST"
