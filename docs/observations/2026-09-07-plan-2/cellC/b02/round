    INSTR_DIGEST="$INSTR_DIGEST" BRIEF="$BRIEF" NAME="$NAME" STATUS="$1" PREV_STATUS="$PREV_STATUS" \
    STATUS_BASIS="${2:-carried label (no wait status collected by this apparatus)}" \
    INSTR_PROFILE="$(cat "$HOME/.claude/CLAUDE.md" "$HOME/.codex/AGENTS.md" "$WT/AGENTS.md" "$WT/CLAUDE.md" 2>/dev/null | sha256sum | cut -d' ' -f1)" \
    BLOG="$BLOG" RESUME="$RESUME" BUILDER_PID="$BUILDER_PID" \
    python3 - "$RSTATE" <<'PY'
