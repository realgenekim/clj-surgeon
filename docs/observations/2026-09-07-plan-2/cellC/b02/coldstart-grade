#!/usr/bin/env python3
"""coldstart-grade <transcript.jsonl|log> [--format claude|codex|auto] [--cond W|0] [--json OUT]

The ACTION-LOG ORACLE (Astra, /var/tmp/forge/plan2/cellC/astra-coldstart.md §"Action-log
oracle") applied as a grader over ONE fresh agent's transcript.

It answers exactly one question: did this agent, with no coaching, execute the
Clojure fast-feedback loop --- warm nREPL probe first, exactly one cold gate last,
a receipt that separates probe from proof --- and did it avoid the named
anti-patterns?

WHAT THIS IS NOT (Astra's correction, honoured):
  A transcript is what the agent ATTEMPTED. It is not a process observer. A hidden
  child, a socket opened inside a python heredoc we failed to classify, or output
  the runner truncated are all invisible here. Where the transcript cannot decide,
  this grader says UNVERIFIED, never PASS. Quoted `pkill` in prose is NOT a kill
  attempt, so every shell scan runs over COMMAND POSITIONS in a comment-and-heredoc
  stripped command, never over raw text.

Timestamps: the harness pipes the runner's stream through `coldstart-stamp`, which
prefixes every line with `@<epoch.micros>|`. Without those stamps the wall metrics
report `unknown` rather than a fabricated zero.

Exit 0 on PASS, 1 on FAIL or UNVERIFIED.
"""
from __future__ import annotations

import argparse
import json
import os
import re
import sys
from dataclasses import dataclass, field
from typing import Any

# ---------------------------------------------------------------------------
# events
# ---------------------------------------------------------------------------


@dataclass
class Ev:
    seq: int
    kind: str  # 'bash' | 'edit' | 'tool' | 'text'
    ts: float | None = None  # when the agent issued it
    end_ts: float | None = None  # when its result came back
    tool: str = ""
    cmd: str = ""  # for bash: the shell command
    payload: str = ""  # for edit: the written content; for text: the prose
    path: str = ""
    output: str = ""

    def brief(self, n: int = 88) -> str:
        s = (self.cmd or self.path or self.payload or "").replace("\n", " ")
        s = re.sub(r"\s+", " ", s).strip()
        return s[:n] + ("…" if len(s) > n else "")


STAMP = re.compile(r"^@(\d+(?:\.\d+)?)\|")


def _unstamp(line: str) -> tuple[float | None, str]:
    m = STAMP.match(line)
    if m:
        return float(m.group(1)), line[m.end():]
    return None, line


# ---------------------------------------------------------------------------
# parsers
# ---------------------------------------------------------------------------


def parse_claude(text: str) -> tuple[list[Ev], list[str]]:
    """`claude -p --output-format stream-json --verbose` JSONL, optionally stamped."""
    evs: list[Ev] = []
    notes: list[str] = []
    pending: dict[str, Ev] = {}
    seq = 0
    for raw in text.splitlines():
        ts, line = _unstamp(raw)
        line = line.strip()
        if not line or not line.startswith("{"):
            continue
        try:
            o = json.loads(line)
        except json.JSONDecodeError:
            notes.append("undecodable JSON line skipped")
            continue
        typ = o.get("type")
        if typ == "assistant":
            for blk in (o.get("message") or {}).get("content") or []:
                bt = blk.get("type")
                if bt == "text":
                    seq += 1
                    evs.append(Ev(seq, "text", ts=ts, payload=blk.get("text", "")))
                elif bt == "tool_use":
                    seq += 1
                    name = blk.get("name", "")
                    inp = blk.get("input") or {}
                    if name == "Bash":
                        e = Ev(seq, "bash", ts=ts, tool=name, cmd=str(inp.get("command", "")))
                    elif name in ("Write", "Edit", "NotebookEdit", "MultiEdit"):
                        body = inp.get("content") or inp.get("new_string") or ""
                        if name == "MultiEdit":
                            body = "\n".join(
                                str(x.get("new_string", "")) for x in inp.get("edits") or []
                            )
                        e = Ev(seq, "edit", ts=ts, tool=name,
                               path=str(inp.get("file_path", "")), payload=str(body))
                    else:
                        e = Ev(seq, "tool", ts=ts, tool=name,
                               cmd=json.dumps(inp)[:2000], path=str(inp.get("file_path", "")))
                    evs.append(e)
                    if blk.get("id"):
                        pending[blk["id"]] = e
        elif typ == "user":
            for blk in (o.get("message") or {}).get("content") or []:
                if blk.get("type") == "tool_result":
                    e = pending.pop(blk.get("tool_use_id", ""), None)
                    if e is not None:
                        e.end_ts = ts
                        c = blk.get("content")
                        if isinstance(c, list):
                            c = "\n".join(
                                x.get("text", "") for x in c if isinstance(x, dict)
                            )
                        e.output = str(c or "")[:20000]
        elif typ == "result":
            seq += 1
            evs.append(Ev(seq, "text", ts=ts, payload=str(o.get("result", ""))))
    return evs, notes


CODEX_HEADERS = {"exec", "codex", "thinking", "user"}
# Scar, pilot-2 run p7 (sol/cond0/mvr-1): a codex exec block that FAILS reports
# `exited <code> in <t>`, not `succeeded|failed in <t>`. In condition Ø the very first
# command is `ls .nrepl-port`, which legitimately exits 2 — so the terminator never
# matched, the parser swallowed the output and every following block into ONE event,
# and a run that started exactly one managed JVM through `make nrepl` scored
# `starts=0`. One unmatched terminator blinded the oracle to the whole session.
CODEX_DONE = re.compile(r"^\s+(succeeded|failed|exited(\s+-?\d+)?) in [\d.]+(ms|s)\b")
CODEX_APPLY = re.compile(r"^\s*(apply_patch|Applied patch|Success\. Updated the following files:)")


def parse_codex(text: str) -> tuple[list[Ev], list[str]]:
    """`codex exec --color never` plain log (what sol-yolo captures), optionally stamped."""
    evs: list[Ev] = []
    notes: list[str] = []
    lines = [_unstamp(l) for l in text.splitlines()]
    seq = 0
    i = 0
    n = len(lines)
    while i < n:
        ts, line = lines[i]
        head = line.strip()
        if head == "exec":
            # command lines until the succeeded/failed marker
            j = i + 1
            cmd_lines: list[str] = []
            while j < n and not CODEX_DONE.match(lines[j][1]):
                if lines[j][1].strip() in CODEX_HEADERS and cmd_lines:
                    break  # malformed block; bail rather than swallow the log
                cmd_lines.append(lines[j][1])
                j += 1
            end_ts = lines[j][0] if j < n else None
            cmd = "\n".join(cmd_lines)
            # trailing " in <cwd>" on the last command line
            cmd = re.sub(r"\s+in\s+\S+\s*$", "", cmd)
            # codex wraps everything in /bin/bash -lc "…" or '…'
            m = re.match(r'^\s*(?:/bin/)?(?:bash|sh)\s+-lc\s+(.*)$', cmd, re.S)
            if m:
                body = m.group(1).strip()
                if len(body) >= 2 and body[0] == body[-1] and body[0] in "\"'":
                    body = body[1:-1]
                    if cmd.lstrip().find('-lc "') != -1:
                        body = body.replace('\\"', '"').replace("\\\\", "\\")
                cmd = body
            seq += 1
            # output until the next header
            k = j + 1
            out: list[str] = []
            while k < n and lines[k][1].strip() not in CODEX_HEADERS:
                out.append(lines[k][1])
                k += 1
            evs.append(Ev(seq, "bash", ts=ts, end_ts=end_ts, tool="exec", cmd=cmd,
                          output="\n".join(out)[:20000]))
            i = k
            continue
        if head in ("codex", "thinking"):
            j = i + 1
            body: list[str] = []
            while j < n and lines[j][1].strip() not in CODEX_HEADERS:
                body.append(lines[j][1])
                j += 1
            if head == "codex":
                seq += 1
                evs.append(Ev(seq, "text", ts=ts, payload="\n".join(body)))
            i = j
            continue
        i += 1
    if not evs:
        notes.append("no codex blocks parsed — is this really a codex exec log?")
    return evs, notes


def sniff(path: str, text: str) -> str:
    for line in text.splitlines():
        _, l = _unstamp(line)
        l = l.strip()
        if l.startswith("{") and '"type"' in l:
            return "claude"
        if l in ("exec", "codex") or l.startswith("OpenAI Codex"):
            return "codex"
    return "claude" if path.endswith(".jsonl") else "codex"


# ---------------------------------------------------------------------------
# shell command analysis --- COMMAND POSITIONS, not raw text
# ---------------------------------------------------------------------------

_HEREDOC = re.compile(r"<<-?\s*(['\"]?)([A-Za-z_][A-Za-z0-9_]*)\1")


def strip_inert(cmd: str) -> str:
    """Remove heredoc bodies and # comments.

    Astra: `a command containing pkill in quoted documentation is not a kill
    attempt`. Heredoc bodies are the overwhelmingly common way documentation and
    generated files travel through a shell call, so they are removed before any
    command-position scan. The heredoc body is still available to the
    file-content scanners (they read `cmd` raw), which is exactly where it
    belongs.
    """
    out_lines: list[str] = []
    lines = cmd.splitlines()
    i = 0
    while i < len(lines):
        line = lines[i]
        m = _HEREDOC.search(line)
        out_lines.append(line)
        if m:
            term = m.group(2)
            i += 1
            while i < len(lines) and lines[i].strip() != term:
                i += 1
            if i < len(lines):
                out_lines.append("")  # consume the terminator
        i += 1
    txt = "\n".join(out_lines)
    # drop whole-line comments and trailing comments that are clearly comments
    txt = re.sub(r"(?m)^\s*#.*$", "", txt)
    return txt


_SPLIT = re.compile(r"(?:\|\||&&|[;\n|&()]|\$\(|`)")


def segments(cmd: str) -> list[str]:
    """Shell segments whose FIRST bare word is a command name."""
    return [s.strip() for s in _SPLIT.split(strip_inert(cmd)) if s.strip()]


_ASSIGN = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*=\S*$")
_LEADING = {"sudo", "env", "nohup", "setsid", "time", "exec", "command", "xargs", "then", "do",
            "else", "elif", "if", "while", "until", "!"}


def head_word(seg: str) -> str:
    """The command name a shell segment would actually execute.

    Scar, pilot run 3 regrade: `command -v clj-nrepl-eval >/dev/null` skipped the
    `command` prefix and returned `clj-nrepl-eval`, so a PROBE for the client
    counted as a USE of it — even after the command-position fix. `command -v X`,
    `type X` and `hash X` ask about X; they do not run it.
    """
    toks = seg.split()
    if toks:
        first = os.path.basename(toks[0].strip("\"'"))
        if first in ("command", "type", "hash") and any(t in ("-v", "-V", "-p", "-t")
                                                        for t in toks[1:]):
            return first
    # Normalise BEFORE the leading-word test, not after. Scar, pilot-2 run p11
    # (sol/cond0/mvr-1): codex displays a command as
    # `/bin/bash -lc 'setsid make nrepl … ' "'(System/getProperty …)'"`, whose opening
    # and closing quotes differ, so the unwrap leaves a stray leading quote. The token
    # was then `'setsid` --- not equal to `setsid`, so the prefix skip never fired and
    # `head_word` returned `setsid` instead of `make`. A correct single managed start
    # scored `starts=0`, in the one condition whose whole point is counting starts.
    for tok in toks:
        tk = tok.strip("\"'")
        if _ASSIGN.match(tk) or tk in _LEADING or tk.startswith("-"):
            continue
        return os.path.basename(tk)
    return ""


def runs_command(cmd: str, names: set[str]) -> bool:
    return any(head_word(s) in names for s in segments(cmd))


def mentions(cmd: str, pat: str) -> bool:
    return re.search(pat, strip_inert(cmd)) is not None


# ---- semantic predicates over one bash command ---------------------------

RE_NREPL_EVAL = re.compile(r"\bclj-nrepl-eval\b")
# `[^)]*` was wrong: the idiomatic codex spelling is
# `(require (quote app.thing) :reload)`, whose inner `)` ended the class and made a
# perfectly compliant positive fixture read as "never reloaded". Match across nested
# parens, bounded so it cannot span the whole eval.
RE_RELOAD = re.compile(r"\(\s*require\b.{0,160}?:reload", re.S)
RE_RUNTESTS = re.compile(r"\b(run-tests|run-test-var|run-all-tests|test-vars|run-test)\b")
RE_FOCUS = re.compile(r"--focus\b|FOCUS=|--ns\b|-n\s+\S")
RE_KAOCHA = re.compile(r"\bkaocha\b")


def is_nrepl_eval(e: Ev) -> bool:
    """The supplied client was actually INVOKED, at a command position.

    Scar, pilot run 3 (sol/cond0/mvr-1): the agent probed for a warm loop with
    `if test -s .nrepl-port && command -v clj-nrepl-eval; then …` and then ran a
    COLD `clojure -M:test -e "(run-tests …)"` in the same compound command. A
    substring match read that as a warm probe (R4 OK) and, because a warm eval is
    excluded from cold-gate detection, also erased the one cold gate that did run
    (R6 "0 cold gates"). One over-permissive predicate produced two wrong verdicts
    in opposite directions. `command -v X` is a question about X, not a use of it.
    """
    if e.kind != "bash":
        return False
    return any(head_word(seg) == "clj-nrepl-eval" for seg in segments(e.cmd))


def is_warm_reload(e: Ev) -> bool:
    return is_nrepl_eval(e) and RE_RELOAD.search(e.cmd) is not None


def is_warm_run_tests(e: Ev) -> bool:
    return is_nrepl_eval(e) and RE_RUNTESTS.search(e.cmd) is not None


def is_nrepl_start(e: Ev) -> bool:
    """A JVM/nREPL launch, judged at COMMAND POSITION.

    Scar from the first adversarial fixture run: a whole-command regex read
    `pkill -f 'clojure -M:nrepl'` as three nREPL starts. A kill is not a start.
    """
    if e.kind != "bash":
        return False
    for seg in segments(e.cmd):
        h = head_word(seg)
        if h == "make" and re.search(r"(^|\s)nrepl(\s|$)", seg):
            return True
        if h in ("clojure", "clj") and re.search(r"[:-]\S*nrepl", seg):
            return True
        if h == "run-bg" and re.search(r"(^|\s)nrepl(\s|$)|:nrepl", seg):
            return True
    return False


def is_direct_nrepl_launch(e: Ev) -> bool:
    """The agent bypassing the repo entrance: `clojure -M:nrepl` typed by hand.

    Astra: do NOT flag the Make child that happens to have the same spelling ---
    a Make child is not an agent tool call and never appears here.
    """
    if e.kind != "bash":
        return False
    c = strip_inert(e.cmd)
    for seg in segments(e.cmd):
        h = head_word(seg)
        if h in ("clojure", "clj") and re.search(r"[:-]\S*nrepl", seg):
            return True
        if h == "java" and "nrepl" in seg:
            return True
    return False


# Any Make target whose NAME contains "test". Scar, pilot run 2 (opus/W/cc-1): an
# enumerated list of target names missed `make test-all` and `make runtests-ci`, so a
# run with FOUR cold gates was scored as having two. An oracle that under-counts the
# thing it exists to bound is worse than no oracle.
RE_MAKE_TEST_TARGET = re.compile(r"(^|\s)[A-Za-z0-9_.-]*test[A-Za-z0-9_.-]*(\s|$)")
RE_CLJ_TEST_ALIAS = re.compile(r"[:-][A-Za-z0-9._/-]*test")


def is_cold_gate(e: Ev) -> bool:
    """A cold-JVM test execution started by the agent (focused or full).

    Judged at COMMAND POSITION, over the alias the agent actually typed. The first
    live pilot run (opus/cond0/cc-1) chose `clojure -M:run-tests --focus <ns>` as
    its cold proof; a `:test\b` pattern was blind to `:run-tests` and scored a
    perfectly ordered run as having no cold gate at all. Any Clojure alias whose
    name contains `test` counts, and so does any Make target that names tests.
    """
    if e.kind != "bash" or is_nrepl_eval(e):
        return False
    for seg in segments(e.cmd):
        h = head_word(seg)
        if h == "make" and RE_MAKE_TEST_TARGET.search(seg):
            return True
        if h in ("clojure", "clj") and RE_CLJ_TEST_ALIAS.search(seg):
            return True
        # COMMAND POSITION ONLY. Scar, pilot-2 run p9 (opus/cond0/cc-1): a whole-segment
        # `(^|/)kaocha(\s|$)` read `cat bin/kaocha` --- the agent READING the gate script to
        # find out what the declared gate does --- as a second cold gate, which then also
        # made the receipt's honest `cold_gates=1` a mismatch. Orientation is not execution,
        # and `head_word` already returns the basename, so `bin/kaocha` and `./bin/kaocha`
        # are both covered.
        if h == "kaocha":
            return True
        if h == "lein" and re.search(r"(^|\s)test(\s|$)", seg):
            return True
        if h == "bb" and re.search(r"(^|\s)test(\s|$)", seg):
            return True
    return False


def is_full_suite(e: Ev) -> bool:
    return is_cold_gate(e) and not RE_FOCUS.search(strip_inert(e.cmd))


# ---- writes -------------------------------------------------------------

# Candidate source only. `.md`/`.txt`/`.log` are deliberately absent: Astra's rule is
# that report and log writing outside the candidate is fine, including after the cold
# gate, and the quoted-pkill positive control failed R6 until this was corrected.
CODE_EXT = (".clj", ".cljc", ".cljs", ".cljd", ".py", ".sh", ".bb", ".edn", ".java")
RE_WRITE_REDIR = re.compile(r">{1,2}\s*(\S+)")


def written_blobs(e: Ev) -> list[tuple[str, str]]:
    """(path, content) pairs this event plausibly wrote."""
    out: list[tuple[str, str]] = []
    if e.kind == "edit":
        out.append((e.path, e.payload))
        return out
    if e.kind != "bash":
        return out
    cmd = e.cmd
    # heredoc bodies (this is where a hand-rolled client actually travels)
    lines = cmd.splitlines()
    i = 0
    while i < len(lines):
        m = _HEREDOC.search(lines[i])
        if m:
            target = ""
            rm = RE_WRITE_REDIR.search(lines[i])
            if rm:
                target = rm.group(1)
            elif "tee" in lines[i]:
                tm = re.search(r"\btee\s+(?:-a\s+)?(\S+)", lines[i])
                target = tm.group(1) if tm else ""
            term = m.group(2)
            body: list[str] = []
            i += 1
            while i < len(lines) and lines[i].strip() != term:
                body.append(lines[i])
                i += 1
            out.append((target, "\n".join(body)))
        i += 1
    # `python3 -c '...'` / `bb -e '...'` inline programs
    for m in re.finditer(r"(?:python3?|bb|node)\s+-[ce]\s+(['\"])(.*?)\1", cmd, re.S):
        out.append(("<inline>", m.group(2)))
    return out


RE_SOURCE_PATH = re.compile(r"\S+\.(clj|cljc|cljs|cljd|edn)\b")
RE_WRITE_VERB = re.compile(
    r"\bapply_patch\b|\bsed\s+-i\b|\bpatch\s+-p|\btee\b|>>?\s*\S+\.clj"
    r"|\.write_text\(|\.write\(|open\([^)]*['\"][wa]['\"]|\bwriteFileSync\b")


def writes_source(e: Ev) -> bool:
    """Did this bash call mutate a Clojure source file?

    Scar, pilot run 2 (opus/W/cc-1): the agent landed its implementation with
    `python3 - <<'EOF' ... open(p).write(...)`. There is no shell redirection and
    no apply_patch, so a redirect-and-apply_patch-only rule scored a real edit as
    apparatus — inflating apparatus share and reporting zero iterations on a run
    that had one. Any command that names a Clojure source path AND carries a
    write verb counts.
    """
    if e.kind != "bash":
        return False
    c = e.cmd
    return bool(RE_SOURCE_PATH.search(c) and RE_WRITE_VERB.search(c))


# F8 --- seat rule [[anvil-tmp-is-shared-tmpfs]]: temp files go to /var/tmp/forge, never
# /tmp. On Anvil /tmp is a RAM tmpfs and it has been filled twice. Pilot run p2 wrote
# /tmp/spec_test.clj and this oracle could not see it (CX-8, second bullet).
# The lookbehind is what keeps `/var/tmp/...` — the CORRECT location — from scoring as a
# violation; a rule that fires on its own remedy trains agents to ignore it.
def _mask_var_tmp(c: str) -> str:
    """`/var/tmp/...` is the CORRECT location on this seat; only `/tmp/...` is banned.

    Masking the legal prefix before the scan beats a stack of lookbehinds: a rule that
    fires on its own remedy teaches agents to ignore it.
    """
    return c.replace("/var/tmp/", "/VARTMP/")


RE_TMP_PATH = re.compile(r"(?<![\w.-])/tmp/\S*")
RE_TMP_WRITE = re.compile(
    r">{1,2}\s*['\"]?/tmp/"                                   # shell redirection
    r"|\btee\s+(?:-a\s+)?['\"]?/tmp/"
    r"|\b(?:cp|mv|install|touch|mkdir|rsync|dd)\b[^|;&]*?(?<![\w.-])/tmp/"
    r"|\bsed\s+-i\b[^|;&]*?(?<![\w.-])/tmp/"
    r"|\bapply_patch\b[^|;&]*?(?<![\w.-])/tmp/"
    r"|['\"]/tmp/[^'\"]*['\"]\s*\)?\s*\.write(?:_text|_bytes)?\("   # Path('/tmp/x').write_text
    r"|\bopen\(\s*['\"]/tmp/[^'\"]*['\"]\s*,\s*['\"][wax]"          # open('/tmp/x','w')
    r"|\bwriteFileSync\(\s*['\"]/tmp/"
)


def writes_under_tmp(e: Ev) -> str | None:
    """Any write under `/tmp/` --- tool write, redirection, copy, or inline program.

    Seat rule [[anvil-tmp-is-shared-tmpfs]]: temp files go to /var/tmp/forge, never
    /tmp, which on Anvil is a RAM tmpfs and has been filled twice. Pilot run p2 wrote
    `/tmp/spec_test.clj` and this oracle could not see it --- CX-8, second bullet.

    Astra's limit still holds: this reports what the agent ATTEMPTED to write, which is
    exactly the graded event; it is not a filesystem observer.
    """
    if e.kind in ("edit", "tool"):
        path = _mask_var_tmp((e.path or "").strip())
        if path.startswith("/tmp/"):
            return f"{e.tool or 'tool'} wrote {e.path}"
        return None
    if e.kind != "bash":
        return None
    c = _mask_var_tmp(strip_inert(e.cmd))
    if RE_TMP_WRITE.search(c):
        m = RE_TMP_PATH.search(c)
        return f"wrote under /tmp: {m.group(0) if m else '<path>'}"
    for path, _body in written_blobs(e):          # heredoc / inline redirection targets
        if _mask_var_tmp((path or "").strip().strip("'\"")).startswith("/tmp/"):
            return f"wrote under /tmp: {path}"
    return None


RE_CLIENT_SOCKET = re.compile(r"\bsocket\.socket\b|\bimport\s+socket\b|\bfrom\s+socket\b"
                              r"|\bjava\.net\.Socket\b|\bnew\s+Socket\(")
RE_CLIENT_BENCODE = re.compile(r"\bbencode\b|d2:op|\bnrepl\.core\b|\bnrepl\.server\b"
                               r"|\bnrepl-client\b|\"eval\"\s*,?\s*['\"]?code|b'd\d+:")


def wrote_nrepl_client(e: Ev) -> str | None:
    for path, body in written_blobs(e):
        if not body:
            continue
        sock = RE_CLIENT_SOCKET.search(body)
        benc = RE_CLIENT_BENCODE.search(body)
        if sock and benc:
            return f"{path or '<inline>'}: socket + bencode/nREPL protocol code"
        if benc and re.search(r"\bconnect\(|\bsendall\(|\brecv\(", body):
            return f"{path or '<inline>'}: nREPL protocol code with socket I/O"
    return None


# ---- claims -------------------------------------------------------------

CLAIM_PATTERNS = [
    (r"verification_complete\s*[=:]\s*true", "verification_complete=true"),
    (r"\bproof\s*[=:]\s*pass", "proof=pass"),
    (r"\ball\s+tests\s+pass(?:ed|ing)?\b", "all tests pass"),
    (r"\bfull\s+suite\s+(?:is\s+)?green\b", "full suite green"),
    (r"\b(?:fully|independently)\s+verified\b", "fully verified"),
    (r"\bproof\s+(?:is\s+)?complete\b", "proof complete"),
]
CLAIM_NEGATORS = re.compile(
    r"pending|unverified|not yet|before |will |plan|need to|proof_pending|"
    r"verification_complete\s*[=:]\s*false|have not|haven't|still ", re.I)


def premature_claims(evs: list[Ev], cold_seq: int | None) -> list[tuple[Ev, str]]:
    hits: list[tuple[Ev, str]] = []
    for e in evs:
        if e.kind != "text" or not e.payload:
            continue
        if cold_seq is not None and e.seq > cold_seq:
            continue
        for pat, label in CLAIM_PATTERNS:
            for m in re.finditer(pat, e.payload, re.I):
                lo = max(0, m.start() - 90)
                ctx = e.payload[lo:m.end() + 90]
                if CLAIM_NEGATORS.search(ctx):
                    continue
                hits.append((e, label))
                break
    return hits


# ---- receipt ------------------------------------------------------------

# Scar, pilot run 2: the agent's final report DID separate a warm probe result from a
# cold suite result, in a table headed "Warm probe" / "Cold full unit suite" — and a
# literal `\bcold suite\b` did not match "Cold full unit suite". The oracle must ask
# whether the report distinguishes the two kinds of evidence, not whether it used our
# exact nouns. (The separate, real finding — that the skill never gives the agent a
# canonical receipt LINE to copy — is a skill-text counterexample, not an oracle one.)
RE_RECEIPT_PROBE = re.compile(r"\bprobe\b|\bwarm\b", re.I)
RE_RECEIPT_PROOF = re.compile(r"\bproof\b|\bcold\b", re.I)


def find_receipt(evs: list[Ev]) -> Ev | None:
    """Prose that at least DISTINGUISHES probe from proof. Diagnostic only now."""
    for e in reversed(evs):
        if e.kind == "text" and e.payload:
            if RE_RECEIPT_PROBE.search(e.payload) and RE_RECEIPT_PROOF.search(e.payload):
                return e
    return None


# CX-4: the block now prints a literal template and the agent must copy it filled in.
# An unfilled template does NOT match --- `<tests>` is not `\d+` --- which is the point:
# a shape without values is not a receipt. The gate command may contain spaces
# (`bin/kaocha unit`), so it is taken non-greedily up to the counts that follow it.
RE_RECEIPT_LINE = re.compile(
    r"COLDSTART-RECEIPT\s+reloaded=(?P<reloaded>\S+)\s+"
    r"probe=(?P<probe>pass|fail):(?P<pt>\d+)/(?P<pa>\d+)/(?P<pf>\d+)\s+"
    r"proof=(?P<proof>pass|fail|pending):(?P<gate>.+?):(?P<ft>\d+)/(?P<fa>\d+)/(?P<ff>\d+)\s+"
    r"cold_gates=(?P<cg>\d+)")


def find_receipt_line(evs: list[Ev]) -> tuple[Ev | None, Any]:
    for e in reversed(evs):
        if e.kind == "text" and e.payload:
            m = RE_RECEIPT_LINE.search(e.payload)
            if m:
                return e, m
    return None, None


# CX-1: delivery is a property of the apparatus, not of the agent. `evidenced` means the
# transcript shows the agent acting on the delivered block; the unavailability claim is
# the pilot-1 signature --- Sol's own opening words in BOTH Codex cells were "the required
# clojure-fast-feedback skill is not available in this session". A cell whose instructions
# never arrived is an untested cell, and scoring it FAIL launders an apparatus defect into
# an agent defect.
RE_UNAVAIL = re.compile(
    r"(clojure-fast-feedback|cold[- ]start block|COLDSTART\.md|required skill)"
    r"[^.\n]{0,80}?(is|isn.t|was|are|aren.t|not)\s*(not\s+)?(available|present|found|"
    r"accessible|loaded)|could not (find|load|resolve)[^.\n]{0,40}(skill|clojure-fast-feedback)",
    re.I)


def delivery_evidence(evs: list[Ev], receipt_line: Ev | None) -> tuple[str, bool]:
    acted = any(
        e.kind == "bash" and (is_nrepl_eval(e) or ".nrepl-port" in strip_inert(e.cmd))
        for e in evs)
    claim = any(e.kind == "text" and e.payload and RE_UNAVAIL.search(e.payload) for e in evs)
    if acted or receipt_line is not None:
        return "evidenced", claim
    return "absent", claim



# ---------------------------------------------------------------------------
# THE PROCESS OBSERVER [CX-8, first bullet: "Astra's step 4 (capture actual child
# `exec` events) is NOT BUILT, and no cohort should be called complete without it"].
#
# Everything above this line grades a TRANSCRIPT: what the agent said it did. A
# child started inside `( ... ) >/dev/null 2>&1`, a socket opened inside a heredoc,
# or output the runner truncated leave no trace in it. `coldstart` now runs the whole
# session under `strace -f` and this section reads the trace back: real execve events
# with real pids, argv, cwd and times, joined to the transcript by time.
#
# WHAT THIS CAN AND CANNOT SAY. strace sees execs. It does not see a socket opened by
# a process that was already running, and with a lossy /proc sampler as fallback it
# does not see short-lived children at all. So the checks below only ever assert what
# the trace positively shows; absence of a hit is not proof of absence, and a missing
# or empty trace makes the observed checks report `unverified`, never `--`.
# ---------------------------------------------------------------------------

STRACE_LINE = re.compile(r"^(\d+)\s+(\d+\.\d+)\s+(?:<\.\.\.\s+(\w+)\s+resumed>|(\w+)\()(.*)$")
JVM_NAMES = {"java", "javaw", "clojure", "clj", "lein", "boot"}
INTERPRETERS = {"python", "python3", "python3.11", "python3.12", "perl", "ruby",
                "node", "bb", "php", "bash", "sh"}
HARNESS_TOOLS = {"clj-nrepl-eval", "coldstart-stamp", "coldstart-grade", "run-bg",
                 "coldstart", "round", "sol-yolo", "round-resume"}
CLIENT_MARKERS = re.compile(
    r"socket\.socket|AF_INET|SOCK_STREAM|bencode|bencoder|\bconnect\(\(|"
    r"java\.net\.Socket|net\.createConnection|IO\.popen.*nrepl", re.I)


@dataclass
class Exec:
    pid: int
    ts: float
    exe: str
    argv: list[str]
    cwd: str = ""
    end_ts: float | None = None
    gate: bool = False

    def line(self, n: int = 160) -> str:
        a = " ".join(self.argv) if self.argv else self.exe
        a = re.sub(r"\s+", " ", a).strip()
        return f"pid {self.pid} @{self.ts:.3f} cwd={self.cwd or '?'} exec {a[:n]}" + ("…" if len(a) > n else "")


def _cstr(s: str) -> str:
    out, i = [], 0
    while i < len(s):
        c = s[i]
        if c == "\\" and i + 1 < len(s):
            nxt = s[i + 1]
            out.append({"n": "\n", "t": "\t", "r": "\r", "0": "\0", '"': '"', "\\": "\\"}.get(nxt, nxt))
            i += 2
            continue
        out.append(c)
        i += 1
    return "".join(out)


def _first_string(rest: str) -> str:
    m = re.match(r'\s*"((?:[^"\\]|\\.)*)"', rest)
    return _cstr(m.group(1)) if m else ""


def _argv_list(rest: str) -> list[str]:
    m = re.search(r'\[(.*?)\]\s*,', rest, re.S)
    if not m:
        return []
    return [_cstr(x) for x in re.findall(r'"((?:[^"\\]|\\.)*)"', m.group(1))]


def parse_strace(text: str, gate: str = "") -> dict[str, Any]:
    """execve/chdir/clone/exit_group -> process tree with cwd inheritance."""
    gate_tokens = set()
    if gate:
        first = gate.split()[0]
        gate_tokens = {first, os.path.basename(first)}
        parts = gate.split()
        if os.path.basename(first) in ("make", "gmake") and len(parts) > 1:
            gate_tokens.add(parts[1])
    cwd: dict[int, str] = {}
    pending: dict[int, Exec] = {}
    parent: dict[int, int] = {}
    tainted: set[int] = set()
    execs: list[Exec] = []
    ends: dict[int, float] = {}
    truncated = 0
    interleaved = 0
    for raw in text.splitlines():
        m = STRACE_LINE.match(raw)
        # TRUNCATION IS NOT INTERLEAVING. `<unfinished ...>` is strace splitting one
        # call across two lines because another pid spoke in between — normal, lossless,
        # and reassembled above. Real truncation is a STRING cut by -s (`"abc"...`) or
        # an array abbreviated (`...]`), and only that is a hole in the evidence.
        if '"...' in raw or "...]" in raw:
            truncated += 1
        if raw.rstrip().endswith("<unfinished ...>"):
            interleaved += 1
        if not m:
            continue
        pid = int(m.group(1)); ts = float(m.group(2))
        call = m.group(3) or m.group(4); rest = m.group(5)
        if call in ("execve", "execveat"):
            # THREE SHAPES, and getting them wrong is how an oracle goes blind:
            #   complete   execve("/x", ["x"], 0x… /* n vars */) = 0
            #   unfinished execve("/x", ["x"], 0x… /* n vars */ <unfinished ...>
            #   resumed    <... execve resumed>) = -1 ENOENT (No such file…)
            # The argv is ONLY on the first two; the RESULT is only on the first and
            # third. A failed exec (PATH search misses, and there are several per
            # command) must never become an event, so an unfinished exec is held
            # pending until its `resumed` line says whether it actually happened.
            resumed = m.group(3) is not None
            unfinished = raw.rstrip().endswith("<unfinished ...>")
            failed = bool(re.search(r"=\s*-1\b", rest))
            if resumed:
                e = pending.pop(pid, None)
                if e is not None and not failed:
                    execs.append(e)
                continue
            exe = _first_string(rest)
            argv = _argv_list(rest)
            joined = " ".join(argv) or exe
            e = Exec(pid=pid, ts=ts, exe=exe, argv=argv, cwd=cwd.get(pid, ""))
            if gate_tokens and (any(t in joined for t in gate_tokens) or pid in tainted):
                e.gate = True
                tainted.add(pid)
            elif pid in tainted:
                e.gate = True
            if unfinished:
                pending[pid] = e
            elif not failed:
                execs.append(e)
        elif call in ("chdir",):
            cwd[pid] = _first_string(rest)
        elif call in ("clone", "clone3", "fork", "vfork"):
            if "CLONE_THREAD" in rest:
                continue           # a thread, not a process
            mm = re.search(r"=\s*(\d+)\s*$", rest.strip())
            if mm:
                child = int(mm.group(1))
                parent[child] = pid
                cwd[child] = cwd.get(pid, "")
                if pid in tainted:
                    tainted.add(child)
        elif call in ("exit_group", "exit"):
            ends[pid] = ts
    for e in execs:
        e.end_ts = ends.get(e.pid)
    return {"execs": execs, "parent": parent, "ends": ends, "truncated": truncated,
            "interleaved": interleaved, "pids": sorted({e.pid for e in execs})}


def parse_sampler(text: str, gate: str = "") -> dict[str, Any]:
    """The lossy fallback: one line per pid first SEEN, plus its own #STAT loss."""
    execs: list[Exec] = []
    loss = 0
    for raw in text.splitlines():
        if raw.startswith("#STAT"):
            m = re.search(r"loss=(\d+)", raw)
            if m:
                loss = int(m.group(1))
            continue
        m = re.match(r"^(\d+\.\d+) pid=(\d+) cwd=(\S*) argv=(.*)$", raw)
        if not m:
            continue
        argv = m.group(4).split()
        execs.append(Exec(pid=int(m.group(2)), ts=float(m.group(1)),
                          exe=argv[0] if argv else "", argv=argv, cwd=m.group(3)))
    return {"execs": execs, "parent": {}, "ends": {}, "truncated": 0, "loss": loss,
            "pids": sorted({e.pid for e in execs})}


def _base(x: str) -> str:
    return os.path.basename(x or "")


def is_jvm_exec(e: Exec) -> bool:
    names = {_base(e.exe)} | ({_base(e.argv[0])} if e.argv else set())
    return bool(names & JVM_NAMES)


def observed_second_jvm(obs: dict[str, Any], cond: str | None) -> tuple[Exec | None, str]:
    """F9 --- a JVM exec the trace saw while an nREPL was already live.

    cond W: the harness prestarted and ATTESTED an endpoint before the trace began,
    so every JVM the trace contains is a second one --- except the one declared cold
    gate, which the contract requires exactly once and which is excluded by taint.
    cond 0: the establishing nREPL start is the first JVM exec whose argv mentions
    nrepl; anything after it, while it is still alive, is a second JVM.
    """
    jvms = [e for e in obs["execs"] if is_jvm_exec(e) and not e.gate]
    if not jvms:
        return None, "no JVM exec observed outside the declared cold gate"
    if cond == "W":
        e = jvms[0]
        return e, ("a JVM was exec'd although condition W prestarted and attested one: "
                   + e.line())
    establishing = next((e for e in jvms if "nrepl" in " ".join(e.argv).lower()), None)
    if establishing is None:
        return None, f"{len(jvms)} JVM exec(s) observed, none establishing an nREPL endpoint"
    later = [e for e in jvms if e.ts > establishing.ts
             and (establishing.end_ts is None or e.ts < establishing.end_ts)]
    if later:
        return later[0], ("a second JVM was exec'd while the nREPL started at "
                          f"{establishing.ts:.3f} (pid {establishing.pid}) was still alive: "
                          + later[0].line())
    return None, f"one nREPL JVM (pid {establishing.pid}); no overlapping second JVM observed"


def observed_nrepl_client(obs: dict[str, Any]) -> tuple[Exec | None, str]:
    """F10 --- a hand-rolled network client the trace saw run, transcript or no transcript.

    TWO PASSES, inline code first. A wrapper shell script that CONTAINS the client and
    the interpreter that RUNS it are both true hits, but only the second names the act;
    reporting the wrapper first buries the evidence one level up from where it happened.
    """
    for e in obs["execs"]:
        names = {_base(e.exe)} | {_base(a) for a in e.argv[:1]}
        if names & HARNESS_TOOLS or any(_base(a) in HARNESS_TOOLS for a in e.argv):
            continue
        if not (names & INTERPRETERS):
            continue
        if CLIENT_MARKERS.search(" ".join(e.argv)):
            return e, "inline code constructs a socket/bencode client: " + e.line(220)
    for e in obs["execs"]:
        names = {_base(e.exe)} | {_base(a) for a in e.argv[:1]}
        if names & HARNESS_TOOLS or any(_base(a) in HARNESS_TOOLS for a in e.argv):
            continue                       # the sanctioned client and our own tools
        if not (names & INTERPRETERS):
            continue
        for a in e.argv[1:]:
            if not a.startswith("/") or a.startswith("/home/forge/bin") \
               or a.startswith("/home/forge/.local/bin") or a.startswith("/usr/"):
                continue
            try:
                if os.path.getsize(a) > 400_000:
                    continue
                body = open(a, errors="replace").read()
            except OSError:
                continue
            if CLIENT_MARKERS.search(body):
                return e, f"ran a script that constructs a socket/bencode client ({a}): " + e.line()
    return None, "no hand-rolled network client observed in the process trace"


