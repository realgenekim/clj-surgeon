#!/usr/bin/env python3
"""coldstart-grade <transcript.jsonl|log> [--format claude|codex|auto] [--cond W|0] [--json OUT]

The ACTION-LOG ORACLE (Astra, /var/tmp/forge/plan2/cellC/astra-coldstart.md §"Action-log
oracle") applied as a grader over ONE fresh agent's transcript.

It answers exactly one question: did this agent, with no coaching, execute the
Clojure fast-feedback loop --- warm nREPL probe first, exactly one cold gate last,
a receipt that separates probe from proof --- and did it avoid the named
anti-patterns?

WHAT THIS IS NOT (Astra's correction, honoured):
  A transcript is what the agent ATTEMPTED. It is not a process observer. A hidden
  child, a socket opened inside a python heredoc we failed to classify, or output
  the runner truncated are all invisible here. Where the transcript cannot decide,
  this grader says UNVERIFIED, never PASS. Quoted `pkill` in prose is NOT a kill
  attempt, so every shell scan runs over COMMAND POSITIONS in a comment-and-heredoc
  stripped command, never over raw text.

Timestamps: the harness pipes the runner's stream through `coldstart-stamp`, which
prefixes every line with `@<epoch.micros>|`. Without those stamps the wall metrics
report `unknown` rather than a fabricated zero.

Exit 0 on PASS, 1 on FAIL or UNVERIFIED.
"""
from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import shlex
import sys
from dataclasses import dataclass, field
from typing import Any

# ---------------------------------------------------------------------------
# events
# ---------------------------------------------------------------------------


@dataclass
class Ev:
    seq: int
    kind: str  # 'bash' | 'edit' | 'tool' | 'text'
    ts: float | None = None  # when the agent issued it
    end_ts: float | None = None  # when its result came back
    tool: str = ""
    cmd: str = ""  # for bash: the shell command
    payload: str = ""  # for edit: the written content; for text: the prose
    path: str = ""
    output: str = ""
    exit_code: int | None = None  # the runner's OWN report of how it ended

    def brief(self, n: int = 88) -> str:
        s = (self.cmd or self.path or self.payload or "").replace("\n", " ")
        s = re.sub(r"\s+", " ", s).strip()
        return s[:n] + ("…" if len(s) > n else "")


STAMP = re.compile(r"^@(\d+(?:\.\d+)?)\|")


def _unstamp(line: str) -> tuple[float | None, str]:
    m = STAMP.match(line)
    if m:
        return float(m.group(1)), line[m.end():]
    return None, line


# ---------------------------------------------------------------------------
# parsers
# ---------------------------------------------------------------------------


def parse_claude(text: str) -> tuple[list[Ev], list[str]]:
    """`claude -p --output-format stream-json --verbose` JSONL, optionally stamped."""
    evs: list[Ev] = []
    notes: list[str] = []
    pending: dict[str, Ev] = {}
    seq = 0
    for raw in text.splitlines():
        ts, line = _unstamp(raw)
        line = line.strip()
        if not line or not line.startswith("{"):
            continue
        try:
            o = json.loads(line)
        except json.JSONDecodeError:
            notes.append("undecodable JSON line skipped")
            continue
        typ = o.get("type")
        if typ == "assistant":
            for blk in (o.get("message") or {}).get("content") or []:
                bt = blk.get("type")
                if bt == "text":
                    seq += 1
                    evs.append(Ev(seq, "text", ts=ts, payload=blk.get("text", "")))
                elif bt == "tool_use":
                    seq += 1
                    name = blk.get("name", "")
                    inp = blk.get("input") or {}
                    if name == "Bash":
                        e = Ev(seq, "bash", ts=ts, tool=name, cmd=str(inp.get("command", "")))
                    elif name in ("Write", "Edit", "NotebookEdit", "MultiEdit"):
                        body = inp.get("content") or inp.get("new_string") or ""
                        if name == "MultiEdit":
                            body = "\n".join(
                                str(x.get("new_string", "")) for x in inp.get("edits") or []
                            )
                        e = Ev(seq, "edit", ts=ts, tool=name,
                               path=str(inp.get("file_path", "")), payload=str(body))
                    else:
                        e = Ev(seq, "tool", ts=ts, tool=name,
                               cmd=json.dumps(inp)[:2000], path=str(inp.get("file_path", "")))
                    evs.append(e)
                    if blk.get("id"):
                        pending[blk["id"]] = e
        elif typ == "user":
            for blk in (o.get("message") or {}).get("content") or []:
                if blk.get("type") == "tool_result":
                    e = pending.pop(blk.get("tool_use_id", ""), None)
                    if e is not None:
                        e.end_ts = ts
                        c = blk.get("content")
                        if isinstance(c, list):
                            c = "\n".join(
                                x.get("text", "") for x in c if isinstance(x, dict)
                            )
                        e.output = str(c or "")[:20000]
                        # Astra 9: whether the call SUCCEEDED is the runner's own
                        # report, and it is the only thing that can contradict a
                        # receipt claiming proof. Carrying it is the difference
                        # between grading a command and grading its RESULT.
                        e.exit_code = 1 if blk.get("is_error") else 0
        elif typ == "result":
            seq += 1
            evs.append(Ev(seq, "text", ts=ts, payload=str(o.get("result", ""))))
    return evs, notes


CODEX_HEADERS = {"exec", "codex", "thinking", "user"}
# Scar, pilot-2 run p7 (sol/cond0/mvr-1): a codex exec block that FAILS reports
# `exited <code> in <t>`, not `succeeded|failed in <t>`. In condition Ø the very first
# command is `ls .nrepl-port`, which legitimately exits 2 — so the terminator never
# matched, the parser swallowed the output and every following block into ONE event,
# and a run that started exactly one managed JVM through `make nrepl` scored
# `starts=0`. One unmatched terminator blinded the oracle to the whole session.
CODEX_DONE = re.compile(r"^\s+(succeeded|failed|exited(\s+-?\d+)?) in [\d.]+(ms|s)\b")
CODEX_APPLY = re.compile(r"^\s*(apply_patch|Applied patch|Success\. Updated the following files:)")


def parse_codex(text: str) -> tuple[list[Ev], list[str]]:
    """`codex exec --color never` plain log (what sol-yolo captures), optionally stamped."""
    evs: list[Ev] = []
    notes: list[str] = []
    lines = [_unstamp(l) for l in text.splitlines()]
    seq = 0
    i = 0
    n = len(lines)
    while i < n:
        ts, line = lines[i]
        head = line.strip()
        if head == "exec":
            # command lines until the succeeded/failed marker
            j = i + 1
            cmd_lines: list[str] = []
            while j < n and not CODEX_DONE.match(lines[j][1]):
                if lines[j][1].strip() in CODEX_HEADERS and cmd_lines:
                    break  # malformed block; bail rather than swallow the log
                cmd_lines.append(lines[j][1])
                j += 1
            end_ts = lines[j][0] if j < n else None
            # Astra 9: the terminator carries the RESULT. `exited 17` and
            # `succeeded` were previously both just "the block ended".
            rc = None
            if j < n:
                mdone = CODEX_DONE.match(lines[j][1])
                if mdone:
                    word = mdone.group(1)
                    if word == "succeeded":
                        rc = 0
                    elif word == "failed":
                        rc = 1
                    else:
                        mnum = re.search(r"exited\s+(-?\d+)", word)
                        rc = int(mnum.group(1)) if mnum else 1
            cmd = "\n".join(cmd_lines)
            # trailing " in <cwd>" on the last command line
            cmd = re.sub(r"\s+in\s+\S+\s*$", "", cmd)
            # codex wraps everything in /bin/bash -lc "…" or '…'
            m = re.match(r'^\s*(?:/bin/)?(?:bash|sh)\s+-lc\s+(.*)$', cmd, re.S)
            if m:
                body = m.group(1).strip()
                if len(body) >= 2 and body[0] == body[-1] and body[0] in "\"'":
                    body = body[1:-1]
                    if cmd.lstrip().find('-lc "') != -1:
                        body = body.replace('\\"', '"').replace("\\\\", "\\")
                cmd = body
            seq += 1
            # output until the next header
            k = j + 1
            out: list[str] = []
            while k < n and lines[k][1].strip() not in CODEX_HEADERS:
                out.append(lines[k][1])
                k += 1
            evs.append(Ev(seq, "bash", ts=ts, end_ts=end_ts, tool="exec", cmd=cmd,
                          output="\n".join(out)[:20000], exit_code=rc))
            i = k
            continue
        if head in ("codex", "thinking"):
            j = i + 1
            body: list[str] = []
            while j < n and lines[j][1].strip() not in CODEX_HEADERS:
                body.append(lines[j][1])
                j += 1
            if head == "codex":
                seq += 1
                evs.append(Ev(seq, "text", ts=ts, payload="\n".join(body)))
            i = j
            continue
        i += 1
    if not evs:
        notes.append("no codex blocks parsed — is this really a codex exec log?")
    return evs, notes


def sniff(path: str, text: str) -> str:
    for line in text.splitlines():
        _, l = _unstamp(line)
        l = l.strip()
        if l.startswith("{") and '"type"' in l:
            return "claude"
        if l in ("exec", "codex") or l.startswith("OpenAI Codex"):
            return "codex"
    return "claude" if path.endswith(".jsonl") else "codex"


# ---------------------------------------------------------------------------
# shell command analysis --- COMMAND POSITIONS, not raw text
# ---------------------------------------------------------------------------

_HEREDOC = re.compile(r"<<-?\s*(\\?)(['\"]?)([A-Za-z_][A-Za-z0-9_]*)\2")


def heredoc_substitutions(body: str) -> list[str]:
    """The `$(…)` / backtick regions of an UNQUOTED heredoc body --- and only those.

    B02e item 4 (acceptance-3 NA-1 / E1). `strip_inert` used to delete every heredoc
    body, quoted or not. Bash does not: an UNQUOTED delimiter (`<<EOF`) leaves the
    body subject to parameter and command substitution, so `cat <<EOF\\n$(pkill -f x)
    \\nEOF` really runs the `pkill`. It was proved with real bash before this was
    written (`C/proof-heredoc/victim-ran.txt`): the victim ran exactly once under
    `<<EOF` and never under `<<'EOF'`.

    Only the SUBSTITUTIONS come back, never the prose around them --- Astra's
    original rule ("pkill in quoted documentation is not a kill attempt") is why the
    body was dropped in the first place, and it still holds for every character that
    the shell will not execute. Inside a heredoc body there is NO quote processing at
    all, so `'$(x)'` executes; the only escape is a backslash before `$`, `` ` ``
    or `\\`. `$((…))` is arithmetic, not a command substitution.
    """
    out: list[str] = []
    i, n = 0, len(body)
    while i < n:
        c = body[i]
        if c == "\\" and i + 1 < n and body[i + 1] in "$`\\\n":
            i += 2                              # escaped: the shell does not expand it
            continue
        if body[i:i + 3] == "$((":               # arithmetic expansion, not a command
            depth = 0
            j = i + 1
            while j < n:
                if body[j] == "(":
                    depth += 1
                elif body[j] == ")":
                    depth -= 1
                    if depth == 0:
                        break
                j += 1
            i = j + 1
            continue
        if body[i:i + 2] == "$(":
            depth = 0
            j = i + 1
            while j < n:
                if body[j] == "\\":
                    j += 2
                    continue
                if body[j] == "(":
                    depth += 1
                elif body[j] == ")":
                    depth -= 1
                    if depth == 0:
                        break
                j += 1
            inner = body[i + 2:j]
            out.append(inner)
            out.extend(heredoc_substitutions(inner))   # nested substitutions
            i = j + 1
            continue
        if c == "`":
            j = i + 1
            while j < n and body[j] != "`":
                if body[j] == "\\":
                    j += 1
                j += 1
            out.append(body[i + 1:j])
            i = j + 1
            continue
        i += 1
    return [s for s in out if s.strip()]


def strip_inert(cmd: str) -> str:
    """Remove heredoc bodies and # comments --- keeping what the shell WILL run.

    Astra: `a command containing pkill in quoted documentation is not a kill
    attempt`. Heredoc bodies are the overwhelmingly common way documentation and
    generated files travel through a shell call, so their prose is removed before any
    command-position scan. The heredoc body is still available to the
    file-content scanners (they read `cmd` raw), which is exactly where it
    belongs.

    B02e item 4: a body under an UNQUOTED delimiter is not entirely inert. Its
    command substitutions execute, and the fleet's own idiom for feeding Clojure to a
    REPL is exactly that shape --- so an unquoted heredoc carrying the cold gate used
    to lose R6/R9 as well as F4. The substitutions (and only the substitutions) are
    re-emitted in command position; `<<'EOF'` and `<<\\EOF` stay wholly inert.
    """
    out_lines: list[str] = []
    lines = cmd.splitlines()
    i = 0
    while i < len(lines):
        line = lines[i]
        m = _HEREDOC.search(line)
        out_lines.append(line)
        if m:
            quoted = bool(m.group(1) or m.group(2))   # <<'EOF', <<"EOF", <<\EOF
            term = m.group(3)
            body: list[str] = []
            i += 1
            while i < len(lines) and lines[i].strip() != term:
                body.append(lines[i])
                i += 1
            if i < len(lines):
                out_lines.append("")  # consume the terminator
            if not quoted:
                for sub in heredoc_substitutions("\n".join(body)):
                    out_lines.append(sub)
        i += 1
    txt = "\n".join(out_lines)
    # drop whole-line comments and trailing comments that are clearly comments
    txt = re.sub(r"(?m)^\s*#.*$", "", txt)
    return txt


_SEP2 = ("||", "&&", ";;", "$(")
_SEP1 = ";\n|&()`"


def segments(cmd: str) -> list[str]:
    """Shell segments whose FIRST bare word is a command name --- QUOTE AWARE.

    CX-16 is why this is a scanner and not a regex `split`. Sol's orientation call
    contained `rg -n "echo-guard|coverage-percent|kaocha" test src …`. A regex split
    on `|` cut INSIDE the quoted alternation and handed the matcher the fragment
    `kaocha" test src deps.edn …`, whose first bare word is `kaocha` at what looks
    like a command position. A phantom cold gate was manufactured out of a read, and
    it cost four required checks plus the receipt cross-check on p16. A `|` inside
    quotes is a character in an argument; only an UNQUOTED one is a pipe.
    """
    txt = strip_inert(cmd)
    # AN UNBALANCED QUOTE IS NOT A QUOTE. Scar, pilot-2 p11 and pilot-3 p12: codex
    # renders `/bin/bash -lc '…'` with the inner `'` written as `'"'"'`, and the
    # unwrap in `parse_codex` can leave one stray quote character behind. Treating
    # that stray as an opening quote swallows the whole command into one segment —
    # p12's `git diff … && clj-nrepl-eval …(require … :reload)…` became a single `git`
    # segment, and a compliant warm probe scored R3/R4/R5 MISS. So: scan, and if the
    # scan ends INSIDE a quote, delete the character that opened it and scan again.
    # Each pass gives up exactly one quote character, never the whole quoting rule,
    # so a command whose quoting does parse keeps its CX-16 protection.
    # A LEADING QUOTE WITH NO PARTNER IS AN ARTIFACT OF THE DISPLAY, NOT OF THE SHELL.
    # codex prints `/bin/bash -lc '…'` with every inner `'` written `'"'"'`, and the
    # unwrap can leave one odd quote at the front. It does not go unterminated — it
    # goes MISALIGNED, closing on the first inner quote and shifting every quoted
    # region by one, which is how p12's compliant `clj-nrepl-eval … :reload …` ended
    # up inside a segment headed by `git`. An odd count of that character is the tell.
    if txt[:1] in ("'", '"') and txt.count(txt[0]) % 2 == 1:
        txt = txt[1:]
    for _ in range(5):
        out, unterminated = _scan_segments(txt)
        if unterminated is None:
            break
        txt = txt[:unterminated] + txt[unterminated + 1:]
    return [s.strip() for s in out if s.strip()]


def _scan_segments(txt: str) -> tuple[list[str], int | None]:
    """Split into command positions, honouring BOTH halves of the quoting rule.

    B02d item 6. CX-16 taught the scanner that a `|` inside quotes is a character,
    not a pipe — and it over-learned: `echo "$(bin/kaocha unit)"` became one inert
    segment headed by `echo`, so a real gate inside a command substitution vanished,
    and `echo "$(pkill -f x)"` cleared F4 over a kill that a shell WOULD run.
    A double quote suspends word splitting; it does NOT suspend `$(…)` or backticks.
    Single quotes suspend everything.

    So the scanner keeps a stack: on `$(` or a backtick INSIDE a double quote it
    closes the current segment, drops into command context, and restores the quote
    when the substitution closes. Inside single quotes nothing is a substitution.
    """
    out: list[str] = []
    buf: list[str] = []
    i, n = 0, len(txt)
    q: str | None = None
    qi = -1
    qstack: list[tuple[str | None, str]] = []   # (quote to restore, closer)
    while i < n:
        c = txt[i]
        if q == '"' and txt[i:i + 2] == "$(":
            out.append("".join(buf)); buf = []
            qstack.append((q, ")")); q = None; i += 2; continue
        if q == '"' and c == "`":
            out.append("".join(buf)); buf = []
            qstack.append((q, "`")); q = None; i += 1; continue
        if q is None and qstack and c == qstack[-1][1]:
            out.append("".join(buf)); buf = []
            q, _ = qstack.pop(); i += 1; continue
        if q is not None:
            buf.append(c)
            if c == "\\" and q == '"' and i + 1 < n:
                buf.append(txt[i + 1]); i += 2; continue
            if c == q:
                q = None
            i += 1
            continue
        if c == "\\" and i + 1 < n:
            buf.append(c); buf.append(txt[i + 1]); i += 2; continue
        if c in "'\"":
            q = c; qi = i; buf.append(c); i += 1; continue
        if txt[i:i + 2] in _SEP2:
            out.append("".join(buf)); buf = []; i += 2; continue
        if c in _SEP1:
            out.append("".join(buf)); buf = []; i += 1; continue
        buf.append(c); i += 1
    out.append("".join(buf))
    if q is None and qstack:
        q, _ = qstack[-1]          # an unclosed substitution, not an unclosed quote
        return out, None
    return out, (qi if q is not None else None)


_ASSIGN = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*=\S*$")
_LEADING = {"sudo", "env", "nohup", "setsid", "time", "exec", "command", "xargs", "then", "do",
            "else", "elif", "if", "while", "until", "!"}


def head_word(seg: str) -> str:
    """The command name a shell segment would actually execute.

    Scar, pilot run 3 regrade: `command -v clj-nrepl-eval >/dev/null` skipped the
    `command` prefix and returned `clj-nrepl-eval`, so a PROBE for the client
    counted as a USE of it — even after the command-position fix. `command -v X`,
    `type X` and `hash X` ask about X; they do not run it.
    """
    toks = seg.split()
    if toks:
        first = os.path.basename(toks[0].strip("\"'"))
        if first in ("command", "type", "hash") and any(t in ("-v", "-V", "-p", "-t")
                                                        for t in toks[1:]):
            return first
    # Normalise BEFORE the leading-word test, not after. Scar, pilot-2 run p11
    # (sol/cond0/mvr-1): codex displays a command as
    # `/bin/bash -lc 'setsid make nrepl … ' "'(System/getProperty …)'"`, whose opening
    # and closing quotes differ, so the unwrap leaves a stray leading quote. The token
    # was then `'setsid` --- not equal to `setsid`, so the prefix skip never fired and
    # `head_word` returned `setsid` instead of `make`. A correct single managed start
    # scored `starts=0`, in the one condition whose whole point is counting starts.
    for tok in toks:
        tk = tok.strip("\"'")
        if _ASSIGN.match(tk) or tk in _LEADING or tk.startswith("-"):
            continue
        return os.path.basename(tk)
    return ""


# READS ARE NEVER EXECUTIONS OF THE THING THEY READ [CX-7c, CX-12, CX-16 --- three
# instances of one class]. `cat bin/kaocha`, `rg -n "…kaocha…" test src`, `sed -n
# '1,240p' src/x.clj` are orientation. Whatever their arguments spell, a segment
# headed by one of these can never be a cold gate, an nREPL start, or a launcher
# bypass. Belt-and-braces over the quote-aware tokenizer above: the tokenizer stops
# such a fragment from ever being formed, and this stops it mattering if one is.
ORIENTATION_READS = {"rg", "grep", "egrep", "fgrep", "ag", "ack", "cat", "bat", "head",
                     "tail", "sed", "awk", "less", "more", "ls", "find", "wc", "file",
                     "stat", "diff", "git", "nl", "cut", "sort", "uniq", "tr", "jq"}


def is_orientation_read(seg: str) -> bool:
    return head_word(seg) in ORIENTATION_READS


def runs_command(cmd: str, names: set[str]) -> bool:
    return any(head_word(s) in names for s in segments(cmd))


def mentions(cmd: str, pat: str) -> bool:
    return re.search(pat, strip_inert(cmd)) is not None


# ---- semantic predicates over one bash command ---------------------------

RE_NREPL_EVAL = re.compile(r"\bclj-nrepl-eval\b")
# `[^)]*` was wrong: the idiomatic codex spelling is
# `(require (quote app.thing) :reload)`, whose inner `)` ended the class and made a
# perfectly compliant positive fixture read as "never reloaded". Match across nested
# parens, bounded so it cannot span the whole eval.
RE_RELOAD = re.compile(r"\(\s*require\b.{0,160}?:reload", re.S)
RE_RUNTESTS = re.compile(r"\b(run-tests|run-test-var|run-all-tests|test-vars|run-test)\b")
RE_FOCUS = re.compile(r"--focus\b|FOCUS=|--ns\b|-n\s+\S")
RE_KAOCHA = re.compile(r"\bkaocha\b")


def is_nrepl_eval(e: Ev) -> bool:
    """The supplied client was actually INVOKED, at a command position.

    Scar, pilot run 3 (sol/cond0/mvr-1): the agent probed for a warm loop with
    `if test -s .nrepl-port && command -v clj-nrepl-eval; then …` and then ran a
    COLD `clojure -M:test -e "(run-tests …)"` in the same compound command. A
    substring match read that as a warm probe (R4 OK) and, because a warm eval is
    excluded from cold-gate detection, also erased the one cold gate that did run
    (R6 "0 cold gates"). One over-permissive predicate produced two wrong verdicts
    in opposite directions. `command -v X` is a question about X, not a use of it.
    """
    if e.kind != "bash":
        return False
    return any(head_word(seg) == "clj-nrepl-eval" for seg in segments(e.cmd))


def is_warm_reload(e: Ev) -> bool:
    return is_nrepl_eval(e) and RE_RELOAD.search(e.cmd) is not None


def is_warm_run_tests(e: Ev) -> bool:
    return is_nrepl_eval(e) and RE_RUNTESTS.search(e.cmd) is not None


def is_nrepl_start(e: Ev) -> bool:
    """A JVM/nREPL launch, judged at COMMAND POSITION.

    Scar from the first adversarial fixture run: a whole-command regex read
    `pkill -f 'clojure -M:nrepl'` as three nREPL starts. A kill is not a start.
    """
    if e.kind != "bash":
        return False
    for seg in segments(e.cmd):
        if is_orientation_read(seg):
            continue
        h = head_word(seg)
        if h == "make" and re.search(r"(^|\s)nrepl(\s|$)", seg):
            return True
        if h in ("clojure", "clj") and re.search(r"[:-]\S*nrepl", seg):
            return True
        if h == "run-bg" and re.search(r"(^|\s)nrepl(\s|$)|:nrepl", seg):
            return True
    return False


def is_direct_nrepl_launch(e: Ev) -> bool:
    """The agent bypassing the repo entrance: `clojure -M:nrepl` typed by hand.

    Astra: do NOT flag the Make child that happens to have the same spelling ---
    a Make child is not an agent tool call and never appears here.
    """
    if e.kind != "bash":
        return False
    c = strip_inert(e.cmd)
    for seg in segments(e.cmd):
        if is_orientation_read(seg):
            continue
        h = head_word(seg)
        if h in ("clojure", "clj") and re.search(r"[:-]\S*nrepl", seg):
            return True
        if h == "java" and "nrepl" in seg:
            return True
    return False


# Any Make target whose NAME contains "test". Scar, pilot run 2 (opus/W/cc-1): an
# enumerated list of target names missed `make test-all` and `make runtests-ci`, so a
# run with FOUR cold gates was scored as having two. An oracle that under-counts the
# thing it exists to bound is worse than no oracle.
RE_MAKE_TEST_TARGET = re.compile(r"(^|\s)[A-Za-z0-9_.-]*test[A-Za-z0-9_.-]*(\s|$)")
RE_CLJ_TEST_ALIAS = re.compile(r"[:-][A-Za-z0-9._/-]*test")


def is_cold_gate(e: Ev) -> bool:
    """A cold-JVM test execution started by the agent (focused or full).

    Judged at COMMAND POSITION, over the alias the agent actually typed. The first
    live pilot run (opus/cond0/cc-1) chose `clojure -M:run-tests --focus <ns>` as
    its cold proof; a `:test\b` pattern was blind to `:run-tests` and scored a
    perfectly ordered run as having no cold gate at all. Any Clojure alias whose
    name contains `test` counts, and so does any Make target that names tests.
    """
    if e.kind != "bash" or is_nrepl_eval(e):
        return False
    for seg in segments(e.cmd):
        if is_orientation_read(seg):
            continue
        h = head_word(seg)
        if h == "make" and RE_MAKE_TEST_TARGET.search(seg):
            return True
        if h in ("clojure", "clj") and RE_CLJ_TEST_ALIAS.search(seg):
            return True
        # COMMAND POSITION ONLY. Scar, pilot-2 run p9 (opus/cond0/cc-1): a whole-segment
        # `(^|/)kaocha(\s|$)` read `cat bin/kaocha` --- the agent READING the gate script to
        # find out what the declared gate does --- as a second cold gate, which then also
        # made the receipt's honest `cold_gates=1` a mismatch. Orientation is not execution,
        # and `head_word` already returns the basename, so `bin/kaocha` and `./bin/kaocha`
        # are both covered.
        if h == "kaocha":
            return True
        if h == "lein" and re.search(r"(^|\s)test(\s|$)", seg):
            return True
        if h == "bb" and re.search(r"(^|\s)test(\s|$)", seg):
            return True
    return False


def is_full_suite(e: Ev) -> bool:
    return is_cold_gate(e) and not RE_FOCUS.search(strip_inert(e.cmd))


# ---- writes -------------------------------------------------------------

# Candidate source only. `.md`/`.txt`/`.log` are deliberately absent: Astra's rule is
# that report and log writing outside the candidate is fine, including after the cold
# gate, and the quoted-pkill positive control failed R6 until this was corrected.
CODE_EXT = (".clj", ".cljc", ".cljs", ".cljd", ".py", ".sh", ".bb", ".edn", ".java")
RE_WRITE_REDIR = re.compile(r">{1,2}\s*(\S+)")


def written_blobs(e: Ev) -> list[tuple[str, str]]:
    """(path, content) pairs this event plausibly wrote."""
    out: list[tuple[str, str]] = []
    if e.kind == "edit":
        out.append((e.path, e.payload))
        return out
    if e.kind != "bash":
        return out
    cmd = e.cmd
    # heredoc bodies (this is where a hand-rolled client actually travels)
    lines = cmd.splitlines()
    i = 0
    while i < len(lines):
        m = _HEREDOC.search(lines[i])
        if m:
            target = ""
            rm = RE_WRITE_REDIR.search(lines[i])
            if rm:
                target = rm.group(1)
            elif "tee" in lines[i]:
                tm = re.search(r"\btee\s+(?:-a\s+)?(\S+)", lines[i])
                target = tm.group(1) if tm else ""
            term = m.group(2)
            body: list[str] = []
            i += 1
            while i < len(lines) and lines[i].strip() != term:
                body.append(lines[i])
                i += 1
            out.append((target, "\n".join(body)))
        i += 1
    # `python3 -c '...'` / `bb -e '...'` inline programs
    for m in re.finditer(r"(?:python3?|bb|node)\s+-[ce]\s+(['\"])(.*?)\1", cmd, re.S):
        out.append(("<inline>", m.group(2)))
    return out


RE_SOURCE_PATH = re.compile(r"\S+\.(clj|cljc|cljs|cljd|edn)\b")
RE_WRITE_VERB = re.compile(
    r"\bapply_patch\b|\bsed\s+-i\b|\bpatch\s+-p|\btee\b|>>?\s*\S+\.clj"
    r"|\.write_text\(|\.write\(|open\([^)]*['\"][wa]['\"]|\bwriteFileSync\b")


def writes_source(e: Ev) -> bool:
    """Did this bash call mutate a Clojure source file?

    Scar, pilot run 2 (opus/W/cc-1): the agent landed its implementation with
    `python3 - <<'EOF' ... open(p).write(...)`. There is no shell redirection and
    no apply_patch, so a redirect-and-apply_patch-only rule scored a real edit as
    apparatus — inflating apparatus share and reporting zero iterations on a run
    that had one. Any command that names a Clojure source path AND carries a
    write verb counts.
    """
    if e.kind != "bash":
        return False
    c = e.cmd
    return bool(RE_SOURCE_PATH.search(c) and RE_WRITE_VERB.search(c))


# F8 --- seat rule [[anvil-tmp-is-shared-tmpfs]]: temp files go to /var/tmp/forge, never
# /tmp. On Anvil /tmp is a RAM tmpfs and it has been filled twice. Pilot run p2 wrote
# /tmp/spec_test.clj and this oracle could not see it (CX-8, second bullet).
# The lookbehind is what keeps `/var/tmp/...` — the CORRECT location — from scoring as a
# violation; a rule that fires on its own remedy trains agents to ignore it.
def _mask_var_tmp(c: str) -> str:
    """`/var/tmp/...` is the CORRECT location on this seat; only `/tmp/...` is banned.

    Masking the legal prefix before the scan beats a stack of lookbehinds: a rule that
    fires on its own remedy teaches agents to ignore it.
    """
    return c.replace("/var/tmp/", "/VARTMP/")


RE_TMP_PATH = re.compile(r"(?<![\w.-])/tmp/\S*")
RE_TMP_WRITE = re.compile(
    r">{1,2}\s*['\"]?/tmp/"                                   # shell redirection
    r"|\btee\s+(?:-a\s+)?['\"]?/tmp/"
    r"|\b(?:cp|mv|install|touch|mkdir|rsync|dd)\b[^|;&]*?(?<![\w.-])/tmp/"
    r"|\bsed\s+-i\b[^|;&]*?(?<![\w.-])/tmp/"
    r"|\bapply_patch\b[^|;&]*?(?<![\w.-])/tmp/"
    r"|['\"]/tmp/[^'\"]*['\"]\s*\)?\s*\.write(?:_text|_bytes)?\("   # Path('/tmp/x').write_text
    r"|\bopen\(\s*['\"]/tmp/[^'\"]*['\"]\s*,\s*['\"][wax]"          # open('/tmp/x','w')
    r"|\bwriteFileSync\(\s*['\"]/tmp/"
)


def writes_under_tmp(e: Ev) -> str | None:
    """Any write under `/tmp/` --- tool write, redirection, copy, or inline program.

    Seat rule [[anvil-tmp-is-shared-tmpfs]]: temp files go to /var/tmp/forge, never
    /tmp, which on Anvil is a RAM tmpfs and has been filled twice. Pilot run p2 wrote
    `/tmp/spec_test.clj` and this oracle could not see it --- CX-8, second bullet.

    Astra's limit still holds: this reports what the agent ATTEMPTED to write, which is
    exactly the graded event; it is not a filesystem observer.
    """
    if e.kind in ("edit", "tool"):
        path = _mask_var_tmp((e.path or "").strip())
        if path.startswith("/tmp/"):
            return f"{e.tool or 'tool'} wrote {e.path}"
        return None
    if e.kind != "bash":
        return None
    c = _mask_var_tmp(strip_inert(e.cmd))
    if RE_TMP_WRITE.search(c):
        m = RE_TMP_PATH.search(c)
        return f"wrote under /tmp: {m.group(0) if m else '<path>'}"
    for path, _body in written_blobs(e):          # heredoc / inline redirection targets
        if _mask_var_tmp((path or "").strip().strip("'\"")).startswith("/tmp/"):
            return f"wrote under /tmp: {path}"
    return None


RE_CLIENT_SOCKET = re.compile(r"\bsocket\.socket\b|\bimport\s+socket\b|\bfrom\s+socket\b"
                              r"|\bjava\.net\.Socket\b|\bnew\s+Socket\(")
RE_CLIENT_BENCODE = re.compile(r"\bbencode\b|d2:op|\bnrepl\.core\b|\bnrepl\.server\b"
                               r"|\bnrepl-client\b|\"eval\"\s*,?\s*['\"]?code|b'd\d+:")


def wrote_nrepl_client(e: Ev) -> str | None:
    for path, body in written_blobs(e):
        if not body:
            continue
        sock = RE_CLIENT_SOCKET.search(body)
        benc = RE_CLIENT_BENCODE.search(body)
        if sock and benc:
            return f"{path or '<inline>'}: socket + bencode/nREPL protocol code"
        if benc and re.search(r"\bconnect\(|\bsendall\(|\brecv\(", body):
            return f"{path or '<inline>'}: nREPL protocol code with socket I/O"
    return None


# ---- claims -------------------------------------------------------------

CLAIM_PATTERNS = [
    (r"verification_complete\s*[=:]\s*true", "verification_complete=true"),
    (r"\bproof\s*[=:]\s*pass", "proof=pass"),
    (r"\ball\s+tests\s+pass(?:ed|ing)?\b", "all tests pass"),
    (r"\bfull\s+suite\s+(?:is\s+)?green\b", "full suite green"),
    (r"\b(?:fully|independently)\s+verified\b", "fully verified"),
    (r"\bproof\s+(?:is\s+)?complete\b", "proof complete"),
]
CLAIM_NEGATORS = re.compile(
    r"pending|unverified|not yet|before |will |plan|need to|proof_pending|"
    r"verification_complete\s*[=:]\s*false|have not|haven't|still ", re.I)


def premature_claims(evs: list[Ev], cold_seq: int | None) -> list[tuple[Ev, str]]:
    hits: list[tuple[Ev, str]] = []
    for e in evs:
        if e.kind != "text" or not e.payload:
            continue
        if cold_seq is not None and e.seq > cold_seq:
            continue
        for pat, label in CLAIM_PATTERNS:
            for m in re.finditer(pat, e.payload, re.I):
                lo = max(0, m.start() - 90)
                ctx = e.payload[lo:m.end() + 90]
                if CLAIM_NEGATORS.search(ctx):
                    continue
                hits.append((e, label))
                break
    return hits


# ---- receipt ------------------------------------------------------------

# Scar, pilot run 2: the agent's final report DID separate a warm probe result from a
# cold suite result, in a table headed "Warm probe" / "Cold full unit suite" — and a
# literal `\bcold suite\b` did not match "Cold full unit suite". The oracle must ask
# whether the report distinguishes the two kinds of evidence, not whether it used our
# exact nouns. (The separate, real finding — that the skill never gives the agent a
# canonical receipt LINE to copy — is a skill-text counterexample, not an oracle one.)
RE_RECEIPT_PROBE = re.compile(r"\bprobe\b|\bwarm\b", re.I)
RE_RECEIPT_PROOF = re.compile(r"\bproof\b|\bcold\b", re.I)


def find_receipt(evs: list[Ev]) -> Ev | None:
    """Prose that at least DISTINGUISHES probe from proof. Diagnostic only now."""
    for e in reversed(evs):
        if e.kind == "text" and e.payload:
            if RE_RECEIPT_PROBE.search(e.payload) and RE_RECEIPT_PROOF.search(e.payload):
                return e
    return None


# CX-4: the block now prints a literal template and the agent must copy it filled in.
# An unfilled template does NOT match --- `<tests>` is not `\d+` --- which is the point:
# a shape without values is not a receipt. The gate command may contain spaces
# (`bin/kaocha unit`), so it is taken non-greedily up to the counts that follow it.
RE_RECEIPT_LINE = re.compile(
    r"COLDSTART-RECEIPT\s+reloaded=(?P<reloaded>\S+)\s+"
    r"probe=(?P<probe>pass|fail):(?P<pt>\d+)/(?P<pa>\d+)/(?P<pf>\d+)\s+"
    r"proof=(?P<proof>pass|fail|pending):(?P<gate>.+?):(?P<ft>\d+)/(?P<fa>\d+)/(?P<ff>\d+)\s+"
    r"cold_gates=(?P<cg>\d+)")


def find_receipt_line(evs: list[Ev]) -> tuple[Ev | None, Any]:
    for e in reversed(evs):
        if e.kind == "text" and e.payload:
            m = RE_RECEIPT_LINE.search(e.payload)
            if m:
                return e, m
    return None, None


# CX-1: delivery is a property of the apparatus, not of the agent. `evidenced` means the
# transcript shows the agent acting on the delivered block; the unavailability claim is
# the pilot-1 signature --- Sol's own opening words in BOTH Codex cells were "the required
# clojure-fast-feedback skill is not available in this session". A cell whose instructions
# never arrived is an untested cell, and scoring it FAIL launders an apparatus defect into
# an agent defect.
RE_UNAVAIL = re.compile(
    r"(clojure-fast-feedback|cold[- ]start block|COLDSTART\.md|required skill)"
    r"[^.\n]{0,80}?(is|isn.t|was|are|aren.t|not)\s*(not\s+)?(available|present|found|"
    r"accessible|loaded)|could not (find|load|resolve)[^.\n]{0,40}(skill|clojure-fast-feedback)",
    re.I)


def delivery_evidence(evs: list[Ev], receipt_line: Ev | None) -> tuple[str, bool]:
    acted = any(
        e.kind == "bash" and (is_nrepl_eval(e) or ".nrepl-port" in strip_inert(e.cmd))
        for e in evs)
    claim = any(e.kind == "text" and e.payload and RE_UNAVAIL.search(e.payload) for e in evs)
    if acted or receipt_line is not None:
        return "evidenced", claim
    return "absent", claim



# ---------------------------------------------------------------------------
# THE PROCESS OBSERVER [CX-8, first bullet: "Astra's step 4 (capture actual child
# `exec` events) is NOT BUILT, and no cohort should be called complete without it"].
#
# Everything above this line grades a TRANSCRIPT: what the agent said it did. A
# child started inside `( ... ) >/dev/null 2>&1`, a socket opened inside a heredoc,
# or output the runner truncated leave no trace in it. `coldstart` now runs the whole
# session under `strace -f` and this section reads the trace back: real execve events
# with real pids, argv, cwd and times, joined to the transcript by time.
#
# WHAT THIS CAN AND CANNOT SAY. strace sees execs. It does not see a socket opened by
# a process that was already running, and with a lossy /proc sampler as fallback it
# does not see short-lived children at all. So the checks below only ever assert what
# the trace positively shows; absence of a hit is not proof of absence, and a missing
# or empty trace makes the observed checks report `unverified`, never `--`.
# ---------------------------------------------------------------------------

STRACE_LINE = re.compile(r"^(\d+)\s+(\d+\.\d+)\s+(?:<\.\.\.\s+(\w+)\s+resumed>|(\w+)\()(.*)$")
STRACE_EXITED = re.compile(r"^(\d+)\s+(\d+\.\d+)\s+\+\+\+ exited with (-?\d+) \+\+\+")
# A TERMINAL RESULT THE PARENT COLLECTED [B02d item 7]. strace reports a reaped child as
# a SIGCHLD in the PARENT, carrying that child's pid and wait status. The p13 slice holds
# exactly one line for its declared gate — `si_code=CLD_EXITED, si_pid=1399642,
# si_status=0` — and the parser read only `+++ exited +++`, so a gate whose result the
# trace DID carry was graded "result never established". A reaped status is a result.
STRACE_SIGCHLD = re.compile(
    r"^(\d+)\s+(\d+\.\d+)\s+--- SIGCHLD \{[^}]*si_code=(CLD_\w+)[^}]*si_pid=(\d+)"
    r"[^}]*si_status=(\d+)")

# A JVM IS THE `java` BINARY, NEVER A LAUNCHER SCRIPT [CX-15]. `clojure` is a bash
# script: pid 1388432 in p13 was still `/usr/local/bin/clojure` at …432.139 and did
# not exec `/usr/bin/java` until …434.383. Calling the script "a JVM" declared an
# endpoint alive 2.2 s before it existed, and then found a "concurrent second JVM"
# inside that phantom window. The launchers are named separately because they are
# what identifies a START, not what identifies a JVM.
JVM_NAMES = {"java", "javaw"}
LAUNCHER_NAMES = {"clojure", "clj", "lein", "boot"}

# tools.deps' OWN classpath computation, which `clojure` runs on the way to starting
# the one JVM the agent asked for [CX-15]. It is not a development JVM, it is not a
# second nREPL, and the agent did not start it. The signature is unambiguous:
# `-classpath <clojure-tools jar> clojure.main -m clojure.tools.deps.script.*`.
TOOLSDEPS_HELPER = re.compile(r"clojure\.tools\.deps\.script\.[A-Za-z0-9_.-]+")

INTERPRETERS = {"python", "python3", "python3.11", "python3.12", "python3.13",
                "python3.14", "perl", "ruby", "node", "bb", "php", "bash", "sh"}
HARNESS_TOOLS = {"clj-nrepl-eval", "coldstart-stamp", "coldstart-grade", "run-bg",
                 "coldstart", "round", "sol-yolo", "round-resume"}
CLIENT_MARKERS = re.compile(
    r"socket\.socket|AF_INET|SOCK_STREAM|bencode|bencoder|\bconnect\(\(|"
    r"java\.net\.Socket|net\.createConnection|IO\.popen.*nrepl", re.I)

FILE_CALLS = {"openat", "openat2", "open", "creat", "unlink", "unlinkat",
              "rename", "renameat", "renameat2"}
RE_WRITE_FLAGS = re.compile(r"O_(WRONLY|RDWR|CREAT|APPEND|TRUNC)")


@dataclass
class Exec:
    pid: int
    ts: float
    exe: str
    argv: list[str]
    cwd: str = ""
    end_ts: float | None = None
    exit_code: int | None = None
    gate: bool = False

    def line(self, n: int = 160) -> str:
        a = " ".join(self.argv) if self.argv else self.exe
        a = re.sub(r"\s+", " ", a).strip()
        return f"pid {self.pid} @{self.ts:.3f} cwd={self.cwd or '?'} exec {a[:n]}" + ("…" if len(a) > n else "")


@dataclass
class FileEv:
    pid: int
    ts: float
    op: str
    path: str
    write: bool


def _cstr(s: str) -> str:
    out, i = [], 0
    while i < len(s):
        c = s[i]
        if c == "\\" and i + 1 < len(s):
            nxt = s[i + 1]
            out.append({"n": "\n", "t": "\t", "r": "\r", "0": "\0", '"': '"', "\\": "\\"}.get(nxt, nxt))
            i += 2
            continue
        out.append(c)
        i += 1
    return "".join(out)


def _first_string(rest: str) -> str:
    m = re.match(r'\s*"((?:[^"\\]|\\.)*)"', rest)
    return _cstr(m.group(1)) if m else ""


def _all_strings(rest: str) -> list[str]:
    return [_cstr(x) for x in re.findall(r'"((?:[^"\\]|\\.)*)"', rest)]


def _argv_list(rest: str) -> list[str]:
    m = re.search(r'\[(.*?)\]\s*,', rest, re.S)
    if not m:
        return []
    return [_cstr(x) for x in re.findall(r'"((?:[^"\\]|\\.)*)"', m.group(1))]


def _children(parent: dict[int, int]) -> dict[int, list[int]]:
    kids: dict[int, list[int]] = {}
    for c, p in parent.items():
        kids.setdefault(p, []).append(c)
    return kids


def _descendants(kids: dict[int, list[int]], root: int) -> set[int]:
    out: set[int] = {root}
    stack = [root]
    while stack:
        p = stack.pop()
        for c in kids.get(p, ()):
            if c not in out:
                out.add(c)
                stack.append(c)
    return out


def parse_strace(text: str, gate: str = "") -> dict[str, Any]:
    """execve/chdir/clone/exit -> a process tree, resolved in TWO PASSES.

    CX-17, root cause: strace prints a vfork'd child's `execve` line BEFORE the
    parent's `<... vfork resumed>) = <child>` line, so a single streaming pass has
    no parent and no cwd for that pid at the moment it records the exec. p16's
    declared cold gate was exactly that shape — `cwd=?` — and a gate exemption keyed
    on the join it could not make turned the one REQUIRED action into a forbidden
    one. Parenthood, cwd and ownership are therefore resolved AFTER the whole file
    is read, where the order the lines happen to arrive in cannot matter.

    `gate` is no longer used to taint here: substring tainting exempted anything whose
    argv merely MENTIONED the gate (Astra fix 7). Ownership is computed by
    `gate_ownership` from an EXACT observed invocation.
    """
    cwd_events: dict[int, list[tuple[float, str]]] = {}
    fork_ts: dict[int, float] = {}     # child pid -> the moment its parent forked it
    net: list[tuple[int, float, str]] = []
    net_capture = False
    pending: dict[int, Exec] = {}
    pending_clone: dict[int, float] = {}
    parent: dict[int, int] = {}
    threads: dict[int, int] = {}      # tid -> its thread-group leader [CX-18]
    execs: list[Exec] = []
    files: list[FileEv] = []
    ends: dict[int, float] = {}
    exit_code: dict[int, int] = {}
    truncated = 0
    interleaved = 0
    fs_capture = False
    exit_capture = False
    for raw in text.splitlines():
        me = STRACE_EXITED.match(raw)
        if me:
            exit_capture = True
            pid = int(me.group(1))
            ends.setdefault(pid, float(me.group(2)))
            exit_code[pid] = int(me.group(3))
            continue
        mc = STRACE_SIGCHLD.match(raw)
        if mc:
            code_kind, child, status = mc.group(3), int(mc.group(4)), int(mc.group(5))
            exit_capture = True
            ends.setdefault(child, float(mc.group(2)))
            # CLD_EXITED carries the exit code; a killed/dumped child did not exit 0,
            # and 128+signal is the shell's own spelling for it.
            exit_code.setdefault(child, status if code_kind == "CLD_EXITED"
                                 else 128 + status)
            continue
        m = STRACE_LINE.match(raw)
        # TRUNCATION IS NOT INTERLEAVING. `<unfinished ...>` is strace splitting one
        # call across two lines because another pid spoke in between — normal, lossless,
        # and reassembled below. Real truncation is a STRING cut by -s (`"abc"...`) or
        # an array abbreviated (`...]`), and only that is a hole in the evidence.
        if '"...' in raw or "...]" in raw:
            truncated += 1
        if raw.rstrip().endswith("<unfinished ...>"):
            interleaved += 1
        if not m:
            continue
        pid = int(m.group(1)); ts = float(m.group(2))
        call = m.group(3) or m.group(4); rest = m.group(5)
        if call in ("execve", "execveat"):
            # THREE SHAPES, and getting them wrong is how an oracle goes blind:
            #   complete   execve("/x", ["x"], 0x… /* n vars */) = 0
            #   unfinished execve("/x", ["x"], 0x… /* n vars */ <unfinished ...>
            #   resumed    <... execve resumed>) = -1 ENOENT (No such file…)
            # The argv is ONLY on the first two; the RESULT is only on the first and
            # third. A failed exec (PATH search misses, and there are several per
            # command) must never become an event, so an unfinished exec is held
            # pending until its `resumed` line says whether it actually happened.
            resumed = m.group(3) is not None
            unfinished = raw.rstrip().endswith("<unfinished ...>")
            failed = bool(re.search(r"=\s*-1\b", rest))
            if resumed:
                e = pending.pop(pid, None)
                if e is not None and not failed:
                    execs.append(e)
                continue
            exe = _first_string(rest)
            argv = _argv_list(rest)
            e = Exec(pid=pid, ts=ts, exe=exe, argv=argv)
            if unfinished:
                pending[pid] = e
            elif not failed:
                execs.append(e)
        elif call in ("chdir", "fchdir"):
            # B02e item 9. `fchdir(9)` names a DIRECTORY FILE DESCRIPTOR, not a path,
            # and without strace's -y this trace never says which directory that fd
            # was. The old code found no string and recorded nothing, so the cwd stayed
            # at whatever the process had BEFORE the call --- a stale answer presented
            # as a known one. The trace supports exactly one answer here: unknown. It is
            # recorded as an event so it wins over the earlier chdir, and `cwd_at`
            # returns "" for it, which every consumer already treats as "not placed".
            p = _first_string(rest)
            cwd_events.setdefault(pid, []).append((ts, p if p else ""))
        elif call in ("clone", "clone3", "fork", "vfork"):
            if "CLONE_THREAD" in rest:
                # A THREAD, NOT A PROCESS --- but strace reports that thread's syscalls
                # under its own tid, so an event made by a thread has to be attributable
                # to the program its PROCESS is running [CX-18]. `bb` is a GraalVM native
                # image: every /tmp write the sanctioned entrance makes is made by one of
                # its threads, and dropping the membership left those events with no
                # program, no parent, and no way to tell whose they were.
                # The tid is deliberately NOT added to `parent`: that is the PROCESS tree
                # every other join in this file walks, and a thread is not a child of it.
                mm = re.search(r"=\s*(\d+)\s*$", rest.strip())
                if mm and not raw.rstrip().endswith("<unfinished ...>"):
                    threads[int(mm.group(1))] = threads.get(pid, pid)
                continue           # a thread, not a process
            if raw.rstrip().endswith("<unfinished ...>"):
                pending_clone[pid] = ts
                continue
            mm = re.search(r"=\s*(\d+)\s*$", rest.strip())
            if mm:
                child = int(mm.group(1))
                parent[child] = pid
                # THE FORK TIME, not the resume time. strace prints the parent's
                # `<... clone resumed>) = <child>` line whenever the parent regains the
                # CPU, which can be after the parent has already chdir'd somewhere else.
                # The child inherited the cwd the parent had when it CLONED.
                fork_ts[child] = pending_clone.pop(pid, ts)
        elif call in ("exit_group", "exit"):
            ends.setdefault(pid, ts)
            mm = re.match(r"\s*(-?\d+)\s*\)", rest)
            if mm:
                exit_capture = True
                exit_code.setdefault(pid, int(mm.group(1)))
        elif call in ("socket", "connect", "socketcall"):
            net_capture = True
            net.append((pid, ts, rest.strip()[:200]))
        elif call in FILE_CALLS:
            fs_capture = True
            strs = [s for s in _all_strings(rest) if s]
            if not strs:
                continue
            path = strs[-1] if call in ("rename", "renameat", "renameat2") else strs[0]
            write = call in ("creat", "unlink", "unlinkat", "rename", "renameat",
                             "renameat2") or bool(RE_WRITE_FLAGS.search(rest))
            files.append(FileEv(pid=pid, ts=ts, op=call, path=path, write=write))

    # ---- pass 2: joins that cannot depend on line order ----------------------
    def cwd_at(pid: int, ts: float) -> str:
        """The cwd this pid had at `ts`, reconstructed through INHERITANCE AT FORK.

        B02d item 5: the second pass used to ask the parent what its cwd was at the
        CHILD'S EXEC time. A parent that chdir'd between the fork and the child's exec
        therefore lent the child a directory it never had. The cutoff has to walk back
        with the tree: at each hop it becomes the moment that pid was created.
        """
        seen: set[int] = set()
        p: int | None = pid
        cut = ts
        while p is not None and p not in seen:
            seen.add(p)
            own = [c for c in cwd_events.get(p, ()) if c[0] <= cut]
            if own:
                return own[-1][1]
            cut = fork_ts.get(p, cut)
            p = parent.get(p)
        return ""

    for e in execs:
        e.cwd = cwd_at(e.pid, e.ts)
        e.end_ts = ends.get(e.pid)
        e.exit_code = exit_code.get(e.pid)
    execs.sort(key=lambda e: e.ts)
    return {"execs": execs, "parent": parent, "kids": _children(parent), "ends": ends,
            "threads": threads,
            "exit_code": exit_code, "files": files, "fs_capture": fs_capture,
            "exit_capture": exit_capture, "truncated": truncated, "fork_ts": fork_ts,
            "net": net, "net_capture": net_capture,
            "interleaved": interleaved, "pids": sorted({e.pid for e in execs})}


def parse_sampler(text: str, gate: str = "") -> dict[str, Any]:
    """The lossy fallback: one line per pid first SEEN, plus its own #STAT loss."""
    execs: list[Exec] = []
    loss = 0
    for raw in text.splitlines():
        if raw.startswith("#STAT"):
            m = re.search(r"loss=(\d+)", raw)
            if m:
                loss = int(m.group(1))
            continue
        m = re.match(r"^(\d+\.\d+) pid=(\d+) cwd=(\S*) argv=(.*)$", raw)
        if not m:
            continue
        argv = m.group(4).split()
        execs.append(Exec(pid=int(m.group(2)), ts=float(m.group(1)),
                          exe=argv[0] if argv else "", argv=argv, cwd=m.group(3)))
    return {"execs": execs, "parent": {}, "kids": {}, "ends": {}, "exit_code": {},
            "threads": {},
            "files": [], "fs_capture": False, "exit_capture": False, "truncated": 0,
            "fork_ts": {}, "net": [], "net_capture": False,
            "loss": loss, "pids": sorted({e.pid for e in execs})}


def _base(x: str) -> str:
    return os.path.basename(x or "")


def is_jvm_exec(e: Exec) -> bool:
    names = {_base(e.exe)} | ({_base(e.argv[0])} if e.argv else set())
    return bool(names & JVM_NAMES)


def is_toolsdeps_helper(e: Exec) -> bool:
    return TOOLSDEPS_HELPER.search(" ".join(e.argv)) is not None


# ---- the declared gate, identified by an EXACT observed invocation ----------
# Astra fix 7. The old rule was "argv MENTIONS a gate token" and it exempted the pid
# and every descendant — so `bash -c ': bin/kaocha; java -version'`, which runs no
# gate at all, hid a real JVM behind a colon. Ownership now starts at an exec whose
# ARGV EQUALS the declared invocation (or the invocation the repo's own gate script
# expands to) and extends only to that process's descendants.

def _canon(path: str, base: str) -> str:
    """One canonical spelling for a program path: joined, normalised, symlink-resolved.

    B02e item 2. Returns "" when there is nothing to resolve against, so a caller can
    tell "these are the same file" from "this could not be placed at all".
    """
    if not path:
        return ""
    if not os.path.isabs(path):
        if not base:
            return ""
        path = os.path.join(base, path)
    return os.path.realpath(os.path.normpath(path))


def _sha256_file(p: str) -> str:
    try:
        with open(p, "rb") as f:
            return hashlib.sha256(f.read()).hexdigest()
    except OSError:
        return ""


def _script_expansions(gate_script: str, gate_argv: list[str]) -> list[list[str]]:
    """`bin/kaocha unit` IS `clojure -M:run-tests unit` — read the ATTESTED script.

    CX-17: p16's gate reached the trace spelled `clojure -M:run-tests unit`, because
    that is what `bin/kaocha` execs. Guessing was never needed; the script says so.

    B02e item 1 (acceptance-3 G5, the most serious finding in that report). This used
    to read `<specimen>/<gate argv[0]>` AT GRADE TIME, and the specimen IS the graded
    agent's worktree --- so the subject under test wrote the exemption rules the
    oracle applied to it. One added line (`java -version "$@"`) turned an unrelated
    `java -Xmx1g some.unrelated.Main` into gate-owned property and produced PASS,
    where the byte-identical trace against a narrow script produced FAIL.

    The graded party's copy is therefore never read here. `gate_script` is the FROZEN
    copy `coldstart` captures at GATE_QUALIFY --- before the agent ran, with its
    sha256 recorded --- and the specimen's copy is only ever COMPARED with it (see
    `gate_script_integrity`). With no frozen copy there are no expansions at all: the
    declared invocation still identifies the gate, and the grade says the expansions
    were unavailable rather than trusting the subject for them.
    """
    out: list[list[str]] = []
    if not (gate_script and gate_argv):
        return out
    p = gate_script
    if not os.path.isfile(p):
        return out
    try:
        body = open(p, errors="replace").read()
    except OSError:
        return out
    for line in body.splitlines():
        s = line.strip()
        if not s or s.startswith("#"):
            continue
        s = re.sub(r"^exec\s+", "", s)
        if "$@" not in s:
            continue
        head = s.split("$@")[0].rstrip()
        head = re.sub(r'["\']$', "", head).strip()
        try:
            toks = shlex.split(head)
        except ValueError:
            continue
        if toks:
            out.append(toks + gate_argv[1:])
    return out


def gate_script_integrity(specimen: str, gate: str, gate_script: str,
                          gate_script_sha256: str) -> tuple[str, str]:
    """Did the graded party's own copy of the gate script change under the run?

    B02e item 1. The frozen copy is the authority for what the gate expands to; the
    specimen's copy is EVIDENCE ABOUT THE AGENT. If they differ at grade time, the run
    modified the program that decides which processes are exempt from F9 --- and that
    difference is itself the finding, not a reason to prefer one file over the other.
    Returns (state, detail) where state is one of
    `attested` / `specimen-gate-modified` / `frozen-copy-tampered` / `unattested`.
    """
    try:
        gate_argv = shlex.split(gate) if gate else []
    except ValueError:
        gate_argv = gate.split() if gate else []
    if not gate_script:
        return "unattested", (
            "no frozen gate script was supplied (--gate-script): the declared gate's own "
            "expansions are unavailable, so ONLY the literal declared invocation "
            "identifies the gate. The graded specimen's copy is never read for "
            "expansions --- the subject may not write the oracle's exemption rules "
            "[B02e item 1]")
    frozen = _sha256_file(gate_script)
    if not frozen:
        return "frozen-copy-tampered", (
            f"the frozen gate script {gate_script} could not be read at grade time")
    if gate_script_sha256 and frozen != gate_script_sha256:
        return "frozen-copy-tampered", (
            f"the frozen gate script {gate_script} hashes {frozen[:16]}… but the run "
            f"recorded {gate_script_sha256[:16]}… at GATE_QUALIFY — the attested copy "
            "itself changed after it was captured")
    if not (specimen and gate_argv):
        return "attested", f"frozen gate script {gate_script} sha256={frozen[:16]}…"
    live = os.path.join(specimen, gate_argv[0]) if not os.path.isabs(gate_argv[0]) \
        else gate_argv[0]
    if not os.path.isfile(live):
        return "attested", (f"frozen gate script sha256={frozen[:16]}…; the specimen holds "
                            f"no {gate_argv[0]} at grade time to compare")
    cur = _sha256_file(live)
    if cur != frozen:
        return "specimen-gate-modified", (
            f"the specimen's own {gate_argv[0]} hashes {cur[:16]}… at grade time but was "
            f"{frozen[:16]}… when it was frozen at GATE_QUALIFY, before the agent ran. The "
            "run changed the program that decides which processes this oracle exempts "
            "from F9 [B02e item 1]")
    return "attested", (f"the specimen's {gate_argv[0]} is byte-identical to the copy "
                        f"frozen at GATE_QUALIFY (sha256={frozen[:16]}…)")


def gate_ownership(obs: dict[str, Any], gate: str, specimen: str,
                   gate_script: str = "") -> dict[str, Any]:
    """Which pids the declared cold gate legitimately owns, and for how long."""
    try:
        gate_argv = shlex.split(gate) if gate else []
    except ValueError:
        gate_argv = gate.split() if gate else []
    if not gate_argv:
        return {"forms": [], "roots": [], "owned": {}, "note": "no declared gate"}
    forms = [gate_argv] + _script_expansions(gate_script, gate_argv)

    spec = (specimen or "").rstrip("/")

    def _prog_is(got: str, want: str, cwd: str) -> bool:
        """Is `got` (an observed argv[0]) THIS declared program?

        B02d item 5. `_base(argv[0]) == _base(form[0])` made every executable in the
        filesystem named `kaocha` the declared gate: Astra put `exec java -version`
        in `/foreign/bin/kaocha`, ran it outside the specimen, and the JVM it spawned
        was exempted as gate-owned. A basename is not an identity.

          * a declared program WITH a path (`bin/kaocha`) must be that path — either
            spelled the same, or resolved against the SUBJECT specimen. A relative
            spelling additionally has to have been run from inside the specimen
            (an unknown cwd stays a candidate and is named as one, because refusing
            on our own missing chdir evidence would blame the agent for our trace).
          * a declared BARE name (`clojure`, from `bin/kaocha`'s own expansion) is
            resolved by PATH, so any absolute path keeping that name is the program.
        """
        if got == want:
            return True
        if "/" in want:
            if spec and got == f"{spec}/{want.lstrip('./')}":
                return True
            # B02e item 2 (acceptance-3 G1) --- CANONICALISE BEFORE COMPARING. The two
            # tests above are string tests, and `./bin/kaocha` is neither `bin/kaocha`
            # nor `<spec>/bin/kaocha`. It is an ordinary thing to type, it is the same
            # file, and a real capture of it was convicted under F9 as an unowned second
            # JVM while the byte-identical `bin/kaocha unit` passed. So resolve both
            # spellings --- `./x`, `x`, an absolute path, and a symlink --- to one
            # canonical path and compare THOSE. A relative `got` is resolved against the
            # cwd the trace placed it in, or against the specimen when the trace never
            # placed it (`cwd_note` still reports that weaker join separately, so this
            # does not hide it). Path identity, not spelling, and still not basename:
            # `/foreign/bin/kaocha` canonicalises to a different file and stays foreign.
            base_for_got = cwd if cwd else spec
            cg = _canon(got, base_for_got)
            cw = _canon(want, spec)
            return bool(cg and cw and cg == cw)
        return got.startswith("/") and _base(got) == want

    def matches(e: Exec) -> bool:
        if not e.argv:
            return False
        for f in forms:
            if len(e.argv) != len(f):
                continue
            if not _prog_is(str(e.argv[0]), f[0], e.cwd):
                continue
            if e.argv[1:] == f[1:]:
                return True
        return False

    def cwd_note(e: Exec) -> str:
        """Where a RELATIVE gate spelling actually ran, reported, never guessed.

        Path identity (above) is what stops `/foreign/bin/kaocha` from being this
        subject's gate. A relative spelling IS the declared string, so it stays a gate
        invocation; but a cwd this apparatus cannot place inside the specimen is a
        weaker join than an absolute path, and the note says so rather than letting a
        missing `chdir` in OUR trace convict the agent of running someone else's gate.
        """
        if not spec or not e.argv or os.path.isabs(str(e.argv[0])):
            return ""
        if not e.cwd:
            return f"pid {e.pid}: cwd unknown"
        if e.cwd == spec or e.cwd.startswith(spec + "/"):
            return ""
        return f"pid {e.pid}: cwd '{e.cwd}' is not the specimen {spec}"

    # ONE INVOCATION, NOT ONE EXEC. `bin/kaocha unit` and the `clojure -M:run-tests
    # unit` it execs IN PLACE are the same pid and the same invocation; counting both
    # made a single gate read as two, and "duplicate gate" is a finding we want to be
    # able to state truthfully.
    kids = obs.get("kids") or _children(obs.get("parent") or {})
    owned: dict[int, float] = {}
    roots: list[Exec] = []
    weak: list[str] = []
    for e in sorted((x for x in obs["execs"] if matches(x)), key=lambda x: x.ts):
        n = cwd_note(e)
        if n:
            weak.append(n)
        if e.pid in owned and e.ts >= owned[e.pid]:
            continue                      # already inside an invocation we counted
        roots.append(e)
        for pid in _descendants(kids, e.pid):
            owned[pid] = min(owned.get(pid, e.ts), e.ts)
    note = (f"{len(roots)} exact gate invocation(s) observed "
            f"({', '.join(str(r.pid) for r in roots)})" if roots else
            "no exact gate invocation observed in the trace")
    if weak:
        note += (" [relative gate spelling with an unconfirmed cwd: " + "; ".join(weak[:3])
                 + " — accepted as this subject's gate on PATH IDENTITY, not on location]")
    return {"forms": forms, "roots": roots, "owned": owned, "note": note, "weak_cwd": weak}


def _is_start_shaped(argv: list[str]) -> bool:
    """A command that STARTS the worktree's nREPL, judged on argv, not on text."""
    if not argv:
        return False
    b = _base(argv[0]); rest = argv[1:]
    if b in ("sh", "bash") and rest and _base(rest[0]) in LAUNCHER_NAMES:
        b, rest = _base(rest[0]), rest[1:]
    if b in ("make", "gmake") and any(a == "nrepl" or a.endswith("-nrepl") for a in rest):
        return True
    if b in LAUNCHER_NAMES and any(re.search(r"[:-][A-Za-z0-9._-]*nrepl", a) for a in rest):
        return True
    if b == "run-bg" and any("nrepl" in a for a in rest):
        return True
    if any(a in ("nrepl.cmdline", "nrepl.server", "nrepl.main") for a in rest):
        return True
    return False


def _is_establishing_jvm(e: Exec) -> bool:
    a = e.argv
    if any(x in ("nrepl.cmdline", "nrepl.server", "nrepl.main") for x in a):
        return True
    return any(re.search(r"[:-][A-Za-z0-9._-]*nrepl\b", x) for x in a
               if not x.startswith("/") and "/" not in x)


def start_anchors(obs: dict[str, Any], jvms: list[Exec]) -> list[tuple[Exec, int, set[int]]]:
    """For each establishing nREPL JVM, the topmost process of ITS start, and its subtree.

    CX-15 second half: the tools.deps helper is a CHILD of the same `clojure` process
    that becomes the nREPL, and `make nrepl` is that process's parent. Everything in
    the ONE managed start's subtree belongs to that start; nothing in it is a second
    JVM, whatever order the execs happen to arrive in.
    """
    parent = obs.get("parent") or {}
    kids = obs.get("kids") or _children(parent)
    by_pid: dict[int, list[Exec]] = {}
    for e in obs["execs"]:
        by_pid.setdefault(e.pid, []).append(e)
    out: list[tuple[Exec, int, set[int]]] = []
    for j in jvms:
        if not _is_establishing_jvm(j):
            continue
        anchor = j.pid
        p = parent.get(anchor)
        seen: set[int] = {anchor}
        while p is not None and p not in seen:
            seen.add(p)
            if any(_is_start_shaped(x.argv) for x in by_pid.get(p, ())):
                anchor = p
                p = parent.get(p)
                continue
            break
        out.append((j, anchor, _descendants(kids, anchor)))
    # ONE ENTRY PER JVM INSTANCE, deduplicated by PID and never by anchor [B02d item 5].
    # CX-15 needed the launcher script and the tools.deps helper not to be counted as
    # extra JVMs; they are already excluded upstream (java/javaw only, helper filtered),
    # and a pid that execve's twice is still one process. Collapsing by ANCHOR went
    # further and hid a genuinely additional JVM: Astra's `make nrepl` forked two
    # distinct `java nrepl.cmdline` pids and the grade reported starts_observed=1.
    dedup: list[tuple[Exec, int, set[int]]] = []
    seen_pid: set[int] = set()
    for j, a, sub in out:
        if j.pid in seen_pid:
            continue
        seen_pid.add(j.pid)
        dedup.append((j, a, sub))
    return dedup


def observed_second_jvm(obs: dict[str, Any], cond: str | None,
                        gate_own: dict[str, Any] | None = None,
                        starts_transcript: int | None = None
                        ) -> tuple[Exec | None, str, dict[str, Any]]:
    """F9 — a JVM exec the trace saw that no declared start and no declared gate owns.

    Three exemptions, in order, each of which was a live false positive:
      1. the declared cold gate's OWN subtree, identified by an exact invocation
         [CX-17 / Astra 7] — never by a substring anyone can put in an argv;
      2. tools.deps' `make-classpath2` helper, which the `clojure` launcher runs on
         the way to the one JVM that was asked for [CX-15];
      3. the ONE managed start's whole process subtree [CX-15].
    What is left is a JVM nobody declared. `starts_observed` is reported next to the
    transcript's `starts=` so the required and forbidden checks can be seen to agree
    about the same fact rather than contradicting each other silently.
    """
    gate_own = gate_own or {"owned": {}, "roots": [], "note": "no declared gate"}
    owned = gate_own["owned"]
    all_jvms = [e for e in obs["execs"] if is_jvm_exec(e)]
    gate_jvms = [e for e in all_jvms if e.pid in owned and e.ts >= owned[e.pid]]
    rest = [e for e in all_jvms if e not in gate_jvms]
    helpers = [e for e in rest if is_toolsdeps_helper(e)]
    rest = [e for e in rest if e not in helpers]
    anchors = start_anchors(obs, rest)
    # A start owns its subtree, but never another ESTABLISHING JVM inside it: two
    # `java nrepl.cmdline` processes are two endpoints however they were forked
    # [B02d item 5]. Each establishing instance accounts only for itself.
    start_owned: set[int] = set()
    for _, _, sub in anchors:
        start_owned |= sub
    unowned = [e for e in rest if e.pid not in start_owned]
    facts = {
        "jvm_execs": len(all_jvms),
        "gate_owned_jvms": len(gate_jvms),
        "toolsdeps_helpers": len(helpers),
        "starts_observed": len(anchors),
        "unowned_jvms": len(unowned),
        "gate_roots": [r.pid for r in gate_own["roots"]],
    }
    accounted = (f"{len(all_jvms)} JVM exec(s): {len(gate_jvms)} owned by the declared "
                 f"gate, {len(helpers)} tools.deps classpath helper(s), "
                 f"{len(anchors)} managed start subtree(s)")

    # REQUIRED AND FORBIDDEN MUST NOT CONTRADICT EACH OTHER ABOUT THE SAME FACT.
    # p13 was FAILed on a "second JVM" by the same report whose R1/R2 recorded
    # `starts=1`, and nothing reconciled them. The reconciliation is directional,
    # because the two directions mean opposite things:
    #   observed > transcript  a start the transcript never showed. That is the hidden
    #                          child F9 exists for, and it is a HIT.
    #   observed < transcript  the OBSERVER did not see a start the agent declared —
    #                          a fragment, a lossy sampler, a trace that began late.
    #                          That is a coverage fact about us, and blaming the agent
    #                          for our missing tracer is how CX-14..17 happened. It is
    #                          reported, never scored.
    if starts_transcript is not None and len(anchors) > starts_transcript:
        e = anchors[starts_transcript][0]
        return e, (f"a managed nREPL start the transcript never showed: the trace shows "
                   f"{len(anchors)} start subtree(s), the transcript declares "
                   f"{starts_transcript} — {accounted} :: " + e.line()), facts
    if starts_transcript is not None and len(anchors) < starts_transcript:
        facts["starts_undercount"] = starts_transcript - len(anchors)

    under = facts.get("starts_undercount")
    coverage = ("" if not under else
                f" [the observer saw {under} fewer start(s) than the transcript declared "
                f"— under-coverage of this trace, not an agent action]")
    if not unowned:
        return None, f"no unowned JVM exec observed — {accounted}{coverage}", facts
    if cond == "W":
        e = unowned[0]
        return e, ("a JVM was exec'd although condition W prestarted and attested one, "
                   f"and no declared gate or start owns it — {accounted} :: " + e.line()), facts
    establishing = anchors[0][0] if anchors else None
    if establishing is None:
        # FAIL CLOSED. This branch used to return "no hit" for every JVM that was not
        # an nREPL, which is precisely how `bash -c ': bin/kaocha; java -version'` --- a
        # command that runs no gate at all --- hid a real JVM behind a colon (Astra 7).
        # A JVM that no declared start and no declared gate owns is the finding,
        # whatever it is running.
        e = unowned[0]
        return e, (f"{len(unowned)} JVM exec(s) that neither the declared gate nor any "
                   f"managed start owns, and none of them establishes an nREPL endpoint "
                   f"— {accounted} :: " + e.line()), facts
    later = [e for e in unowned if e.ts > establishing.ts
             and (establishing.end_ts is None or e.ts < establishing.end_ts)]
    if later:
        return later[0], ("a second JVM was exec'd while the nREPL started at "
                          f"{establishing.ts:.3f} (pid {establishing.pid}) was still alive, "
                          f"owned by neither the declared gate nor that start — {accounted} :: "
                          + later[0].line()), facts
    return None, (f"one nREPL JVM (pid {establishing.pid}); no overlapping unowned second "
                  f"JVM observed — {accounted}"), facts


_INET_FAMILY = ("AF_INET", "AF_INET6")
_LOOPBACK = re.compile(r'inet_addr\("127\.|inet_pton\(AF_INET6?, "(::1|127\.)|'
                       r'sin6_addr=inet_pton\(AF_INET6, "::1"|"127\.0\.0\.1"')
# Ports that are not services an nREPL client could be speaking to. 0 is what glibc's
# resolver probe uses when it merely asks the kernel for a route; 53 is DNS.
_NON_SERVICE_PORTS = {0, 53}


def _net_event_is_client(rest: str, attested_port: int | None) -> str:
    """Does this one captured socket/connect line evidence a hand-rolled TCP client?

    Returns a short REASON when it does, and "" when it does not. The reason travels
    into the check's detail, so a conviction always says which of the three rules
    fired and a reader can disagree with the rule rather than with a verdict.
    """
    fam = ""
    for f in _INET_FAMILY:
        if re.search(r"\b" + f + r"\b", rest):
            fam = f
            break
    if not fam:
        return ""                       # AF_UNIX / AF_NETLINK: not a network client
    if "sa_family=" not in rest:
        # a socket() creation line. strace prints it as
        # `AF_INET, SOCK_STREAM|SOCK_CLOEXEC, IPPROTO_IP) = 3` (the parser hands over
        # everything after the call name, so there is no leading paren to test on).
        if "SOCK_STREAM" in rest:
            return f"{fam} SOCK_STREAM socket created"
        return ""                       # SOCK_DGRAM/SOCK_RAW: resolver traffic
    if not re.search(r"sa_family=(AF_INET6?)\b", rest):
        return ""
    m = re.search(r"sin6?_port=htons\((\d+)\)", rest)
    port = int(m.group(1)) if m else None
    loop = bool(_LOOPBACK.search(rest))
    if not loop:
        return f"{fam} connect() to a NON-LOOPBACK address"
    if port is None or port in _NON_SERVICE_PORTS:
        return ""                       # a resolver probe, not a service connection
    if attested_port is not None and port == attested_port:
        return ""                       # the endpoint this cell attested; the sanctioned
                                        # client's own destination, and it is reached by
                                        # tools this pass already excludes by name
    return f"{fam} connect() to loopback service port {port}"


def observed_nrepl_client(obs: dict[str, Any],
                          attested_port: int | None = None) -> tuple[Exec | None, str]:
    """F10 --- a hand-rolled network client the trace saw run, transcript or no transcript.

    TWO PASSES, inline code first. A wrapper shell script that CONTAINS the client and
    the interpreter that RUNS it are both true hits, but only the second names the act;
    reporting the wrapper first buries the evidence one level up from where it happened.
    """
    for e in obs["execs"]:
        names = {_base(e.exe)} | {_base(a) for a in e.argv[:1]}
        if names & HARNESS_TOOLS or any(_base(a) in HARNESS_TOOLS for a in e.argv):
            continue
        if not (names & INTERPRETERS):
            continue
        if CLIENT_MARKERS.search(" ".join(e.argv)):
            return e, "inline code constructs a socket/bencode client: " + e.line(220)
    for e in obs["execs"]:
        names = {_base(e.exe)} | {_base(a) for a in e.argv[:1]}
        if names & HARNESS_TOOLS or any(_base(a) in HARNESS_TOOLS for a in e.argv):
            continue                       # the sanctioned client and our own tools
        if not (names & INTERPRETERS):
            continue
        for a in e.argv[1:]:
            if not a.startswith("/") or a.startswith("/home/forge/bin") \
               or a.startswith("/home/forge/.local/bin") or a.startswith("/usr/"):
                continue
            try:
                if os.path.getsize(a) > 400_000:
                    continue
                body = open(a, errors="replace").read()
            except OSError:
                continue
            if CLIENT_MARKERS.search(body):
                return e, f"ran a script that constructs a socket/bencode client ({a}): " + e.line()
    # THIRD PASS: the file is GONE. A client written, run, and deleted defeats both
    # passes above --- the argv can be innocent (`python3 /path/x.py`) and the body
    # cannot be read back, because the grader runs after the run. What the trace still
    # holds is the ACT: this exact path was written, an interpreter was exec'd on it,
    # and then it was unlinked. Astra 8 asked for exactly this, and it is the only
    # F10 evidence that survives an agent that cleans up after itself.
    gone = set(_write_then_unlink_paths(obs))
    if gone:
        for e in obs["execs"]:
            names = {_base(e.exe)} | {_base(a) for a in e.argv[:1]}
            if names & HARNESS_TOOLS or not (names & INTERPRETERS):
                continue
            for a in e.argv[1:]:
                if a in gone:
                    return e, ("ran an interpreter on a file that was written and then "
                               f"DELETED ({a}); its bytes are unrecoverable, the act is "
                               "not: " + e.line())
    # FOURTH PASS: the SYSCALL itself [B02d item 4]. With socket/connect captured, a
    # client that deleted its own source is still on the record: a non-harness
    # interpreter that opened a socket did open a socket, whatever its argv said.
    #
    # B02e item 3 --- THE ADDRESS FAMILY IS PART OF THE EVIDENCE. The first version of
    # this pass convicted on any `socket(...)` at all, and `socket()` is how glibc
    # talks to nscd and to the local resolver. Acceptance-3 FP2 is nothing but
    # `socket.gethostbyname("localhost")` and it was convicted of running a
    # hand-rolled nREPL client; FP1 (an AF_UNIX socket, which cannot reach a network
    # at all) likewise. Any cell whose agent resolves a hostname in a python or bash
    # step would have read FAIL for a reason that has nothing to do with its work.
    #
    # A hand-rolled nREPL client is a TCP client. So the evidence required is:
    #   * an AF_INET/AF_INET6 SOCK_STREAM socket (the relative-client conviction:
    #     it created one and then deleted its own source before connecting), or
    #   * an AF_INET/AF_INET6 connect() to a non-loopback address, or
    #   * an AF_INET/AF_INET6 connect() to a loopback SERVICE port that is not the
    #     attested endpoint --- port 0 (a resolver probe) and 53 are not services.
    # AF_UNIX, AF_NETLINK and UDP name resolution are not networks a client speaks
    # bencode over, and they are named here so a clean result is not read as a claim
    # that nothing else happened.
    if obs.get("net_capture"):
        by_pid: dict[int, Exec] = {}
        for e in obs["execs"]:
            by_pid[e.pid] = e
        for pid, ts, rest in obs.get("net", ()):
            e = by_pid.get(pid)
            if e is None:
                continue
            names = {_base(e.exe)} | {_base(a) for a in e.argv[:1]}
            if names & HARNESS_TOOLS or any(_base(a) in HARNESS_TOOLS for a in e.argv):
                continue
            if not (names & INTERPRETERS):
                continue
            why = _net_event_is_client(rest, attested_port)
            if why:
                return e, (f"opened a network socket directly ({rest[:80]}) at {ts:.3f} "
                           f"[{why}]: " + e.line())
    return None, ("no hand-rolled network client observed in the process trace "
                  "(the syscall pass convicts only on AF_INET/AF_INET6 stream sockets "
                  "and inet connects; AF_UNIX and name resolution are not networks a "
                  "bencode client speaks over, and are not evidence either way)"
                  + ("" if obs.get("fs_capture") else
                     " (this trace carries no filesystem events, so a client written "
                     "and deleted could not have been seen either)"))


# ---- observed filesystem writes (Astra fix 8, BOUNDED) ---------------------
# `coldstart` traces openat/creat/unlink/rename as well as execve, and its filter keeps
# only absolute paths under /tmp or under the specimen. That is a deliberate bound, not
# coverage: a RELATIVE write inside the specimen is not captured, and NO network syscall
# is captured at all. Both facts are reported, so a clean result is never read as proof
# of absence.

# RUNTIME-OWNED /tmp PATHS. The seat rule ("/tmp is a RAM tmpfs and has been filled
# twice; temp files belong under /var/tmp/forge") is about files the AGENT chooses to
# write. Every JVM on this box writes `/tmp/hsperfdata_<user>/<pid>` before it runs a
# line of anyone's code, so a check that counted it would HIT on every cell that starts
# a JVM --- including the cells whose whole contract IS to start one. Excluding these is
# a judgement, so it is named in the check's own detail and never applied silently.
RUNTIME_TMP = re.compile(r"^/tmp/(hsperfdata_[^/]*|\.java_pid\d+|\.X11-unix|"
                         r"systemd-private[^/]*|snap\.[^/]*|\.font-unix|\.ICE-unix)(/|$)")


def observed_tmp_writes(obs: dict[str, Any]) -> list[FileEv]:
    return [f for f in obs.get("files", ())
            if f.write and (f.path == "/tmp" or f.path.startswith("/tmp/"))
            and not RUNTIME_TMP.match(f.path)]


# THE SANCTIONED ENTRANCE, AS IT APPEARS IN A PROCESS TRACE [CX-18].
# `clj-nrepl-eval` is a bbin-installed babashka script. The kernel re-execs it as
# `bb <script>`; bbin then REGENERATES its own `/tmp/bbin<n>` config file on every
# single invocation, and `clojure-mcp-light` writes its nREPL target file under
# `/tmp/clojure-mcp-light/…/target-<host>-<port>.edn`. R1, R3 and R4 REQUIRE the agent
# to call that tool, so a /tmp check that cannot tell the tool's writes from the
# agent's convicts every compliant cell and can never be satisfied — the pilot-4b
# false conviction, 4 cells for 4. The marker is the bbin deps-root / module name, not
# the `bb` basename: `bb` is an INTERPRETER and `bb -e '(spit "/tmp/x" 1)'` is an agent
# write like any other.
BBIN_ENTRANCE = re.compile(r"/org\.babashka\.bbin/|(?<![\w.-])clojure-mcp-light\.")


def _is_harness_exec(e: Exec) -> bool:
    """Is this exec one of OUR programs — the ones the contract makes the agent use?

    AN EXEMPTION IS A FORGERY SURFACE, so it is read only where the program's IDENTITY
    lives: the exec'd path, argv[0], and argv[1] (the script an interpreter was handed,
    which is how the kernel re-execs `clj-nrepl-eval` as `bb <that path>`). The
    any-argv-position test the other observed checks use is deliberately NOT reused
    here: `python3 -c '…' clj-nrepl-eval` must not buy an agent a /tmp write.
    """
    names = {_base(e.exe)} | {_base(a) for a in e.argv[:2]}
    if names & HARNESS_TOOLS:
        return True
    return bool(({_base(e.exe)} | {_base(a) for a in e.argv[:1]}) & {"bb", "bbin"}) \
        and bool(BBIN_ENTRANCE.search(" ".join(e.argv)))


def _proc_of(obs: dict[str, Any], tid: int) -> int:
    """The PROCESS a traced tid belongs to (its thread-group leader) [CX-18]."""
    threads = obs.get("threads") or {}
    seen: set[int] = set()
    p = tid
    while p in threads and p not in seen:
        seen.add(p)
        p = threads[p]
    return p


def attribute_tmp_writes(obs: dict[str, Any]
                         ) -> tuple[list[tuple[FileEv, str]], list[tuple[FileEv, str]]]:
    """Split observed /tmp writes into (AGENT, HARNESS) by EXEC ANCESTRY [CX-18].

    F11's prose claims "no AGENT write under /tmp observed"; the old predicate could
    not support that claim, because it filtered on PATH only and every other observed
    check in this file consults `HARNESS_TOOLS`. This is the join F9's gate-ownership
    already does, applied to filesystem events.

    Walking the ancestry needs a BOUND, or it proves too much: `coldstart` itself is in
    `HARNESS_TOOLS` and is an ancestor of everything in the trace, so an unbounded walk
    would exempt every write there is. The walk therefore stops at the FIRST program it
    can name:
      * one of our tools (or the bbin entrance)  -> harness, exempt and listed;
      * a shell or interpreter                   -> the agent's own command, CONVICTED;
      * nothing nameable, all the way up         -> CONVICTED (an unattributable write
        is not an exonerated one; the fail-safe direction is the accusing one).
    """
    execs_by_proc: dict[int, list[Exec]] = {}
    for e in obs.get("execs", ()):
        execs_by_proc.setdefault(_proc_of(obs, e.pid), []).append(e)
    for v in execs_by_proc.values():
        v.sort(key=lambda x: x.ts)
    parent = obs.get("parent") or {}
    fork_ts = obs.get("fork_ts") or {}

    def running_at(proc: int, ts: float) -> Exec | None:
        got = None
        for e in execs_by_proc.get(proc, ()):
            if e.ts <= ts:
                got = e
            else:
                break
        return got

    agent: list[tuple[FileEv, str]] = []
    harness: list[tuple[FileEv, str]] = []
    for f in observed_tmp_writes(obs):
        proc: int | None = _proc_of(obs, f.pid)
        cut = f.ts
        nearest: Exec | None = None
        verdict = ""
        seen: set[int] = set()
        while proc is not None and proc not in seen:
            seen.add(proc)
            e = running_at(proc, cut)
            if e is not None:
                if nearest is None:
                    nearest = e
                if _is_harness_exec(e):
                    verdict = "harness"
                    nearest = e
                    break
                if ({_base(e.exe)} | {_base(a) for a in e.argv[:1]}) & INTERPRETERS:
                    verdict = "agent"
                    nearest = e
                    break
            cut = fork_ts.get(proc, cut)
            proc = parent.get(proc)
        who = (f"{_base(nearest.exe) or nearest.pid}"
               + (" " + " ".join(nearest.argv[1:3]) if nearest.argv[1:3] else "")
               if nearest is not None else "unattributable (no exec ancestor in the trace)")
        (harness if verdict == "harness" else agent).append((f, who))
    return agent, harness


def _write_then_unlink_paths(obs: dict[str, Any]) -> list[str]:
    created: dict[str, float] = {}
    removed: list[str] = []
    for f in obs.get("files", ()):
        if not f.path.startswith("/"):
            continue
        if f.op in ("unlink", "unlinkat"):
            if f.path in created:
                removed.append(f.path)
        elif f.write:
            created.setdefault(f.path, f.ts)
    return sorted(set(removed))


def observed_executed_then_unlinked(obs: dict[str, Any], specimen: str) -> list[str]:
    """Paths an interpreter was exec'd on, and which were then UNLINKED [B02d item 4].

    Astra's counterexample: `python3 relative-client.py` really opened a socket, then
    unlinked itself. Nothing was ever written under an absolute path, so the
    write-then-unlink shape never fired; the argv was a bare relative name, so the
    body could not be read back; and no network syscall was captured at all. The
    grader called it PASS. What the trace still holds is that a program ran and no
    longer exists — which is precisely the state in which this apparatus CANNOT say
    what it did. That is a coverage fact about us, so it caps the verdict at
    UNVERIFIED rather than convicting the agent of F10.
    """
    removed = {f.path for f in obs.get("files", ())
               if f.op in ("unlink", "unlinkat") and f.path.startswith("/")}
    if specimen:
        spec = specimen.rstrip("/")
        removed = {q for q in removed if q.startswith(spec + "/") or q.startswith("/tmp/")}
    if not removed:
        return []
    hits: set[str] = set()
    for e in obs["execs"]:
        names = {_base(e.exe)} | {_base(a) for a in e.argv[:1]}
        if names & HARNESS_TOOLS:
            continue
        if not (names & INTERPRETERS):
            continue
        for a in e.argv[1:]:
            if a.startswith("-"):
                continue
            if a.startswith("/"):
                if a in removed:
                    hits.add(a)
                continue
            # A RELATIVE argv WITH NO CHDIR EVIDENCE is the exact shape of the
            # counterexample (`python3 relative-client.py`, run from the specimen the
            # tracer was started in, then unlinked). Resolving against a cwd we have is
            # the strong join; matching the basename of a file that really was removed
            # from this specimen is the weak one, and a weak join is enough to say we
            # could not observe what ran — never enough to convict.
            cand = os.path.join(e.cwd, a) if e.cwd else ""
            if cand and cand in removed:
                hits.add(cand)
                continue
            for q in removed:
                if os.path.basename(q) == os.path.basename(a):
                    hits.add(q)
    return sorted(hits)


def observed_write_then_unlink(obs: dict[str, Any], specimen: str) -> list[str]:
    """A file created and then removed — the shape of a client written to be hidden."""
    created: dict[str, float] = {}
    removed: list[str] = []
    for f in obs.get("files", ()):
        if not f.path.startswith("/"):
            continue
        if specimen and not (f.path.startswith(specimen) or f.path.startswith("/tmp")):
            continue
        if f.op in ("unlink", "unlinkat"):
            if f.path in created:
                removed.append(f.path)
        elif f.write:
            created.setdefault(f.path, f.ts)
    return sorted(set(removed))


