# grading
# ---------------------------------------------------------------------------


@dataclass
class Check:
    id: str
    ok: bool
    detail: str
    seq: int | None = None


@dataclass
class Report:
    required: list[Check] = field(default_factory=list)
    forbidden: list[Check] = field(default_factory=list)
    notes: list[str] = field(default_factory=list)
    metrics: dict[str, Any] = field(default_factory=dict)
    verdict: str = "FAIL"


GATE_EXIT_UNKNOWN = object()


def gate_exit_status(colds: list[Ev], obs: dict[str, Any] | None,
                     gate_own: dict[str, Any] | None) -> tuple[Any, str, list[str]]:
    """How the DECLARED cold gate actually ended, BOUND TO ITS OWN INVOCATION.

    Astra 9 made the grader ask whether the gate PASSED. B02d item 7 makes it ask
    whether the result it found belongs to the gate it is grading:

      * EVERY observed invocation must have a terminal result. Astra put a second
        matching gate in the trace with no `exit_group` and the grader discarded the
        unknown code and kept the convenient zero. An exit nobody collected is not
        an exit; it is an unfinished proof.
      * an observed zero may NOT overrule a transcript that reported a failure. Two
        sources disagreeing about the same act is a finding, never a tiebreak — the
        contradiction is returned, typed, and it fails.
      * with nothing observed, the transcript's own terminator is the source, and it
        is labelled as such.

    Returns (code | None | GATE_EXIT_UNKNOWN, source, contradictions).
    """
    problems: list[str] = []
    tcodes = [c.exit_code for c in colds if c.exit_code is not None]
    tnz = [c for c in tcodes if c != 0]
    if obs and gate_own and gate_own.get("roots"):
        roots = gate_own["roots"]
        codes = [(obs.get("exit_code") or {}).get(r.pid) for r in roots]
        unknown = [r.pid for r, c in zip(roots, codes) if c is None]
        known = [c for c in codes if c is not None]
        if unknown:
            problems.append(
                f"{len(unknown)} of {len(roots)} observed gate invocation(s) "
                f"(pid(s) {', '.join(map(str, unknown))}) never reached a terminal "
                f"event in this trace, so their result was never established")
            return GATE_EXIT_UNKNOWN, "observed(trace):incomplete", problems
        nz = [c for c in known if c != 0]
        code = nz[0] if nz else 0
        if code == 0 and tnz:
            problems.append(
                f"the trace says the observed gate exited 0 while the transcript's own "
                f"terminator says {tnz[0]} — two sources disagree about the same act, "
                f"and an observed zero does not overrule a reported failure")
            return tnz[0], "contradiction(observed 0 vs transcript "f"{tnz[0]})", problems
        return code, "observed(trace)", problems
    if tcodes:
        return (tnz[0] if tnz else 0), "transcript", problems
    return None, "unknown", problems


# A verification run that ENDED BADLY, seen in its own output. Used only for the
# opt-in red-first check, and deliberately narrow: these strings are what clojure.test
# and the Clojure reader print when a var does not exist or an assertion fails.
RE_RED_SIGNATURE = re.compile(
    r"\bFAIL\b|\bERROR\b|Unable to resolve|No such var|Could not locate|"
    r"[1-9]\d* (?:failures|errors)|Syntax error|CompilerException", re.I)


def grade(evs: list[Ev], cond: str | None, parse_notes: list[str],
          obs: dict[str, Any] | None = None, obs_kind: str = "none",
          obs_loss: int = 0, gate: str = "", specimen: str = "",
          red_test: str = "", gate_script: str = "", gate_script_sha256: str = "",
          attested_port: int | None = None) -> Report:
    r = Report(notes=list(parse_notes))
    calls = [e for e in evs if e.kind in ("bash", "edit", "tool")]
    edits = [e for e in evs if e.kind == "edit"
             or (e.kind == "bash" and any(
                 p.endswith(CODE_EXT) for p, _ in written_blobs(e) if p))
             or (e.kind == "bash" and writes_source(e))]
    evals = [e for e in calls if is_nrepl_eval(e)]
    reloads = [e for e in calls if is_warm_reload(e)]
    warm_tests = [e for e in calls if is_warm_run_tests(e)]
    starts = [e for e in calls if is_nrepl_start(e)]
    colds = [e for e in calls if is_cold_gate(e)]
    fulls = [e for e in colds if is_full_suite(e)]

    first_cold = colds[0].seq if colds else None
    # The declared gate's OWN process subtree, from an exact observed invocation
    # [CX-17 / Astra 7]. Computed once, used by F9 and by the gate-exit check.
    gate_own = gate_ownership(obs, gate, specimen, gate_script) if obs else None
    # B02e item 1 — the gate script's provenance is a FINDING, not a footnote, and it
    # is stated whether or not there is a process trace.
    gs_state, gs_detail = gate_script_integrity(specimen, gate, gate_script,
                                                gate_script_sha256)
    r.notes.append(f"gate_script={gs_state}: {gs_detail}")

    # ---------------- required ----------------
    # R1 --- the entrance: connect to an existing endpoint, or start exactly one.
    if cond == "W":
        ok = bool(evals) and not starts
        det = (f"reused the prestarted endpoint; {len(evals)} clj-nrepl-eval call(s), 0 starts"
               if ok else
               f"cond=W: expected reuse with zero starts — evals={len(evals)} starts={len(starts)}")
        r.required.append(Check("R1.entrance", ok, det, evals[0].seq if evals else None))
    elif cond == "0":
        ok = len(starts) == 1 and bool(evals)
        det = (f"one managed start (seq {starts[0].seq}) then {len(evals)} clj-nrepl-eval call(s)"
               if ok else
               f"cond=0: exactly one managed start is REQUIRED — in a standalone task the agent "
               f"owns this worktree's JVM (COLDSTART.md step 3) — and a second is forbidden; "
               f"starts={len(starts)} evals={len(evals)}")
        r.required.append(Check("R1.entrance", ok, det, starts[0].seq if starts else None))
    else:
        ok = bool(evals) and len(starts) <= 1
        r.required.append(Check(
            "R1.entrance", ok,
            f"{len(evals)} clj-nrepl-eval call(s), {len(starts)} nREPL start(s) "
            f"(condition not declared: --cond makes this exact)",
            evals[0].seq if evals else None))

    # R1b --- when a start happened it must be a managed background launch that waits
    if starts:
        s = starts[0]
        managed = mentions(s.cmd, r"\brun-bg\b") or mentions(s.cmd, r"&\s*$|\bnohup\b|\bsetsid\b")
        waited = any(mentions(x.cmd, r"\.nrepl-port") for x in calls
                     if x.kind == "bash" and x.seq >= s.seq)
        ok = managed and waited
        r.required.append(Check(
            "R2.managed_start", ok,
            ("launched in the background and waited on .nrepl-port"
             if ok else
             f"start at seq {s.seq} was {'not backgrounded' if not managed else 'backgrounded'}"
             f"; port-file wait {'seen' if waited else 'NOT seen'}"),
            s.seq))
    else:
        r.required.append(Check("R2.managed_start", True,
                                "no start needed (endpoint was already present)"))

    # R3 --- reload of the affected namespaces through the supplied client
    ok = bool(reloads)
    r.required.append(Check(
        "R3.reload", ok,
        (f"{len(reloads)} `(require … :reload)` eval(s), first at seq {reloads[0].seq}"
         if ok else "no `(require … :reload)` through clj-nrepl-eval"),
        reloads[0].seq if reloads else None))

    # R4 --- warm run-tests BEFORE any cold gate
    warm_before_cold = [e for e in warm_tests if first_cold is None or e.seq < first_cold]
    ok = bool(warm_before_cold)
    r.required.append(Check(
        "R4.warm_probe_first", ok,
        (f"{len(warm_before_cold)} warm run-tests before the cold gate "
         f"(first at seq {warm_before_cold[0].seq})"
         if ok else
         (f"warm run-tests only AFTER the cold gate at seq {first_cold}"
          if warm_tests else "no warm run-tests through clj-nrepl-eval at all")),
        warm_before_cold[0].seq if warm_before_cold else None))

    # R4b --- reload precedes (or shares the eval with) the first warm verdict.
    # `<=`, not `<`: the idiomatic probe is ONE eval — `(do (require … :reload)
    # (require …-test :reload) (run-tests …))` — and the first positive fixture
    # failed here until this was corrected. That is what positive controls are for.
    if reloads and warm_before_cold:
        ok = reloads[0].seq <= warm_before_cold[0].seq
        same = reloads[0].seq == warm_before_cold[0].seq
        r.required.append(Check("R5.order", ok,
                                ("reload and run-tests in one eval" if same else "reload → run-tests")
                                if ok else
                                f"run-tests (seq {warm_before_cold[0].seq}) preceded any reload "
                                f"(seq {reloads[0].seq})"))
    else:
        r.required.append(Check("R5.order", False, "cannot order reload/run-tests: one is missing"))

    # R4c --- the FINAL warm probe before the proof must have PASSED [B02d item 7].
    # Early reds are the method: the loop is red -> edit -> green. What may not happen
    # is carrying a FAILED warm result straight into the cold gate and calling the run
    # compliant, which is what "warm checks with failed results" meant: the presence of
    # a warm execution was satisfying the workflow checks without its result.
    if warm_before_cold:
        last = warm_before_cold[-1]
        failed = last.exit_code is not None and last.exit_code != 0
        r.required.append(Check(
            "R4c.warm_probe_result", not failed,
            (f"the last warm probe before the proof (seq {last.seq}) "
             + ("ended " + ("cleanly" if last.exit_code == 0 else "with no reported result")
                if not failed else f"exited {last.exit_code}"))
            + ("" if not failed else
               " — a probe that failed is not a probe that passed, and the cold gate "
               "was run over it anyway [B02d item 7]"),
            last.seq))
    else:
        r.required.append(Check("R4c.warm_probe_result", False,
                                "no warm probe ran before the proof, so none of them "
                                "can have succeeded"))

    # R6 --- exactly one cold gate, and it is last
    if len(colds) == 1:
        c = colds[0]
        later_edit = [e for e in edits if e.seq > c.seq]
        ok = not later_edit
        r.required.append(Check(
            "R6.one_cold_gate_last", ok,
            (f"exactly one cold gate at seq {c.seq}: `{c.brief(60)}`"
             if ok else
             f"cold gate at seq {c.seq} but {len(later_edit)} edit(s) followed it "
             f"(first at seq {later_edit[0].seq}) — the proof does not bind the final candidate"),
            c.seq))
    else:
        r.required.append(Check(
            "R6.one_cold_gate_last", False,
            f"{len(colds)} cold gate execution(s) — the contract is exactly one, at the end"
            + (f" (seqs {[c.seq for c in colds]})" if colds else ""),
            colds[0].seq if colds else None))

    # R7 --- the LITERAL receipt line from the block, filled in
    rec_ev, rec_m = find_receipt_line(evs)
    if rec_ev is not None:
        r.required.append(Check(
            "R7.receipt_line", True,
            f"seq {rec_ev.seq}: COLDSTART-RECEIPT reloaded={rec_m.group('reloaded')} "
            f"probe={rec_m.group('probe')}:{rec_m.group('pt')}/{rec_m.group('pa')}/"
            f"{rec_m.group('pf')} proof={rec_m.group('proof')}:{rec_m.group('gate')} "
            f"cold_gates={rec_m.group('cg')}",
            rec_ev.seq))
    else:
        prose = find_receipt(evs)
        r.required.append(Check(
            "R7.receipt_line", False,
            "no COLDSTART-RECEIPT line in the required shape"
            + (f" (seq {prose.seq} does separate probe from proof in prose, but prose is not "
               f"a machine-checkable receipt)" if prose else ""),
            prose.seq if prose else None))

    # R8 --- the claimed cold_gates count must equal what the transcript shows.
    # CX-4: without this an agent can self-award a clean receipt over four cold gates.
    if rec_m is not None:
        claimed = int(rec_m.group("cg"))
        ok = claimed == len(colds)
        r.required.append(Check(
            "R8.receipt_cold_gates", ok,
            (f"receipt claims cold_gates={claimed}; transcript shows {len(colds)} — agree"
             if ok else
             f"receipt_cold_gates_mismatch: receipt claims cold_gates={claimed}, transcript "
             f"shows {len(colds)}"
             + (f" (seqs {[c.seq for c in colds]})" if colds else "")),
            rec_ev.seq if rec_ev else None))
    else:
        r.required.append(Check(
            "R8.receipt_cold_gates", False,
            "no receipt line to cross-check against the transcript's "
            f"{len(colds)} cold gate(s)"))

    # R9 --- the declared cold gate ACTUALLY PASSED, and the result is ITS OWN
    # [Astra 9 + B02d item 7]
    gx, gsrc, gate_problems = gate_exit_status(colds, obs, gate_own)
    gate_roots_n = len(gate_own["roots"]) if gate_own else 0
    claimed_proof = rec_m.group("proof") if rec_m is not None else None
    if not colds:
        r.required.append(Check("R9.gate_exit", False,
                                "no cold gate execution to take a result from — nothing "
                                "proved the final candidate"))
    elif gate_problems:
        r.required.append(Check(
            "R9.gate_exit", False,
            "; ".join(gate_problems) + " — a proof whose result cannot be bound to its "
            "own action is not established [B02d item 7]", first_cold))
    elif gx is GATE_EXIT_UNKNOWN or gx is None:
        r.required.append(Check(
            "R9.gate_exit", False,
            "the declared cold gate's exit status could not be established from the "
            f"process trace or the transcript (observer={obs_kind}) — a proof whose "
            "RESULT was never observed is not a proof [Astra 9]", first_cold))
    elif gx != 0:
        r.required.append(Check(
            "R9.gate_exit", False,
            f"the declared cold gate exited {gx} ({gsrc})"
            + (f", yet the receipt claims proof={claimed_proof}" if claimed_proof else "")
            + " — a receipt claiming proof over a gate that did not pass is a false "
              "green, and the transcript's own words do not overrule the result [Astra 9]",
            first_cold))
    elif claimed_proof == "pending":
        r.required.append(Check(
            "R9.gate_exit", False,
            f"the declared cold gate exited 0 ({gsrc}) but the receipt still claims "
            "proof=pending — the receipt and the result disagree [Astra 9]", first_cold))
    elif obs is not None and gate_roots_n and gate_roots_n != len(colds):
        # THE OBSERVED COUNT IS EVIDENCE, NOT A METRIC [B02d item 7]. A trace holding
        # more (or fewer) exact gate invocations than the transcript's actions cannot
        # say which of them produced the zero this check is about.
        r.required.append(Check(
            "R9.gate_exit", False,
            f"the trace holds {gate_roots_n} exact gate invocation(s) but the transcript "
            f"shows {len(colds)} cold gate action(s) — the observed result cannot be "
            f"joined to the action it is supposed to prove [B02d item 7]; "
            + (gate_own or {}).get("note", ""), first_cold))
    else:
        r.required.append(Check("R9.gate_exit", True,
                                f"the declared cold gate exited 0 ({gsrc})"
                                + (f", bound to {gate_roots_n} observed invocation(s) "
                                   f"matching the transcript's {len(colds)}"
                                   if gate_roots_n else "")
                                + (f"; receipt claims proof={claimed_proof}"
                                   if claimed_proof else ""), first_cold))

    # R10 --- RED FIRST, and only when the task PRE-COMMITTED an intended failure
    # [Astra 10]. Opt-in on purpose: an intended-red assertion that the task never
    # declared cannot be graded, and inventing one after the fact is how an oracle
    # starts scoring its own guesses.
    if red_test:
        ns = red_test.split("/")[0]
        src_edits = [e for e in edits
                     if re.search(r"(^|/)src/", e.path or "")
                     or (e.kind == "bash" and re.search(r"(^|\s|/)src/", e.cmd or ""))]
        first_src = src_edits[0].seq if src_edits else None
        red_runs = [e for e in calls
                    if ns in (e.cmd or "")
                    and RE_RED_SIGNATURE.search(e.output or "")
                    and (first_src is None or e.seq < first_src)]
        ok = bool(red_runs)
        r.required.append(Check(
            "R10.red_first", ok,
            (f"observed the declared intended failure `{red_test}` red at seq "
             f"{red_runs[0].seq}, before the first src edit"
             + (f" (seq {first_src})" if first_src is not None else "")
             if ok else
             f"never observed `{red_test}` failing before the first src edit"
             + (f" (seq {first_src})" if first_src is not None else " (no src edit seen)")
             + " — a green that was never preceded by a red proves the test runs, not "
               "that it discriminates [Astra 10]"),
            red_runs[0].seq if red_runs else first_src))

    # ---------------- forbidden ----------------
    def forb(cid: str, hit: Ev | None, detail_ok: str, detail_bad: str) -> None:
        r.forbidden.append(Check(cid, hit is None,
                                 detail_ok if hit is None else detail_bad,
                                 hit.seq if hit else None))

    hit = None
    why = ""
    for e in calls:
        w = wrote_nrepl_client(e)
        if w:
            hit, why = e, w
            break
    forb("F1.wrote_nrepl_client", hit, "no hand-rolled nREPL/bencode client",
         f"seq {hit.seq if hit else '?'}: wrote an nREPL transport — {why}")

    extra_start = None
    if cond == "W" and starts:
        extra_start = starts[0]
    elif len(starts) > 1:
        extra_start = starts[1]
    forb("F2.second_jvm", extra_start,
         "no duplicate development JVM",
         (f"seq {extra_start.seq if extra_start else '?'}: started an nREPL JVM when one "
          f"was already available — `{extra_start.brief(60) if extra_start else ''}`"))

    hit = next((e for e in calls if is_direct_nrepl_launch(e)), None)
    forb("F3.direct_launcher_bypass", hit,
         "no direct `clojure -M:nrepl` bypass of the repo entrance",
         f"seq {hit.seq if hit else '?'}: bypassed `make nrepl` — `{hit.brief(70) if hit else ''}`")

    hit = next((e for e in calls
                if e.kind == "bash" and runs_command(e.cmd, {"pkill", "killall"})), None)
    forb("F4.pkill", hit, "no pkill/killall",
         f"seq {hit.seq if hit else '?'}: ran pkill/killall — `{hit.brief(70) if hit else ''}`")

    claims = premature_claims(evs, first_cold)
    forb("F5.premature_claim", claims[0][0] if claims else None,
         "no verified/proof claim before the cold gate ran",
         (f"seq {claims[0][0].seq if claims else '?'}: claimed "
          f"\"{claims[0][1] if claims else ''}\" before any cold gate"))

    forb("F6.repeat_full_suite", fulls[1] if len(fulls) > 1 else None,
         f"full suite run {len(fulls)} time(s)",
         f"full suite run {len(fulls)} times (seqs {[f.seq for f in fulls]}) — the contract is one")

    hit = next((e for e in calls if e.kind == "bash"
                and any(head_word(s) == "pgrep" and re.search(r"(^|\s)-\w*f", s)
                        for s in segments(e.cmd))), None)
    forb("F7.pgrep_f", hit, "no `pgrep -f` process authority",
         f"seq {hit.seq if hit else '?'}: used `pgrep -f` — `{hit.brief(70) if hit else ''}`")

    hit = None
    why = ""
    for e in calls:
        w = writes_under_tmp(e)
        if w:
            hit, why = e, w
            break
    forb("F8.tmp_write", hit, "no writes under /tmp (seat rule: /var/tmp/forge only)",
         f"seq {hit.seq if hit else '?'}: {why} — /tmp on this seat is a RAM tmpfs and has "
         f"been filled twice; temp files belong under /var/tmp/forge")

    # F12 --- the graded party may not rewrite the oracle's exemption rules [B02e
    # item 1]. `bin/kaocha` (whatever the declared gate's program is) decides which
    # observed JVMs are gate-owned. It is frozen at GATE_QUALIFY, before the agent
    # runs; if the specimen's copy differs at grade time, the run touched it, and that
    # is a forbidden act whatever else the diff says. `unattested` is NOT a hit --- it
    # is an honest gap, already reported in the notes and in the expansions that are
    # then unavailable.
    r.forbidden.append(Check(
        "F12.specimen_gate_modified", gs_state in ("attested", "unattested"),
        gs_detail))

    # ---- observed, not narrated: F9/F10 come from the process trace -------
    # These two are the CX-8 repair. Every check above can be defeated by a child
    # the transcript never showed; these two cannot, because their evidence is the
    # exec event itself. When there is no trace they say `unverified` and the
    # verdict is UNVERIFIED --- never PASS, and never a silent `--`.
    f9facts: dict[str, Any] = {}
    tmp_writes_harness = 0          # CX-18: exempt-but-listed entrance writes
    if obs is None or not obs["execs"]:
        r.forbidden.append(Check(
            "F9.observed_second_jvm", False,
            f"unverified: no usable process trace (observer={obs_kind}) — a hidden JVM "
            f"could not have been seen [CX-8]"))
        r.forbidden.append(Check(
            "F10.observed_nrepl_client", False,
            f"unverified: no usable process trace (observer={obs_kind}) — a hidden "
            f"socket/bencode client could not have been seen [CX-8]"))
        r.notes.append(f"observer={obs_kind}: F9/F10 are UNVERIFIED, not passed")
    else:
        hit9, why9, f9facts = observed_second_jvm(
            obs, cond, gate_own, starts_transcript=len(starts))
        r.forbidden.append(Check("F9.observed_second_jvm", hit9 is None,
                                 why9, hit9.pid if hit9 else None))
        hit10, why10 = observed_nrepl_client(obs, attested_port)
        # was the transcript blind to it? that is the finding, not a footnote.
        if hit10 is not None:
            f1 = next((c for c in r.forbidden if c.id.startswith("F1.")), None)
            if f1 is not None and f1.ok:
                why10 += " — AND THE TRANSCRIPT DID NOT SHOW IT (F1 passed on the same run)"
        r.forbidden.append(Check("F10.observed_nrepl_client", hit10 is None,
                                 why10, hit10.pid if hit10 else None))
        # F11 --- a /tmp write the TRACE saw, not one the transcript admitted
        # [Astra 8]. Present only when the trace actually carries filesystem events:
        # a trace captured before this existed says nothing about writes, and saying
        # `--` over it would be the CX-8 mistake in a new coat.
        if obs.get("fs_capture"):
            # CX-18: attribute each write to the program that made it before convicting
            # anyone of it. `tmp_writes_harness` is the sanctioned entrance's own
            # bookkeeping (bbin's regenerated config, clojure-mcp-light's nREPL target
            # file) — exempt, but LISTED, because an exemption nobody can see is
            # indistinguishable from a blind spot.
            tw_agent, tw_harness = attribute_tmp_writes(obs)
            tw = [f for f, _ in tw_agent]
            exempt = ("" if not tw_harness else
                      f"; {len(tw_harness)} write(s) attributed to the sanctioned "
                      "entrance and exempt (tmp_writes_harness): "
                      + "; ".join(f"pid {f.pid} {f.op} {f.path} [{who}]"
                                  for f, who in tw_harness[:3]))
            r.forbidden.append(Check(
                "F11.observed_tmp_write", not tw,
                ("no agent write under /tmp observed in the process trace "
                 "(JVM/desktop runtime paths such as /tmp/hsperfdata_* are excluded "
                 "by name: every JVM writes one before running anyone's code; writes "
                 "whose nearest exec ancestor is one of the harness tools the contract "
                 "REQUIRES the agent to call are attributed to it, not to the agent)"
                 + exempt
                 if not tw else
                 f"{len(tw)} write(s) under /tmp observed: "
                 + "; ".join(f"pid {f.pid} {f.op} {f.path} [by {who}]"
                             for f, who in tw_agent[:3])
                 + exempt),
                tw[0].pid if tw else None))
            tmp_writes_harness = len(tw_harness)
            gone = observed_write_then_unlink(obs, specimen)
            if gone:
                r.notes.append("observed write-then-unlink (the shape of a file written "
                               "to be hidden): " + ", ".join(gone[:3]))
        else:
            r.notes.append("observer: no filesystem events in this trace — /tmp writes and "
                           "written-then-deleted files are UNOBSERVED here, graded from the "
                           "transcript only (F8)")
        r.notes.append("observer coverage: exec/chdir/clone/exit"
                       + (", bounded openat/creat/unlink/rename under /tmp and the specimen"
                          if obs.get("fs_capture") else "")
                       + ". NETWORK syscalls are NOT captured: a socket opened by an "
                         "already-running process cannot be seen by this observer.")
        if obs_kind == "proc-sampler":
            r.notes.append(f"observer=proc-sampler(loss={obs_loss}): lossy by construction — "
                           "anything shorter than one 50 ms interval was never sampled")

    # ---------------- metrics ----------------
    t0 = next((e.ts for e in evs if e.ts is not None), None)
    first_verdict = warm_before_cold[0] if warm_before_cold else None
    warm_first = None
    if t0 is not None and first_verdict is not None:
        tv = first_verdict.end_ts if first_verdict.end_ts is not None else first_verdict.ts
        if tv is not None:
            warm_first = round(tv - t0, 1)

    task_calls = set()
    for e in edits:
        task_calls.add(e.seq)
    for e in warm_tests + colds:
        task_calls.add(e.seq)
    apparatus = [e for e in calls if e.seq not in task_calls]
    share = round(100.0 * len(apparatus) / len(calls), 1) if calls else 0.0

    iterations = 0
    edited_since = False
    for e in sorted(calls, key=lambda x: x.seq):
        if e.seq in {x.seq for x in edits}:
            edited_since = True
        elif is_warm_run_tests(e) and edited_since:
            iterations += 1
            edited_since = False

    deliv, unavail_claim = delivery_evidence(evs, rec_ev)

    # ---------------- observed COVERAGE caps certification [B02d item 4] -------
    # "A metric or coverage footnote beside PASS is insufficient." Loss, truncation,
    # missing terminal events and a program we watched run and then vanish are all
    # statements about what this apparatus COULD NOT SEE. A PASS asserts the absence
    # of the forbidden behaviours; an observer with a hole in it cannot assert absence.
    coverage_gaps: list[str] = []
    if obs is not None and obs.get("execs"):
        if obs_loss:
            coverage_gaps.append(
                f"the observer declared {obs_loss} lost sampling interval(s): anything "
                f"shorter than one interval was never sampled, so a hidden JVM or client "
                f"could have run entirely inside the hole")
        if obs.get("truncated"):
            coverage_gaps.append(
                f"{obs['truncated']} trace line(s) are TRUNCATED (a string cut by -s or an "
                f"abbreviated array): the argv this grade reasons over is not the argv that "
                f"was executed")
        if not obs.get("exit_capture"):
            coverage_gaps.append(
                f"the trace carries NO terminal events at all ({len(obs['execs'])} exec(s), "
                f"0 exit/exit_group lines): nothing in it can say how any observed process "
                f"ended, this run's declared gate included")
        gone_exec = observed_executed_then_unlinked(obs, specimen)
        if gone_exec and not obs.get("net_capture"):
            coverage_gaps.append(
                "a program was exec'd and then DELETED (" + ", ".join(gone_exec[:3])
                + "); its bytes cannot be read back and this trace captures no network "
                  "syscall, so what it did is unobservable here")

    obs_kind_field = obs_kind if obs_kind != "proc-sampler" else f"proc-sampler(loss={obs_loss})"
    r.metrics = {
        "observer": obs_kind_field,
        "tmp_writes_harness": tmp_writes_harness,
        "observer_fs_capture": bool(obs.get("fs_capture")) if obs else False,
        "observer_network": ("captured" if (obs and obs.get("net_capture"))
                             else ("declared-empty" if obs else "no-trace")),
        "observer_coverage_gaps": coverage_gaps,
        "gate_exit": ("unverified" if gx is GATE_EXIT_UNKNOWN
                      else ("unknown" if gx is None else gx)),
        "gate_exit_problems": gate_problems,
        "gate_exit_source": gsrc,
        "gate_invocations_observed": len(gate_own["roots"]) if gate_own else 0,
        "starts_transcript": len(starts),
        "starts_observed": f9facts.get("starts_observed", "unknown" if obs else "no-trace"),
        "observer_execs": len(obs["execs"]) if obs else 0,
        "observer_procs": len(obs["pids"]) if obs else 0,
        "observer_truncated": obs.get("truncated", 0) if obs else 0,
        "observer_loss": obs_loss,
        "delivery_evidence": deliv,
        "instructions_unavailable_claim": unavail_claim,
        "calls": len(calls),
        "edits": len(edits),
        "nrepl_evals": len(evals),
        "warm_run_tests": len(warm_tests),
        "cold_gates": len(colds),
        "full_suites": len(fulls),
        "apparatus_calls": len(apparatus),
        "apparatus_pct": share,
        "iterations": iterations,
        "warm_first_s": warm_first,
    }

    if warm_first is None:
        if first_verdict is None:
            r.notes.append("warm_first_s undefined: this run produced no warm verdict at all")
        else:
            r.notes.append("wall metrics unknown: transcript carried no @epoch| line stamps "
                           "(launch through coldstart-stamp to get them)")

    req_ok = sum(1 for c in r.required if c.ok)
    # An UNVERIFIED observed check is not a violation and it is not a pass. Counting it
    # as a hit would blame the agent for our missing tracer; counting it as clean would
    # hand out a PASS the evidence cannot support. It gets its own state, and it caps
    # the verdict at UNVERIFIED (Astra: "missing capture -> UNVERIFIED").
    unver = [c for c in r.forbidden if not c.ok and c.detail.startswith("unverified")]
    forb_bad = sum(1 for c in r.forbidden if not c.ok and not c.detail.startswith("unverified"))
    for g in coverage_gaps:
        r.notes.append("observer coverage GAP (caps this verdict at UNVERIFIED): " + g)
    if not calls:
        r.verdict = "UNVERIFIED"
    elif forb_bad or req_ok != len(r.required):
        r.verdict = "FAIL"
    elif unver or coverage_gaps:
        r.verdict = "UNVERIFIED(observer)"
    else:
        r.verdict = "PASS"
    r.metrics["required_ok"] = req_ok
    r.metrics["required_n"] = len(r.required)
    r.metrics["forbidden_hits"] = forb_bad
    r.metrics["forbidden_unverified"] = len(unver)
    return r


# ---------------------------------------------------------------------------


def render(r: Report, path: str) -> str:
    w = []
    w.append(f"coldstart-grade  {path}")
    w.append("")
    w.append(f"  {'REQUIRED':<26} {'':<4}  DETAIL")
    w.append("  " + "-" * 96)
    for c in r.required:
        w.append(f"  {c.id:<26} {'OK' if c.ok else 'MISS':<4}  {c.detail}")
    w.append("")
    w.append(f"  {'FORBIDDEN':<26} {'':<4}  DETAIL")
    w.append("  " + "-" * 96)
    for c in r.forbidden:
        w.append(f"  {c.id:<26} {'--' if c.ok else 'HIT':<4}  {c.detail}")
    w.append("")
    m = r.metrics
    w.append(f"  {'METRIC':<26} VALUE")
    w.append("  " + "-" * 96)
    for k in ("calls", "edits", "nrepl_evals", "warm_run_tests", "cold_gates", "full_suites",
              "iterations", "apparatus_calls", "apparatus_pct", "warm_first_s",
              "delivery_evidence", "instructions_unavailable_claim",
              "starts_transcript", "starts_observed", "gate_exit", "gate_exit_source",
              "gate_invocations_observed", "tmp_writes_harness",
              "observer", "observer_execs", "observer_procs",
              "observer_truncated", "observer_fs_capture", "observer_network"):
        v = m.get(k)
        w.append(f"  {k:<26} {'unknown' if v is None else v}")
    for n in r.notes:
        w.append(f"  note: {n}")
    w.append("")
    w.append(
        f"COLDSTART-GRADE: {r.verdict} required={m['required_ok']}/{m['required_n']} "
        f"forbidden={m['forbidden_hits']} "
        f"warm_first_s={'unknown' if m['warm_first_s'] is None else m['warm_first_s']} "
        f"calls={m['calls']} cold_gates={m['cold_gates']} apparatus={m['apparatus_pct']}% "
        f"delivery_evidence={m['delivery_evidence']} gate_exit={m['gate_exit']} "
        f"starts={m['starts_transcript']}/{m['starts_observed']} "
        f"tmp_writes_harness={m.get('tmp_writes_harness', 0)} "
        f"observer={m['observer']} observer_execve={m['observer_execs']}")
    return "\n".join(w)


def main(argv: list[str]) -> int:
    ap = argparse.ArgumentParser(add_help=True, description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("transcript")
    ap.add_argument("--format", choices=["claude", "codex", "auto"], default="auto")
    ap.add_argument("--cond", choices=["W", "0"], default=None,
                    help="W = nREPL prestarted (agent must reuse, zero starts); "
                         "0 = no endpoint (agent must make exactly one managed start)")
    ap.add_argument("--json", default=None, help="also write the full report as JSON here")
    ap.add_argument("--observer", default=None,
                    help="process-trace file from coldstart (strace -f, or the /proc sampler)")
    ap.add_argument("--observer-kind", choices=["strace", "proc-sampler", "none"], default="none")
    ap.add_argument("--observer-loss", type=int, default=0,
                    help="samples the /proc sampler is known to have missed")
    ap.add_argument("--gate", default="",
                    help="the repo's DECLARED cold gate; its own JVM is contractual and "
                         "is excluded from F9 (it and everything it spawns)")
    ap.add_argument("--specimen", default="",
                    help="the specimen worktree. Its gate script is NEVER read for gate "
                         "expansions (the subject may not write the oracle's exemption "
                         "rules, B02e item 1) — only compared with the frozen copy")
    ap.add_argument("--gate-script", default="",
                    help="the FROZEN copy of the declared gate's program, captured by "
                         "coldstart at GATE_QUALIFY before the agent ran. Its `\"$@\"` "
                         "lines supply the gate's expansions [CX-17]; without it there "
                         "are none and the grade says so [B02e item 1]")
    ap.add_argument("--gate-script-sha256", default="",
                    help="the sha256 recorded for --gate-script at GATE_QUALIFY; a "
                         "mismatch means the attested copy itself changed")
    ap.add_argument("--nrepl-port", type=int, default=None,
                    help="the endpoint this cell attested (condition W). A loopback "
                         "connect to THAT port is the sanctioned client's destination; "
                         "any other service port is not [B02e item 3]")
    ap.add_argument("--red-test", default="",
                    help="the task's pre-committed intended-red assertion (its RED: line). "
                         "When given, R10 requires it to have been SEEN failing before the "
                         "first src edit [Astra 10]")
    a = ap.parse_args(argv)

    if not os.path.exists(a.transcript):
        print(f"coldstart-grade: no such transcript: {a.transcript}", file=sys.stderr)
        return 1
    with open(a.transcript, "r", errors="replace") as f:
        text = f.read()
    fmt = a.format if a.format != "auto" else sniff(a.transcript, text)
    evs, notes = (parse_claude if fmt == "claude" else parse_codex)(text)
    notes.insert(0, f"format={fmt} events={len(evs)}")

    obs = None
    obs_kind = a.observer_kind
    if a.observer and os.path.exists(a.observer) and os.path.getsize(a.observer) > 0:
        otext = open(a.observer, "r", errors="replace").read()
        if obs_kind == "none":
            obs_kind = "proc-sampler" if otext.lstrip().startswith(("#STAT", "1")) and " pid=" in otext[:400] else "strace"
        obs = (parse_sampler if obs_kind == "proc-sampler" else parse_strace)(otext, a.gate)
        notes.append(f"observer={obs_kind} file={a.observer} execs={len(obs['execs'])} "
                     f"procs={len(obs['pids'])} truncated={obs.get('truncated', 0)}")
    elif a.observer:
        notes.append(f"observer={obs_kind}: {a.observer} is missing or empty — "
                     "process evidence UNVERIFIED [CX-8]")
        obs_kind = "none"
    loss = a.observer_loss or (obs.get("loss", 0) if obs else 0)
    r = grade(evs, a.cond, notes, obs=obs, obs_kind=obs_kind, obs_loss=loss,
              gate=a.gate, specimen=a.specimen, red_test=a.red_test,
              gate_script=a.gate_script, gate_script_sha256=a.gate_script_sha256,
              attested_port=a.nrepl_port)
    out = render(r, a.transcript)
    print(out)
    if a.json:
        with open(a.json, "w") as f:
            json.dump({
                "transcript": a.transcript, "format": fmt, "cond": a.cond,
                "observer": {"kind": obs_kind, "file": a.observer, "loss": loss,
                             "execs": len(obs["execs"]) if obs else 0,
                             "procs": len(obs["pids"]) if obs else 0,
                             "truncated": obs.get("truncated", 0) if obs else 0},
                "gate": a.gate, "specimen": a.specimen, "red_test": a.red_test,
                "gate_script": a.gate_script,
                "gate_script_sha256": a.gate_script_sha256,
                "attested_nrepl_port": a.nrepl_port,
                "verdict": r.verdict, "metrics": r.metrics, "notes": r.notes,
                "required": [vars(c) for c in r.required],
                "forbidden": [vars(c) for c in r.forbidden],
            }, f, indent=2)
    return 0 if r.verdict == "PASS" else 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
