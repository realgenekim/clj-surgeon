#!/usr/bin/env bash
# coldstart <name> --repo <path> --base <sha> --model <opus|sonnet|sol|astra>
#           --cond <W|0> --task <task.md> [--minutes 20]
#           [--selftest-tamper delivery]   apparatus self-test only: corrupt the inlined
#                                          block after installing it, so the delivery gate
#                                          can be shown refusing. Refuses before launch.
#           [--selftest-agent '<sh>']      apparatus self-test only: run <sh> in the
#                                          specimen INSTEAD of a model, through the real
#                                          launch/observe/wait/detach path. The fixture
#                                          for CX-14 needs an agent that leaves a
#                                          long-lived child behind, and only the real
#                                          path can witness that LAUNCH still ends when
#                                          the AGENT does. Loud in the receipt: no model
#                                          line, selftest_agent=yes, never a cohort cell.
#
# ONE cold-start acceptance session, end to end, with every gotcha this seat paid for
# baked in. Design of record: /var/tmp/forge/plan2/cellC/astra-coldstart.md (steps 5-8).
#
#   SPECIMEN  own worktree + the COLD START block INLINED into CLAUDE.md and AGENTS.md
#             (plus the .claude/skills symlink and the pointer line), committed clean,
#             the block's EXACT BYTES re-read back out of both files
#   GATE_QUAL the repo's DECLARED cold gate, run on the UNTOUCHED base before any agent
#             exists. A gate that is already red makes every later PASS/FAIL meaningless,
#             so it is qualified first and its wall is recorded.
#   CONDITION W = one attested prestarted nREPL / 0 = assert no endpoint exists
#   LAUNCH    a FRESH agent whose entire prompt is the task file (VERIFY/GATE stripped)
#   OBSERVE   every runner line stamped with a real receive time by coldstart-stamp, AND
#             the whole process tree traced (strace -f: execve/exit/chdir/clone), so a
#             child the transcript never showed is still on the record [CX-8]
#   GRADE     coldstart-grade — the action-log oracle
#   CHECK     the task's own VERIFY command, run COLD in the specimen, independently
#   RECEIPT   one ledger line; transcript, diff, grade and receipt frozen under the run dir
#
# RATCHETS BAKED IN (each one is a scar, not a preference):
#  * [[waiters-bind-to-pid-not-argv]] no `pgrep -f` anywhere; every scan is /proc + argv.
#  * never `pkill`. The ceiling kills the run's OWN process group (run-bg setsids, so the
#    printed pid IS the pgid) — an id we created, never a pattern.
#  * never wrap the runner in an outer `timeout`: timeout kills your WAIT, not the child.
#  * `</dev/null` on every subprocess; a codex/clojure that inherits a tty stdin hangs.
#  * temp under /var/tmp/forge, never /tmp (RAM tmpfs, filled twice).
#  * `date` here is uutils: no %3N. Take %N and cut.
#  * the CC suite APPENDS to the tracked 00SERVER-LOGS.txt — excluded from dirt checks.
#  * worktree-add, never `git worktree add`: create and TRUST are one step, or a folder
#    trust dialog reaches Gene's phone.
#  * the model is verified from the runner's OWN log, never from the flag we passed.
#    A flag is a request; the log is the receipt.
#  * DELIVERY is inlined, not pointed at, and recorded per run as installed/observed.
#    A cell whose instructions never arrived is UNVERIFIED(delivery), never a behavior
#    FAIL: pilot 1 scored two Codex cells FAIL for an apparatus defect (CX-1).
set -uo pipefail
. "$HOME/bin/seat-tmp-guard.sh" 2>/dev/null || true

ROOT=/var/tmp/forge/coldstart
SKILL=/home/forge/src/claude-skills-nrepl/clojure-fast-feedback
COLDBLOCK=$SKILL/COLDSTART.md   # CX-1: delivery is INLINING this file, not pointing at it
LEDGER=$ROOT/ledger.txt
POINTER='Clojure work: load the clojure-fast-feedback skill first; cold-start commands are at its top.'

usage() { sed -n '2,45p' "$0" >&2; exit 2; }
[ $# -ge 1 ] || usage
NAME=$1; shift
# the ORIGINAL argv, kept before any shift: this script re-execs a FROZEN copy of
# itself with exactly the arguments it was called with [B02d item 10].
COLD_ARGV=("$@")
case "$NAME" in -*|*/*) echo "coldstart: REFUSED bad-run-name '$NAME' — the run name is a directory under $ROOT, so it may not start with '-' or contain '/'" >&2; exit 2 ;; esac
REPO="" BASE="" MODEL="" COND="" TASK="" MINUTES=20 TAMPER=none SELFAGENT=""
while [ $# -gt 0 ]; do
  case "$1" in
    --repo) REPO=$(readlink -f "${2:?}"); shift 2 ;;
    --base) BASE=${2:?}; shift 2 ;;
    --model) MODEL=${2:?}; shift 2 ;;
    --cond) COND=${2:?}; shift 2 ;;
    --task) TASK=$(readlink -f "${2:?}"); shift 2 ;;
    --minutes) MINUTES=${2:?}; shift 2 ;;
    --selftest-tamper) TAMPER=${2:?}; shift 2 ;;
    --selftest-agent) SELFAGENT=${2:?}; shift 2 ;;
    *) echo "coldstart: unknown option $1" >&2; usage ;;
  esac
done

RUN=$ROOT/$NAME
WT=$RUN/wt
LOG=$RUN/coldstart.log
FROZEN=$RUN/coldstart.frozen
FROZEN_GRADE=$RUN/coldstart-grade.frozen

# ---------------------------------------------------------------------------
# RESERVE THE BUNDLE BEFORE ANY WRITE, THEN RUN FROZEN BYTES [B02d item 10].
#
# `mkdir -p "$RUN"; : > "$LOG"` truncated an existing run's log and only THEN refused
# the duplicate name — Astra's live-duplicate-hashes.json shows exactly that one file
# changing on a REFUSED/3. The reservation IS the `mkdir`: atomic, so two runs cannot
# share a name and a second run can never destroy the first one's evidence. Round has
# had this rule since B02b; this is the same rule, here.
#
# Then: this runner and its grader are mutable files in ~/bin, and a run that reads
# them at each step measures whatever they happened to be at that moment. Both are
# copied into the reserved bundle, both sha256s go in the receipt, and the run EXECS
# its own copy — so an edit to ~/bin/coldstart mid-run cannot change the behaviour
# being measured.
# ---------------------------------------------------------------------------
if [ "${COLDSTART_FROZEN:-}" != 1 ]; then
  mkdir -p "$ROOT"
  if ! mkdir "$RUN" 2>/dev/null; then
    echo "coldstart: REFUSED run-exists: $RUN already exists. A run bundle is reserved by name, atomically, BEFORE any byte is written, so a second run can never truncate the first one's log or overwrite its evidence [B02d item 10]. Choose another name, or move the old bundle aside deliberately." >&2
    exit 3
  fi
  : > "$LOG"
  cp /home/forge/bin/coldstart "$FROZEN" && chmod +x "$FROZEN" || {
    echo "coldstart: REFUSED cannot freeze the runner into $FROZEN" >&2; exit 3; }
  cp /home/forge/bin/coldstart-grade "$FROZEN_GRADE" && chmod +x "$FROZEN_GRADE" || {
    echo "coldstart: REFUSED cannot freeze the grader into $FROZEN_GRADE" >&2; exit 3; }
  export COLDSTART_FROZEN=1 COLDSTART_RUNNER_SRC=/home/forge/bin/coldstart
  exec "$FROZEN" "$NAME" ${COLD_ARGV[@]+"${COLD_ARGV[@]}"}
fi
[ -f "$FROZEN" ] && [ -f "$FROZEN_GRADE" ] || {
  echo "coldstart: REFUSED frozen bytes missing in $RUN" >&2; exit 3; }
RUNNER_SHA=$(sha256sum < "$FROZEN" | cut -d' ' -f1)
GRADER_SHA=$(sha256sum < "$FROZEN_GRADE" | cut -d' ' -f1)
GRADER=$FROZEN_GRADE
RUNNER_SRC=${COLDSTART_RUNNER_SRC:-/home/forge/bin/coldstart}
stamp() { date -u +%FT%T.%N | cut -c1-23; }
# B02d item 10 — durations come from /proc/uptime (CLOCK_BOOTTIME, monotonic).
# `date(1)` is a LABEL source; a wall-clock step is not a duration.
now_ms() { local u r; read -r u r < /proc/uptime; echo $(( ${u%.*} * 1000 + 10#${u#*.} * 10 )); }
T0=$(date +%s)
T0_MS=$(now_ms)
say() { printf '%s\n' "$*" | tee -a "$LOG"; }
PHASES=()
step() { PHASES+=("$1|$2|$3"); say "$(stamp)  [+$(( $(date +%s) - T0 ))s]  $1 ${2}s :: $3"; }
refuse() { say "$(stamp)  REFUSED: $*"; exit 3; }

say "$(stamp)  COLDSTART $NAME  repo=$REPO base=${BASE:0:12} model=$MODEL cond=$COND task=$TASK minutes=$MINUTES"

# ---------------------------------------------------------------------------
# 0. PREFLIGHT — refuse placeholders and moving refs before anything is created
# ---------------------------------------------------------------------------
t=$(date +%s)
[ -n "$REPO" ] && [ -d "$REPO/.git" ] || refuse "--repo must be a git repository"
[ -n "$BASE" ] || refuse "--base <sha> is required (a moving ref is not a base)"
git -C "$REPO" rev-parse --verify -q "$BASE^{commit}" >/dev/null || refuse "base $BASE is not a commit in $REPO"
[ -f "$TASK" ] || refuse "--task file not found: $TASK"
case "$COND" in W|0) ;; *) refuse "--cond must be W or 0" ;; esac
case "$MODEL" in opus|sonnet) RUNNER=claude ;; sol) RUNNER=codex; CMODEL=gpt-5.6-sol ;;
  astra) RUNNER=codex; CMODEL=gpt-6-astra ;; *) refuse "--model must be opus|sonnet|sol|astra" ;; esac
[ -d "$SKILL" ] || refuse "skill not installed at $SKILL"
[ -f "$COLDBLOCK" ] || refuse "cold-start block missing: $COLDBLOCK (CX-1 — a pointer is not delivery)"
[ -x "$GRADER" ] || refuse "frozen coldstart-grade missing at $GRADER"
[ -x /home/forge/bin/coldstart-stamp ] || refuse "coldstart-stamp missing"
[ -x /home/forge/bin/run-bg ] || refuse "run-bg missing"
[ -e "$WT" ] && refuse "specimen already exists: $WT (a run dir is never reused)"
VERIFY=$(sed -nE 's/^VERIFY:[[:space:]]*//p' "$TASK" | head -1)
# NOTE the single quotes: backticks inside a double-quoted string are command
# substitution, and this seat has already shipped prose that executed itself once.
[ -n "$VERIFY" ] || refuse 'task file has no "VERIFY: <cmd>" line — there would be no independent check'
# CX-3: the repo's DECLARED cold gate, published to the specimen so no agent hunts the
# Makefile for one. p2 spent four calls hunting and then ran four gates against a
# contract of one; that cost was an apparatus failure paid in agent turns.
GATE=$(sed -nE 's/^GATE:[[:space:]]*//p' "$TASK" | head -1)
[ -n "$GATE" ] || refuse 'task file has no "GATE: <cmd>" line — the declared cold gate is not optional (CX-3)'
# THE PRE-COMMITTED INTENDED RED [Astra 10]. A task may name one assertion that MUST be
# seen failing before the first src edit. It is stripped from the prompt like VERIFY --- a
# task that tells the agent which test to watch go red has coached the very behaviour the
# cell exists to measure. Optional: a task without a RED: line simply is not graded on it,
# because an oracle that invents an intended failure is scoring its own guess.
PORT="" ; GATE_SCRIPT="" ; GATE_SCRIPT_SHA="" ; RED_ATTESTED=unattested ; RED_GOLDEN=none ; WORKER_STATUS_CONTRADICTION=no
RED=$(sed -nE 's/^RED:[[:space:]]*//p' "$TASK" | head -1)
# B02d item 9 — MANDATORY, not opt-in. Astra: `astra10-no-red.log` PASSes when RED is
# omitted, and the old seeds asked the caller to CREATE the test namespace, so nothing
# was ever pre-committed to fail. A readiness cell that cannot be graded on red-first
# is not a readiness cell, so the refusal is here, before the specimen exists.
[ -n "$RED" ] || refuse 'task file has no "RED: <ns>/<var>" line — the pre-committed intended failure is REQUIRED (B02d item 9). An oracle that invents which test should have been red is scoring its own guess, and a green that was never preceded by a red proves the test runs, not that it discriminates.'
# ...and the failing test has to EXIST before the agent does. The seed carries it in an
# `overlay/` directory beside the task file; the harness copies it into the specimen and
# then asserts the named test really is red on the untouched base.
OVERLAY=${TASK%.md}.overlay
[ -d "$OVERLAY" ] || refuse "task '$TASK' declares RED: $RED but has no $OVERLAY directory beside it. The pre-committed failing test must be a FILE this harness installs before launch — a RED: line naming a test the agent is expected to write first is a coaching instruction, not a readiness control (B02d item 9)."
SKILL_SHA=$(cat "$SKILL/SKILL.md" | sha256sum | cut -c1-16)
BLOCK_SHA=$(sha256sum < "$COLDBLOCK" | cut -c1-16)
case "$TAMPER" in none|delivery) ;; *) refuse "--selftest-tamper takes 'delivery' or 'none'" ;; esac

# ---------------------------------------------------------------------------
# THE PROCESS OBSERVER [CX-8, first bullet].  A transcript is what the agent
# ATTEMPTED; it is not a record of what ran. `strace -f` records every descendant
# execve with its pid, argv and time, every chdir, every clone (so a pid can be
# joined to its parent and a cwd inherited), and every exit_group. That is the
# only way a second JVM started inside `( ... ) >/dev/null 2>&1` reaches the grade.
#
# ptrace_scope on this box is 1 (restricted), which is fine: strace is the direct
# PARENT of the run, not an attacher. If strace is missing, the fallback is a 50 ms
# /proc sampler, which is LOSSY BY CONSTRUCTION — anything shorter than the interval
# is invisible — so it reports its own loss and is labelled as such in the receipt.
# ---------------------------------------------------------------------------
STRACE=$(command -v strace 2>/dev/null || true)
if [ -n "$STRACE" ]; then OBSERVER=strace; else OBSERVER=proc-sampler; fi
OBSDIR=$RUN/observer
mkdir -p "$OBSDIR"
OBSFILE=$OBSDIR/trace.$( [ "$OBSERVER" = strace ] && echo strace || echo sampler )
OBSFILTER=$OBSDIR/obs-filter.sh

# THE EFFECTIVE INSTRUCTION PROFILE. A PASS has to name the instructions it ran
# under: this seat's own global prompt files are inherited by both runners (CX-8,
# "global seat instructions are inherited"), so the digest covers them AND the
# specimen's own files. Recomputed after the specimen is built; the seat half is
# hashed here so a mid-run edit to a global file is visible as a changed digest.
SEAT_CLAUDE=$HOME/.claude/CLAUDE.md
SEAT_AGENTS=$HOME/.codex/AGENTS.md
step PREFLIGHT $(( $(date +%s) - t )) "runner=$RUNNER verify='$VERIFY' gate='$GATE' skill_sha256=$SKILL_SHA block_sha256=$BLOCK_SHA observer=$OBSERVER${STRACE:+ ($STRACE)} tamper=$TAMPER"

# ---------------------------------------------------------------------------
# 1. SPECIMEN — own worktree, skill installed, boot pointer, committed clean
# ---------------------------------------------------------------------------
t=$(date +%s)
/home/forge/bin/worktree-add "$REPO" "$WT" "coldstart/$NAME" "$BASE" >>"$LOG" 2>&1 </dev/null \
  || refuse "worktree-add failed (see $LOG)"
HEAD0=$(git -C "$WT" rev-parse HEAD)
[ "$HEAD0" = "$(git -C "$REPO" rev-parse "$BASE^{commit}")" ] || refuse "specimen HEAD != requested base"

# DELIVERY (CX-1). Three mechanisms, named separately in the receipt because they are
# not equally supported by every runner:
#   T  the .claude/skills symlink   — Claude Code resolves it; codex exec does not
#   P  the one-line pointer         — an instruction to load something, not the thing
#   inline  the block's own bytes appended to CLAUDE.md and AGENTS.md — the only one
#           that survives a runner with no skill mechanism at all.
mkdir -p "$WT/.claude/skills"
ln -sfn "$SKILL" "$WT/.claude/skills/clojure-fast-feedback"
BLOCK=$RUN/coldstart-block.md
{
  cat "$COLDBLOCK"
  printf '\n%s\n' "This repo's cold gate: \`$GATE\`"
} > "$BLOCK"
for f in CLAUDE.md AGENTS.md; do
  [ -f "$WT/$f" ] || : > "$WT/$f"
  { printf '\n%s\n\n' "$POINTER"; cat "$BLOCK"; } >> "$WT/$f"
done
case "$RUNNER" in claude) DELIVERY_INSTALLED="inline+P+T" ;; *) DELIVERY_INSTALLED="inline+P" ;; esac

# APPARATUS SELF-TEST HOOK, and nothing else. It corrupts one byte of the installed
# block so the exact-bytes gate below can be SHOWN refusing. It always ends in a
# refusal, so no agent ever runs under a tampered profile.
if [ "$TAMPER" = delivery ]; then
  say "$(stamp)  SELFTEST: tampering with the inlined block in $WT/AGENTS.md (one byte) — this run MUST refuse"
  python3 - "$WT/AGENTS.md" <<'PY'
import sys
p = sys.argv[1]
b = open(p, "rb").read()
i = b.find(b"COLDSTART-RECEIPT")
assert i >= 0, "nothing to tamper with"
open(p, "wb").write(b[:i] + b"COLDSTART-RECEIPX" + b[i + 17:])
PY
fi

# DELIVERY, VERIFIED AS EXACT BYTES — not as a marker word.
# The old check grepped for `COLDSTART-RECEIPT` and for the gate line. Both survive a
# block that was truncated, re-wrapped, half-appended by a failed write, or edited by
# anything that touched the file afterwards: the marker is present and the instructions
# are still wrong. The gate now asks the only question that matters at the place it
# takes effect — do the block's OWN BYTES appear, contiguously, in this file?
for f in CLAUDE.md AGENTS.md; do
  dmsg=$(python3 - "$WT/$f" "$BLOCK" "$f" 2>&1 <<'PY'

import sys
target, block, label = sys.argv[1], sys.argv[2], sys.argv[3]
want = open(block, "rb").read()
have = open(target, "rb").read()
if want in have:
    sys.exit(0)
# name the closest thing to a diagnosis a byte comparison can give
head = want[:80]
where = have.find(head)
print(f"delivery-bytes: {label} does not contain the {len(want)}-byte cold-start block verbatim "
      f"({'the block starts at offset %d but diverges after that' % where if where >= 0 else 'the block does not start anywhere in the file'})",
      file=sys.stdout)
sys.exit(1)
PY
) || refuse "$dmsg"
  grep -qF "This repo's cold gate: \`$GATE\`" "$WT/$f" || refuse "delivery check: $f does not carry the declared gate"
done
say "$(stamp)  delivery: the $(wc -c < "$BLOCK") bytes of $COLDBLOCK are present VERBATIM in CLAUDE.md and AGENTS.md"
git -C "$WT" add -A CLAUDE.md AGENTS.md >>"$LOG" 2>&1 </dev/null
GIT_AUTHOR_NAME=forge-anvil GIT_AUTHOR_EMAIL=forge-anvil@anvil \
GIT_COMMITTER_NAME=forge-anvil GIT_COMMITTER_EMAIL=forge-anvil@anvil \
  git -C "$WT" commit -q -m "coldstart specimen $NAME: fast-feedback skill + boot pointer" \
  >>"$LOG" 2>&1 </dev/null || refuse "could not commit the specimen basis"
BASIS=$(git -C "$WT" rev-parse HEAD)
dirty=$(git -C "$WT" status --porcelain --untracked-files=no -- . ':!00SERVER-LOGS.txt' 2>/dev/null)
[ -z "$dirty" ] || refuse "specimen is dirty before the agent ever ran"

# ---------------------------------------------------------------------------
# THE EFFECTIVE INSTRUCTION PROFILE — what this cell actually ran under.
# Both runners inherit this seat's own global prompt files on top of the specimen's
# (CX-8: "global seat instructions are inherited"), so a PASS that names only the
# block is naming a quarter of its own instructions. The digest is over the
# concatenation, in a fixed order, and every component is listed with its own hash so
# a changed digest can be attributed instead of merely noticed.
# ---------------------------------------------------------------------------
PROFILE_JSON=$RUN/instruction-profile.json
PROFILE=$(python3 - "$PROFILE_JSON" "$SEAT_CLAUDE" "$SEAT_AGENTS" "$WT/CLAUDE.md" "$WT/AGENTS.md" <<'PY'
import hashlib, json, os, sys
out, paths = sys.argv[1], sys.argv[2:]
h = hashlib.sha256()
comps = []
for p in paths:
    try:
        b = open(p, "rb").read()
    except OSError:
        b = b""
        comps.append({"path": p, "present": False, "bytes": 0, "sha256": None})
    else:
        comps.append({"path": p, "present": True, "bytes": len(b),
                      "sha256": hashlib.sha256(b).hexdigest()})
    h.update(b)
digest = h.hexdigest()
json.dump({"profile_sha256": digest, "order": paths, "components": comps},
          open(out, "w"), indent=2)
print(digest)
PY
)
# B02d item 9 — the INHERITED half of the profile is recorded on its own. This seat's
# global CLAUDE.md/AGENTS.md reach both runners and this apparatus does not isolate
# them, so a cell's instructions are the block PLUS a prompt nobody registered. That is
# a confound; it is named `profile_isolated=no` rather than implied by a single digest.
INHERITED=$(cat "$SEAT_CLAUDE" "$SEAT_AGENTS" 2>/dev/null | sha256sum | cut -d' ' -f1)
SPECIMEN_PROFILE=$(cat "$WT/CLAUDE.md" "$WT/AGENTS.md" 2>/dev/null | sha256sum | cut -d' ' -f1)
PROFILE_ISOLATED=no
say "$(stamp)  instruction profile: sha256=$PROFILE inherited_global=${INHERITED:0:16} specimen=${SPECIMEN_PROFILE:0:16} profile_isolated=$PROFILE_ISOLATED  (components: $PROFILE_JSON)"
step SPECIMEN $(( $(date +%s) - t )) "basis=${BASIS:0:12} delivery=$DELIVERY_INSTALLED (block bytes verbatim in CLAUDE.md+AGENTS.md, gate='$GATE'), profile=${PROFILE:0:16}, tree clean"

# ---------------------------------------------------------------------------
# 1b. GATE QUALIFICATION — the declared cold gate, on the UNTOUCHED base, BEFORE
# the agent exists.
#
# CX-2 is the scar: curtaincall's `make runtests-once` cannot pass in a fresh
# worktree at all (its new-mission-worktree-test prerequisite dies), and we found
# that out from an agent's failure, at agent prices. A gate that is already red
# makes every later reading of it meaningless — a FAIL cannot be attributed and a
# PASS cannot be trusted — so it is qualified here, once, and its wall is recorded
# as the floor any four-minute claim has to clear.
# ---------------------------------------------------------------------------
t=$(date +%s)
GQLOG=$RUN/gate-qualify.log
( cd "$WT" && eval "$GATE" ) > "$GQLOG" 2>&1 </dev/null
GATE_RC=$?
GATE_WALL=$(( $(date +%s) - t ))
if [ $GATE_RC -ne 0 ]; then
  say "$(stamp)  gate output (tail):"; tail -20 "$GQLOG" | tee -a "$LOG"
  refuse "gate-not-qualified: the declared cold gate \`$GATE\` exits $GATE_RC on the untouched base ${BASIS:0:12} after ${GATE_WALL}s. Nothing this gate says about the agent's work would mean anything. Fix the gate or the base before spending a cell (CX-2)."
fi
# restore whatever the gate wrote (CC's suite appends to a TRACKED log file)
git -C "$WT" checkout -q -- . 2>/dev/null
git -C "$WT" clean -fdq -e .claude 2>/dev/null
dirty=$(git -C "$WT" status --porcelain --untracked-files=no -- . ':!00SERVER-LOGS.txt' 2>/dev/null)
[ -z "$dirty" ] || refuse "the qualified gate left the specimen dirty and it could not be restored"
# FREEZE THE GATE'S OWN PROGRAM, HERE, BEFORE THE AGENT EXISTS [B02e item 1].
# `bin/kaocha` (or whatever the declared gate's argv[0] is) is what the grader reads to
# learn that `bin/kaocha unit` IS `clojure -M:run-tests unit` — and therefore which
# observed JVMs are exempt from F9. That file lives in the SPECIMEN, which is the graded
# agent's own worktree: acceptance-3 G5 added one line to it (`java -version "$@"`) and an
# entirely unrelated `java -Xmx1g some.unrelated.Main` was exempted as gate-owned, turning
# a FAIL into a PASS on a byte-identical trace. The subject may not write the oracle's
# exemption rules. A copy is taken NOW, its sha256 recorded, and the grader is handed the
# copy; it compares the specimen's copy at grade time and calls any difference
# `specimen-gate-modified`.
GATE_PROG=$(printf '%s\n' "$GATE" | awk '{print $1}')
GATE_SCRIPT=""; GATE_SCRIPT_SHA=""
if [ -n "$GATE_PROG" ] && [ -f "$WT/$GATE_PROG" ]; then
  GATE_SCRIPT=$RUN/gate-program.frozen
  cp "$WT/$GATE_PROG" "$GATE_SCRIPT" || refuse "could not freeze the gate program $WT/$GATE_PROG"
  chmod 0444 "$GATE_SCRIPT"
  GATE_SCRIPT_SHA=$(sha256sum "$GATE_SCRIPT" | cut -d' ' -f1)
  say "$(stamp)  GATE PROGRAM FROZEN: $GATE_PROG sha256=${GATE_SCRIPT_SHA:0:16} -> $GATE_SCRIPT (captured before the agent ran; the grader never reads the specimen's copy for expansions) [B02e item 1]"
else
  say "$(stamp)  NOTE: the declared gate's program '$GATE_PROG' is not a file in the specimen, so there is nothing to freeze; the grader will have no gate expansions and will say so [B02e item 1]"
fi
step GATE_QUALIFY "$GATE_WALL" "ok: \`$GATE\` exits 0 on the untouched base ${BASIS:0:12} in ${GATE_WALL}s (log: $GQLOG) gate_program=${GATE_PROG:-none} gate_program_sha256=${GATE_SCRIPT_SHA:0:16}"

# ---------------------------------------------------------------------------
# 1c. READINESS — the PRE-COMMITTED INTENDED RED, installed and ATTESTED [B02d item 9]
#
# The old seeds told the agent to create the test namespace itself, so nothing was
# pre-committed and R10 could only ever grade a test the agent wrote to its own taste.
# Astra: "old missing-Var/caller-created-test seeds cannot establish intended
# assertion-red". The failing test now ships in the seed's own `<task>.overlay/`, it is
# installed here — AFTER the gate was qualified green on the untouched base, so the two
# facts stay separable — and the declared gate is run again to prove that this overlay,
# and nothing else, is what makes it red. A red we did not watch turn red is a claim.
# ---------------------------------------------------------------------------
t=$(date +%s)
OVERLAY_FILES=$( (cd "$OVERLAY" && find . -type f | sed 's|^\./||') | tr '\n' ' ')
(cd "$OVERLAY" && tar cf - .) | (cd "$WT" && tar xf -) \
  || refuse "could not install the readiness overlay from $OVERLAY"
RQLOG=$RUN/red-qualify.log
( cd "$WT" && eval "$GATE" ) > "$RQLOG" 2>&1 </dev/null
RED_RC=$?
RED_WALL=$(( $(date +%s) - t ))
if [ $RED_RC -eq 0 ]; then
  say "$(stamp)  red-qualify output (tail):"; tail -20 "$RQLOG" | tee -a "$LOG"
  refuse "red-not-qualified: with the readiness overlay ($OVERLAY_FILES) installed, the declared gate \`$GATE\` still exits 0. The declared RED \`$RED\` is not failing on this base, so nothing this cell later calls a red-first observation could be that assertion going red (B02d item 9)."
fi
# THE RED MUST BE THE DECLARED ASSERTION'S RED [B02e item 5].
#
# What used to stand here was `grep -qF "${RED%%/*}"` over the gate's stdout, printing an
# advisory NOTE when it missed. Two things were wrong with it and acceptance-3 executed
# both. (a) It is a SUBSTRING test for the NAMESPACE, and the overlay's own FILENAME
# satisfies it: an overlay with a deliberate shell syntax error, renamed
# `tests/intended-red.sh`, was ATTESTED with no NOTE at all — the file naming silenced the
# only guard there was. (b) Even when it fired it was advisory, so a gate that died at
# PARSE TIME, having never run a line of the declared assertion, was recorded as
# `intended red ATTESTED` with nothing in the receipt to tell a regrader otherwise.
#
# So: parse the gate's own output for the declared VAR (the half after the `/`), with
# every overlay path and basename blanked first so a filename can never be the evidence.
# A parse/compile death or an unrelated failure is `red-wrong-reason` and REFUSES —
# a red we cannot attribute is not a pre-committed intended red, and every later
# red-first observation in this cell would rest on it.
RED_NS=${RED%%/*}; RED_VAR=${RED##*/}
RED_ATTESTED=$(RQLOG="$RQLOG" RED_NS="$RED_NS" RED_VAR="$RED_VAR" \
  OVERLAY_FILES="$OVERLAY_FILES" python3 - <<'PY' 2>/dev/null || echo "red-wrong-reason/classifier-failed"
import os, re, sys
try:
    txt = open(os.environ["RQLOG"], errors="replace").read()
except OSError:
    print("red-wrong-reason/no-output"); raise SystemExit
# A FILENAME IS NOT EVIDENCE. Blank every overlay path, its basename, and that
# basename without its extension, before looking for the declared var anywhere.
for f in (os.environ.get("OVERLAY_FILES") or "").split():
    for token in {f, os.path.basename(f), os.path.splitext(os.path.basename(f))[0]}:
        if token:
            txt = txt.replace(token, " ")
var = os.environ["RED_VAR"].strip()
ns = os.environ["RED_NS"].strip()
# `/` is allowed before the var: `ns/var` is the canonical spelling of a Clojure test
# var and is exactly what a failing runner prints. Filenames that would also match
# through their `/` were blanked above, which is the point of blanking them.
named = bool(var) and re.search(r"(?<![A-Za-z0-9_.\-])" + re.escape(var)
                                + r"(?![A-Za-z0-9_\-])", txt) is not None
# A gate that never parsed never ran the assertion. These are the deaths that happen
# BEFORE any test var is reached; each was observed in an acceptance-3 negative or is
# the same class as one.
PARSE = re.compile(r"Syntax error|PARSE ERROR|unexpected|Unable to resolve|"
                   r"Could not locate|CompilerException|ClassNotFoundException|"
                   r"FileNotFoundException|SyntaxError|command not found|"
                   r"No such file or directory|cannot find|Parse error", re.I)
if named:
    print("assertion")
elif PARSE.search(txt):
    print("red-wrong-reason/parse-or-load-error")
else:
    print("red-wrong-reason/unrelated-failure" + ("" if ns in txt else "/ns-not-named"))
PY
)
case "$RED_ATTESTED" in
  assertion) : ;;
  *) say "$(stamp)  red-qualify output (tail):"; tail -20 "$RQLOG" | tee -a "$LOG"
     refuse "red-wrong-reason ($RED_ATTESTED): with the readiness overlay ($OVERLAY_FILES) installed the declared gate \`$GATE\` exits $RED_RC, but its output never names the declared assertion \`$RED_VAR\` at a failure site — after every overlay filename was blanked, so a file named after the RED cannot stand in for the assertion going red. A red this harness cannot attribute to the declared var is not a pre-committed intended red, and every red-first observation in this cell would rest on it [B02e item 5]." ;;
esac
# THE GOLDEN REPAIR, WHEN THE SEED SHIPS ONE. A red that the seed's own known-good fix
# turns green in THIS run is the strongest form of the attestation; without it the
# attestation is honest but one-sided, and the receipt says which one this was.
RED_GOLDEN=none
GOLDEN=${TASK%.md}.golden
if [ -d "$GOLDEN" ]; then
  (cd "$GOLDEN" && tar cf - .) | (cd "$WT" && tar xf -) \
    || refuse "could not install the golden repair from $GOLDEN"
  GLOG=$RUN/red-golden.log
  ( cd "$WT" && eval "$GATE" ) > "$GLOG" 2>&1 </dev/null
  GOLD_RC=$?
  git -C "$WT" checkout -q -- . 2>/dev/null
  git -C "$WT" clean -fdq -e .claude 2>/dev/null
  if [ $GOLD_RC -eq 0 ]; then
    RED_GOLDEN=green
  else
    say "$(stamp)  golden output (tail):"; tail -20 "$GLOG" | tee -a "$LOG"
    refuse "red-golden-not-green: the seed's own golden repair ($GOLDEN) leaves the declared gate exiting $GOLD_RC. A red whose known-good fix does not turn it green is not the red this seed claims to have pre-committed [B02e item 5]."
  fi
fi
# Restore whatever the red gate wrote, then RE-INSTALL the overlay: `git clean` cannot
# be trusted to spare the overlay's own untracked files (they are not always under
# test/ — the harness's own selftest seed drops a marker at the repo root), and
# re-extracting is idempotent.
git -C "$WT" checkout -q -- . 2>/dev/null
git -C "$WT" clean -fdq -e .claude 2>/dev/null
(cd "$OVERLAY" && tar cf - .) | (cd "$WT" && tar xf -) \
  || refuse "could not re-install the readiness overlay after the red gate ran"
git -C "$WT" add -A >>"$LOG" 2>&1 </dev/null
GIT_AUTHOR_NAME=forge-anvil GIT_AUTHOR_EMAIL=forge-anvil@anvil \
GIT_COMMITTER_NAME=forge-anvil GIT_COMMITTER_EMAIL=forge-anvil@anvil \
  git -C "$WT" commit -q -m "coldstart readiness overlay $NAME: the pre-committed intended red ($RED)" \
  >>"$LOG" 2>&1 </dev/null || refuse "could not commit the readiness overlay"
BASIS=$(git -C "$WT" rev-parse HEAD)
dirty=$(git -C "$WT" status --porcelain --untracked-files=no -- . ':!00SERVER-LOGS.txt' 2>/dev/null)
[ -z "$dirty" ] || refuse "the specimen is dirty after the readiness overlay was committed"
step READINESS "$RED_WALL" "intended red ATTESTED: \`$GATE\` exits $RED_RC with the overlay installed ($OVERLAY_FILES) at basis ${BASIS:0:12}; declared RED=$RED red_attested=$RED_ATTESTED red_golden=$RED_GOLDEN (log: $RQLOG)"

# ---------------------------------------------------------------------------
# 2. CONDITION
# ---------------------------------------------------------------------------
t=$(date +%s)
JVM_PID=""
if [ "$COND" = W ]; then
  rm -f "$WT/.nrepl-port"
  out=$(cd "$WT" && /home/forge/bin/run-bg "$NAME-jvm" make nrepl 2>&1 </dev/null)
  say "  $out"
  JVM_PID=$(printf '%s' "$out" | sed -nE 's/.*pid=([0-9]+).*/\1/p')
  [ -n "$JVM_PID" ] || refuse "condition W: run-bg did not print a pid"
  for _ in $(seq 1 180); do [ -s "$WT/.nrepl-port" ] && break; sleep 1; done
  [ -s "$WT/.nrepl-port" ] || refuse "condition W: no .nrepl-port after 180 s"
  PORT=$(cat "$WT/.nrepl-port")
  # attest: the endpoint answers AND its root is THIS worktree. A port file is a
  # handshake, not an identity — prestarting an endpoint we never attested would
  # hand the agent someone else's JVM and call that the experiment's condition.
  ATT=$(clj-nrepl-eval --port "$PORT" '(vector (+ 1 2) (System/getProperty "user.dir"))' \
        2>&1 </dev/null | tr -d '\n')
  case "$ATT" in *"3"*"$WT"*) ;; *) refuse "condition W: attestation failed — got: $ATT" ;; esac
  step CONDITION $(( $(date +%s) - t )) "W: nREPL prestarted port=$PORT jvm_pid_group=$JVM_PID attested root=$WT"
else
  [ -e "$WT/.nrepl-port" ] && refuse "condition 0: a .nrepl-port already exists in a fresh worktree"
  step CONDITION $(( $(date +%s) - t )) "0: no endpoint present (asserted absent)"
fi

# ---------------------------------------------------------------------------
# 3. LAUNCH — the agent's ENTIRE prompt is the task, VERIFY line stripped.
#    The VERIFY command is the harness's independent check; showing it to the
#    agent would be coaching (Astra: the task contains no verification hints).
# ---------------------------------------------------------------------------
t=$(date +%s); t_ms=$(now_ms)
PROMPT=$RUN/prompt.md
grep -vE '^(VERIFY|GATE|REPO|BASE|BASE_REF|QUALIFIED|RED):' "$TASK" > "$PROMPT"
TRANSCRIPT=$RUN/transcript.$([ "$RUNNER" = claude ] && echo jsonl || echo log)
REPORT=$RUN/report.md

if [ "$RUNNER" = claude ]; then
  FMT=claude
  LAUNCH_PRE="cd '$WT' && "
  LAUNCH_CMD="claude -p --model '$MODEL' --output-format stream-json --verbose \
--dangerously-skip-permissions --add-dir '$WT' < '$PROMPT'"
else
  FMT=codex
  LAUNCH_PRE=""
  LAUNCH_CMD="CODEX_BIN=/home/forge/.local/bin/codex CODEX_MODEL='$CMODEL' \
/home/forge/bin/sol-yolo '$WT' '$PROMPT' '' '$REPORT'"
fi

# APPARATUS SELF-TEST ONLY. Substituting the runner is the ONLY way a fixture can
# witness the launch/observe/wait/detach path itself rather than a copy of it, and a
# copy is what let CX-14 ship: the wait loop was reviewed, looked right, and waited on
# the wrong pid. Recorded everywhere a reader could mistake this for a cell.
if [ -n "$SELFAGENT" ]; then
  LAUNCH_PRE="cd '$WT' && "
  LAUNCH_CMD="$SELFAGENT"
  say "$(stamp)  SELFTEST AGENT: no model runs in this cell — LAUNCH is \`$SELFAGENT\`"
fi
LAUNCH=""

# ---------------------------------------------------------------------------
# THE RUN IS LAUNCHED UNDER THE OBSERVER, not beside it. `strace -f` becomes the
# parent of the whole tree, so a child created inside a subshell whose output was
# redirected to /dev/null still produces an execve line with its pid, argv and time.
# clone/chdir are traced too: without them a pid cannot be joined to its parent and
# a cwd cannot be inherited, and "which JVM was this" stops being answerable.
# `-s 65536`, raised from 4096 in B02d: a truncated argv is exactly the argv we care
# about (a long inline `python3 -c` is the hidden-client shape), and since item 4 makes
# truncation CAP the verdict at UNVERIFIED, a `-classpath` long enough to be cut would
# otherwise disqualify every real JVM cell. p16's frozen trace carries four such lines. `abbrev=none` is deliberately NOT set: it
# expands the environment array of EVERY execve, multiplying the trace ~40x and copying
# the seat's whole environment into a file we keep.
# ---------------------------------------------------------------------------
# THE AGENT'S OWN EXIT, WRITTEN BY THE AGENT'S OWN SHELL [CX-14]. `kill -0 $AGENT_PGID`
# waits on the TRACER, and a tracer cannot exit while it is still tracing a child the
# agent legitimately left running (the nREPL it started in condition Ø). In pilot 3 that
# made two of four cells sit until the ceiling fired: p13 reported `wall=1316s
# ceiling=yes` for a 213 s session that had already written a clean receipt. `ceiling=yes`
# then meant nothing, because it was true of every Ø cell by construction. This sentinel
# is written the instant the agent's own pipeline ends, and it is what LAUNCH waits on.
AGENT_RC_FILE=$RUN/agent.rc
WORKER_RC_FILE=$RUN/worker.rc
WORKER_PID_FILE=$RUN/worker.pid
rm -f "$AGENT_RC_FILE" "$WORKER_RC_FILE" "$WORKER_PID_FILE"
# `$?` AFTER A PIPELINE IS THE LOGGER'S STATUS [B02d item 8]. The launch is
# `<worker> | coldstart-stamp > transcript`, and without pipefail `$?` is
# coldstart-stamp's — which is 0 essentially always. Astra's worker exited 17 in the
# trace and this file said 0; the run graded PASS and the runner exited 0.
# The repair is not a flag, it is a subject: the worker is BACKGROUNDED inside the
# launch shell, its pid is written down, `wait` collects THAT pid's status, and
# agent.rc carries the worker's status or the literal word `unknown`.
LAUNCH="$LAUNCH_PRE{ { $LAUNCH_CMD ; } 2>&1 & __w=\$!; printf '%s' \$__w > '$WORKER_PID_FILE'; wait \$__w; printf '%s' \$? > '$WORKER_RC_FILE'; } | /home/forge/bin/coldstart-stamp > '$TRANSCRIPT'; printf '%s' \"\$(cat '$WORKER_RC_FILE' 2>/dev/null || echo unknown)\" > '$AGENT_RC_FILE'"

SAMPLER_PGID=""
if [ "$OBSERVER" = strace ]; then
  # A BOUNDED FILESYSTEM CAPTURE [Astra fix 8]. F8 (/tmp writes) and F10 (a client
  # written and then deleted) were transcript-only claims; now the trace can carry
  # them. The bound is the filter below, not the syscall list: unfiltered `openat`
  # over a JVM is tens of megabytes and slows the cell we are timing. `-q`, not `-qq`,
  # because `-qq` suppresses `+++ exited with N +++` — and that line is how the
  # declared gate's RESULT reaches the grade [Astra fix 9].
  cat > "$OBSFILTER" <<'FILTEREOF'
#!/bin/sh
# generated by coldstart. $1 = trace file, $2 = specimen root.
# Control events pass whole. Filesystem events pass ONLY for an absolute path under
# /tmp or under this run's specimen. That bound is also a LIMIT and the grade says so:
# a RELATIVE write inside the specimen is not captured here. NETWORK syscalls ARE
# captured as of B02d item 4 (socket/connect are control events and pass whole), so a
# hand-rolled client that deletes itself still leaves the act on the record.
exec grep -E "(execve|execveat|chdir|fchdir|clone|clone3|vfork|fork|exit_group|exit|socket|connect)\(|<\.\.\.|\+\+\+ exited|(openat|openat2|open|creat|unlink|unlinkat|rename|renameat|renameat2)\((AT_FDCWD, )?\"(/tmp[/\"]|$2)" > "$1"
FILTEREOF
  chmod +x "$OBSFILTER"
  out=$(/home/forge/bin/run-bg "$NAME-agent" "$STRACE" -f -q -ttt -s 65536 \
        -e trace=execve,execveat,chdir,fchdir,exit_group,clone,clone3,fork,vfork,openat,openat2,open,creat,unlink,unlinkat,rename,renameat,renameat2,socket,connect \
        -o "|$OBSFILTER $OBSFILE $WT" -- bash -c "$LAUNCH" 2>&1 </dev/null)
else
  # LOSSY BY CONSTRUCTION and labelled as such: a process that lives less than one
  # sampling interval is invisible to it. It counts its own misses so the receipt can
  # say how blind it was rather than implying it saw everything.
  sout=$(/home/forge/bin/run-bg "$NAME-sampler" python3 -c '
import os, sys, time
out, interval = sys.argv[1], float(sys.argv[2])
seen = set(); n = 0; t0 = time.time()
f = open(out, "w", buffering=1)
while True:
    n += 1
    for d in os.listdir("/proc"):
        if not d.isdigit() or d in seen:
            continue
        try:
            argv = open(f"/proc/{d}/cmdline", "rb").read().replace(b"\0", b" ").decode("utf8", "replace").strip()
            cwd = os.readlink(f"/proc/{d}/cwd")
            st = os.stat(f"/proc/{d}")
        except OSError:
            continue
        seen.add(d)
        f.write(f"{time.time():.6f} pid={d} cwd={cwd} argv={argv}\n")
    expected = int((time.time() - t0) / interval) + 1
    f.write(f"#STAT samples={n} expected={expected} loss={max(0, expected - n)}\n")
    time.sleep(interval)
' "$OBSFILE" 0.05 2>&1 </dev/null)
  say "  $sout"
  SAMPLER_PGID=$(printf '%s' "$sout" | sed -nE 's/.*pid=([0-9]+).*/\1/p')
  out=$(/home/forge/bin/run-bg "$NAME-agent" bash -c "$LAUNCH" 2>&1 </dev/null)
fi
say "  $out"
AGENT_PGID=$(printf '%s' "$out" | sed -nE 's/.*pid=([0-9]+).*/\1/p')
if [ -z "$AGENT_PGID" ]; then
  # A JOB THAT FINISHED IS NOT A JOB THAT NEVER STARTED [B02e item 11]. run-bg decides
  # a launch failed when its `kill -0` finds no live process — but the pidfile is
  # written BY THE JOB ITSELF, before exec, so a job that exited between those two
  # instants is indistinguishable from one that never ran. Acceptance-3 NA-9:
  # `--selftest-agent "echo 'no-op agent'"` produced `FAILED to start` over a 7-byte
  # pidfile. The pidfile's existence is the start receipt; read it, and refuse only
  # when there is no pidfile at all.
  _apf=/var/tmp/forge/run-bg/$NAME-agent.pid
  AGENT_PGID=$(tr -dc '0-9' < "$_apf" 2>/dev/null)
  [ -n "$AGENT_PGID" ] && say "$(stamp)  run-bg reported no live pid, but $_apf names pid $AGENT_PGID: the job wrote its own pid before exec and had already exited when the liveness poll ran. STARTED AND FINISHED, not a failed launch [B02e item 11]."
fi
[ -n "$AGENT_PGID" ] || refuse "run-bg did not print a pid for the agent launch, and /var/tmp/forge/run-bg/$NAME-agent.pid holds no pid either — nothing started"
LAUNCH_EPOCH=$(date +%s)
# THE CEILING STARTS AT LAUNCH, NOT AFTER DISCOVERY [B02e item 6]. `DEADLINE` used to be
# computed AFTER the worker-discovery loop below, so `--minutes` bounded only the second
# of two loops. Acceptance-3 NA-5b: a worker that was never discoverable made 90
# iterations of a /proc scan cost 248 s under a 120 s ceiling, and the run reported
# `ceiling=no`. The deadline is a WALL from the moment the launch happened, and every
# loop that can spend that wall checks it.
DEADLINE=$(( LAUNCH_EPOCH + MINUTES * 60 ))
CEILING=no

# The real worker is a CHILD of that shell. run-bg setsids, so the printed pid is
# the process-group leader and killing the GROUP is exact. We still name the worker
# in the start receipt: a receipt that cannot name its subject is not a receipt.
worker_pids() {  # /proc scan by argv + start time. NEVER pgrep -f.
  local p args
  for p in /proc/[0-9]*; do
    p=${p#/proc/}
    args=$({ tr '\0' ' ' < "/proc/$p/cmdline"; } 2>/dev/null) || continue
    case "$args" in
      *"codex exec "*" -C ${WT} "*|*"codex exec "*" -C ${WT}/ "*) echo "$p" ;;
      *"claude"*" -p "*"--add-dir ${WT}"*) echo "$p" ;;
    esac
  done | sort -n
}
WORKER=""
# ...and stop hunting the moment the agent is already done. Without this a fast agent
# (or the selftest agent) is charged 90 s of OUR discovery loop as its own wall [CX-14].
for _ in $(seq 1 90); do
  WORKER=$(worker_pids | head -1); [ -n "$WORKER" ] && break
  [ -e "$AGENT_RC_FILE" ] && break
  # the discovery loop spends the declared wall like any other loop [B02e item 6]
  if [ "$(date +%s)" -ge "$DEADLINE" ]; then
    CEILING=yes
    say "$(stamp)  the declared wall (--minutes $MINUTES) expired during worker DISCOVERY, before the agent was ever located — ceiling=yes"
    break
  fi
  sleep 1
done
say "START RECEIPT: name=$NAME pgid=$AGENT_PGID worker=${WORKER:-<not-discovered>} runner=$RUNNER model=$MODEL transcript=$TRANSCRIPT discovery_ceiling=$CEILING"

AGENT_RC=unknown
# WAIT ON THE AGENT, NOT ON THE TRACER [CX-14]. Three exits from this loop, and only
# the second is a ceiling: the agent's own shell wrote its status; the agent overran
# --minutes; or the observer itself died, which is an apparatus fact, not an agent one.
while :; do
  if [ -e "$AGENT_RC_FILE" ]; then AGENT_RC=$(cat "$AGENT_RC_FILE" 2>/dev/null); break; fi
  if ! kill -0 "$AGENT_PGID" 2>/dev/null; then
    say "$(stamp)  observer group $AGENT_PGID is gone and no agent.rc was written — the agent's own exit is UNKNOWN"
    break
  fi
  if [ "$(date +%s)" -ge "$DEADLINE" ]; then
    # exact: our OWN process group, an id we created. Never pkill, never a pattern.
    kill -TERM -- "-$AGENT_PGID" 2>/dev/null
    sleep 5
    kill -KILL -- "-$AGENT_PGID" 2>/dev/null
    CEILING=yes
    break
  fi
  sleep 1
done
AGENT_WALL=$(( $(date +%s) - t ))
LAUNCH_WALL_MS=$(( $(now_ms) - t_ms ))
# WHATEVER ENDED THE PHASE, THE WALL IS THE WALL [B02e item 6]. `ceiling` is a
# statement about elapsed time, not about which branch of which loop exited last, and a
# field that only reports one of the ways time can run out is not a bound.
[ "$(date +%s)" -ge "$DEADLINE" ] && CEILING=yes

# THE TRACER OUTLIVES THE AGENT ON PURPOSE, AND MUST NOT OUTLIVE THIS PHASE [CX-14].
# `setsid` starts a new session; it does NOT detach from ptrace, so the nREPL the agent
# started is still a traced descendant and strace cannot exit on its own. Terminate the
# TRACER by the exact pid run-bg gave us — never the group, which would also kill the
# agent's nREPL that the reap sweep below owns and reports. SIGTERM makes strace detach
# from every tracee and flush; the settle loop waits for the filter to close the file.
if [ "$OBSERVER" = strace ] && kill -0 "$AGENT_PGID" 2>/dev/null; then
  say "$(stamp)  agent finished (rc=$AGENT_RC) — detaching the tracer (pid $AGENT_PGID); its tracees keep running"
  kill -TERM "$AGENT_PGID" 2>/dev/null
  for _ in $(seq 1 40); do kill -0 "$AGENT_PGID" 2>/dev/null || break; sleep 0.5; done
  kill -0 "$AGENT_PGID" 2>/dev/null && { kill -KILL "$AGENT_PGID" 2>/dev/null; say "$(stamp)  tracer did not detach on TERM; killed"; }
  prev=-1
  for _ in $(seq 1 20); do
    cur=$(wc -c < "$OBSFILE" 2>/dev/null || echo 0)
    [ "$cur" = "$prev" ] && break
    prev=$cur; sleep 0.5
  done
fi

# the model is verified from the runner's OWN log, not from the flag we passed
if [ "$RUNNER" = claude ]; then
  LOGMODEL=$(python3 - "$TRANSCRIPT" <<'PY' 2>/dev/null
import json,re,sys
for line in open(sys.argv[1],errors="replace"):
    line=re.sub(r'^@[\d.]+\|','',line).strip()
    if not line.startswith('{'): continue
    try: o=json.loads(line)
    except Exception: continue
    if o.get('type')=='system' and o.get('model'):
        print(o['model']); break
PY
)
else
  LOGMODEL=$(sed -E 's/^@[0-9.]+\|//' "$TRANSCRIPT" 2>/dev/null | grep -m1 -E '^[[:space:]]*model:' \
             | sed -E 's/.*model:[[:space:]]*//' | tr -d '\r')
fi
MODEL_OK=unknown
case "$LOGMODEL" in
  "") MODEL_OK=no-model-line ;;
  *"$MODEL"*|*"${CMODEL:-@@}"*) MODEL_OK=verified ;;
  *) MODEL_OK="MISMATCH(asked=$MODEL got=$LOGMODEL)" ;;
esac
# stop the fallback sampler by the exact group we created (never pkill, never a pattern)
if [ -n "$SAMPLER_PGID" ]; then
  kill -TERM -- "-$SAMPLER_PGID" 2>/dev/null; sleep 1; kill -KILL -- "-$SAMPLER_PGID" 2>/dev/null
fi
# what the observer actually captured — reported as facts, never as reassurance
OBS_LINES=0; OBS_EXECS=0; OBS_LOSS=0; OBS_TRUNC=0
if [ -s "$OBSFILE" ]; then
  OBS_LINES=$(wc -l < "$OBSFILE")
  # execve LINES, not successful execs: strace prints one line per attempt (a PATH
  # search misses several times per command) and splits interleaved calls across two.
  # The grader's `observer_execve` is the count of execs that actually HAPPENED; this
  # is deliberately a different, larger number and is named so it cannot be confused
  # with it.
  OBS_EXECS=$(grep -c 'execve' "$OBSFILE" 2>/dev/null || echo 0)
  # TRUNCATION, not interleaving: `<unfinished ...>` is lossless and reassembled by the
  # grader. A real hole is a string cut by -s ("abc"...) or an abbreviated array (...]).
  OBS_TRUNC=$(grep -c -e '"\.\.\.' -e '\.\.\.\]' "$OBSFILE" 2>/dev/null || echo 0)
  [ "$OBSERVER" = proc-sampler ] && OBS_LOSS=$(grep '^#STAT' "$OBSFILE" | tail -1 | sed -nE 's/.*loss=([0-9]+).*/\1/p')
  : "${OBS_LOSS:=0}"
else
  say "$(stamp)  OBSERVER PRODUCED NOTHING ($OBSFILE) — process evidence for this cell is UNVERIFIED"
  OBSERVER="none"
fi
OBSERVER_FIELD=$OBSERVER
[ "$OBSERVER" = proc-sampler ] && OBSERVER_FIELD="proc-sampler(loss=$OBS_LOSS)"
say "$(stamp)  observer: $OBSERVER_FIELD lines=$OBS_LINES execve_lines=$OBS_EXECS truncated=$OBS_TRUNC file=$OBSFILE"
# THE WORKER'S OWN PID AND STATUS, as the launch shell collected them [B02d item 8].
WORKER_SHELL_PID=$(cat "$WORKER_PID_FILE" 2>/dev/null)
WORKER_RC=$(cat "$WORKER_RC_FILE" 2>/dev/null)
: "${WORKER_SHELL_PID:=none}" "${WORKER_RC:=unknown}"
AGENT_RC_SOURCE="wait(2) on worker pid $WORKER_SHELL_PID inside the launch shell"
[ "$WORKER_RC" = unknown ] && AGENT_RC_SOURCE="NOT COLLECTED (the launch shell wrote no worker status)"
# TWO AUTHORITIES ON ONE SUBJECT — TYPED, NEVER PRINTED SIDE BY SIDE [B02e item 7].
# `worker.rc` is written by the launch shell's `wait`; `agent.rc` is written by the same
# shell one command later. Acceptance-3 NA-5b killed that shell in between, and the run
# printed `exit=0 source=wait(2)` on one line and `agent_rc=unknown` on the next, with
# no refusal and nothing typed. A reader of the receipt line alone would conclude the
# worker exited 0 cleanly. When the two disagree the disagreement IS the finding: it is
# named, it reaches the integrity gate, and `source=wait(2)` is never printed for a
# status this run then calls unknown.
WORKER_STATUS_CONTRADICTION=no
if [ "$WORKER_RC" != unknown ] && { [ -z "$AGENT_RC" ] || [ "$AGENT_RC" = unknown ]; }; then
  WORKER_STATUS_CONTRADICTION=yes
  AGENT_RC_SOURCE="CONTRADICTION(worker-status-without-agent-status): the launch shell recorded worker pid $WORKER_SHELL_PID exiting $WORKER_RC, then did not survive to record the agent's own status. Neither figure is this cell's terminal status."
  say "$(stamp)  WORKER TERMINAL RECEIPT: pid=$WORKER_SHELL_PID exit=$WORKER_RC UNRECONCILED — the launch shell wrote worker.rc but never wrote agent.rc, so this exit code is NOT the collected agent status and must not be read as one [B02e item 7]"
else
  say "$(stamp)  WORKER TERMINAL RECEIPT: pid=$WORKER_SHELL_PID exit=$WORKER_RC source=$AGENT_RC_SOURCE (never the logger pipeline's status)"
fi
step LAUNCH "$AGENT_WALL" "agent_rc=$AGENT_RC (worker pid $WORKER_SHELL_PID, $AGENT_RC_SOURCE) ceiling=$CEILING worker=${WORKER:-none} model_from_log='${LOGMODEL:-none}' ($MODEL_OK) observer=$OBSERVER_FIELD execve_lines=$OBS_EXECS launch_wall_ms=$LAUNCH_WALL_MS"

# ---------------------------------------------------------------------------
# 4. GRADE — the action-log oracle over what the agent actually attempted
# ---------------------------------------------------------------------------
t=$(date +%s)
GRADEOUT=$RUN/grade.txt
"$GRADER" "$TRANSCRIPT" --format "$FMT" --cond "$COND" \
  --observer "$OBSFILE" --observer-kind "$OBSERVER" --observer-loss "$OBS_LOSS" \
  --gate "$GATE" --specimen "$WT" ${RED:+--red-test "$RED"} \
  ${GATE_SCRIPT:+--gate-script "$GATE_SCRIPT"} \
  ${GATE_SCRIPT_SHA:+--gate-script-sha256 "$GATE_SCRIPT_SHA"} \
  ${PORT:+--nrepl-port "$PORT"} \
  --json "$RUN/grade.json" > "$GRADEOUT" 2>&1 </dev/null
GLINE=$(grep -m1 '^COLDSTART-GRADE:' "$GRADEOUT")
GRADE=$(printf '%s' "$GLINE" | awk '{print $2}')
WARMF=$(printf '%s' "$GLINE" | sed -nE 's/.*warm_first_s=([^ ]*).*/\1/p')
CALLS=$(printf '%s' "$GLINE" | sed -nE 's/.*calls=([^ ]*).*/\1/p')
APPA=$(printf '%s' "$GLINE" | sed -nE 's/.*apparatus=([^ ]*).*/\1/p')
: "${GRADE:=UNVERIFIED}" "${WARMF:=unknown}" "${CALLS:=0}" "${APPA:=0%}"

# DELIVERY, OBSERVED (CX-1). What was INSTALLED is one fact; whether it reached the
# runner's effective instruction set is another, and only the second exculpates a cell.
# The classification comes from coldstart-grade, which owns event parsing: a raw-text grep
# over a whole transcript matched "unavailable" inside tool OUTPUT in all four pilot runs
# --- the same over-permissive-predicate mistake as CX-7c.
#   evidenced   the agent acted on the block (client call, port file, or a receipt line)
#   absent      it did not
#   unsupported absent AND the agent said the delivered instructions were not available
# A cell whose instructions never arrived is an UNTESTED cell, not a behavior failure.
# Scoring it FAIL would launder an apparatus defect into an agent defect.
JQ='import json,sys; m=json.load(open(sys.argv[1]))["metrics"]; print(m.get(sys.argv[2],""))'
DELIVERY_OBSERVED=$(python3 -c "$JQ" "$RUN/grade.json" delivery_evidence 2>/dev/null)
UNAVAIL_CLAIM=$(python3 -c "$JQ" "$RUN/grade.json" instructions_unavailable_claim 2>/dev/null)
: "${DELIVERY_OBSERVED:=unknown}" "${UNAVAIL_CLAIM:=False}"
[ "$DELIVERY_OBSERVED" = absent ] && [ "$UNAVAIL_CLAIM" = True ] && DELIVERY_OBSERVED=unsupported
DELIVERY="$DELIVERY_INSTALLED/$DELIVERY_OBSERVED"
if [ "$DELIVERY_OBSERVED" = unsupported ] && [ "$GRADE" = FAIL ]; then
  say "$(stamp)  DELIVERY UNSUPPORTED: the agent stated the delivered instructions were not available to it and never touched the block. This cell is UNVERIFIED(delivery), not a behavior FAIL."
  GRADE="UNVERIFIED(delivery)"
fi
step GRADE $(( $(date +%s) - t )) "$GLINE delivery=$DELIVERY"

# ---------------------------------------------------------------------------
# THE TRACKED-TREE DIGEST [acceptance-4 control C2 / PILOT-final-source-after-proof].
#
# Nothing bound the tree the PROOF ran over to the tree that is FROZEN. Acceptance-4's
# agent left a detached writer that appended to a tracked file once the VERIFY had
# already produced its evidence, and the run wrote `task=PASS integrity=ok` over a
# frozen diff.patch containing a line the proof never saw. A receipt has to be able to
# name the causal binding between its proof and its subject.
#
# The SUBJECT is exactly diff.patch's subject, so the digest uses diff.patch's own
# pathspec. `git add -A` is what makes this the tracked tree: it honours .gitignore, so
# build caches (.cpcache/, target/, *.log) never move the digest, and it stages the
# agent's untracked new files, which ARE part of the subject. `ls-files -s` is
# content-addressed (mode + blob sha + stage + path), never mtime. The index is reset
# immediately; FREEZE does this same add/reset pair already. `00SERVER-LOGS.txt` is
# excluded on the grounds it is excluded from diff.patch: the CC suite APPENDS to it, so
# the harness's own gate would otherwise be the drift it reports.
src_index() {  # $1 = file to write the index listing to; echoes the digest
  git -C "$WT" add -A >/dev/null 2>&1 </dev/null
  git -C "$WT" ls-files -s -- . ':!00SERVER-LOGS.txt' > "$1" 2>/dev/null
  git -C "$WT" reset -q >/dev/null 2>&1 </dev/null
  sha256sum < "$1" | cut -d' ' -f1
}

# ---------------------------------------------------------------------------
# 5a. THE DECLARED GATE, COLD, ON THE AGENT'S FINAL TREE [acceptance-4 §2, §5].
#
# `coldstart` ran the declared GATE exactly twice — green on the untouched base at
# GATE_QUALIFY and red with the readiness overlay at READINESS — and never again. Only
# VERIFY, the task's own FOCUSED check, ran after the agent. The pilot's pass criterion 3
# is "the declared VERIFY focus green AND the declared GATE green", so half of it was not
# measured by the apparatus at all and an operator had to run the gate by hand — which is
# to say it was not measured. A focused green over a suite the change broke is exactly the
# shape of work this cohort exists to detect, and a receipt that cannot see it is not a
# receipt about the suite.
#
# It runs BEFORE the verify, deliberately: the gate is a superset of the focused check, so
# after it every compile cache the verify would otherwise create is already warm, and the
# tree hash taken at the end of the proofs is not moved by the proofs' own side effects.
#
# `timeout` is correct here and forbidden around the agent launch, for the same reason in
# both places: it kills the child it spawned, not your wait. Here the child IS the gate.
# A descendant JVM can outlive it, and the /proc + cwd sweep below is what reaps that.
# 124 is a timeout and is a non-zero gate exit like any other.
# ---------------------------------------------------------------------------
t=$(date +%s)
GFLOG=$RUN/gate-final.log
GF_LIMIT=$(( GATE_WALL * 6 )); [ "$GF_LIMIT" -lt 600 ] && GF_LIMIT=600
( cd "$WT" && timeout -k 15 "$GF_LIMIT" bash -c "$GATE" ) > "$GFLOG" 2>&1 </dev/null
GATE_FINAL_EXIT=$?
GATE_FINAL_WALL=$(( $(date +%s) - t ))
GATE_FINAL_SUM=$(grep -oE '[0-9]+ tests?, [0-9]+ assertions?[^\n]*' "$GFLOG" | tail -1)
if [ "$GATE_FINAL_EXIT" -ne 0 ]; then
  say "$(stamp)  gate-final output (tail):"; tail -20 "$GFLOG" | tee -a "$LOG"
fi
step GATE_FINAL "$GATE_FINAL_WALL" "gate_final_exit=$GATE_FINAL_EXIT (\`$GATE\`, cold, on the agent's final tree; qualified green on the base in ${GATE_WALL}s, limit ${GF_LIMIT}s) ${GATE_FINAL_SUM:-<no kaocha summary line>} ($GFLOG)"

# ---------------------------------------------------------------------------
# 5b. INDEPENDENT TASK CHECK — the task's own VERIFY, run COLD in the specimen.
#    The agent's evidence is never the harness's evidence.
# ---------------------------------------------------------------------------
t=$(date +%s)
VLOG=$RUN/verify.log
( cd "$WT" && eval "$VERIFY" ) > "$VLOG" 2>&1 </dev/null
VRC=$?
if [ $VRC -eq 0 ] && grep -qE '[0-9]+ tests?, [0-9]+ assertions?, 0 failures' "$VLOG"; then
  TASK_RESULT=PASS
elif grep -qE '0 failures\.' "$VLOG" && [ $VRC -eq 0 ]; then
  TASK_RESULT=PASS
else
  TASK_RESULT=FAIL
fi
VSUM=$(grep -oE '[0-9]+ tests?, [0-9]+ assertions?[^\n]*' "$VLOG" | tail -1)
# THE TREE THE PROOFS RAN OVER. Taken here, after the last proof has exited, so the
# window it opens is exactly acceptance-4's gap: everything that touches the subject
# between the proof producing its evidence and the freeze taking its artifact.
SRC_AT_VERIFY=$(src_index "$RUN/src-index-verify.txt")
step TASK_CHECK $(( $(date +%s) - t )) "$TASK_RESULT rc=$VRC ${VSUM:-<no kaocha summary line>} ($VLOG) gate_final_exit=$GATE_FINAL_EXIT src_hash_at_verify=${SRC_AT_VERIFY:0:16}"

# ---------------------------------------------------------------------------
# 6. FREEZE + RECEIPT
# ---------------------------------------------------------------------------
git -C "$WT" add -A >/dev/null 2>&1 </dev/null
git -C "$WT" diff --cached "$BASIS" -- . ':!00SERVER-LOGS.txt' > "$RUN/diff.patch" 2>/dev/null
git -C "$WT" reset -q >/dev/null 2>&1 </dev/null
DIFFSTAT=$(git -C "$WT" diff --stat "$BASIS" -- . ':!00SERVER-LOGS.txt' 2>/dev/null | tail -1)

# C2 — THE FROZEN ARTIFACT MUST BE THE TREE THE PROOF SAW.
SRC_AT_FREEZE=$(src_index "$RUN/src-index-freeze.txt")
FINAL_SOURCE_DRIFT=no
if [ -z "$SRC_AT_VERIFY" ] || [ -z "$SRC_AT_FREEZE" ]; then
  FINAL_SOURCE_DRIFT=unknown
elif [ "$SRC_AT_VERIFY" != "$SRC_AT_FREEZE" ]; then
  FINAL_SOURCE_DRIFT=yes
  say "$(stamp)  FINAL SOURCE DRIFT: the tracked tree changed AFTER the proofs and BEFORE the freeze. diff.patch is an artifact of a tree neither the gate nor the verify ran over [acceptance-4 PILOT-final-source-after-proof]:"
  diff "$RUN/src-index-verify.txt" "$RUN/src-index-freeze.txt" 2>&1 | head -40 | tee -a "$LOG"
fi

# C1 — THE PROFILE DIGEST MUST STILL BE THE PROFILE THIS RUN CLAIMS TO HAVE RUN UNDER.
# `profile=` was computed once, at SPECIMEN, and never re-verified. Acceptance-4's agent
# appended one line to the specimen's own CLAUDE.md — a file the run names as half of its
# own declared profile — and the receipt still said `integrity=ok` with the SPECIMEN-time
# digest. The recompute is over the run's OWN recorded component list, so a changed digest
# is attributed to a named file instead of merely noticed. The seat-global half can drift
# from outside the cell and would not appear in `diff=` at all; this sees that too.
PROFILE_RECHECK=$RUN/profile-recheck.txt
PJ="$PROFILE_JSON" python3 - > "$PROFILE_RECHECK" 2>/dev/null <<'PY' || true
import hashlib, json, os
try:
    spec = json.load(open(os.environ["PJ"]))
except Exception as e:
    print("unknown"); print(f"could not re-read the run's own instruction-profile.json: {e}"); raise SystemExit
recorded = {c["path"]: c for c in spec.get("components", [])}
h = hashlib.sha256(); drift = []
for path in spec.get("order", []):
    try:
        b = open(path, "rb").read(); present, sha = True, hashlib.sha256(b).hexdigest()
    except OSError:
        b, present, sha = b"", False, None
    h.update(b)
    was = recorded.get(path, {})
    if was.get("present") != present or was.get("sha256") != sha:
        drift.append(f"{path}: {was.get('sha256')} ({was.get('bytes')} bytes) -> {sha} ({len(b)} bytes)")
print(h.hexdigest())
for d in drift:
    print(d)
PY
PROFILE_NOW=$(head -1 "$PROFILE_RECHECK" 2>/dev/null)
PROFILE_DRIFT=no
if [ -z "$PROFILE_NOW" ] || [ "$PROFILE_NOW" = unknown ]; then
  PROFILE_DRIFT=unknown
elif [ "$PROFILE_NOW" != "$PROFILE" ]; then
  PROFILE_DRIFT=yes
fi
if [ "$PROFILE_DRIFT" != no ]; then
  say "$(stamp)  PROFILE DRIFT ($PROFILE_DRIFT): the receipt's profile=${PROFILE:0:16} recomputes to ${PROFILE_NOW:0:16} over this run's own component list. The instructions this cell claims to have run under are not the instructions on disk [acceptance-4 PILOT-profile-drift]:"
  tail -n +2 "$PROFILE_RECHECK" 2>/dev/null | head -20 | tee -a "$LOG"
fi

# kill the W JVM we started, by the exact process group we created
if [ -n "$JVM_PID" ]; then
  kill -TERM -- "-$JVM_PID" 2>/dev/null && say "$(stamp)  reaped condition-W JVM group $JVM_PID"
  sleep 2; kill -KILL -- "-$JVM_PID" 2>/dev/null
fi
# ... and the JVM the AGENT started in condition 0. Scar, pilot run 1: the harness
# reaped only its own W JVM, so a passing cond-0 run left a 512 MB nREPL alive in a
# worktree nobody would look at again. The scan is /proc + cwd + argv on the exact
# specimen path — never `pgrep -f`, never a pattern kill.
for d in /proc/[0-9]*; do
  pid=${d#/proc/}
  cwd=$(readlink "$d/cwd" 2>/dev/null) || continue
  [ "$cwd" = "$WT" ] || continue
  args=$({ tr '\0' ' ' < "$d/cmdline"; } 2>/dev/null) || continue
  case "$args" in
    *nrepl*|*java*|*clojure*)
      kill "$pid" 2>/dev/null && say "$(stamp)  reaped specimen JVM $pid (${args:0:70})" ;;
  esac
done

TOTAL=$(( $(date +%s) - T0 ))
TOTAL_MS=$(( $(now_ms) - T0_MS ))
# ---------------------------------------------------------------------------
# THE INTEGRITY GATE [B02d item 8]. A grade and a task check say what the agent's
# WORK looks like. They say nothing about whether the run that produced it was the
# run we asked for. Astra's worker exited 17 in the trace while this script recorded
# agent.rc=0, graded PASS/PASS and exited 0 — because the final predicate never asked.
# It asks now, and it fails closed on every unknown.
# ---------------------------------------------------------------------------
INTEG=""
add_i() { INTEG="$INTEG${INTEG:+,}$1"; }
case "$AGENT_RC" in
  0) : ;;
  ""|unknown) add_i "worker_exit=unknown" ;;
  *) add_i "worker_exit=$AGENT_RC" ;;
esac
[ "$CEILING" = no ] || add_i "ceiling=yes"
[ "${WORKER_STATUS_CONTRADICTION:-no}" = no ] || add_i "worker_status=contradiction"
if [ -z "$SELFAGENT" ]; then
  [ "$MODEL_OK" = verified ] || add_i "model=$MODEL_OK"
fi
# The declared GATE, cold, on the final tree. A focused VERIFY green over a suite the
# change broke is not a green cell, and until now nothing in this script asked.
case "${GATE_FINAL_EXIT:-unknown}" in
  0) : ;;
  124) add_i "gate_final=timeout" ;;
  ""|unknown) add_i "gate_final=unknown" ;;
  *) add_i "gate_final=$GATE_FINAL_EXIT" ;;
esac
# C1 and C2, failing closed on unknown like every other field here.
[ "${PROFILE_DRIFT:-unknown}" = no ] || add_i "profile_drift=${PROFILE_DRIFT:-unknown}"
[ "${FINAL_SOURCE_DRIFT:-unknown}" = no ] || add_i "final_source_drift=${FINAL_SOURCE_DRIFT:-unknown}"
INTEGRITY=${INTEG:-ok}
say ""
say "  $(printf '%-12s %8s  %s' PHASE 'WALL s' RESULT)"
say "  $(printf '%.0s-' $(seq 1 100))"
for p in "${PHASES[@]}"; do
  say "  $(printf '%-12s %8s  %s' "${p%%|*}" "$(echo "$p" | cut -d'|' -f2)" "$(echo "$p" | cut -d'|' -f3-)")"
done
say "  $(printf '%-12s %8s' TOTAL "$TOTAL")"
say ""
# B02d item 10 — every time field names a COMPLETE endpoint, and the durations come
# from /proc/uptime (CLOCK_BOOTTIME, monotonic). `launch_wall` is the agent's own
# launch→terminal-status span and is NESTED inside `total`; neither is a continuation
# economics measurement and neither is row-1 timing qualification.
LINE="COLDSTART $NAME:${SELFAGENT:+ selftest_agent=yes} model=$MODEL($MODEL_OK) cond=$COND grade=$GRADE task=$TASK_RESULT gate_final_exit=${GATE_FINAL_EXIT:-unknown} gate_final_wall=${GATE_FINAL_WALL:-unknown}s gate_final='${GATE_FINAL_SUM:-none}' integrity=$INTEGRITY delivery=$DELIVERY gate='$GATE' gate_qualify_wall=${GATE_WALL}s red_qualify_wall=${RED_WALL}s red='$RED' red_attested=$RED_ATTESTED red_golden=$RED_GOLDEN overlay='${OVERLAY_FILES:-none}' warm_first=$WARMF calls=$CALLS apparatus=$APPA agent_wall(launch_wall)=${AGENT_WALL}s(${LAUNCH_WALL_MS}ms) agent_rc=$AGENT_RC agent_rc_source='$AGENT_RC_SOURCE' worker_rc=$WORKER_RC worker_status_contradiction=$WORKER_STATUS_CONTRADICTION worker_pid=$WORKER_SHELL_PID total_wall=${TOTAL}s(${TOTAL_MS}ms) duration_source=/proc/uptime ceiling=$CEILING observer=$OBSERVER_FIELD observer_execve_lines=$OBS_EXECS profile=${PROFILE:0:16} profile_drift=${PROFILE_DRIFT:-unknown} profile_isolated=$PROFILE_ISOLATED inherited_global=${INHERITED:0:16} runner_sha256=${RUNNER_SHA:0:16} grader_sha256=${GRADER_SHA:0:16} gate_program_sha256=${GATE_SCRIPT_SHA:0:16} src_hash_at_verify=${SRC_AT_VERIFY:0:16} src_hash_at_freeze=${SRC_AT_FREEZE:0:16} final_source_drift=${FINAL_SOURCE_DRIFT:-unknown} diff='${DIFFSTAT:-none}'"
say "$LINE"
printf '%s  %s\n' "$(stamp)" "$LINE" >> "$LEDGER"
say "$(stamp)  frozen: $RUN/{transcript.*,grade.txt,grade.json,diff.patch,verify.log,gate-final.log,prompt.md,coldstart.log,gate-qualify.log,red-qualify.log,instruction-profile.json,profile-recheck.txt,src-index-{verify,freeze}.txt,observer/}"

if [ "$INTEGRITY" != ok ]; then
  say "$(stamp)  NOT CERTIFIED: run integrity is $INTEGRITY. Whatever the grade and the task check say, this run was not the run that was asked for — an uncollected or non-zero worker status, a ceiling kill, an unverified model, a declared GATE that is not green on the final tree, a drifted instruction profile, or a source tree that changed between the proof and the freeze each mean the evidence belongs to something other than the declared cell [B02d item 8; acceptance-4 §5 C1/C2 and the unmeasured half of pass criterion 3]."
fi
[ "$GRADE" = PASS ] && [ "$TASK_RESULT" = PASS ] && [ "$INTEGRITY" = ok ] && exit 0
exit 1
