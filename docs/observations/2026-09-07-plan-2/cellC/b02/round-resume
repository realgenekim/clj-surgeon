#!/usr/bin/env bash
# round-resume <worktree> <session-id> <prompt-file> [report-path] — resume an EXPLICIT,
# PERSISTED codex session in a worktree and feed it a new prompt on stdin.
#
# The sibling of ~/bin/sol-yolo for continuation work (Astra, B02 contract:
# "use explicit persisted session ID, never --last").  Two mechanical facts about
# codex 0.153.3 that this script exists to encode:
#
#   * `codex exec resume` takes NO `-C/--cd` and NO `--color`.  The working root of a
#     resumed session is the process CWD, so this script chdirs into the worktree and
#     the worktree fence is the cd, not a flag.  (`round`'s /proc discovery already
#     accepts cwd==worktree as a match, so a resumed builder is still discoverable.)
#   * options must precede the positional SESSION_ID; `--color never` is rejected
#     outright, which is how the first attempt failed.
#
# NEVER `--last`: "the most recent recorded session" is whatever else this box did
# last, which is exactly the wrong-session class Astra requires us to refuse.
#
# ---------------------------------------------------------------------------
# B02b, item 6 — CONTINUATION ADMISSION LIVES HERE TOO.
#
# Astra's finding: "Direct installed `round-resume` resumed that same session from
# **resume-b**, returned the remembered token, and exited 0 ... It checks no prior
# root."  `round` validated the history and then handed the work to a wrapper that
# validated nothing, so the gate could be walked around by calling the wrapper —
# which is a public, documented entrance, not a private implementation detail.
#
# A check that exists in only one of two entrances is not a control. This script
# now performs the SAME fail-closed admission against the SAME state directory that
# `round` uses (keyed by sha256 of the canonical worktree path), BEFORE codex is
# executed. Missing metadata refuses. Root mismatch refuses. Model mismatch refuses.
# Absence is never permission.
#
# Also item 6: the repo `.codex/config.toml` neutralisation is RESTORED on exit,
# error and signal. Renaming a repository file and leaving it renamed because the
# run failed is a mutation of the subject by the apparatus.
# ---------------------------------------------------------------------------
. "$HOME/bin/seat-tmp-guard.sh"   # temp on /var/tmp/forge, never tmpfs
set -uo pipefail
WT=${1:?worktree}; SID=${2:?session-id}; PF=${3:?prompt-file}; OUT=${4:-$WT/../sol-report.md}
[ -d "$WT" ] || { echo "round-resume: no such worktree: $WT" >&2; exit 2; }
[ -f "$PF" ] || { echo "round-resume: no such prompt file: $PF" >&2; exit 2; }
case "$WT" in /home/forge/src/clj-surgeon|/home/forge/src/clj-surgeon/)
  echo "round-resume: refusing: that checkout serves my MCP server on 7906" >&2; exit 3;; esac
case "$SID" in
  --last|--*) echo "round-resume: refusing '$SID' — resume takes an explicit session uuid, never a flag (no --last)" >&2; exit 3 ;;
  [0-9a-fA-F]*-*-*-*-*) ;;
  *) echo "round-resume: refusing '$SID' — not a session uuid" >&2; exit 3 ;;
esac

# ---------------------------------------------------------------------------
# HISTORICAL ADMISSION — the same state dir, the same rules, before any launch.
# ---------------------------------------------------------------------------
WTC=$(readlink -f "$WT")
RSTATE=/var/tmp/forge/round/state/$(printf '%s' "$WTC" | sha256sum | cut -d' ' -f1)
MODEL=${CODEX_MODEL:-gpt-5.6-sol}
# The per-seat key that `round`'s wait(2) path signs a COLLECTED terminal status with
# [B02e item 8]. Read-only here: this entrance verifies, it never signs — a wrapper that
# could mint its own attestation would be the same hole in a new coat. Never printed.
ROUND_KEYFILE=/var/tmp/forge/round/state/.key
refuse() { echo "round-resume: REFUSED $*" >&2; exit 3; }

[ -s "$RSTATE/session.json" ] || refuse "resume-no-metadata: $RSTATE/session.json does not exist, so nothing is known about session $SID for root '$WTC' — not its root, not its model, not its settings, not how it ended. A continuation with no history is a fresh session wearing a session id."
# THE EFFECTIVE SETTINGS OF *THIS* INVOCATION — computed from the very flags the
# exec below passes, so the comparison is against what will actually run, not against
# a remembered intention. B02d item 3: "nonempty settings are not matching settings".
EFF_PROVIDER=${CODEX_PROVIDER:-openai}
EFF_APPROVAL=never                 # --dangerously-bypass-approvals-and-sandbox
EFF_SANDBOX=danger-full-access     # --dangerously-bypass-approvals-and-sandbox
EFF_REASONING=high                 # -c model_reasoning_effort="high"
# The EFFECTIVE INSTRUCTION PROFILE: the seat-global prompt files both runners inherit
# plus the repo's own, hashed in a fixed order. A continuation into a changed prompt is
# an unmeasured environment change, which is the same class as a changed model.
EFF_PROFILE=$(cat "$HOME/.claude/CLAUDE.md" "$HOME/.codex/AGENTS.md" \
  "$WT/AGENTS.md" "$WT/CLAUDE.md" 2>/dev/null | sha256sum | cut -d' ' -f1)

_meta=$(EFF_PROVIDER="$EFF_PROVIDER" EFF_APPROVAL="$EFF_APPROVAL" EFF_SANDBOX="$EFF_SANDBOX" \
        EFF_REASONING="$EFF_REASONING" EFF_PROFILE="$EFF_PROFILE" \
        ROUND_HMAC_KEY="$ROUND_KEYFILE" \
        python3 - "$RSTATE/session.json" <<'PY' 2>/dev/null
import hashlib, hmac, json, os, shlex, sys
try:
    r = json.load(open(sys.argv[1]))
except Exception as ex:
    print("META_OK=0"); print("META_ERR=" + shlex.quote(str(ex))); raise SystemExit
if not isinstance(r, dict):
    print("META_OK=0"); print("META_ERR=" + shlex.quote("session.json is not a JSON object")); raise SystemExit
env = os.environ
s = r.get("settings")
s = s if isinstance(s, dict) else {}
# key -> the value THIS invocation will run under.  Equality, key by key.
WANT = {"provider": env["EFF_PROVIDER"], "approval": env["EFF_APPROVAL"],
        "sandbox": env["EFF_SANDBOX"], "reasoning effort": env["EFF_REASONING"]}
missing, differ = [], []
for k, want in sorted(WANT.items()):
    got = s.get(k)
    if got is None or str(got).strip() == "":
        missing.append(k)
    elif str(got).strip() != want:
        differ.append(f"{k}: recorded {got!r}, this invocation runs {want!r}")
# the effective instruction profile is part of the environment being continued
prof = r.get("instruction_profile_sha256")
if not prof:
    missing.append("instruction_profile_sha256")
elif str(prof) != env["EFF_PROFILE"]:
    differ.append(f"instruction profile: recorded {str(prof)[:16]}…, "
                  f"this invocation runs {env['EFF_PROFILE'][:16]}…")
# a terminal label is only a RESULT if this apparatus collected a wait status for it
basis = str(r.get("terminal_status_basis") or "")
# B02e item 8 — A LABEL IS VERIFIED ONLY IF THE RECORD IS SIGNED BY THIS SEAT.
# What stood here was `basis.startswith("wait(2)")`: a substring test over a field in
# this very file, which nothing authenticated. Acceptance-3 NA-7 wrote the basis
# "wait(2) collected by nobody at all" and was ADMITTED as a verified prior
# termination. The upgrade now requires an HMAC-SHA256 over the label AND the evidence
# it rests on — session, root, worktree, status, basis, the collecting pid, the boot id
# and that pid's starttime, the round's name and the moment it was recorded — made with
# the per-seat key only `round`'s wait(2) path can use. No key, no MAC, a MAC that does
# not verify, or any bound field edited after signing all mean the same thing:
# carried(unverified). The reason is carried out with the label, because a refusal to
# upgrade that cannot say why is just a different unexplained string.
att = r.get("terminal_status_attestation")
att = att if isinstance(att, dict) else {}
mac = str(att.get("mac") or "")
verified = False
if not basis.startswith("wait(2)"):
    why = "the recorded basis is not a wait(2) collection"
elif not mac:
    why = "unsigned: nothing attested that this status was collected"
else:
    try:
        with open(os.environ.get("ROUND_HMAC_KEY") or "", "rb") as kfh:
            key = kfh.read().strip()
    except OSError:
        key = b""
    if not key:
        why = "this seat holds no signing key, so no record can be shown to be its own"
    else:
        payload = "\n".join([
            "round-terminal-status-v1",
            str(r.get("session_id") or ""), str(r.get("root") or ""),
            str(r.get("worktree") or ""), str(r.get("terminal_status") or ""),
            basis, str(r.get("terminal_status_pid") or ""),
            str(r.get("terminal_status_boot_id") or ""),
            str(r.get("terminal_status_starttime") or ""),
            str(r.get("round") or ""), str(r.get("recorded_utc") or ""),
        ]).encode()
        verified = hmac.compare_digest(
            hmac.new(key, payload, hashlib.sha256).hexdigest(), mac)
        why = "" if verified else ("the attestation does not verify — this record was "
                                   "not written by this seat's round wait(2) path, or a "
                                   "signed field was edited after it was written")
print("META_OK=1")
for k, v in (("PREV_ROOT", r.get("root")), ("PREV_MODEL", r.get("model")),
             ("PREV_MODEL_REQ", r.get("model_requested")),
             ("PREV_STATUS", r.get("terminal_status")), ("PREV_SID", r.get("session_id")),
             ("PREV_BASIS", basis or "none recorded"),
             ("PREV_BASIS_WHY", why),
             ("PREV_STATUS_LABEL", (str(r.get("terminal_status") or "unknown") + "(wait2,signed)")
              if verified else ("carried(unverified)")),
             ("SET_MISSING", ", ".join(missing)),
             ("SET_DIFFER", "; ".join(differ)),
             ("PREV_SETTINGS", ";".join(f"{k2}={v2}" for k2, v2 in sorted(s.items()) if v2))):
    print(f"{k}=" + shlex.quote("" if v is None else str(v)))
PY
)
eval "$_meta"
: "${META_OK:=0}" "${META_ERR:=unreadable}" "${PREV_ROOT:=}" "${PREV_MODEL:=}" \
  "${PREV_MODEL_REQ:=}" "${PREV_STATUS:=}" "${PREV_SID:=}" "${PREV_SETTINGS:=}" \
  "${SET_MISSING:=}" "${SET_DIFFER:=}" "${PREV_BASIS:=none recorded}" \
  "${PREV_STATUS_LABEL:=carried(unverified)}" "${PREV_BASIS_WHY:=no attestation was evaluated}"
[ "$META_OK" = 1 ] || refuse "resume-bad-metadata: $RSTATE/session.json could not be read as a session record ($META_ERR)"
[ -n "$PREV_ROOT" ] || refuse "resume-missing-root: $RSTATE/session.json records no root for session $SID. An unknown previous root cannot be compared with '$WTC'."
[ "$PREV_ROOT" = "$WTC" ] || refuse "resume-root-mismatch: session $SID was recorded against root '$PREV_ROOT'; this invocation asks to continue it in '$WTC'. A scope change gets a deliberate fresh session, never a resume."
[ -n "$PREV_MODEL$PREV_MODEL_REQ" ] || refuse "resume-missing-model: $RSTATE/session.json records no model for session $SID (neither an observed model: line nor the model that was requested). Resuming into an unknown model is an unmeasured environment change."
PM=${PREV_MODEL:-$PREV_MODEL_REQ}
[ "${PM%% *}" = "$MODEL" ] || refuse "resume-model-mismatch: session $SID ran on '$PM'; this invocation asks for '$MODEL'."
[ -n "$PREV_SETTINGS" ] || refuse "resume-missing-settings: $RSTATE/session.json records no provider/approval/sandbox/reasoning settings for session $SID. Unrecorded settings are unverified settings."
# B02d item 3 — EQUALITY, not non-emptiness. A recorded setting that differs from the
# setting this invocation will actually run under is an environment change wearing a
# session id, and it is refused BEFORE any model is executed.
# ONE refusal naming EVERY discrepancy [B02d item 3]. Reporting the first one
# found would hide a settings mismatch behind an unrecorded field, and the
# mismatch is the finding.
if [ -n "$SET_MISSING$SET_DIFFER" ]; then
  refuse "resume-settings-mismatch: session $SID does not match the effective settings of this invocation.${SET_DIFFER:+ DIFFERENT: $SET_DIFFER.}${SET_MISSING:+ UNRECORDED (an effective setting that was never written down cannot be compared, and absence is never permission): $SET_MISSING.} Continuing a session into a different effective environment measures neither the old one nor the new one."
fi
[ -n "$PREV_SID" ] || refuse "resume-missing-session-id: $RSTATE/session.json records no session_id to compare '$SID' against"
[ "$PREV_SID" = "$SID" ] || refuse "resume-state-inconsistent: asked to continue '$SID' but $RSTATE/session.json records session '$PREV_SID' for this root"
[ -n "$PREV_STATUS" ] || PREV_STATUS=unknown
echo "round-resume: ADMITTED session=$SID root='$PREV_ROOT' model='$PM' settings='$PREV_SETTINGS'==effective(provider=$EFF_PROVIDER;approval=$EFF_APPROVAL;sandbox=$EFF_SANDBOX;reasoning effort=$EFF_REASONING) instruction_profile=${EFF_PROFILE:0:16} previous_terminal_status=$PREV_STATUS_LABEL (stored label '$PREV_STATUS', basis: $PREV_BASIS)${PREV_BASIS_WHY:+ [not upgraded: $PREV_BASIS_WHY]}" >&2

# ---------------------------------------------------------------------------
# Same MCP fence as sol-yolo: a repo-declared server may point at a port this seat must
# never contact (curtain-call declares clj-surgeon on 7888 = another seat's production).
# RESTORED on every exit path — success, failure, or signal.
# ---------------------------------------------------------------------------
MOVED=""
restore_config() {
  [ -n "$MOVED" ] || return 0
  if [ -f "$MOVED" ]; then
    mv "$MOVED" "$WT/.codex/config.toml" \
      && echo "round-resume: restored $WT/.codex/config.toml" >&2 \
      || echo "round-resume: WARNING could not restore $WT/.codex/config.toml from $MOVED" >&2
  fi
  MOVED=""
}
trap 'restore_config' EXIT
trap 'restore_config; exit 130' INT
trap 'restore_config; exit 143' TERM

if [ -f "$WT/.codex/config.toml" ]; then
  for n in $(grep -oE '^\[mcp_servers\.[^]]+\]' "$WT/.codex/config.toml" | sed -E 's/\[mcp_servers\.([^]]+)\]/\1/'); do
    echo "round-resume: neutralising repo-declared MCP server '$n'" >&2
  done
  MOVED=$WT/.codex/config.toml.disabled-by-round-resume
  mv "$WT/.codex/config.toml" "$MOVED"
fi

cd "$WT" || refuse "cannot chdir to $WT"
"${CODEX_BIN:-/usr/bin/codex}" exec resume \
  --skip-git-repo-check --dangerously-bypass-approvals-and-sandbox \
  -m "$MODEL" -c 'model_reasoning_effort="high"' \
  -o "$OUT.last.md" "$SID" - < "$PF"
rc=$?
if [ ! -s "$OUT" ] && [ -s "$OUT.last.md" ]; then cp "$OUT.last.md" "$OUT"; fi
restore_config
exit $rc
