+(deftest bridge4-keyword-check-force-end-and-cancel-semantics
+  (reset! channel/bridge3-convos {})
+  (reset! channel/bridge4-keyword-seen {:order [] :m {}})
+  (testing "force_end finalizes through the normal enqueue path without an end word"
+    (with-redefs [groq/transcribe-audio (fn [_] {:transcript "send this now"})]
+      (let [tmp (java.io.File/createTempFile "b4k-force" ".webm")
+            body (read-json (channel/handle-bridge4-keyword-check
+                              {:params {:seat "b4force" :end "over" :force_end "1"
+                                        :dedup_id "forced-1"
+                                        :audio {:tempfile tmp :filename "k.webm"}}}))]
+        (is (true? (:ended body)))
+        (is (= "send this now" (:transcript body)))
+        (is (= ["send this now"]
+               (mapv :text (get-in @channel/channel-state [:messages "b4force"]))))
+        (.delete tmp))))
+  (testing "cancel remains a non-ended transcript when force_end is absent"
+    (with-redefs [groq/transcribe-audio (fn [_] {:transcript "cancel"})]
+      (let [tmp (java.io.File/createTempFile "b4k-cancel" ".webm")
+            body (read-json (channel/handle-bridge4-keyword-check
+                              {:params {:seat "b4cancel" :end "over"
+                                        :audio {:tempfile tmp :filename "k.webm"}}}))]
+        (is (false? (:ended body)))
+        (is (= "cancel" (:transcript body)))
+        (is (empty? (get-in @channel/channel-state [:messages "b4cancel"])))
+        (.delete tmp)))))
+
 (deftest bridge4-keyword-check-blank-and-bad-seat
   (testing "blank STT (road-noise pause) => ended=false, no enqueue, NOT an error"
     (with-redefs [groq/transcribe-audio (fn [_] {:transcript "   "})]
