+(ns marvin-voice-remote.clock)
+
+(def ^:dynamic *now-ms-fn*
+  "The server wall-clock source, exposed for deterministic bindings."
+  (fn [] (System/currentTimeMillis)))
+
+(defn now-ms
+  "Return the current server wall-clock time in epoch milliseconds."
+  ^long []
+  (long (*now-ms-fn*)))
+
+(defn fixed
+  "Return a clock source fixed at the supplied epoch millisecond value."
+  [ms]
+  (fn [] (long ms)))
