# Independent of the gate: requires only the three SOURCE namespaces, never
# fixture.fanout-test. Asserts the end state, both traps, and that the old name
# is gone from code while surviving in the docstring and the string literal.
FANOUT_ACCEPT = r"""(require 'fixture.util 'fixture.scope 'fixture.paths)
(let [np (resolve 'fixture.util/normalize-path)
      ex (resolve 'fixture.scope/expand)
      ad (resolve 'fixture.scope/admits?)
      jn (resolve 'fixture.paths/join)
      rl (resolve 'fixture.paths/relative-to)
      ca (resolve 'fixture.paths/clean-all)]
  (assert np "normalize-path resolves")
  (assert (nil? (resolve 'fixture.util/normalize)) "the old name is gone from code")
  (assert (= "a//b" (np "  a//b//  ")) "1-arity trims and drops trailing slashes")
  (assert (= "" (np "   ")) "1-arity on blank")
  (assert (= "a/b" (np "  a//b//  " {:strict? true})) ":strict? collapses inner slashes")
  (assert (= "a//b" (np "a//b" nil)) "nil opts is lenient")
  (assert (= ["src" "test"] (ex ["test/"])) "expand 1-arity unchanged")
  (assert (= ["src" "a//b"] (ex ["a//b/"])) "expand lenient by default")
  (assert (= ["src" "a/b"] (ex ["a//b/"] {:strict? true})) "expand threads :strict?")
  (assert (true? (ad "src/")) "admits? still works")
  (assert (= "a/b" (jn ["a" "b/"])) "join 1-arity")
  (assert (= "a//b" (jn ["a" "" "b"])) "join lenient by default")
  (assert (= "a/b" (jn ["a" "" "b"] {:strict? true})) "join threads :strict?")
  (assert (= "a/b" (rl "src/" "src/a/b")) "relative-to")
  (assert (= ["a" "b"] (ca ["a/" "b//"])) "clean-all")
  (assert (= "normalize" @(resolve 'fixture.paths/op-name)) "TRAP: string literal intact")
  (assert (re-find #"\(normalize " (:doc (meta jn))) "TRAP: docstring example intact")
  (println "ACCEPT-OK"))"""

# ---- mission 4: real-1 (the REAL-REPOSITORY mission) ----------------------
#
# The first three missions are five-file toy fixtures. Every ratio measured on
# them was measured against a gate that costs ~70 ms. This mission is the same
# protocol pointed at THIS repository: the preimage is a byte-for-byte copy of
# a real src file and its real focused test namespace, read out of git at a
# pinned sha, with nothing invented but the two files a standalone project
# needs (deps.edn and .clj-surgeon.edn).
#
# The change: rename the public `finding-identity` to `finding-fingerprint`
# and the private helper `field` to `finding-field`, across every call site in
# clj-surgeon.diagnostic-delta. TWO spans in the same file must NOT change:
# the `let` binding named `identity` inside `representative-difference` (a
# local, not the function) and the sentence in the docstring that uses the word
# "identity" as a concept. A blind search-and-replace fails the mission.
#
# The gate is the REAL test namespace with its two `delta/finding-identity`
# references moved to the post-change name -- a red test, in the TDD sense.
# Nothing else in it changes and it is NOT mutable: a candidate that satisfies
# the gate by editing it fails acceptance on byte identity.

REAL1_REPO = os.environ.get("TYPIST_REAL1_REPO",
                            "/home/forge/src/clj-surgeon-fable-typist")
REAL1_SHA = "f2efc87c72659489544ac996c392233f4ec29172"
REAL1_SRC = "src/clj_surgeon/diagnostic_delta.clj"
REAL1_TEST = "test/clj_surgeon/diagnostic_delta_test.clj"

REAL1_EDN = (
    '{:verification-profiles\n'
    ' {"typist-real-1"\n'
    '  {:commands [["bb" "-cp" "src:test" "-e"\n'
    '               "(require \'clojure.test \'clj-surgeon.diagnostic-delta-test)'
    ' (let [r (clojure.test/run-tests \'clj-surgeon.diagnostic-delta-test)]'
    ' (System/exit (if (and (zero? (:fail r)) (zero? (:error r))) 0 1)))"]]}}}\n'
)


def real1_blob(rel):
    """The file's bytes as of REAL1_SHA. Never the working tree: a preimage
    read from a dirty checkout is not a preimage."""
    r = subprocess.run(["git", "show", "%s:%s" % (REAL1_SHA, rel)],
                       cwd=REAL1_REPO, capture_output=True, text=True)
    if r.returncode != 0:
        die("typist-run: refusing — cannot read %s at %s from %s: %s"
            % (rel, REAL1_SHA[:8], REAL1_REPO, (r.stderr or "").strip()), 5)
    return r.stdout


def real1_seed():
    """The preimage: two real files, verbatim, plus the two project files a
    standalone copy needs. The ONE edit is the gate's two references."""
    src = real1_blob(REAL1_SRC)
    test = real1_blob(REAL1_TEST)
    n = test.count("delta/finding-identity")
    if n != 2:
        die("typist-run: refusing — real-1 expected exactly 2 "
            "`delta/finding-identity` references in %s at %s, found %d"
            % (REAL1_TEST, REAL1_SHA[:8], n), 5)
    test = test.replace("delta/finding-identity", "delta/finding-fingerprint")
    return {"deps.edn": '{:paths ["src" "test"]}\n',
            ".clj-surgeon.edn": REAL1_EDN,
            REAL1_SRC: src,
            REAL1_TEST: test}


# Independent of the gate: it never loads clj-surgeon.diagnostic-delta-test.
# Behaviour through the renamed vars, both do-not-change spans checked in the
# source text, and no residue of either old name.
REAL1_ACCEPT = r"""(require 'clj-surgeon.diagnostic-delta)
(let [ff (resolve 'clj-surgeon.diagnostic-delta/finding-fingerprint)
      fld (resolve 'clj-surgeon.diagnostic-delta/finding-field)
      dd (resolve 'clj-surgeon.diagnostic-delta/diagnostic-delta)
      nf (resolve 'clj-surgeon.diagnostic-delta/normalize-filename)
      src (slurp "src/clj_surgeon/diagnostic_delta.clj")
      w {:filename "src/sample/core.clj" :type :unresolved-symbol
         :level :warning :message "Unresolved symbol: legacy" :row 4 :col 7}]
  (assert ff "finding-fingerprint resolves")
  (assert (nil? (resolve 'clj-surgeon.diagnostic-delta/finding-identity))
          "the old public name is gone")
  (assert fld "the private helper is renamed to finding-field")
  (assert (nil? (resolve 'clj-surgeon.diagnostic-delta/field))
          "the old private helper name is gone")
  (assert (= {:filename "src/sample/core.clj" :type :unresolved-symbol
              :level :warning :message "Unresolved symbol: legacy"}
             (ff w))
          "fingerprint drops row/col")
  (assert (= (ff w) (ff (assoc w :filename "./src/sample/core.clj")))
          "fingerprint still normalises dot-relative paths")
  (assert (= (ff w) (ff (assoc w :filename "src\\sample\\core.clj")))
          "fingerprint still normalises windows paths")
  (assert (= "src/a.clj" (nf "./src/a.clj")) "normalize-filename unchanged")
  (assert (:ok (dd {:findings []} {:findings []})) "empty delta is ok")
  (assert (false? (:ok (dd {:findings []} {:findings [w]})))
          "a new warning blocks")
  (assert (= 1 (:introduced-count (dd {:findings []} {:findings [w]})))
          "introduced-count")
  (assert (:ok (dd {:findings [w]} {:findings [(assoc w :row 400)]}))
          "line drift is not a regression")
  (assert (= :invalid-diagnostic-snapshot
             (:error-type (dd nil {:findings []})))
          "malformed snapshots still refuse")
  (assert (re-find #"\(get remaining identity 0\)" src)
          "TRAP: the local binding named `identity` is intact")
  (assert (re-find
            #"location-independent identity used for diagnostic multiset deltas"
            src)
          "TRAP: the docstring sentence is intact")
  (assert (not (re-find #"finding-identity" src))
          "no residual old public name in the source")
  (assert (not (re-find #"\(defn- field" src))
          "no residual old private helper definition")
  (println "ACCEPT-OK"))"""


# ---- missions 5 & 6: real-2 / real-2j (the GATE-DOMINATED variants) -------
#
# real-1 measured the fast typist against a gate that costs 0.06 s (babashka,
# one focused namespace). That flatters the typist: whatever the model saves is
# nearly the whole wall. real-2 and real-2j change ONE thing — the proof
# profile — and nothing else: same preimage bytes, same change, same traps,
# same independent acceptance witness, same authorized file.
#
#   real-2   the SAME focused namespace, run on the JVM (~0.75 s cold).
#   real-2j  a broader honest set that still exercises the change: three real
#            test namespaces from this repository, two of which load
#            clj-surgeon.diagnostic-delta transitively through
#            clj-surgeon.mcp-change-buffer and clj-surgeon.mcp-admit-tool.
#            (~18 s cold.) clj-surgeon.analyzer-contract-test was measured and
#            REJECTED from the set: it asserts on clojure.test's global report
#            counters and fails when run after another namespace — an
#            order-dependent test is not an honest gate.
#
# The JVM classpath is resolved ONCE from this repository's
# :clj-surgeon/mcp-test alias and baked into the profile, because a candidate
# workspace is a standalone two-file project that cannot resolve deps itself.
# The candidate's own `src` and `test` come FIRST, so the candidate's file is
# what loads; the repository entries are only there so the JVM has clojure and,
# for real-2j, the additional test namespaces.

REAL2_CP_CACHE = {}


def real2_classpath(jars_only):
    """`clojure -Spath -A:clj-surgeon/mcp-test` from the real repository, with
    relative entries made absolute and the candidate's own src/test in front.
    jars_only drops the repository's source/test roots: real-2's gate must see
    ONLY the candidate's two files."""
    key = bool(jars_only)
    if key in REAL2_CP_CACHE:
        return REAL2_CP_CACHE[key]
    r = subprocess.run(["clojure", "-Spath", "-A:clj-surgeon/mcp-test"],
                       cwd=REAL1_REPO, capture_output=True, text=True, timeout=300)
    if r.returncode != 0:
        die("typist-run: refusing — cannot resolve the JVM classpath for the "
            "real-2 gate: %s" % (r.stderr or "").strip(), 5)
    REAL2_SPATH_RAW[key] = r.stdout.strip()
    entries = []
    for e in r.stdout.strip().split(os.pathsep):
        if not e:
            continue
        p = e if os.path.isabs(e) else os.path.join(REAL1_REPO, e)
        if jars_only and not p.endswith(".jar"):
            continue
        entries.append(p)
    if not entries:
        die("typist-run: refusing — the resolved JVM classpath is empty", 5)
    cp = os.pathsep.join(["src", "test"] + entries)
    REAL2_CP_CACHE[key] = cp
    return cp


REAL2_NSS = ["clj-surgeon.diagnostic-delta-test"]
REAL2J_NSS = ["clj-surgeon.diagnostic-delta-test",
              "clj-surgeon.mcp-change-buffer-test",
              "clj-surgeon.mcp-compact-location-test",
              "clj-surgeon.ns-isolation-test"]


def real2_gate_argv(nss, jars_only):
    quoted = " ".join("'" + n for n in nss)
    expr = ("(require 'clojure.test %s)"
            " (let [r (apply clojure.test/run-tests '(%s))]"
            " (System/exit (if (and (zero? (:fail r)) (zero? (:error r))) 0 1)))"
            % (quoted, " ".join(nss)))
    return ["java", "-cp", real2_classpath(jars_only), "clojure.main", "-e", expr]


def real2_edn(profile, nss, jars_only):
    argv = real2_gate_argv(nss, jars_only)
    return ('{:verification-profiles\n'
            ' {%s\n'
            '  {:commands [[%s]]}}}\n'
            % (edn_str(profile), "\n               ".join(edn_str(a) for a in argv)))


def real2_seed_factory(profile, nss, jars_only):
    """The real-1 preimage with ONE file different: `.clj-surgeon.edn`, whose
    single verification profile is the JVM gate instead of the bb gate."""
    def seed():
        s = real1_seed()
        s[".clj-surgeon.edn"] = real2_edn(profile, nss, jars_only)
        return s
    return seed


