        "profile": "typist-fanout",
        "mutable": ["src/fixture/util.clj", "src/fixture/scope.clj",
                    "src/fixture/paths.clj"],
        "accept_expr": FANOUT_ACCEPT,
        "accept_desc": ("independent behavioural witness (fixture.util/scope/paths only, "
                        "never the gate's test ns) + both traps + preimage byte identity"),
    },
}

# Bound at startup from the selected mission; every judging function reads them.
MISSION = None
DOSSIER = None
PREIMAGE = None
MANIFEST = None
PROFILE = None
MUTABLE = None
ACCEPT_EXPR = None


def select_mission(name, dossier=None, fixture=None):
    """Bind the module-level mission state. Refuses an unknown mission."""
    global MISSION, DOSSIER, PREIMAGE, MANIFEST, PROFILE, MUTABLE, ACCEPT_EXPR
    if name not in MISSIONS:
        die("typist-run: refusing — unknown mission %r (known: %s)"
            % (name, ", ".join(sorted(MISSIONS))), 7)
    m = MISSIONS[name]
    MISSION = name
    DOSSIER = os.path.abspath(dossier) if dossier else m["dossier"]
    PREIMAGE = os.path.abspath(fixture) if fixture else m["preimage"]
    MANIFEST = PREIMAGE + ".manifest.edn"
    PROFILE = m["profile"]
    mut = m["mutable"]
    MUTABLE = list(mut) if isinstance(mut, (list, tuple)) else [mut]
    ACCEPT_EXPR = m["accept_expr"]
    return m


def mission_for_dossier(path):
    """The mission whose dossier basename this is. Refuses an unpaired dossier."""
    base = os.path.basename(os.path.abspath(path))
    for name, m in MISSIONS.items():
        if os.path.basename(m["dossier"]) == base:
            return name
    die("typist-run: refusing — dossier %s is not paired with a mission. "
        "Pass --mission explicitly, or register it in MISSIONS." % path, 7)


def die(msg, code=1):
    sys.stderr.write(msg + "\n")
    sys.exit(code)


def sha256_bytes(b):
    return hashlib.sha256(b).hexdigest()


def edn_str(s):
    return '"' + s.replace("\\", "\\\\").replace('"', '\\"') + '"'


def edn(v, indent=0):
    pad = " " * indent
    if isinstance(v, dict):
        items = []
        for k, val in v.items():
            items.append(pad + " :" + k + " " + edn(val, indent + 2 + len(k)))
        return "{" + "\n".join(items).lstrip() + "}"
    if isinstance(v, (list, tuple)):
        return "[" + "\n ".join(edn(x, indent + 1) for x in v) + "]"
    if isinstance(v, bool):
        return "true" if v else "false"
    if v is None:
        return "nil"
    if isinstance(v, str):
        return edn_str(v)
    if isinstance(v, float):
        return "%.3f" % v
    return str(v)


# --------------------------------------------------------------------------
# fixture

def tree_files(root):
    out = []
    for dirpath, dirnames, filenames in os.walk(root):
        dirnames[:] = [d for d in dirnames if d != ".git"]
        for f in filenames:
            p = os.path.join(dirpath, f)
            out.append(os.path.relpath(p, root))
    return sorted(out)


def materialize_fixture(force=False):
    """(Re)build the frozen preimage plus its content-hash manifest."""
    if os.path.isdir(PREIMAGE) and not force:
        pass
    else:
        shutil.rmtree(PREIMAGE, ignore_errors=True)
        for rel, body in MISSIONS[MISSION]["seed"].items():
            p = os.path.join(PREIMAGE, rel)
            os.makedirs(os.path.dirname(p), exist_ok=True)
            with open(p, "w") as fh:
                fh.write(body)
    man = {}
    for rel in tree_files(PREIMAGE):
        with open(os.path.join(PREIMAGE, rel), "rb") as fh:
            man[rel] = sha256_bytes(fh.read())
    with open(MANIFEST, "w") as fh:
        fh.write("{:preimage %s\n :files\n {%s}}\n" % (
            edn_str(PREIMAGE),
            "\n  ".join('%s %s' % (edn_str(k), edn_str(v)) for k, v in sorted(man.items()))))
    return man


def resolve_gate_commands():
    """The verification profile the ledger resolves for this workspace, read
    from the PREIMAGE `.clj-surgeon.edn` at plan time (mission/resolve-verification
    copies the commands once, at plan time, and the mission carries them)."""
    r2 = subprocess.run(
        ["bb", "-e",
         '(require (quote [cheshire.core :as j])) '
         '(println (j/generate-string (:commands (get (:verification-profiles '
         '(clojure.edn/read-string (slurp ".clj-surgeon.edn"))) "%s"))))' % PROFILE],
        cwd=PREIMAGE, capture_output=True, text=True, timeout=120)
    if r2.returncode != 0:
        die("typist-run: cannot serialize verification profile: %s" % r2.stderr.strip(), 5)
    cmds = json.loads(r2.stdout.strip())
    if not cmds:
        die("typist-run: verification profile %r configures no commands" % PROFILE, 5)
    return cmds


# --------------------------------------------------------------------------
# candidate evaluation

def fresh_copy(dest):
    shutil.rmtree(dest, ignore_errors=True)
    shutil.copytree(PREIMAGE, dest)
    subprocess.run(["git", "init", "-q", "."], cwd=dest, check=True,
                   capture_output=True)
    subprocess.run(["git", "add", "-A"], cwd=dest, check=True, capture_output=True)
    subprocess.run(["git", "-c", "user.email=typist@anvil", "-c", "user.name=typist",
                    "commit", "-qm", "preimage"], cwd=dest, check=True, capture_output=True)
    return dest


DIFF_START = re.compile(r"^(diff --git |--- )", re.M)


def extract_diff(text):
    """The unified diff inside a model response; None when there is none."""
    if not text:
        return None
    t = text.replace("\r\n", "\n")
    # strip a single fenced block if the whole diff is fenced
    fence = re.search(r"```(?:diff|patch)?\n(.*?)```", t, re.S)
    if fence and DIFF_START.search(fence.group(1)):
        t = fence.group(1)
    m = DIFF_START.search(t)
    if not m:
        return None
    body = t[m.start():]
    body = re.sub(r"\n```.*$", "\n", body, flags=re.S)
    if not body.endswith("\n"):
        body += "\n"
    return body


# --------------------------------------------------------------------------
# the context-anchored hunk applier
#
# gpt-oss-120b (like Codex's own apply_patch format) emits hunks with a BARE
# `@@` header and no line ranges, and sometimes omits the `diff --git` line.
# That is a context-anchored patch, not a malformed one: the hunk locates itself
# by its context and `-` lines rather than by line numbers. `git apply` cannot
# read it, so the runner does — as a FALLBACK, only after git apply refuses.
#
# It never repairs whitespace INSIDE a line. A `+` line carrying an extra
# leading space is written exactly as the model emitted it, and the gate and the
# acceptance check do the judging.

HUNK_HEADER = re.compile(r"^@@")


def parse_unified(diff_text):
    """[{:path p :hunks [[(marker, text), ...], ...]}] — `diff --git` optional,
    hunk ranges optional. Returns None when there is no file block at all."""
    lines = diff_text.split("\n")
    blocks, i, n = [], 0, len(lines)
    while i < n:
        line = lines[i]
        if line.startswith("--- "):
            old = line[4:].strip()
            if i + 1 >= n or not lines[i + 1].startswith("+++ "):
                i += 1
                continue
            new = lines[i + 1][4:].strip()
            path = new if new not in ("/dev/null", "") else old
            for pre in ("a/", "b/"):
                if path.startswith(pre):
                    path = path[2:]
            path = path.split("\t")[0].strip()
            i += 2
            hunks = []
            while i < n and HUNK_HEADER.match(lines[i]):
                i += 1
                body = []
                while i < n:
                    l = lines[i]
                    if HUNK_HEADER.match(l) or l.startswith("--- ") or \
                       l.startswith("diff --git ") or l.startswith("```"):
                        break
                    if l == "":
                        # a bare empty line inside a hunk is an empty context line
                        body.append((" ", ""))
                    elif l[0] in " +-":
                        body.append((l[0], l[1:]))
                    elif l.startswith("\\ No newline"):
                        pass
                    else:
                        break
                    i += 1
                if body:
                    hunks.append(body)
            if hunks:
                blocks.append({"path": path, "hunks": hunks})
        else:
            i += 1
    return blocks or None


def safe_path(workdir, rel):
    full = os.path.realpath(os.path.join(workdir, rel))
    root = os.path.realpath(workdir)
    return full if full == root or full.startswith(root + os.sep) else None


def apply_anchored(workdir, diff_text):
    """Locate every hunk by VERBATIM context, require exactly one match, and
    splice. -> (ok, detail)"""
    blocks = parse_unified(diff_text)
    if not blocks:
        return False, "anchor: no file block in the response"
    staged = {}
    for b in blocks:
        full = safe_path(workdir, b["path"])
        if full is None:
            return False, "anchor: path escapes the workspace: " + b["path"]
        if not os.path.isfile(full):
            return False, "anchor: no such file: " + b["path"]
        with open(full) as fh:
            cur = fh.read().split("\n")
        for body in b["hunks"]:
            old = [t for (m, t) in body if m in " -"]
            new = [t for (m, t) in body if m in " +"]
            if not old:
                return False, "anchor: hunk has no context to locate it"
            hits = [j for j in range(len(cur) - len(old) + 1)
                    if cur[j:j + len(old)] == old]
            if not hits:
                return False, "anchor: no match in " + b["path"]
            if len(hits) > 1:
                return False, "anchor: ambiguous (%d) in %s" % (len(hits), b["path"])
            j = hits[0]
            cur = cur[:j] + new + cur[j + len(old):]
        staged[full] = "\n".join(cur)
    for full, text in staged.items():
        with open(full, "w") as fh:
            fh.write(text)
    return True, "anchored: %d file block(s)" % len(blocks)


def apply_diff(workdir, diff_text):
    """git apply --check then git apply. -> (ok, detail)

    The candidate's bytes are RETAINED at `candidate.diff` whether it applies or
    not: the preregistration says failed candidates are counted, never dropped,
    and a malformed diff is the evidence for the defect class that produced it.
    Nothing here repairs the bytes — apply, gate and acceptance do the judging."""
    with open(os.path.join(workdir, "candidate.diff"), "w") as fh:
        fh.write(diff_text)
    patch = os.path.join(workdir, ".typist.patch")
    with open(patch, "w") as fh:
        fh.write(diff_text)
    git_detail = None
    for stage in (["git", "apply", "--check", "-p1", ".typist.patch"],
                  ["git", "apply", "-p1", ".typist.patch"]):
        r = subprocess.run(stage, cwd=workdir, capture_output=True, text=True)
        if r.returncode != 0:
            git_detail = (r.stderr or r.stdout).strip()[:200]
            break
    os.remove(patch)
    if git_detail is None:
        return True, "applied", "git"
    # git refused; try the context-anchored applier on the untouched tree
    ok, detail = apply_anchored(workdir, diff_text)
    return ok, "git refused (%s); %s" % (git_detail, detail), ("anchored" if ok else None)


def run_gate(workdir, cmds, timeout=300):
    for cmd in cmds:
        r = subprocess.run(cmd, cwd=workdir, capture_output=True, text=True,
                           timeout=timeout)
        if r.returncode != 0:
            tail = ((r.stdout or "") + (r.stderr or "")).strip().splitlines()
            return False, " | ".join(tail[-4:])[:400]
    return True, "0 failures, 0 errors"


def run_acceptance(workdir, manifest, timeout=300):
    """INDEPENDENT of the gate: behaviour + byte identity of untouched files."""
    now = {}
    for rel in tree_files(workdir):
        if rel.startswith(".git/") or rel in (".typist.patch", "candidate.diff"):
            continue
        with open(os.path.join(workdir, rel), "rb") as fh:
            now[rel] = sha256_bytes(fh.read())
    added = sorted(set(now) - set(manifest))
    removed = sorted(set(manifest) - set(now))
    changed = sorted(k for k in now if k in manifest and now[k] != manifest[k])
    illegal = [k for k in changed if k not in MUTABLE] + added + removed
    if illegal:
        return False, "files outside the mission changed: " + ",".join(illegal[:6])
    untouched = [f for f in MUTABLE if f not in changed]
    if untouched:
        return False, ("authorized file(s) byte-identical to the preimage: %s"
                       % ",".join(untouched))
    r = subprocess.run(["bb", "-cp", "src", "-e", ACCEPT_EXPR], cwd=workdir,
                       capture_output=True, text=True, timeout=timeout)
    if r.returncode != 0 or "ACCEPT-OK" not in r.stdout:
        tail = ((r.stdout or "") + (r.stderr or "")).strip().splitlines()
        return False, "behaviour: " + (" | ".join(tail[-3:])[:300] or "no ACCEPT-OK")
    return True, "behaviour ok; only %s changed" % ",".join(MUTABLE)


def evaluate(cand_dir, diff_text, manifest, cmds):
    rec = {}
    if diff_text is None:
        rec["apply_ok"] = False
        rec["apply_detail"] = "no unified diff in the response"
        rec["applier"] = None
        rec["gate_ok"] = False
        rec["accept_ok"] = False
        return rec
    ok, detail, applier = apply_diff(cand_dir, diff_text)
    rec["apply_ok"], rec["apply_detail"], rec["applier"] = ok, detail, applier
    if not ok:
        rec["gate_ok"] = False
        rec["accept_ok"] = False
        return rec
    try:
        g_ok, g_detail = run_gate(cand_dir, cmds)
    except subprocess.TimeoutExpired:
        g_ok, g_detail = False, "gate timed out"
    rec["gate_ok"], rec["gate_detail"] = g_ok, g_detail
    try:
        a_ok, a_detail = run_acceptance(cand_dir, manifest)
    except subprocess.TimeoutExpired:
        a_ok, a_detail = False, "acceptance timed out"
    rec["accept_ok"], rec["accept_detail"] = a_ok, a_detail
    return rec


# --------------------------------------------------------------------------
# arms

def arm_fake(k, good, bad):
    """Deterministic candidates: alternating known-good / known-bad diffs."""
    out = []
    for i in range(k):
        path = good if i % 2 == 0 else bad
        with open(path) as fh:
            text = fh.read()
        out.append({"cand": "c%d" % i, "source": path, "text": text,
                    "response_s": time.time() - T0,
                    "tokens": None, "error": None})
    return out


def arm_replay(run_dir):
    """Re-feed the RETAINED bytes of an earlier run through apply+gate+acceptance.
    No network, no model call: the candidates are read off disk exactly as they
    were received. This is how a protocol amendment is tested against candidates
    that already exist, instead of buying new ones."""
    run_dir = os.path.abspath(run_dir)
    out = []
    for name in sorted(os.listdir(run_dir)):
        f = os.path.join(run_dir, name, "candidate.diff")
        if not os.path.isfile(f):
            continue
        with open(f) as fh:
            out.append({"cand": name, "source": "replay:" + f, "text": fh.read(),
                        "response_s": 0.0, "tokens": None, "error": None})
    if not out:
        die("typist-run: no retained candidate.diff under %s" % run_dir, 6)
    return out


def arm_n(prompt, k):
    """codex exec -m gpt-5.6-sol; stdin from /dev/null."""
    def one(i):
        d = None
        scratch = fresh_copy(os.path.join(RUN_DIR, "n%d-scratch" % i))
        cmd = ["codex", "exec", "-m", "gpt-5.6-sol",
               "-c", 'model_reasoning_effort="medium"',
               "--skip-git-repo-check", prompt]
        try:
            with open(os.devnull) as devnull:
                r = subprocess.run(cmd, cwd=scratch, stdin=devnull,
                                   capture_output=True, text=True, timeout=900)
            text, err = r.stdout, (r.stderr or "").strip()[:300] if r.returncode else None
        except Exception as e:                                   # noqa: BLE001
            text, err = "", "codex exec failed: %s" % e
        d = extract_diff(text)
        if d is None:
            # it may have edited the tree in place
            g = subprocess.run(["git", "diff"], cwd=scratch,
                               capture_output=True, text=True)
            if g.stdout.strip():
                d = g.stdout
        return {"cand": "n%d" % i, "source": "codex exec gpt-5.6-sol",
                "text": d, "response_s": time.time() - T0,
                "tokens": None, "error": err}
    with cf.ThreadPoolExecutor(max_workers=max(1, k)) as ex:
        return list(ex.map(one, range(k)))


# --------------------------------------------------------------------------
# TYPIST PROVIDERS (arm F)
#
# Arm F is "a fast typist". WHICH fast typist is a provider choice, not a
# rewrite of the arm: every provider returns the SAME candidate record shape and
# every candidate goes through the same apply / gate / acceptance judging.
#
# A field the provider does not report is `None` — never a computed stand-in.
# Groq reports `completion_time` and `queue_time`; OpenRouter usually does not;
# `codex exec` exposes no token counts at all. Those are nil in the record and
# "n/a" in the bench table. Nothing here invents a number.

PROVIDERS = {
    "groq": {
        "kind": "openai-chat",
        "url": GROQ_URL,
        "model": GROQ_MODEL,
        "key_file": GROQ_KEY_FILE,
        "key_label": "Groq",
        "headers": {"User-Agent": GROQ_UA},
    },
    "openrouter": {
        "kind": "openai-chat",
        "url": "https://openrouter.ai/api/v1/chat/completions",
        "model": "openai/gpt-oss-120b",
        "key_file": os.environ.get("TYPIST_OPENROUTER_KEY_FILE",
                                   "/home/forge/secrets/openrouter.edn"),
        "key_label": "OpenRouter",
        "headers": {
            "User-Agent": GROQ_UA,
            # OpenRouter's attribution headers; they identify the caller, not a secret.
            "HTTP-Referer": "https://github.com/realgenekim/clj-surgeon",
            "X-Title": "clj-surgeon typist",
        },
    },
    "spark": {
        "kind": "codex-exec",
        "model": "gpt-5.3-codex-spark",
        "reasoning_effort": "low",
    },
}

# The provider-side usage-limit refusal. It is a TYPED REFUSAL, exactly like
# Groq's finish_reason=length: nothing is applied, nothing is gated, and it is
# counted in `refusals`. It is never retried in a loop.
USAGE_LIMIT_RE = re.compile(r"hit your usage limit", re.I)


def provider_key(cfg):
    """Read the provider's API key. Refuses BEFORE any network call is made.
    The key is never echoed, logged, or written to a receipt."""
    path = cfg["key_file"]
    if not os.path.exists(path):
        die("typist-run: refusing — no %s key at %s" % (cfg["key_label"], path), 4)
    with open(path) as fh:
        m = re.search(r':(?:openrouter-api-)?key\s+"([^"]+)"', fh.read())
    if not m:
        die("typist-run: refusing — no %s key at %s" % (cfg["key_label"], path), 4)
    return m.group(1)


def call_openai_chat(cfg, model, prompt, k, temperature, tag):
    """Groq and OpenRouter share the OpenAI chat-completions wire format."""
    key = provider_key(cfg)   # refuses BEFORE any network call is made

    def one(i):
        cand = "%s%d" % (tag, i)
        body = json.dumps({"model": model,
                           "messages": [{"role": "user", "content": prompt}],
                           "temperature": temperature,
                           # gpt-oss-120b is a REASONING model: reasoning tokens
                           # are spent BEFORE any output token, so the budget has
                           # to cover reasoning + diff, not the diff alone.
                           "max_tokens": GROQ_MAX_TOKENS}).encode()
        headers = {"Content-Type": "application/json",
                   "Authorization": "Bearer " + key}
        headers.update(cfg["headers"])
        req = urllib.request.Request(cfg["url"], body, headers)
        t_call = time.time()
        try:
            d = json.load(urllib.request.urlopen(req, timeout=300))
        except Exception as e:                                   # noqa: BLE001
            return {"cand": cand, "source": model, "text": None,
                    "response_s": time.time() - T0,
                    "call_wall_s": time.time() - t_call,
                    "tokens": None,
                    "error": "%s request failed: %s" % (cfg["key_label"], e)}
        call_wall = time.time() - t_call
        u = d.get("usage") or {}
        details = u.get("completion_tokens_details") or {}
        choice = (d.get("choices") or [{}])[0]
        msg = choice.get("message") or {}
        content = msg.get("content") or ""
        # the reasoning trace is measured, never stored: length only.
        reasoning_chars = len(msg.get("reasoning") or "")
        finish = choice.get("finish_reason")
        # `length` is a TYPED REFUSAL — the budget ran out. It is not a wrong
        # candidate and must never be scored as one.
        refusal = "length" if finish == "length" else None
        if msg.get("refusal"):
            refusal = refusal or "refusal"
        return {"cand": cand, "source": model,
                "text": None if refusal else extract_diff(content),
                "raw_chars": len(content),
                "reasoning_chars": reasoning_chars,
                "finish_reason": finish,
                "refusal": refusal,
                "response_s": time.time() - T0,
                "call_wall_s": call_wall,
                "tokens": u.get("completion_tokens"),
                "reasoning_tokens": details.get("reasoning_tokens"),
                "prompt_tokens": u.get("prompt_tokens"),
                # provider-reported timings; absent on most OpenRouter upstreams.
                "completion_time_s": u.get("completion_time"),
                "queue_time": u.get("queue_time"),
                # which upstream OpenRouter actually routed to (Cerebras/Groq/...).
                "upstream": d.get("provider"),
                "error": None}
    with cf.ThreadPoolExecutor(max_workers=max(1, k)) as ex:
        return list(ex.map(one, range(k)))


def call_codex_exec(model, prompt, k, tag, reasoning_effort, run_dir):
    """`codex exec` as a typist: k parallel invocations = k PROCESSES.

    Each gets a fresh scratch copy of the fixture as its cwd, stdin from
    /dev/null, and the dossier bytes as its prompt. Wall is measured from
    process spawn to exit. codex exec exposes NO token counts, so every token
    field is nil — never a guess."""
    def one(i):
        cand = "%s%d" % (tag, i)
        scratch = fresh_copy(os.path.join(run_dir, "%s-scratch" % cand))
        cmd = ["codex", "exec", "-m", model,
               "-c", 'model_reasoning_effort="%s"' % reasoning_effort,
               "--skip-git-repo-check", prompt]
        t_call = time.time()
        try:
            with open(os.devnull) as devnull:
                r = subprocess.run(cmd, cwd=scratch, stdin=devnull,
                                   capture_output=True, text=True, timeout=900)
            text = r.stdout or ""
            # The WHOLE stderr is what refusal detection reads. codex exec
            # prints a banner FIRST and the refusal LAST, so truncating the
            # head would hide exactly the sentence we are looking for.
            full_err = (r.stderr or "").strip()
            err = full_err[-600:] if r.returncode else None
        except Exception as e:                                   # noqa: BLE001
            text, full_err, err = "", "", "codex exec failed: %s" % e
        call_wall = time.time() - t_call
        blob = text + "\n" + full_err + "\n" + (err or "")
        refusal = "usage-limit" if USAGE_LIMIT_RE.search(blob) else None
        d = None
        if not refusal:
            d = extract_diff(text)
            if d is None:
                # it may have edited the scratch tree in place
                g = subprocess.run(["git", "diff"], cwd=scratch,
                                   capture_output=True, text=True)
                if g.stdout.strip():
                    d = g.stdout
        return {"cand": cand, "source": "codex exec " + model,
                "text": d,
                # a refusal must carry its own evidence, verbatim
                "refusal_evidence": (full_err or text).strip()[-400:] if refusal else None,
                "raw_chars": len(text),
                "reasoning_chars": None,
                "finish_reason": None,
                "refusal": refusal,
                "response_s": time.time() - T0,
                "call_wall_s": call_wall,
                "tokens": None, "reasoning_tokens": None, "prompt_tokens": None,
                "completion_time_s": None, "queue_time": None,
                "upstream": None,
                "error": None if refusal else err}
    with cf.ThreadPoolExecutor(max_workers=max(1, k)) as ex:
        return list(ex.map(one, range(k)))


def arm_f(prompt, k, temperature=0.7, provider="groq", model=None,
          tag="f", run_dir=None):
    """The fast-typist arm, over whichever provider was named."""
    if provider not in PROVIDERS:
        die("typist-run: refusing — unknown provider %r (known: %s)"
            % (provider, ", ".join(sorted(PROVIDERS))), 7)
    cfg = PROVIDERS[provider]
    model = model or cfg["model"]
    if cfg["kind"] == "codex-exec":
        return call_codex_exec(model, prompt, k, tag,
                               cfg["reasoning_effort"], run_dir or RUN_DIR)
    return call_openai_chat(cfg, model, prompt, k, temperature, tag)


# --------------------------------------------------------------------------
# judging — one path for every arm, every provider, every mode

REFUSAL_DETAIL = {
    "length": "finish_reason=length: the token budget ran out before a complete diff",
    "refusal": "the model returned a refusal message instead of a diff",
    "usage-limit": ("the provider reported a usage limit; apply, gate and "
                    "acceptance were NOT run and nothing was retried"),
}


def judge_candidates(cands, manifest, cmds, run_dir, t_ref=None):
    """Apply + gate + acceptance for every candidate, in one place.

    `t_ref` is the clock a verified candidate's wall is measured from: process
    start for a normal run, ROUND start in --bench (so rounds are comparable)."""
    t_ref = T0 if t_ref is None else t_ref
    records = []
    for c in cands:
        refusal = c.get("refusal")
        if refusal:
            # A TYPED REFUSAL is not a wrong candidate: nothing is applied,
            # nothing is gated, and it is scored in `refusals`, never as
            # apply_ok=false. nil, not false — we did not run the check.
            cand_dir = None
            ev = {"apply_ok": None, "gate_ok": None, "accept_ok": None,
                  "refusal_detail": REFUSAL_DETAIL.get(
                      refusal, "provider refused: %s" % refusal)}
        else:
            cand_dir = fresh_copy(os.path.join(run_dir, c["cand"]))
            ev = evaluate(cand_dir, c.get("text"), manifest, cmds)
        verified = bool(ev.get("apply_ok") and ev.get("gate_ok") and ev.get("accept_ok"))
        rec = {"cand": c["cand"], "source": c["source"],
               "dir": cand_dir,
               "response_wall_s": round(c["response_s"], 3),
               "call_wall_s": (round(c["call_wall_s"], 3)
                               if c.get("call_wall_s") is not None else None),
               "upstream": c.get("upstream"),
               "refusal": refusal,
               "finish_reason": c.get("finish_reason"),
               "tokens": c.get("tokens"),
               "reasoning_tokens": c.get("reasoning_tokens"),
               "reasoning_chars": c.get("reasoning_chars"),
               "raw_chars": c.get("raw_chars"),
               "prompt_tokens": c.get("prompt_tokens"),
               "refusal_evidence": c.get("refusal_evidence"),
               "completion_time_s": c.get("completion_time_s"),
               "queue_time_s": c.get("queue_time"),
               "error": c.get("error")}
        rec.update(ev)
        rec["verified"] = verified
        rec["verified_wall_s"] = round(time.time() - t_ref, 3) if verified else None
        rec["semantic_mismatch"] = bool(ev.get("gate_ok") and not ev.get("accept_ok"))
        records.append(rec)
    return records


# --------------------------------------------------------------------------
# --bench — the provider comparison
#
# Round-robin, k=1, one shared apply/gate/acceptance path. Round-robin is the
# point: a provider measured in a block of six would carry that block's
# time-of-day load. Interleaving makes every provider share the same weather.

def median(xs):
    s = sorted(xs)
    n = len(s)
    if not n:
        return None
    return s[n // 2] if n % 2 else (s[n // 2 - 1] + s[n // 2]) / 2.0


def fmt(x, spec="%.2f"):
    return "n/a" if x is None else (spec % x)


def bench(prompt, providers, models, rounds, temperature, manifest, cmds):
    """Per provider: `rounds` rounds of k=1, interleaved. Prints ONE table."""
    # Pre-flight, before any network call: a provider whose key file is absent
    # is BLOCKED, not slow. It gets a row of typed refusals and "n/a" times.
    # (Outside --bench the same condition is a hard exit 4 — a single-provider
    # run has nothing to compare it against.)
    blocked = {}
    for p in providers:
        cfg = PROVIDERS[p]
        if cfg["kind"] != "openai-chat":
            continue
        path = cfg["key_file"]
        ok = False
        if os.path.exists(path):
            with open(path) as fh:
                ok = bool(re.search(r':(?:openrouter-api-)?key\s+"([^"]+)"', fh.read()))
        if not ok:
            blocked[p] = "no-key"
            print("bench: %s is BLOCKED — no %s key at %s; it will show refusals, "
                  "never a time" % (p, cfg["key_label"], path))

    per = {p: [] for p in providers}
    for r_i in range(rounds):
        for p in providers:
            if p in blocked:
                per[p].append({
                    "cand": "%s-r%d-0" % (p, r_i), "round": r_i, "provider": p,
                    "source": models.get(p) or PROVIDERS[p]["model"],
                    "refusal": blocked[p],
                    "refusal_detail": "no API key on this box; nothing was called",
                    "verified": False, "verified_wall_s": None,
                    "call_wall_s": None, "response_wall_s": None,
                    "tokens": None, "completion_time_s": None, "upstream": None,
                    "apply_ok": None, "gate_ok": None, "accept_ok": None})
                continue
            run_dir = os.path.join(FX, "bench-%d-%s-r%d" % (int(T0), p, r_i))
            os.makedirs(run_dir, exist_ok=True)
            global RUN_DIR
            RUN_DIR = run_dir
            t_round = time.time()
            cands = arm_f(prompt, 1, temperature, provider=p,
                          model=models.get(p), tag="%s-r%d-" % (p, r_i),
                          run_dir=run_dir)
            recs = judge_candidates(cands, manifest, cmds, run_dir, t_ref=t_round)
            rec = recs[0]
            rec["round"] = r_i
            rec["provider"] = p
            rec["run_dir"] = run_dir
            per[p].append(rec)
            print("  bench round %d/%d %-11s verified=%s wall=%s refusal=%s"
                  % (r_i + 1, rounds, p, rec["verified"],
                     fmt(rec["verified_wall_s"] or rec["call_wall_s"]),
                     rec["refusal"] or "-"), flush=True)

    rows = []
    for p in providers:
        recs = per[p]
        model = models.get(p) or PROVIDERS[p]["model"]
        firsts = sorted(round(r["verified_wall_s"], 2)
                        for r in recs if r["verified_wall_s"] is not None)
        walls = [r["call_wall_s"] for r in recs if r["call_wall_s"] is not None]
        # provider-REPORTED completion throughput only. No provider timing ->
        # no tok/s. We never divide by our own wall and call it the provider's.
        tps = [r["tokens"] / r["completion_time_s"]
               for r in recs
               if r.get("tokens") and r.get("completion_time_s")]
        rows.append({
            "provider": p, "model": model,
            "rounds": len(recs),
            "verified": len(firsts),
            "first_verified_s": firsts,
            "median_first_verified_s": median(firsts),
            "max_first_verified_s": max(firsts) if firsts else None,
            "median_response_wall_s": median(walls),
            "median_completion_tok_s": median(tps),
            "refusals": sum(1 for r in recs if r.get("refusal")),
            "upstreams": sorted({r["upstream"] for r in recs if r.get("upstream")}),
        })

    hdr = ("provider", "model", "rounds verified", "first_verified_s (sorted)",
           "median", "max", "med resp_wall_s", "med tok/s", "refusals")
    body = [(r["provider"], r["model"],
             "%d/%d" % (r["verified"], r["rounds"]),
             ("[" + ", ".join("%.2f" % x for x in r["first_verified_s"]) + "]")
             if r["first_verified_s"] else "n/a",
             fmt(r["median_first_verified_s"]),
             fmt(r["max_first_verified_s"]),
             fmt(r["median_response_wall_s"]),
             fmt(r["median_completion_tok_s"], "%.1f"),
             str(r["refusals"])) for r in rows]
    widths = [max(len(hdr[i]), *(len(b[i]) for b in body)) for i in range(len(hdr))]
    line = "  ".join("-" * w for w in widths)
    print("")
    print("BENCH  mission=%s  dossier=%s  rounds=%d  k=1  round-robin"
          % (MISSION, os.path.basename(DOSSIER), rounds))
    print(line)
    print("  ".join(h.ljust(w) for h, w in zip(hdr, widths)))
    print(line)
    for b in body:
        print("  ".join(c.ljust(w) for c, w in zip(b, widths)))
    print(line)

    out = os.path.join(FX, "bench-%d.edn" % int(T0))
    with open(out, "w") as fh:
        fh.write(edn({"bench": True,
                      "at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
                      "mission": MISSION, "dossier": DOSSIER,
                      "dossier_sha256": sha256_bytes(prompt.encode()),
                      "preimage": PREIMAGE, "gate_profile": PROFILE,
                      "gate_commands": cmds, "rounds": rounds, "k": 1,
                      "interleaved": True,
                      "rows": rows,
                      "candidates": [r for p in providers for r in per[p]]}) + "\n")
    print("\nbench table written to %s" % out)
    return 0


# --------------------------------------------------------------------------

def main():
    ap = argparse.ArgumentParser(prog="typist-run", add_help=True)
    ap.add_argument("--arm", choices=["N", "F", "fake"])
    ap.add_argument("--replay", metavar="RUN_DIR",
                    help="re-run apply+gate+acceptance on the RETAINED "
                         "candidate.diff files of an earlier run. No network.")
    ap.add_argument("--provider", default="groq", choices=sorted(PROVIDERS),
                    help="which fast typist arm F buys (default: groq)")
    ap.add_argument("--model", default=None,
                    help="override the provider's default model id")
    ap.add_argument("--bench", action="store_true",
                    help="compare providers: `rounds` rounds of k=1 per provider, "
                         "interleaved round-robin, one table at the end")
    ap.add_argument("--providers", default="groq",
                    help="--bench only: comma-separated provider list")
    ap.add_argument("--rounds", type=int, default=6,
                    help="--bench only: rounds per provider (default 6)")
    ap.add_argument("--runs", type=int, default=1)
    ap.add_argument("--k", type=int, default=None)
    ap.add_argument("--temperature", type=float, default=0.7)
    ap.add_argument("--fake-good", default=os.path.join(HERE, "fixtures", "typist-good.diff"))
    ap.add_argument("--fake-bad", default=os.path.join(HERE, "fixtures", "typist-bad.diff"))
    ap.add_argument("--rebuild-fixture", action="store_true")
    ap.add_argument("--dossier", default=None,
                    help="the frozen dossier to hand every arm "
                         "(default: bin/typist-dossier.md, the scope-roots mission)")
    ap.add_argument("--mission", default=None, choices=sorted(MISSIONS),
                    help="the mission whose fixture, gate profile, authorized file "
                         "and acceptance witness judge the candidates. Default: "
                         "derived from the dossier basename.")
    ap.add_argument("--fixture", default=None, metavar="PREIMAGE_DIR",
                    help="override the mission's preimage directory; its manifest "
                         "is written beside it as <dir>.manifest.edn")
    a = ap.parse_args()
    if not a.arm and not a.replay and not a.bench:
        ap.error("one of --arm, --replay or --bench is required")

    bench_providers = []
    if a.bench:
        bench_providers = [p.strip() for p in a.providers.split(",") if p.strip()]
        if not bench_providers:
            ap.error("--bench needs a non-empty --providers list")
        for p in bench_providers:
            if p not in PROVIDERS:
                die("typist-run: refusing — unknown provider %r (known: %s)"
                    % (p, ", ".join(sorted(PROVIDERS))), 7)
        if a.rounds < 1:
            ap.error("--rounds must be >= 1")

    mission = a.mission or (mission_for_dossier(a.dossier) if a.dossier else "scope-roots")
    select_mission(mission, a.dossier, a.fixture)

    if shutil.which("bb") is None:
        die("typist-run: refusing — bb (babashka) is not on PATH; the gate cannot run", 5)
    if not os.path.isfile(DOSSIER):
        die("typist-run: refusing — no dossier at %s" % DOSSIER, 7)
    with open(DOSSIER) as fh:
        prompt = fh.read()
    dossier_sha = sha256_bytes(prompt.encode())

    manifest = materialize_fixture(force=a.rebuild_fixture)
    cmds = resolve_gate_commands()

    if a.bench:
        models = {p: a.model for p in bench_providers} if a.model else {}
        sys.exit(bench(prompt, bench_providers, models, a.rounds,
                       a.temperature, manifest, cmds))

    if a.replay:
        a.arm = a.arm or "replay"
        runs = 1
        k = 0
    else:
        k = a.k if a.k is not None else (1 if a.arm == "N" else 5)
        runs = a.runs

    exit_code = 0
    for r_i in range(runs):
        run_id = "%s-%s-%d-%d" % (a.arm, MISSION, int(T0), r_i)
        global RUN_DIR
        RUN_DIR = os.path.join(FX, run_id)
        os.makedirs(RUN_DIR, exist_ok=True)

        if a.replay:
            cands = arm_replay(a.replay)
        elif a.arm == "fake":
            cands = arm_fake(k, a.fake_good, a.fake_bad)
        elif a.arm == "N":
            cands = arm_n(prompt, k)
        else:
            cands = arm_f(prompt, k, a.temperature,
                          provider=a.provider, model=a.model, run_dir=RUN_DIR)

        records = judge_candidates(cands, manifest, cmds, RUN_DIR)

        verified_walls = [r["verified_wall_s"] for r in records if r["verified"]]
        first = min(verified_walls) if verified_walls else None
        apply_ok = sum(1 for r in records if r.get("apply_ok"))
        gate_ok = sum(1 for r in records if r.get("gate_ok"))
        accept_ok = sum(1 for r in records if r.get("accept_ok"))
        mismatch = sum(1 for r in records if r["semantic_mismatch"])
        refusals = sum(1 for r in records if r.get("refusal"))

        receipt = {
            "run": run_id, "arm": a.arm, "at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
            "startup_charged" : True,
            "t0_epoch": round(T0, 3),
            "dossier": DOSSIER, "dossier_sha256": dossier_sha,
            "preimage": PREIMAGE, "manifest": MANIFEST,
            "gate_profile": PROFILE, "gate_commands": cmds,
            "mission": MISSION, "mutable_file": MUTABLE,
            "provider": (a.provider if a.arm == "F" else None),
            "model": ((a.model or PROVIDERS[a.provider]["model"])
                      if a.arm == "F" else None),
            "acceptance": MISSIONS[MISSION]["accept_desc"],
            "candidates": records,
            "first_verified_s": first,
            "semantic_mismatch": mismatch,
            "refusals": refusals,
        }
        with open(os.path.join(RUN_DIR, "receipt.edn"), "w") as fh:
            fh.write(edn(receipt) + "\n")

        tok = [r["tokens"] for r in records if r["tokens"] is not None]
        tok_s = ("tokens=%d" % sum(tok)) if tok else "tokens=unknown"
        rt = [r["reasoning_tokens"] for r in records if r.get("reasoning_tokens") is not None]
        rt_s = ("reasoning_tokens=%d" % sum(rt)) if rt else "reasoning_tokens=unknown"
        print("arm=%s mission=%s run=%s first_verified_s=%s candidates=%d apply_ok=%d "
              "gate_ok=%d accept_ok=%d semantic_mismatch=%d refusals=%d %s %s"
              % (a.arm, MISSION, run_id,
                 ("%.2f" % first) if first is not None else "none",
                 len(records), apply_ok, gate_ok, accept_ok, mismatch, refusals,
                 tok_s, rt_s))
        if mismatch:
            exit_code = 3
    sys.exit(exit_code)


if __name__ == "__main__":
    main()
