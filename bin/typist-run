        "profile": "typist-narrow",
        "mutable": "src/fixture/scope.clj",
        "accept_expr": SCOPE_ACCEPT,
        "accept_desc": "independent behavioural witness (fixture.scope only) + preimage byte identity",
    },
    "onesite": {
        "dossier": os.path.join(HERE, "typist-dossier-onesite.md"),
        "preimage": os.path.join(FX, "fixture-preimage-onesite"),
        "seed": ONESITE_SEED,
        "profile": "typist-onesite",
        "mutable": "src/fixture/util.clj",
        "accept_expr": ONESITE_ACCEPT,
        "accept_desc": "independent behavioural witness (fixture.util only) + preimage byte identity",
