#!/usr/bin/env python3
"""typist-run — runner for the fast-typist preregistration (2026-09-05).

Two arms over ONE frozen dossier (bin/typist-dossier.md, byte-identical to both):

  --arm N --runs 1   one careful author  (codex exec -m gpt-5.6-sol)
  --arm F --k 5      k parallel typists   (--provider groq|openrouter|spark)
  --arm fake --k 2   the ratchet: known-good + known-bad diffs, no network
  --replay <dir>     re-judge RETAINED candidate bytes; no network
  --bench            compare typists head to head; one table at the end

WHICH fast typist arm F buys is a provider choice, not a different arm: every
provider returns the same candidate record and every candidate goes through the
same apply / gate / acceptance judging.

  groq        Groq openai/gpt-oss-120b        (reports completion/queue time)
  openrouter  openai/gpt-oss-120b via OpenRouter (records the routed :upstream)
  spark       codex exec -m gpt-5.3-codex-spark, low reasoning; k = k processes

  bin/typist-run --bench --providers groq,openrouter,spark \
                 --dossier bin/typist-dossier-onesite.md --rounds 6

--bench runs `rounds` rounds of k=1 per provider, INTERLEAVED round-robin so
every provider shares the same time-of-day weather, and writes the table to
/var/tmp/forge/typist-fx/bench-<epoch>.edn. A provider with no key, or one whose
calls all refuse, gets a row of refusals and "n/a" — never a fabricated time.

Every candidate diff is applied onto its OWN fresh copy of the fixture preimage,
then the GATE runs (the verification profile the mission ledger would resolve for
this workspace), then an INDEPENDENT ACCEPTANCE CHECK runs (a behavioural witness
that never loads the gate's test namespace, plus a byte-identity check of every
untouched file against the preimage manifest).

Clock: t0 is process start (startup is charged). Wall to first verified candidate
includes queue, transport, apply, gate and acceptance.

No number is ever fabricated: a missing API usage field prints `tokens=unknown`.
"""

import argparse
import concurrent.futures as cf
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import time
import urllib.request

T0 = time.time()

FX = "/var/tmp/forge/typist-fx"
HERE = os.path.dirname(os.path.abspath(__file__))
GROQ_KEY_FILE = os.environ.get("TYPIST_GROQ_KEY_FILE", "/home/forge/secrets/groq.edn")
GROQ_URL = "https://api.groq.com/openai/v1/chat/completions"
GROQ_MODEL = "openai/gpt-oss-120b"
GROQ_UA = "curl/8.5.0 forge-anvil-typist-run"   # urllib's default UA gets 403
GROQ_MAX_TOKENS = 6000   # reasoning tokens are spent first; budget covers both

# --------------------------------------------------------------------------
# MISSIONS. Each dossier is paired with exactly one mission: its own preimage
# tree, its own manifest, its own verification profile, its own authorized file,
# and its own INDEPENDENT acceptance witness. The dossier is the prompt; the
# mission is everything the runner must know to judge a candidate for it.
#
# Adding a dossier without its mission is a refusal, not a default: judging a
# candidate against another mission's witness would be a silent wrong answer.

UTIL_CLJ = '''(ns fixture.util
  "Path helpers shared by the scope expander. NOT part of this mission."
  (:require [clojure.string :as str]))

(defn normalize
  "Trim a path and drop any trailing slash."
  [p]
  (str/replace (str/trim p) #"/+$" ""))
'''

SCOPE_CLJ = '''(ns fixture.scope
  "Scope expansion for the helper-extraction fence."
  (:require [fixture.util :as util]))

(def default-roots
  "The roots this workspace admits when the caller names none."
  ["src"])

(defn scope-roots
  "The admitted roots for this scope expansion."
  []
  default-roots)

(defn expand
  "Every admitted root plus the caller's paths, normalised, in order."
  [paths]
  (vec (distinct (map util/normalize (concat (scope-roots) paths)))))
'''

# ---- mission 1: scope-roots (cohort 1; a multi-line signature change) -----

SCOPE_SEED = {
"deps.edn": '{:paths ["src" "test"]}\n',

".clj-surgeon.edn": '''{:verification-profiles
 {"typist-narrow"
  {:commands [["bb" "-cp" "src:test" "-e"
               "(require 'clojure.test 'fixture.scope-test) (let [r (clojure.test/run-tests 'fixture.scope-test)] (System/exit (if (and (zero? (:fail r)) (zero? (:error r))) 0 1)))"]]}}}
''',

"src/fixture/util.clj": UTIL_CLJ,
"src/fixture/scope.clj": SCOPE_CLJ,

"test/fixture/scope_test.clj": '''(ns fixture.scope-test
  (:require [clojure.test :refer [deftest is testing]]
            [fixture.scope :as scope]))

(deftest default-roots-unchanged
  (is (= ["src"] (scope/scope-roots))))

(deftest roots-opt-is-honoured
  (testing "(:roots opts) replaces the default roots"
    (is (= ["src" "test"] (scope/scope-roots {:roots ["src" "test"]})))
    (is (= ["lib"] (scope/scope-roots {:roots ["lib"]})))))

(deftest empty-roots-falls-back
  (is (= ["src"] (scope/scope-roots {:roots []}))))

(deftest expand-still-normalises
  (is (= ["src" "test"] (scope/expand ["test/"]))))
''',
}

# The independent acceptance witness. It requires ONLY fixture.scope — never the
# gate's test namespace — so a candidate that satisfies the gate by editing the
# tests cannot satisfy this.
SCOPE_ACCEPT = (
    "(require 'fixture.scope) "
    "(let [f (resolve 'fixture.scope/scope-roots)] "
    "(assert (= [\"src\"] (f)) \"0-arity default\") "
    "(assert (= [\"src\" \"test\"] (f {:roots [\"src\" \"test\"]})) \":roots honoured\") "
    "(assert (= [\"lib\"] (f {:roots [\"lib\"]})) \":roots honoured (single)\") "
    "(assert (= [\"src\"] (f {:roots []})) \"empty :roots falls back\") "
    "(assert (= [\"src\"] (f nil)) \"nil opts falls back\") "
    "(assert (vector? (f {:roots [\"a\"]})) \"returns a vector\") "
    "(println \"ACCEPT-OK\"))"
)

# ---- mission 2: onesite (the ONE-SITE CONTROL; a single literal) ----------
#
# The preregistration requires a control the careful author is expected to win
# or tie. This is it: one known site, one literal, no signature change, no
# call-site fan-out.

ONESITE_UTIL_CLJ = '''(ns fixture.util
  "Path helpers shared by the scope expander."
  (:require [clojure.string :as str]))

(def max-path-segments
  "The most path segments this workspace will normalise in one call."
  16)

(defn normalize
  "Trim a path and drop any trailing slash."
  [p]
  (str/replace (str/trim p) #"/+$" ""))
'''

ONESITE_SEED = {
"deps.edn": '{:paths ["src" "test"]}\n',

".clj-surgeon.edn": '''{:verification-profiles
 {"typist-onesite"
  {:commands [["bb" "-cp" "src:test" "-e"
               "(require 'clojure.test 'fixture.util-test) (let [r (clojure.test/run-tests 'fixture.util-test)] (System/exit (if (and (zero? (:fail r)) (zero? (:error r))) 0 1)))"]]}}}
''',

"src/fixture/util.clj": ONESITE_UTIL_CLJ,
"src/fixture/scope.clj": SCOPE_CLJ,

"test/fixture/util_test.clj": '''(ns fixture.util-test
  (:require [clojure.test :refer [deftest is]]
            [fixture.util :as util]))

(deftest max-path-segments-is-64
  (is (= 64 util/max-path-segments)))

(deftest normalize-unchanged
  (is (= "a/b" (util/normalize "  a/b//  "))))
''',
}

ONESITE_ACCEPT = (
    "(require 'fixture.util) "
    "(let [v @(resolve 'fixture.util/max-path-segments) "
    "      n (resolve 'fixture.util/normalize)] "
    "(assert (= 64 v) \"max-path-segments is 64\") "
    "(assert (integer? v) \"max-path-segments is an integer literal\") "
    "(assert (= \"a/b\" (n \"  a/b//  \")) \"normalize unchanged\") "
    "(assert (= \"\" (n \"   \")) \"normalize unchanged (blank)\") "
    "(println \"ACCEPT-OK\"))"
)

# ---- mission 3: fanout (the SEARCH mission; multi-file, multi-hunk) ------
#
# Cohort 1 found a single gpt-oss-120b candidate verifying 12/12 on both of the
# missions above, which makes k=5 unmeasurable: parallel search cannot beat a
# ceiling already reached at k=1. This mission is deliberately harder — six
# hunks across three files, a signature change fanned out to five call sites,
# and TWO traps a fast typist gets wrong: the old name survives inside a
# docstring example and inside a string literal, and must NOT be renamed.

FANOUT_UTIL_CLJ = r"""(ns fixture.util
  "Path helpers shared by the scope expander."
  (:require [clojure.string :as str]))

(defn normalize
  "Trim a path and drop any trailing slash."
  [p]
  (str/replace (str/trim p) #"/+$" ""))
"""

FANOUT_SCOPE_CLJ = r"""(ns fixture.scope
  "Scope expansion for the helper-extraction fence."
  (:require [fixture.util :as util]))

(def default-roots
  "The roots this workspace admits when the caller names none."
  ["src"])

(defn scope-roots
  "The admitted roots for this scope expansion."
  []
  default-roots)

(defn expand
  "Every admitted root plus the caller's paths, normalised, in order."
  [paths]
  (vec (distinct (map util/normalize (concat (scope-roots) paths)))))

(defn admits?
  "Does this scope admit the given path?"
  [p]
  (contains? (set (expand [])) (util/normalize p)))
"""

FANOUT_PATHS_CLJ = r"""(ns fixture.paths
  "Path assembly built on the shared helpers."
  (:require [clojure.string :as str]
            [fixture.util :as util]))

(def op-name
  "The operation name reported in telemetry."
  "normalize")

(defn join
  "Join segments into one path.

  Example:
    (normalize \"a/b/\")  ;=> \"a/b\""
  [segs]
  (util/normalize (str/join "/" segs)))

(defn relative-to
  "Strip the root prefix from a path."
  [root p]
  (let [r (util/normalize root)
        n (util/normalize p)]
    (if (str/starts-with? n (str r "/"))
      (subs n (inc (count r)))
      n)))

(defn clean-all
  "Normalise every path in the collection."
  [paths]
  (mapv util/normalize paths))
"""

FANOUT_TEST_CLJ = r"""(ns fixture.fanout-test
  (:require [clojure.test :refer [deftest is testing]]
            [fixture.util :as util]
            [fixture.scope :as scope]
            [fixture.paths :as paths]))

(deftest normalize-path-renamed
  (is (= "a//b" (util/normalize-path "  a//b//  ")))
  (is (= "" (util/normalize-path "   ")))
  (is (nil? (resolve 'fixture.util/normalize))))

(deftest strict-collapses-inner-slashes
  (is (= "a/b" (util/normalize-path "  a//b//  " {:strict? true})))
  (is (= "a//b" (util/normalize-path "a//b" {:strict? false})))
  (is (= "a//b" (util/normalize-path "a//b" nil))))

(deftest expand-threads-strict
  (is (= ["src" "test"] (scope/expand ["test/"])))
  (is (= ["src" "a//b"] (scope/expand ["a//b/"])))
  (is (= ["src" "a/b"] (scope/expand ["a//b/"] {:strict? true}))))

(deftest admits-still-works
  (is (true? (scope/admits? "src/")))
  (is (false? (scope/admits? "lib"))))

(deftest join-threads-strict
  (is (= "a/b" (paths/join ["a" "b/"])))
  (is (= "a//b" (paths/join ["a" "" "b"])))
  (is (= "a/b" (paths/join ["a" "" "b"] {:strict? true}))))

(deftest relative-to-and-clean-all
  (is (= "a/b" (paths/relative-to "src/" "src/a/b")))
  (is (= "lib/x" (paths/relative-to "src" "lib/x")))
  (is (= ["a" "b"] (paths/clean-all ["a/" "b//"]))))

(deftest the-two-traps
  (testing "the string literal and the docstring example keep the OLD name"
    (is (= "normalize" paths/op-name))
    (is (re-find #"\(normalize " (:doc (meta #'paths/join))))))
"""

FANOUT_EDN = (
    '{:verification-profiles\n'
    ' {"typist-fanout"\n'
    '  {:commands [["bb" "-cp" "src:test" "-e"\n'
    '               "(require \'clojure.test \'fixture.fanout-test)'
    ' (let [r (clojure.test/run-tests \'fixture.fanout-test)]'
    ' (System/exit (if (and (zero? (:fail r)) (zero? (:error r))) 0 1)))"]]}}}\n'
)

FANOUT_SEED = {
    "deps.edn": '{:paths ["src" "test"]}\n',
    ".clj-surgeon.edn": FANOUT_EDN,
    "src/fixture/util.clj": FANOUT_UTIL_CLJ,
    "src/fixture/scope.clj": FANOUT_SCOPE_CLJ,
    "src/fixture/paths.clj": FANOUT_PATHS_CLJ,
    "test/fixture/fanout_test.clj": FANOUT_TEST_CLJ,
}

# Independent of the gate: requires only the three SOURCE namespaces, never
# fixture.fanout-test. Asserts the end state, both traps, and that the old name
# is gone from code while surviving in the docstring and the string literal.
FANOUT_ACCEPT = r"""(require 'fixture.util 'fixture.scope 'fixture.paths)
(let [np (resolve 'fixture.util/normalize-path)
      ex (resolve 'fixture.scope/expand)
      ad (resolve 'fixture.scope/admits?)
      jn (resolve 'fixture.paths/join)
      rl (resolve 'fixture.paths/relative-to)
      ca (resolve 'fixture.paths/clean-all)]
  (assert np "normalize-path resolves")
  (assert (nil? (resolve 'fixture.util/normalize)) "the old name is gone from code")
  (assert (= "a//b" (np "  a//b//  ")) "1-arity trims and drops trailing slashes")
  (assert (= "" (np "   ")) "1-arity on blank")
  (assert (= "a/b" (np "  a//b//  " {:strict? true})) ":strict? collapses inner slashes")
  (assert (= "a//b" (np "a//b" nil)) "nil opts is lenient")
  (assert (= ["src" "test"] (ex ["test/"])) "expand 1-arity unchanged")
  (assert (= ["src" "a//b"] (ex ["a//b/"])) "expand lenient by default")
  (assert (= ["src" "a/b"] (ex ["a//b/"] {:strict? true})) "expand threads :strict?")
  (assert (true? (ad "src/")) "admits? still works")
  (assert (= "a/b" (jn ["a" "b/"])) "join 1-arity")
  (assert (= "a//b" (jn ["a" "" "b"])) "join lenient by default")
  (assert (= "a/b" (jn ["a" "" "b"] {:strict? true})) "join threads :strict?")
  (assert (= "a/b" (rl "src/" "src/a/b")) "relative-to")
  (assert (= ["a" "b"] (ca ["a/" "b//"])) "clean-all")
  (assert (= "normalize" @(resolve 'fixture.paths/op-name)) "TRAP: string literal intact")
  (assert (re-find #"\(normalize " (:doc (meta jn))) "TRAP: docstring example intact")
  (println "ACCEPT-OK"))"""

