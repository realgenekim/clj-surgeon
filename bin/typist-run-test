#!/usr/bin/env python3
"""typist-run-test — the OFFLINE fence tests for bin/typist-run (2026-09-06).

THE OFFLINE CONTRACT IS A CHOKEPOINT, NOT A SANDBOX (Sol fence r4). Every test
here is monkeypatched, pure, or a subprocess run under TYPIST_OFFLINE=1, which
refuses the RUNNER'S OWN codex/claude spawns and network opens with exit 6
before they happen. It does NOT confine children: a general-purpose child
(bash, python3) that the runner is allowed to start could still spawn an
absolute path, reset PATH, `env -i`, re-exec, or open a socket. Python
monkeypatching plus a mutable PATH cannot make that impossible; only an
OS-enforced process/network boundary or a strictly confined broker can, and
NEITHER IS AVAILABLE on this box to this user (`unshare -rn` -> write to
uid_map not permitted; no bwrap, no firejail, no sudo).

THIS SUITE RETAINS LIMITED WITNESSES: runner key paths resolve to dummy files;
the Codex session path set is unchanged; the observed ledger does not grow;
no matching provider-priced receipt remains in the suite fixture tree.
These checks are not a complete process/network census or proof that arbitrary
children could not spend. The parent Python audit guard and bootstrapped runner
children retain the stronger cooperative guard from the root branch. They are
not an OS sandbox. The default-key-path check prints paths without opening keys.

  bin/typist-run-test

Covers the three Sol fence findings:
  (1) key paths are fixed; the only seam is --keys-dir, fenced to /var/tmp/forge
  (2) the OpenRouter upstream pin and the registry model are UNCONDITIONAL
  (3) no exception text -- and no key -- reaches a record or a receipt
  (4) the WRITE fence: TYPIST_FX, --fixture and every rmtree target resolve
      under /var/tmp/forge or the worktree, and arm NW refuses outright unless
      its warm workspace is under /var/tmp/forge (it runs codex unsandboxed,
      so that directory is its ONLY containment), and NW performs that refusal
      before mission selection, fixture materialization or any other write
  (5) cost accounting: an aggregate is the SUM of its priceable members and
      `unknown` when it has none -- never a table rate applied to summed-to-
      zero tokens, never a provider's own figure discarded for a re-derivation
"""

import atexit
import importlib.machinery
import importlib.util
import io
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import uuid
import urllib.error
import urllib.request

HERE = os.path.dirname(os.path.abspath(__file__))
RUNNER = os.path.join(HERE, "typist-run")
FENCE = "/var/tmp/forge"
CODEX_SESSIONS = os.path.expanduser("~/.codex/sessions")

# THE OFFLINE CONTRACT: CHOKEPOINT, NOT SANDBOX (Astra 2026-09-06; renamed
# after Sol fence r4). TYPIST_OFFLINE refuses the RUNNER'S OWN spawn/connect
# paths at one chokepoint. It does not confine children and it is not a
# sandbox -- see this module's docstring for what is proven instead.
# This file's docstring
# claimed every test is "monkeypatched or pure"; the NW check below pointed at
# the WORKTREE, and the write fence ADMITS the worktree, so on a checkout that
# lives under /var/tmp/forge the NW refusal never fired and this "offline"
# suite made a real codex warm-up call -- 12.2 s and a created session. Every
# subprocess this file starts now carries TYPIST_OFFLINE=1, which makes the
# runner refuse any codex/claude spawn and any network open BEFORE it happens.
# The suite's offline-ness is therefore a property it ENFORCES, not one it
# inherits from where the repo happens to sit.
os.environ["TYPIST_OFFLINE"] = "1"


def codex_session_paths():
    """The SET of file paths under ~/.codex/sessions.

    A SET, not a newest-mtime (Sol fence r4). A newest-mtime witness answers
    "did the most recent file change", which is not the question: a rewritten
    file is not a new session, and a deleted file is not the absence of a new
    one. A real codex call CREATES a rollout file, so set equality across the
    suite is the witness -- bound to a store this file never writes."""
    out = set()
    for dirpath, _dirs, names in os.walk(CODEX_SESSIONS):
        for f in names:
            out.add(os.path.join(dirpath, f))
    return out


def events_ledger_size():
    """(exists, size) of ~/.clj-surgeon/events.jsonl. Part of the egress
    canary only: uninstrumented calls need not write this file."""
    p = os.path.expanduser("~/.clj-surgeon/events.jsonl")
    try:
        return (True, os.path.getsize(p))
    except OSError:
        return (False, 0)


PROVIDER_SPEND_RE = re.compile(r':cost_source\s+"provider"|:upstream\s+"(?!\s*nil)')


def provider_priced_receipts(root):
    """List EDN files matching the priced-receipt canary; not an RPC census."""
    hits = []
    for dirpath, _dirs, names in os.walk(root):
        for f in names:
            if not f.endswith(".edn"):
                continue
            fp = os.path.join(dirpath, f)
            try:
                body = open(fp).read()
            except OSError:
                continue
            if PROVIDER_SPEND_RE.search(body):
                hits.append(fp)
    return hits

# THE SUITE'S OWN fx TREE. Every artifact this file causes the runner to write
# lands under here, so the egress canary at the end scans exactly what THIS run
# produced -- not whatever else happens to sit in /var/tmp/forge/typist-real-fx.
SUITE_FX = os.path.join(FENCE, "typist-real-fx", "suite-%s" % uuid.uuid4().hex[:8])

FAILURES = []

# Every runner subprocess is hard offline, even if the refusal under test
# regresses. A scratch worktree made the old NW witness accidentally live.
OFFLINE_BOOTSTRAP = r"""
import importlib.machinery, importlib.util, os, sys

def deny_external(event, args):
    if event.startswith("socket.") or event in {
        "subprocess.Popen", "os.system", "os.exec", "os.posix_spawn"}:
        raise RuntimeError("offline test blocked " + event)
    if event == "open" and isinstance(args[0], str) and args[0].startswith("/home/forge/secrets/"):
        raise RuntimeError("offline test blocked real key access")

sys.addaudithook(deny_external)
path = sys.argv.pop(1)
sys.argv[0] = path
loader = importlib.machinery.SourceFileLoader("offline_typist_runner", path)
spec = importlib.util.spec_from_loader("offline_typist_runner", loader)
module = importlib.util.module_from_spec(spec)
loader.exec_module(module)
if os.environ.get("TYPIST_TEST_GUARD_PROBE"):
    os.system("true")
if os.environ.get("TYPIST_TEST_NW_SCRATCH"):
    module.TEST_KEYS_FENCE = os.environ["TYPIST_TEST_NW_SCRATCH"]
    module.resolve_gate_commands = lambda: [["offline-proof-never-executed"]]
module.main()
"""

def offline_run(args, **kwargs):
    return subprocess.run([sys.executable, "-c", OFFLINE_BOOTSTRAP, RUNNER] + args,
                          **kwargs)



def allowed_test_child(executable, command, environment):
    if not isinstance(command, (list, tuple)):
        return False
    bootstrap = (list(command[:4]) == [sys.executable, "-c", OFFLINE_BOOTSTRAP, RUNNER]
                 and os.path.realpath(executable) == os.path.realpath(sys.executable))
    echo = list(command) == ["/bin/echo", "ordinary"] and executable == "/bin/echo"
    shim = (list(command) == ["/bin/bash", "--noprofile", "--norc", "-c", "codex exec -m gpt-5.6-sol"]
            and executable == "/bin/bash" and isinstance(environment, dict)
            and environment.get("BASH_ENV") == "/dev/null"
            and environment.get("ENV") == "/dev/null"
            and os.path.realpath(environment.get("PATH", "")).startswith(FENCE + "/typist-offline-shim-")
            and os.pathsep not in environment.get("PATH", ""))
    return bootstrap or echo or shim


def harness_audit(event, args):
    if event.startswith("socket.") or event in {"os.system", "os.exec", "os.fork"}:
        raise RuntimeError("offline test blocked " + event)
    if event == "open" and isinstance(args[0], (str, bytes)):
        path = os.path.realpath(os.fsdecode(args[0]))
        if path.startswith("/home/forge/secrets/"):
            raise RuntimeError("offline test blocked real key access")
    if event == "subprocess.Popen":
        executable, command, _cwd, environment = args
        if not allowed_test_child(executable, command, environment):
            raise RuntimeError("offline test blocked unreviewed subprocess")
    if event == "os.posix_spawn":
        executable, command, environment = args
        if not allowed_test_child(executable, command, environment):
            raise RuntimeError("offline test blocked unreviewed posix_spawn")


sys.addaudithook(harness_audit)


def run_runner(args, env=None, timeout=180):
    """Use the root audit bootstrap, offline flag and explicit dummy key paths.
    Explicit --keys-dir values are retained for refusal tests."""
    a = list(args)
    if "--keys-dir" not in a:
        a += ["--keys-dir", keys_dir()]
    e = dict(os.environ, TYPIST_OFFLINE="1")
    if env:
        e.update(env)
    return offline_run(a, env=e,
                          capture_output=True, text=True, timeout=timeout)


def check(name, ok, detail=""):
    print("%-58s %s%s" % (name, "ok" if ok else "FAIL",
                          ("  " + detail) if detail else ""))
    if not ok:
        FAILURES.append(name)


def load_runner():
    loader = importlib.machinery.SourceFileLoader("typist_run", RUNNER)
    spec = importlib.util.spec_from_loader("typist_run", loader)
    m = importlib.util.module_from_spec(spec)
    loader.exec_module(m)
    return m


def keys_dir():
    d = tempfile.mkdtemp(prefix="typist-keys-test-", dir=FENCE)
    atexit.register(shutil.rmtree, d, True)
    for name, body in (("groq.edn", '{:key "gsk_DUMMY123"}\n'),
                       ("openrouter.edn", '{:openrouter-api-key "sk-or-DUMMY456"}\n')):
        p = os.path.join(d, name)
        with open(p, "w") as fh:
            fh.write(body)
        os.chmod(p, 0o600)
    return d


# --------------------------------------------------------------------------
# (a) the scrubber is a pure function

def test_scrub(m):
    cases = [
        ("OpenRouter request failed: gsk_DUMMY123", "OpenRouter request failed: <redacted>"),
        ("key sk-or-v1_abcDEF-09 rejected", "key <redacted> rejected"),
        ("Authorization: Bearer sk-live.ABC-123", "Authorization: <redacted>"),
        ("nothing secret here", "nothing secret here"),
        ("two gsk_AAA and sk-or-BBB", "two <redacted> and <redacted>"),
    ]
    for src, want in cases:
        check("scrub(%r)" % src[:34], m.scrub(src) == want, repr(m.scrub(src)))
    check("scrub is pure (same input, same output)",
          m.scrub("gsk_X1") == m.scrub("gsk_X1") == "<redacted>")
    check("scrub passes non-strings through",
          m.scrub(None) is None and m.scrub(7) == 7 and m.scrub(True) is True)
    check("scrub is total (no key survives a receipt string)",
          "gsk_DUMMY123" not in m.edn_str("boom gsk_DUMMY123"))


def test_classify(m):
    def cls(e):
        return m.classify_error(e)
    h404 = urllib.error.HTTPError("u", 404, "nf", {}, None)
    h502 = urllib.error.HTTPError("u", 502, "bg", {}, None)
    check("classify HTTPError 404 -> http-4xx", cls(h404) == ("http-4xx", 404))
    check("classify HTTPError 502 -> http-5xx", cls(h502) == ("http-5xx", 502))
    check("classify TimeoutError -> timeout", cls(TimeoutError()) == ("timeout", None))
    check("classify URLError -> transport",
          cls(urllib.error.URLError("refused")) == ("transport", None))
    check("classify ValueError -> parse", cls(ValueError("bad json")) == ("parse", None))
    check("classify Exception('gsk_DUMMY123') -> transport, no text",
          cls(Exception("gsk_DUMMY123")) == ("transport", None))
    check("generic_error carries no exception text",
          m.generic_error("OpenRouter", "http-5xx", 502)
          == "OpenRouter request failed (http-5xx, status 502)")


# --------------------------------------------------------------------------
# (b) the routing pin: registry model + provider block, unconditionally

def probe_request(m, provider, upstream="Cerebras"):
    """Monkeypatch urlopen; return (payload, headers) of the request built."""
    seen = {}

    def fake_urlopen(req, timeout=None):
        seen["payload"] = json.loads(req.data.decode())
        seen["headers"] = dict(req.headers)
        return io.BytesIO(json.dumps({
            "provider": upstream,
            "choices": [{"finish_reason": "stop",
                         "message": {"content": "```diff\n--- a\n+++ b\n```"}}],
            "usage": {"completion_tokens": 3}}).encode())

    real = urllib.request.urlopen
    urllib.request.urlopen = fake_urlopen
    try:
        recs = m.arm_f("PROMPT", 1, 0.0, provider=provider, tag="probe",
                       run_dir="/var/tmp/forge/typist-real-fx")
    finally:
        urllib.request.urlopen = real
    return seen, recs[0]


def test_routing(m):
    # no env, no flag: the environment is emptied of every legacy knob first.
    for k in ("TYPIST_OPENROUTER_ORDER", "TYPIST_GROQ_KEY_FILE",
              "TYPIST_OPENROUTER_KEY_FILE"):
        os.environ.pop(k, None)
    seen, rec = probe_request(m, "openrouter")
    print("  openrouter request body: %s" % json.dumps(
        {k: v for k, v in seen["payload"].items() if k != "messages"},
        sort_keys=True))
    check("openrouter pins the upstream order unconditionally",
          seen["payload"].get("provider")
          == {"order": ["Cerebras", "Groq"], "allow_fallbacks": False})
    check("openrouter uses the REGISTRY model",
          seen["payload"]["model"] == m.PROVIDERS["openrouter"]["model"],
          seen["payload"]["model"])
    check("no --model flag is registered",
          'ap.add_argument("--model"' not in open(RUNNER).read())
    check("a pinned upstream is accepted", rec["refusal"] is None, str(rec["refusal"]))

    seen2, rec2 = probe_request(m, "openrouter", upstream="DeepInfra")
    check("an UNPINNED upstream is the typed refusal upstream-mismatch",
          rec2["refusal"] == "upstream-mismatch" and rec2["text"] is None,
          str(rec2["refusal"]))
    check("a missing upstream is refused too",
          probe_request(m, "openrouter", upstream=None)[1]["refusal"]
          == "upstream-mismatch")

    seen3, _ = probe_request(m, "groq")
    check("groq carries NO provider block (it is not a router)",
          "provider" not in seen3["payload"])
    check("groq uses the registry model",
          seen3["payload"]["model"] == m.PROVIDERS["groq"]["model"])

    # even with the retired env var set, nothing changes.
    os.environ["TYPIST_OPENROUTER_ORDER"] = "DeepInfra"
    seen4, _ = probe_request(m, "openrouter")
    os.environ.pop("TYPIST_OPENROUTER_ORDER")
    check("the retired TYPIST_OPENROUTER_ORDER cannot change the pin",
          seen4["payload"]["provider"]["order"] == ["Cerebras", "Groq"])


# --------------------------------------------------------------------------
# (c) the key fence

def test_keys(m):
    src = open(RUNNER).read()
    check("no TYPIST_*_KEY_FILE read remains",
          "TYPIST_GROQ_KEY_FILE" not in src and "TYPIST_OPENROUTER_KEY_FILE" not in src)
    check("groq key path is fixed", m.PROVIDERS["groq"]["key_file"]
          == "/home/forge/secrets/groq.edn")
    check("openrouter key path is fixed", m.PROVIDERS["openrouter"]["key_file"]
          == "/home/forge/secrets/openrouter.edn")
    d = keys_dir()
    m.KEYS_DIR = d
    check("--keys-dir redirects the groq key file",
          m.key_file_for(m.PROVIDERS["groq"]) == os.path.join(d, "groq.edn"))
    check("preflight passes on a mode-600 dummy key",
          m.preflight_key_file(m.PROVIDERS["groq"])[0] is None)
    os.chmod(os.path.join(d, "groq.edn"), 0o644)
    check("preflight refuses a key file that is not mode 600",
          m.preflight_key_file(m.PROVIDERS["groq"])[0] == "key-mode")
    os.chmod(os.path.join(d, "groq.edn"), 0o600)
    missing = dict(m.PROVIDERS["groq"], key_file="/home/forge/secrets/nope.edn")
    check("preflight refuses a missing key file",
          m.preflight_key_file(missing)[0] == "no-key")
    m.KEYS_DIR = None


def test_keys_dir_fence():
    """The fence is enforced in main(), so drive it as a subprocess."""
    for bad in ("/home/forge", "/tmp", FENCE + "/../../etc"):
        r = run_runner(["--arm", "fake", "--keys-dir", bad], timeout=120)
        check("--keys-dir %s is refused" % bad,
              r.returncode == 4 and "outside the test fence" in r.stderr,
              (r.stderr.strip().splitlines() or [""])[0])


def test_write_fence():
    """THE WRITE FENCE (Sol fence r1, finding 3). Every proof here is a
    SUBPROCESS refusal, because the fence is enforced in main() and a refusal
    that only holds when a unit test calls the helper directly is not a fence.
    Each case must exit 4 and must do so BEFORE any provider call."""
    repo_root = os.path.realpath(os.path.join(HERE, os.pardir))

    def run(args, env=None, name=""):
        return run_runner(args, env)

    r = run(["--arm", "fake"], {"TYPIST_FX": "/home/forge"})
    check("TYPIST_FX=/home/forge is refused",
          r.returncode == 4 and "TYPIST_FX artifact root" in r.stderr,
          (r.stderr.strip().splitlines() or [""])[0])

    r = run(["--arm", "fake", "--fixture", "/tmp/x"])
    check("--fixture /tmp/x is refused",
          r.returncode == 4 and "--fixture preimage directory" in r.stderr,
          (r.stderr.strip().splitlines() or [""])[0])

    # A SYMLINK planted INSIDE the fence that points outside it. The name is
    # inside; the target is not, and the target is what gets rmtree'd.
    link_dir = tempfile.mkdtemp(prefix="fence-symlink-", dir=FENCE)
    link = os.path.join(link_dir, "looks-inside")
    os.symlink("/home/forge", link)
    r = run(["--arm", "fake", "--fixture", link])
    check("a symlink under the fence pointing outside is refused",
          r.returncode == 4 and "/home/forge" in r.stderr,
          (r.stderr.strip().splitlines() or [""])[0])
    os.unlink(link)
    os.rmdir(link_dir)

    # A test-local scratch root makes this independent of where the worktree
    # lives. ARM NW has a workspace inside the WRITE fence but outside
    # this SCRATCH fence: allowed to be written, not allowed to host an
    # unsandboxed codex child. Refused before any codex process is started.
    fx_in_repo = os.path.join(repo_root, "target", "fence-probe-fx")
    r = run(["--arm", "NW"], {"TYPIST_FX": fx_in_repo,
                              "TYPIST_TEST_NW_SCRATCH": os.path.join(FENCE, "isolated-offline-nw-root")})
    check("NW with a workspace outside the scratch fence is refused",
          r.returncode == 4 and "NW: sandbox unavailable" in r.stderr,
          (r.stderr.strip().splitlines() or [""])[0])
    check("...and it refused before any codex call",
          "codex" not in r.stdout)
    guarded = run(["--arm", "NW"], {"TYPIST_TEST_GUARD_PROBE": "1"})
    check("offline subprocess guard prevents real codex execution",
          guarded.returncode != 0 and "offline test blocked os.system" in guarded.stderr)



def test_offline_guard(m):
    """THE GUARD ITSELF. A test that only proves the fence refuses proves
    nothing about a checkout the fence admits; TYPIST_OFFLINE is the second,
    geography-independent stop."""
    check("TYPIST_OFFLINE=1 is read once, at import", m.OFFLINE is True)
    for exe in ("codex", "claude", "/usr/local/bin/codex"):
        try:
            m.guard_spawn([exe, "exec"])
            ok, detail = False, "no refusal"
        except SystemExit as e:
            ok, detail = e.code == 6, "exit=%s" % e.code
        check("offline refuses a %s spawn (exit 6)" % exe, ok, detail)
    try:
        m.guard_spawn(["clojure", "-M:x"])
        ok = True
    except SystemExit:
        ok = False
    check("offline leaves ordinary tools (clojure) alone", ok)
    try:
        m.subprocess.run(["codex", "exec", "-m", "x"], capture_output=True)
        ok, detail = False, "no refusal"
    except SystemExit as e:
        ok, detail = e.code == 6, "exit=%s" % e.code
    check("the guard sits at the subprocess CHOKEPOINT, not at call sites",
          ok, detail)
    try:
        m.urllib.request.urlopen("https://example.invalid")
        ok, detail = False, "no refusal"
    except SystemExit as e:
        ok, detail = e.code == 6, "exit=%s" % e.code
    check("offline refuses a network open (exit 6)", ok, detail)

    # SOL FENCE R3, finding 3: the three routes that walked past the r2 guard.
    # Each of them hands the command line to a SHELL, so argv[0] is `sh` or
    # `bash` and a guard that only looks at argv[0] sees nothing. Two stops
    # close them: the shell STRING is scanned in-process, and a PATH shim
    # makes `codex`/`claude` unstartable even for a shell string this process
    # never sees the inside of.
    try:
        m.os.system("codex exec -m gpt-5.6-sol")
        ok, detail = False, "no refusal"
    except SystemExit as e:
        ok, detail = e.code == 6, "exit=%s" % e.code
    check("offline refuses os.system('codex ...') (exit 6)", ok, detail)
    try:
        m.subprocess.run("codex exec -m gpt-5.6-sol", shell=True)
        ok, detail = False, "no refusal"
    except SystemExit as e:
        ok, detail = e.code == 6, "exit=%s" % e.code
    check("offline refuses a shell string (shell=True) (exit 6)", ok, detail)
    # Even a broken runner shim cannot fall through to the live PATH.
    r = m.subprocess.run(["/bin/bash", "--noprofile", "--norc", "-c", "codex exec -m gpt-5.6-sol"],
                         env=dict(os.environ, PATH=m.OFFLINE_SHIM_DIR, BASH_ENV="/dev/null", ENV="/dev/null"),
                         capture_output=True, text=True)
    check("a bash -c trampoline hits the PATH shim (exit 6)",
          r.returncode == 6 and "offline: spawn of codex refused" in r.stderr,
          "exit=%s %r" % (r.returncode, r.stderr.strip()))
    for name, arguments in [("spawnv", (os.P_WAIT, "/usr/local/bin/codex", ["codex", "--version"])),
                            ("posix_spawn", ("/usr/local/bin/codex", ["codex", "--version"], {}))]:
        if hasattr(m.os, name):
            try:
                getattr(m.os, name)(*arguments)
                refused = False
            except SystemExit as e:
                refused = e.code == 6
            check("offline refuses %s with its actual argument order" % name, refused)
    check("the offline PATH shim is installed under /var/tmp/forge",
          bool(m.OFFLINE_SHIM_DIR)
          and m.OFFLINE_SHIM_DIR.startswith(FENCE + os.sep)
          and os.access(os.path.join(m.OFFLINE_SHIM_DIR, "claude"), os.X_OK),
          str(m.OFFLINE_SHIM_DIR))
    r = m.subprocess.run(["/bin/echo", "ordinary"], capture_output=True, text=True)
    check("offline still RUNS an ordinary tool (echo)",
          r.returncode == 0 and r.stdout.strip() == "ordinary",
          "exit=%s %r" % (r.returncode, r.stdout.strip()))


# --------------------------------------------------------------------------
# (e) cost accounting -- an aggregate never outranks its members

def test_cost(m):
    """SOL FENCE R2, finding 5. The old report priced a group's SUMMED tokens,
    so one call with NO usage summed to zero tokens, met the table rate, and
    printed $0.0000 for a call nobody can price. Zero is a number a reader
    acts on; unknown is not."""
    for value, spelling in [(0.123456789123, "0.123456789123"), (1e-9, "0.000000001")]:
        check("human cost preserves %s" % spelling, m.usd_str(value) == "$" + spelling)
        check("cost-field EDN preserves float repr %r" % value,
              ":cost_usd " + repr(value) in m.edn({"cost_usd": value}))
    check("a candidate with missing usage is (None, None), never zero",
          m.cost_for("groq", None, None, None, None) == (None, None))
    check("a missing completion count is unknown, not zero",
          m.cost_for("groq", None, 100, None, None) == (None, None))
    priced, src = m.cost_for("groq", None, 1000, 1000, None)
    check("a complete usage pair prices from the dated table",
          priced is not None and src == "table:%s:groq" % m.PRICES_DATE,
          "%s %s" % (priced, src))
    check("a provider-reported cost wins over the table",
          m.cost_for("openrouter", "Cerebras", 10, 10, 0.12345678)
          == (0.12345678, "provider"))

    check("run_cost of one priced + one unpriced is the priced one",
          m.run_cost([{"cost_usd": 0.000521}, {"cost_usd": None}]) == 0.000521)
    check("run_cost of all-unpriced is None, never 0.0",
          m.run_cost([{"cost_usd": None}, {"cost_usd": None}]) is None)
    check("run_cost sums every priced candidate",
          m.run_cost([{"cost_usd": 0.1}, {"cost_usd": 0.02},
                      {"cost_usd": None}]) == 0.12)

    check("candidate_cost keeps the provider's own figure verbatim",
          m.candidate_cost("groq", {"cost_usd": 0.12345678,
                                    "cost_source": "provider",
                                    "prompt_tokens": 1, "tokens": 1})
          == (0.12345678, "provider"))
    check("candidate_cost refuses to price a call with no usage",
          m.candidate_cost("groq", {"prompt_tokens": None, "tokens": None})
          == (None, None))

    # THE REPORT, driven as a real CLI over a tree of unpriceable receipts.
    fx = os.path.join(SUITE_FX, "cost-%s" % uuid.uuid4().hex[:8])
    os.makedirs(fx, exist_ok=True)
    try:
        with open(os.path.join(fx, "receipt.edn"), "w") as fh:
            fh.write('{:candidates [{:cand "groq-1" :prompt_tokens nil '
                     ':tokens nil :cost_usd nil :cost_source nil}]}\n')
        r = run_runner(["--cost-report", "--fx", fx], {"TYPIST_FX": fx})
        row = [ln for ln in r.stdout.splitlines() if ln.startswith("groq")]
        tot = [ln for ln in r.stdout.splitlines() if ln.startswith("TOTAL")]
        check("--cost-report: an unpriceable groq row prints unknown",
              bool(row) and row[0].rstrip().endswith("unknown"),
              (row or [""])[0].strip())
        check("--cost-report: the TOTAL of only-unpriced rows is unknown",
              bool(tot) and tot[0].rstrip().endswith("unknown"),
              (tot or [""])[0].strip())
        check("--cost-report: no $0.0000 anywhere in the table",
              "$0.0000" not in r.stdout)
        written = [f for f in os.listdir(fx) if f.startswith("cost-report-")]
        body = open(os.path.join(fx, written[0])).read() if written else ""
        check("--cost-report: the receipt's :total_usd is nil, not 0",
              ":total_usd nil" in body,
              "; ".join(ln.strip() for ln in body.splitlines()
                        if "total_usd" in ln))
    finally:
        shutil.rmtree(fx, ignore_errors=True)

    # A MIXED GROUP: one provider-priced candidate and one unpriceable one.
    fx2 = os.path.join(SUITE_FX, "cost-%s" % uuid.uuid4().hex[:8])
    os.makedirs(fx2, exist_ok=True)
    try:
        with open(os.path.join(fx2, "receipt.edn"), "w") as fh:
            fh.write('{:candidates ['
                     '{:cand "groq-1" :prompt_tokens 10 :tokens 10 '
                     ':cost_usd 0.12345678 :cost_source "provider"} '
                     '{:cand "groq-2" :prompt_tokens nil :tokens nil '
                     ':cost_usd nil :cost_source nil}]}\n')
        r = run_runner(["--cost-report", "--fx", fx2], {"TYPIST_FX": fx2})
        row = [ln for ln in r.stdout.splitlines() if ln.startswith("groq")]
        # SOL FENCE R3, finding 5. The r2 test asserted the provider's figure
        # on the DISPLAY only, and the display was already truncating it to
        # $0.1235; the RECEIPT -- the artifact anyone would later read as the
        # authority -- went through the generic EDN float branch and became
        # 0.123. A cost is not a timing: the receipt must round-trip the
        # provider's own digits exactly, and the table must not print fewer.
        check("--cost-report: a mixed group keeps the provider's figure",
              bool(row) and "$0.12345678" in row[0], (row or [""])[0].strip())
        check("--cost-report: the table prints at least 6 decimals",
              bool(row) and re.search(r"\$\d+\.\d{6,}", row[0]),
              (row or [""])[0].strip())
        written = [f for f in os.listdir(fx2) if f.startswith("cost-report-")]
        body = open(os.path.join(fx2, written[0])).read() if written else ""
        check("--cost-report: the RECEIPT round-trips 0.12345678 exactly",
              ":cost_usd 0.12345678" in body,
              "; ".join(ln.strip() for ln in body.splitlines()
                        if "cost_usd" in ln))
        check("--cost-report: :total_usd is the provider figure, unrounded",
              ":total_usd 0.12345678" in body,
              "; ".join(ln.strip() for ln in body.splitlines()
                        if "total_usd" in ln))
        check("--cost-report: no truncated 0.123 in the receipt",
              ":cost_usd 0.123 " not in body and ":total_usd 0.123 " not in body
              and ":cost_usd 0.123\n" not in body
              and ":total_usd 0.123\n" not in body)
        check("--cost-report: the unpriced member is still counted UNKNOWN",
              "1 call(s) have no rate and are UNKNOWN, not zero." in r.stdout)
    finally:
        shutil.rmtree(fx2, ignore_errors=True)


# --------------------------------------------------------------------------
# (f) Runner key-path resolution, without reading real credentials.

def test_no_real_key_reachable():
    """Configured path witness only; no claim of child confinement."""
    d = keys_dir()
    r = run_runner(["--print-key-paths", "--keys-dir", d], timeout=120)
    check("--print-key-paths exits 0 and prints the contract",
          r.returncode == 0 and "offline_contract=chokepoint-not-sandbox" in r.stdout,
          "exit=%s %r" % (r.returncode, r.stdout.strip().splitlines()[:1]))
    paths = dict(
        (ln.split()[0], ln.split("key_path=", 1)[1].strip())
        for ln in r.stdout.splitlines() if "key_path=" in ln and not ln.startswith("keys_dir"))
    for prov in ("groq", "openrouter"):
        p = paths.get(prov, "")
        check("%s key path resolves under the dummy fence" % prov,
              bool(p) and (p == d or p.startswith(d + os.sep)), p)
    check("NO resolved key path touches /home/forge/secrets",
          not any(v.startswith("/home/forge/secrets") for v in paths.values()),
          repr(paths))
    check("--print-key-paths never prints a key VALUE",
          "gsk_" not in r.stdout and "sk-or-" not in r.stdout)
    # and the default, WITHOUT the seam, still is the fixed registry path --
    # so the witness above is a redirection, not an accident of a broken lookup.
    plain = offline_run(["--print-key-paths"],
                           env=dict(os.environ, TYPIST_OFFLINE="1"),
                           capture_output=True, text=True, timeout=120)
    check("without --keys-dir the groq path is still the fixed registry path",
          "/home/forge/secrets/groq.edn" in plain.stdout,
          (plain.stdout.strip().splitlines() or [""])[-1])


def main():
    os.makedirs(SUITE_FX, exist_ok=True)
    print(__doc__.strip().splitlines()[0])
    print("OFFLINE CONTRACT: chokepoint-not-sandbox -- TYPIST_OFFLINE=1 refuses "
          "the RUNNER'S OWN spawn/connect paths;")
    print("  it does NOT confine children and is NOT a sandbox. No OS boundary "
          "is available to this user on")
    print("  this box (unshare -rn: uid_map not permitted; no bwrap/firejail; "
          "no sudo). A general-purpose child")
    print("  Witnesses cover configured dummy paths and observed artifacts only;")
    print("  they do not prove arbitrary child containment or a full spending census.")
    print("")
    before = codex_session_paths()
    before_ledger = events_ledger_size()
    m = load_runner()
    m.KEYS_DIR = keys_dir()
    print("== scrubber ==");        test_scrub(m)
    print("== typed errors ==");    test_classify(m)
    print("== routing pin ==");     test_routing(m)
    print("== key fence ==");       test_keys(m)
    print("== --keys-dir fence =="); test_keys_dir_fence()
    print("== write fence ==");     test_write_fence()
    print("== offline guard ==");   test_offline_guard(m)
    print("== cost accounting =="); test_cost(m)
    print("== configured dummy key paths =="); test_no_real_key_reachable()

    # ---- OBSERVED ARTIFACT CANARIES. Independent checks, both
    # bound to stores this file never writes.
    print("")
    print("== observed artifact canaries ==")
    after = codex_session_paths()
    check("the ~/.codex/sessions PATH SET is identical before and after",
          after == before,
          "added=%s removed=%s" % (sorted(after - before)[:3],
                                   sorted(before - after)[:3]))
    after_ledger = events_ledger_size()
    check("~/.clj-surgeon/events.jsonl did not grow",
          after_ledger == before_ledger,
          "before=%s after=%s" % (before_ledger, after_ledger))
    priced = provider_priced_receipts(SUITE_FX)
    check("no suite receipt matches the provider-priced canary",
          not priced, "%s (fx=%s)" % (priced[:3], SUITE_FX))
    shutil.rmtree(SUITE_FX, ignore_errors=True)
    print("")
    if FAILURES:
        print("FAILED %d: %s" % (len(FAILURES), ", ".join(FAILURES)))
        return 1
    print("typist-run-test: all checks ok")
    return 0


if __name__ == "__main__":
    sys.exit(main())
