#!/usr/bin/env bb
;; preservation-tables-test — the ratchet over the brief's own allowlist tables.
;;
;; PB-FENCE-006 was a table entry whose semantics were never modelled: `are` sat in
;; the "introduces no binding" table while `clojure.test/are` binds the symbols in
;; its argv. Fixing that one entry fixes nothing; the class is that **a table entry
;; is a soundness claim, and an unexamined claim is exactly how a checker
;; certifies a defect.**
;;
;; So every entry in every table must carry its falsifier here:
;;
;;   R1  every `core-fn-allowlist` entry resolves to a real clojure.core Var that is
;;       NOT a macro. That resolution IS the falsifier: a function's arguments are
;;       evaluated, so it cannot introduce a binding. This rung removed `cast` and
;;       the typo `when-first?`.
;;   R2  every head in a non-frozen table is a special form, or resolves in
;;       clojure.core / clojure.test. If it resolves to a MACRO it must be declared
;;       either non-binding (and carry an R3 witness) or frozen.
;;   R3  every non-frozen head that the walker gives binding treatment, and every
;;       macro declared non-binding, carries an EXECUTED witness below that
;;       exercises its binding semantics against the real `scope-analysis`.
;;       A table entry with no witness fails this test.
;;   R4  the three historic false-certification classes carry full planted-defect
;;       replay rows in `bin/preservation-replay`, named here.
;;
;; `frozen-heads` needs no witness: freezing is the ABSENCE of a claim. That
;; asymmetry is the whole design — anything unproved goes there.
(ns preservation-tables-test
  (:require [babashka.fs :as fs]
            [babashka.classpath :refer [add-classpath]]
            [clojure.string :as str]
            [clojure.edn :as edn]
            [clojure.set :as set]
            [babashka.process :as p]
            [clojure.test :as t]))

(def here (fs/parent (fs/real-path *file*)))
(add-classpath (str here))
(require '[preservation-scan :as sc])

(def brief-src (slurp (str (fs/path here "preservation-brief"))))
(def replay-src (slurp (str (fs/path here "preservation-replay"))))

(def brief (str (fs/path here "preservation-brief")))

(def tables
  (edn/read-string (:out (p/sh {:out :string :err :string} brief "--dump-tables" "1"))))

(def walked-special-forms (:walked-special-forms tables))
(def frozen-special-forms (:frozen-special-forms tables))
(def let-like-vars (:let-like-vars tables))
(def seq-binding-vars (:seq-binding-vars tables))
(def fn-like-vars (:fn-like-vars tables))
(def defn-like-vars (:defn-like-vars tables))
(def other-modelled-vars (:other-modelled-vars tables))
(def frozen-vars (:frozen-vars tables))
(def non-binding-macro-vars (:non-binding-macro-vars tables))
(def core-fn-vars (:core-fn-vars tables))
(def table-vars (:table-vars tables))

(defn bare [q] (last (str/split q #"/")))
(defn nspace [q] (first (str/split q #"/")))

;; Every Var the walker gives binding treatment to, plus every macro declared
;; non-binding. These are the claims that need an executed witness.
(def claim-vars
  (set/union let-like-vars seq-binding-vars fn-like-vars defn-like-vars
             other-modelled-vars non-binding-macro-vars))

;; --------------------------------------------------------------- resolution

(defn var-for
  "Resolve a fully qualified table entry in its stated namespace."
  [q]
  (let [n (nspace q) b (bare q)]
    (try (ns-resolve (symbol n) (symbol b)) (catch Exception _ nil))))

(defn macro? [nm] (boolean (:macro (meta (var-for nm)))))

;; ------------------------------------------------------------- the witnesses
;;
;; Each entry: head -> [source, binder-that-must-be-detected].
;; The witness runs the REAL `scope-analysis` and asserts the head's binding
;; position is reported bound, so a bare use of that name can never be
;; canonicalised to a Var. A head with no entry fails R3.

(def binding-witnesses
  {"let"             ["(let [probe 1] probe)" "probe"]
   "let*"            ["(let* [probe 1] probe)" "probe"]
   "loop"            ["(loop [probe 1] probe)" "probe"]
   "loop*"           ["(loop* [probe 1] probe)" "probe"]
   "binding"         ["(binding [probe 1] probe)" "probe"]
   "with-open"       ["(with-open [probe (f)] probe)" "probe"]
   "with-local-vars" ["(with-local-vars [probe 1] probe)" "probe"]
   "with-redefs"     ["(with-redefs [probe 1] probe)" "probe"]
   "with-bindings"   ["(with-bindings [probe 1] probe)" "probe"]
   "if-let"          ["(if-let [probe (f)] probe nil)" "probe"]
   "when-let"        ["(when-let [probe (f)] probe)" "probe"]
   "if-some"         ["(if-some [probe (f)] probe nil)" "probe"]
   "when-some"       ["(when-some [probe (f)] probe)" "probe"]
   "when-first"      ["(when-first [probe xs] probe)" "probe"]
   "dotimes"         ["(dotimes [probe 3] probe)" "probe"]
   "with-precision"  ["(with-precision [probe 1] probe)" "probe"]
   "with-in-str"     ["(with-in-str [probe 1] probe)" "probe"]
   "for"             ["(for [probe xs] probe)" "probe"]
   "doseq"           ["(doseq [probe xs] probe)" "probe"]
   "fn"              ["(fn [probe] probe)" "probe"]
   "fn*"             ["(fn* [probe] probe)" "probe"]
   "defn"            ["(defn f [probe] probe)" "probe"]
   "defn-"           ["(defn- f [probe] probe)" "probe"]
   "defmacro"        ["(defmacro m [probe] probe)" "probe"]
   "letfn"           ["(letfn [(g [probe] probe)] (g 1))" "probe"]
   "catch"           ["(try (f) (catch Exception probe probe))" "probe"]
   "as->"            ["(as-> (f) probe probe)" "probe"]
   "defmethod"       ["(defmethod m :k [probe] probe)" "probe"]
   ;; `case` binds nothing, but its TEST constants are unevaluated: a symbol there
   ;; is a literal, not a Var reference, so the walker must freeze it.
   "case"            ["(case x probe 1 2)" "probe"]})

;; Destructuring must be covered too, since that is the shape PB-FENCE-001 used.
(def destructuring-witnesses
  {"map destructuring"    ["(let [{:keys [probe]} m] probe)" "probe"]
   "vector destructuring" ["(let [[a probe] v] probe)" "probe"]
   "nested :as"           ["(fn [{:keys [x] :as probe}] probe)" "probe"]
   "for :let"             ["(for [x xs :let [probe (f x)]] probe)" "probe"]})

;; A macro declared NON-binding must not report a binder for its natural syntax.
;; This is the falsifier that `are` fails: run it with "are" declared non-binding
;; and the witness below shows `probe` unbound, which is precisely the state that
;; let Sol's PB-FENCE-006 pair be certified.
(def non-binding-witnesses
  {"when"     "(when true probe)"
   "when-not" "(when-not false probe)"
   "if-not"   "(if-not false probe nil)"
   "and"      "(and probe)"
   "or"       "(or probe)"
   "cond"     "(cond :else probe)"
   "->"       "(-> probe f)"
   "->>"      "(->> probe f)"
   "some->"   "(some-> probe f)"
   "doto"     "(doto probe f)"
   "testing"  "(testing \"x\" probe)"
   "is"       "(is (= probe 1))"})

;; R4: the three classes that produced a false section-A certification each have a
;; full planted-defect replay row. The names must appear in the replay source.
(def required-replay-rows
  ["local-shadow" "symlink-escape" "external-macro"
   "are-binding" "kind-collision" "uppercase-alias" "referred-testing"])

;; ------------------------------------------------------------------- harness

(def failures (atom []))
(defn check! [ok? label detail]
  (when-not ok? (swap! failures conj (str label " — " detail)))
  ok?)

;; R1 -----------------------------------------------------------------------
(println "R1  core-fn-vars:" (count core-fn-vars) "entries")
(doseq [q (sort core-fn-vars)]
  (let [v (var-for q)]
    (check! (some? v) "R1 unresolved" (str "`" q "` resolves to no Var"))
    (when v (check! (not (:macro (meta v))) "R1 macro in function table"
                    (str "`" q "` is a MACRO; a macro's operands may be binding forms")))))

;; R2 -----------------------------------------------------------------------
(println "R2  modelled/frozen Vars:" (count table-vars))
(doseq [q (sort table-vars)]
  (let [v (var-for q)]
    (check! (some? v) "R2 unresolved table Var" (str "`" q "` resolves to no Var")))
  (check! (not (contains? core-fn-vars q)) "R2 table collision"
          (str "`" q "` is in both a modelled/frozen table and the function allowlist")))
(doseq [q (sort non-binding-macro-vars)]
  (let [v (var-for q)]
    (when v (check! (:macro (meta v)) "R2 function in macro table"
                    (str "`" q "` is declared a non-binding MACRO but resolves to a function")))))
(check! (empty? (set/intersection walked-special-forms frozen-special-forms))
        "R2 special-form collision" "a special form is both walked and frozen")

;; R3 -----------------------------------------------------------------------
(println "R3  claims needing a witness:" (count claim-vars))
(doseq [q (sort claim-vars)]
  (let [b (bare q)]
    (check! (or (contains? binding-witnesses b) (contains? non-binding-witnesses b))
            "R3 unwitnessed table entry"
            (str "`" q "` is a table entry with no executed witness — a soundness claim with no falsifier"))))

(defn brief-bound? [src]
  (let [{:keys [out exit]} (p/sh {:out :string :err :string} brief "--probe-scope" src)]
    (and (zero? exit) (str/includes? out "BOUND"))))

(println "R3  running" (+ (count binding-witnesses) (count destructuring-witnesses)
                          (count non-binding-witnesses)) "executed witnesses")
(doseq [[nm [src _]] (sort binding-witnesses)]
  (check! (brief-bound? src) "R3 binding witness FAILED"
          (str "`" nm "`: " src " — the walker did not report `probe` bound")))
(doseq [[nm [src _]] (sort destructuring-witnesses)]
  (check! (brief-bound? src) "R3 destructuring witness FAILED" (str nm ": " src)))
(doseq [[nm src] (sort non-binding-witnesses)]
  (check! (not (brief-bound? src)) "R3 non-binding witness FAILED"
          (str "`" nm "` is declared non-binding but the walker reports `probe` bound: " src)))

;; R5 -----------------------------------------------------------------------
;; GENERATED, one row per table entry. PB-FENCE-009: a table used to speak for a
;; SPELLING, so a file that referred its own binding macro named `testing` got
;; clojure.test/testing's semantics. Every entry must flip to unmodelled when a
;; same-named macro is referred from another namespace. These rows are produced
;; here, not hand-written, so a new table entry cannot arrive without one.
(def shadow-ns "shadow.probe")
(def shadow-targets (vec (sort (set/union table-vars core-fn-vars))))
(println "R5  generated shadow witnesses:" (count shadow-targets))
(let [tsv (str "/var/tmp/forge/item3/shadow-witnesses.tsv")
      _ (fs/create-dirs (fs/parent tsv))
      _ (spit tsv (str/join "\n" (for [q shadow-targets]
                                    (str (bare q) "\t" (bare q) "|" shadow-ns))))
      out (:out (p/sh {:out :string :err :string} brief "--probe-heads" tsv))
      lines (vec (remove str/blank? (str/split-lines out)))]
  (check! (= (count lines) (count shadow-targets)) "R5 probe count"
          (str "expected " (count shadow-targets) " results, got " (count lines)))
  (doseq [[q line] (map vector shadow-targets lines)]
    (check! (str/starts-with? line "unmodelled") "R5 shadow witness FAILED"
            (str "`" q "`: a referred `" shadow-ns "/" (bare q)
                 "` did not flip the head to unmodelled — got `" line
                 "`. The table is speaking for a spelling, not a Var"))))

;; the unshadowed control: without a refer, the same heads keep their meaning
(let [tsv "/var/tmp/forge/item3/shadow-controls.tsv"
      _ (spit tsv (str/join "\n" (for [q shadow-targets] (str (bare q) "\t-"))))
      out (:out (p/sh {:out :string :err :string} brief "--probe-heads" tsv))
      lines (vec (remove str/blank? (str/split-lines out)))]
  (doseq [[q line] (map vector shadow-targets lines)]
    (check! (not (str/starts-with? line "unmodelled")) "R5 control FAILED"
            (str "`" q "` is unmodelled even with nothing shadowing it: " line))))

;; R4 -----------------------------------------------------------------------
(println "R4  required replay rows:" (count required-replay-rows))
(doseq [r required-replay-rows]
  (check! (str/includes? replay-src r) "R4 missing replay row"
          (str "`" r "` has no planted-defect row in bin/preservation-replay")))

;; --------------------------------------------------------------------------
(println)
(if (empty? @failures)
  (do (println "PASS — every table entry carries its falsifier, including a generated shadow witness.")
      (System/exit 0))
  (do (println (str "FAIL — " (count @failures) " table claims are unsupported:"))
      (doseq [f (take 40 @failures)] (println "  -" f))
      (when (> (count @failures) 40) (println "  ... and" (- (count @failures) 40) "more"))
      (System/exit 1)))
