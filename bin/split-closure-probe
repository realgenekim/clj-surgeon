#!/usr/bin/env bb
#_{:clj-kondo/ignore [:namespace-name-mismatch]}
(ns split-closure-probe (:require [babashka.fs :as fs] [clj-surgeon.analyze :as a] [clojure.edn :as edn]
                                [clojure.string :as str] [clojure.test :as t] [rewrite-clj.zip :as z]))
(def kinds #{"def" "defn" "defn-" "defmulti" "defmethod" "defmacro" "defonce" "defrecord" "defprotocol" "deftype"})
(defn references [form env] (let [walk #(references % env) [op & args] (when (seq? form) form)]
    (cond (symbol? form) (when-not (env form) [form]) (#{'quote 'clojure.core/quote 'ns 'comment} op) []
          (#{'let 'loop 'let* 'loop*} op) (loop [[b init & more :as bs] (destructure (first args)) scope env found []]
            (if (seq bs) (recur more (conj scope b) (into found (references init scope)))
              (into found (mapcat #(references % scope) (rest args)))))
          (#{'defn 'defn- 'defmacro} op) (walk (cons 'fn (drop-while #(not (sequential? %)) (rest args))))
      (#{'fn 'fn*} op) (let [[scope tail] (if (symbol? (first args)) [(conj env (first args)) (rest args)] [env args])]
            (mapcat (fn [[params & body]] (references (list* 'let [params nil] body) scope))
                    (if (vector? (first tail)) [tail] tail)))
          (#{'def 'defonce} op) (mapcat walk (rest args)) (coll? form) (mapcat walk form) :else [])))
(defn sites [lib owners parsed] (let [nodes (remove #(= :uneval (z/tag %)) (take-while some? (iterate z/right parsed)))
        forms (map z/sexpr nodes) aliases (assoc (a/parse-ns-aliases (first nodes)) lib lib)
        refers (into {} (for [f forms :when (and (seq? f) (= 'ns (first f)))
                          c (drop 2 f) :when (and (seq? c) (= :require (first c)))
                          [target & opts] (filter vector? (rest c)) :when (= lib (str target))
                          :let [{:keys [refer rename]} (apply hash-map opts)]
                          n (if (= :all refer) owners (map str refer))] [(str (get rename (symbol n) n)) n]))]
    (count (filter #(if (namespace %) (and (owners (name %)) (= lib (aliases (namespace %))))
                       (owners (refers (name %)))) (mapcat #(references % #{}) forms)))))
(defn probe [{:keys [source destinations]} parsed callers existing] (let [forms (a/top-level-forms parsed)
        graph (filter #(kinds (:type-str %)) forms) names (into (sorted-set) (map :name-str graph))
        counts (frequencies (mapcat :forms destinations)) unmapped (vec (remove counts names))
        doubled (vec (filter #(< 1 (get counts % 0)) names))
        edges (sort (for [{:keys [name-str zloc]} graph dep (set (map str (references (z/sexpr zloc) #{})))
                         :when (and (names dep) (not= name-str dep))] [name-str dep]))
        hits (sort (for [[file forms] callers] [file (sites (:lib source) names forms)]))] (str/join "\n" (concat
      (for [n names] (str "owner " n " " (case (get counts n 0) 0 "not-at-all" 1 "exactly-once" "more-than-once")))
      [(str "non-owners=" (- (count forms) (count graph))) (str "unmapped=" (pr-str unmapped))
       (str "double-mapped=" (pr-str doubled)) (str "unknown=" (pr-str (vec (sort (remove names (keys counts))))))]
      (for [d destinations] (str "destination " (pr-str (select-keys d [:lib :file :forms]))
                                " exists=" (contains? existing (:file d))))
      (for [[file n] hits] (str "caller " file " sites=" n)) (for [[owner dep] edges] (str owner " -> " dep))
      [(format (str "split-closure-probe: owners=%d distinct=%d mapped=%d unmapped=%d double=%d "
                    "destinations=%d absent=%d sites=%d callers=%d edges=%d")
               (count graph) (count names) (count (filter #(= 1 (get counts %)) names))
      (count unmapped) (count doubled) (count destinations) (count (remove #(existing (:file %)) destinations))
               (reduce + (map second hits)) (count (filter #(pos? (second %)) hits)) (count edges))]))))
(defn run-probe [request-file root]
  (let [request (edn/read-string (slurp request-file)) read-source #(a/string->zloc (slurp (fs/file root %)))
        source (get-in request [:source :file]) exists? #(fs/exists? (fs/path root %))
        paths (distinct (mapcat #(fs/glob (fs/path root %) "**.clj") (filter exists? (:roots request))))
     callers (into {} (for [p paths :let [f (str (fs/relativize root p))] :when (not= f source)] [f (read-source f)]))]
    (str (apply str (for [p (remove exists? (:roots request))] (str "missing-root=" p "\n")))
         (probe request (read-source source) callers (set (filter exists? (map :file (:destinations request))))))))
(when (= *file* (System/getProperty "babashka.file")) (cond (= ["--self-test"] *command-line-args*)
      (do (require 'split-closure-probe-test) (let [{:keys [test fail error]} (t/run-tests 'split-closure-probe-test)]
              (System/exit (if (and (pos? test) (zero? (+ fail error))) 0 1))))
        (= 2 (count *command-line-args*)) (println (apply run-probe *command-line-args*))
     :else (throw (ex-info "Usage: bb bin/split-closure-probe REQUEST.edn SOURCE-TREE | --self-test (.clj only)" {}))))
