#!/usr/bin/env bb
(ns surgeon-footprint {:clj-kondo/ignore [:namespace-name-mismatch]}
  (:require [clj-surgeon.agent-routing :as routing] [babashka.process :as process] [cheshire.core :as json]
            [clojure.java.io :as io] [clojure.string :as str] [babashka.fs :as fs]
            [clojure.test :refer [deftest is run-tests]]))
(def names-re #"clj-surgeon|cclsp|clojure-lsp")
(defn lines [s] (remove str/blank? (str/split-lines (or s ""))))
(defn toml [s]
  (when (re-find #"\"\"\"|'''" (or s "")) (throw (ex-info "unsupported: multiline TOML string" {})))
  (let [clean (str/replace (or s "") #"'[^']*'|\"(?:\\.|[^\"\\])*\"|#[^\r\n]*"
                           #(if (str/starts-with? % "#") "" %))
        joined (str/replace clean #"\[(?:[^\[\]\"']|\"(?:\\.|[^\"\\])*\"|'[^']*')*\]"
                            #(str/replace % #"\r?\n" " "))]
    (for [[_ table body] (re-seq #"(?ms)^\h*\[([^\]\r\n]+)\]\h*\n?((?:(?!^\h*\[).)*)" joined)]
      [table (into {} (map #(subvec % 1) (re-seq #"(?m)^\h*(\w+)\h*=\h*(.*?)\h*$" body)))])))
(defn entries [s toml?]
  (let [data (if toml? {"mcpServers" (toml s)} (json/parse-string s))]
    (concat (when toml? (keep-indexed #(when (re-find #"^\h*[^#=]+\h*=\h*\{" %2)
                                         (str "unsupported: inline table at line " (inc %1)))
                          (str/split-lines (or s ""))))
      (for [[path config] (cons [nil data] (get data "projects")) [name entry] (get config "mcpServers")
            :when (or (not toml?) (re-matches
                    #"(?:mcp_servers|'mcp_servers'|\"mcp_servers\")\h*\.\h*(?:[\w-]+|'[^']+'|\"[^\"]+\")" name))
            :let [command (str/join " " (keep entry ["command" "args" "url"]))]
            :when (re-find names-re (str name " " command))]
        (str (when path (str "project=" path " ")) name " required="
             (get entry "required" "unspecified") " command=" command
             (when (contains? entry "disabled") (str " disabled=" (get entry "disabled"))))))))
(defn regular-token? [probe] (true? (:regular? probe)))
(defn file-probe [file] {:regular? (.isFile file)})
(defn read-file [path & [limit]]
  (try (let [file (io/file path)] (if limit
          (when (regular-token? (file-probe file))
            (with-open [in (io/input-stream file)] (String. (.readNBytes in limit) "UTF-8")))
          (java.nio.file.Files/readString (.toPath file))))
       (catch java.nio.file.NoSuchFileException _ nil)
       (catch Exception e e)))
(defn cron-lines [s read-script]
  (for [line (lines s)
        :let [paths (keep #(let [content (read-script %)]
                             (cond (instance? Exception content) (str % " (unreadable)")
                                   (and (string? content) (re-find
                                    #"clj-surgeon|cclsp|clojure-lsp|7906|7888|7890|surgeon-call|/mcp" content)) %))
                      (distinct (map #(str/replace % #"^['\"]|['\"]$" "")
                                     (re-seq #"\"[^\"]+\"|'[^']+'|[^\s<>;|&]+" line))))]
        :when (or (and (not (re-find #"^\s*#" line)) (re-find names-re line)) (seq paths))]
    (str line (when (seq paths) (str " scripts=" (str/join "," paths))))))
(defn section [title source]
  (println (str "section: " title))
  (reduce + (for [[path raw parse] source]
              (try (when (instance? Exception raw) (throw raw))
                   (let [found (when raw (vec (parse raw)))]
                     (doseq [v (or (seq found) [(if raw "none" "absent")])] (println (str path ": " v)))
                     (count found))
                   (catch Exception e (println (str path (if (identical? e raw) ": unreadable: " ": parse error: ")
                                                 (.getMessage e))) 0)))))
(defn listener [line]
  (when-let [[_ address port tail] (or (re-matches
                               #"\s*(?:LISTEN|tcp[46]?)\s+\d+\s+\d+\s+(\S+)[:.](\d+)\s+\S+\s*(.*)" line)
          (when-let [[_ cmd pid address port] (re-matches
                      #"\s*(\S+)\s+(\d+)\s+.*\sTCP\s+(\S+):(\d+)\s+\(LISTEN\)" line)]
            [nil address port (str "LISTEN " cmd " pid=" pid)]))]
    (let [owner (str/replace tail #"^LISTEN\s*" "")]
      (when (and (or (str/starts-with? (str/trim line) "LISTEN") (str/starts-with? tail "LISTEN"))
                 (or (#{"7888" "7890" "7906"} port) (re-find names-re owner)))
        {:address address :port port :owner owner}))))
(defn process-line [line]
  (when-let [[_ pid uptime args] (re-matches #"\s*(\d+)\s+([\d:-]+)\s+(.+)" line)]
    (when (re-find #"clj[-_]surgeon|cclsp|clojure-lsp" args)
      (let [[exe & argv] (drop-while #(re-matches #"(?:\w+=.*|(?:/usr/bin/)?env)" %)
                                    (str/split args #"\s+"))
            exe (last (str/split (or exe "") #"/"))
            [main & main-argv] (loop [[x & xs] argv]
                   (cond (#{"-cp" "-classpath" "--class-path" "--module-path" "-p"} x) (recur (rest xs))
                         (#{"-jar" "-e" "--eval" "-i" "--init" "-f" "--file"} x) nil
                         (or (= x "clojure.main") (str/starts-with? (or x "") "-")) (recur xs)
                         :else (cons x xs)))
            surgeon? #(and (= "clj-surgeon" (last (str/split (or %1 "") #"/"))) (some #{"mcp-serve"} %2))
            server? (or (#{"cclsp" "clojure-lsp"} exe) (surgeon? exe argv)
                        (and (#{"bb" "clojure" "java"} exe)
                             (or (#{"clj_surgeon.mcp_server" "clj-surgeon.mcp-server"} main)
                                 (and (= exe "bb") (surgeon? main main-argv)))))]
        {:kind (if server? :server :mention) :pid pid :command (subs args 0 (min 100 (count args)))
         :uptime (str (reduce + (map * [1 60 3600 86400] (map parse-long (reverse (str/split uptime #"[-:]"))))))}))))
(defn units [sources]
  (distinct (for [line (mapcat lines sources)
                  :let [tokens (str/split (str/trim line) #"\s+")
                        unit (if (re-matches #"\d+|-" (first tokens)) (nth tokens 2 "") (first tokens))]
                  :when (re-find names-re unit)] (str/replace unit #"\.plist$" ""))))
(defn routing-block [s]
  (let [s (or s "") {:keys [ok state begin end]} (#'routing/marker-state s)]
    (cond (not ok) ["malformed"] (= state :absent) ["absent"]
          :else (let [block (subs s begin (if (str/starts-with? (subs s end) "\n") (inc end) end))]
                  [(str (#'routing/sha256 block) " "
                        (some #(when (str/includes? % "Derived from doctrine commit") %) (lines block)))]))))
(defn command [& argv]
  (try (let [{:keys [exit out err]} (apply process/shell {:out :string :err :string :continue true} argv)]
         (if (and (or (zero? (or exit 0))
                      (and (= "lsof" (first argv)) (= 1 exit) (str/blank? out))) (str/blank? err)) (or out "")
             (throw (ex-info (if (str/blank? err) (str "exit " exit) (str/trim err)) {}))))
       (catch Exception e (println (str (str/join " " argv) ": unavailable: " (.getMessage e))) nil)))
(defn launch-agents [home]
  (try (str/join "\n" (filter #(str/ends-with? % ".plist")
              (or (.list (io/file home "Library/LaunchAgents")) (throw (java.io.IOException. "listing failed")))))
       (catch Exception e (println (str "~/Library/LaunchAgents: unavailable: " (.getMessage e))) nil)))
(defn host-name [resolve-host] (try (.getHostName (resolve-host)) (catch Exception _ "unknown-host")))
(defn listeners [mac?]
  (let [[tool raw] (some #(when-let [out (apply command %)] [(first %) out])
                        [["ss" "-ltnp"] ["ss" "-ltn"] ["lsof" "-nP" "-iTCP" "-sTCP:LISTEN"]
                         (if mac? ["netstat" "-an" "-p" "tcp"] ["netstat" "-ltn"])])]
    (println (str "listeners-source: " (or tool "none")))
    (section "Listeners" [["listen" (or raw "unavailable: no ss, lsof or netstat")
                           #(if tool (keep listener (lines %)) [%])]])
    (count (keep listener (lines raw)))))
(defn host-footprint [home & [mac?]]
  (let [listeners (listeners mac?)
        processes (keep process-line (lines (command "ps" "-eo" (if mac? "pid,etime,args" "pid,etimes,args"))))
        sources (if mac?
                  [(command "launchctl" "list") (launch-agents home)]
                  [(command "systemctl" "--user" "list-units" "--all" "--no-pager" "--plain")
                   (command "systemctl" "--user" "list-unit-files" "--no-pager" "--plain")])
        unit-count (section "Launch units" [["units" sources units]])]
    (section "Processes" [["ps" processes identity]])
    (section "Routing blocks" (for [p ["/.claude/CLAUDE.md" "/.codex/AGENTS.md"]]
                [(str home p) (or (read-file (str home p) 65536) :not-regular)
                 #(if (= % :not-regular) ["not-regular"] (routing-block %))]))
    (str " listeners=" listeners " servers=" (count (filter #(= :server (:kind %)) processes))
         " units=" unit-count)))
(defn profile-dirs [home env dirs]
  (->> (concat (when-not (str/blank? env) [env]) dirs
               (filter #(fs/directory? % {:nofollow-links true}) (fs/list-dir home ".claude-*")))
       (map #(str (fs/normalize (fs/absolutize %)))) distinct sort))
(defn profile-sources [dirs read-config]
  (for [dir dirs name [".claude.json" "settings.json"] :let [p (str dir "/" name) raw (read-config p)]
        :when (some? raw)] [p raw #(entries % false)]))
(defn config-dirs [args]
  (when (and (even? (count args))
             (every? (fn [[flag dir]] (and (= flag "--config-dir") (not (str/blank? dir))
                                           (not (str/starts-with? dir "--")))) (partition 2 args)))
    (vec (take-nth 2 (rest args)))))
(defn census [& [dirs]]
  (let [home (or (System/getenv "HOME") (System/getProperty "user.home"))
        default-dir (str (fs/normalize (fs/absolutize (str home "/.claude"))))
        selected (profile-dirs home (System/getenv "CLAUDE_CONFIG_DIR") dirs)
        profiles (remove #{default-dir} selected)
        _ (println (str "profiles: " (count profiles) " extra (" (str/join ", " profiles) ")"))
        read-cron #(let [p (str/replace % #"^~/" (str home "/"))]
                     (read-file (if (.isAbsolute (io/file p)) p (str home "/" p)) 65536))
        entries-count (section "MCP entries"
                        (concat (for [p ["~/.codex/config.toml" "~/.claude.json" "~/.claude/settings.json"
                                 "~/.claude/mcp.json" "./.mcp.json" "./.codex/config.toml"]]
                          [p (read-file (str/replace p #"^~" home)) #(entries % (str/ends-with? p ".toml"))])
                                (profile-sources selected #(when-not (= % (str default-dir "/settings.json"))
                                                             (read-file %)))))
        cron (try (:out (process/shell {:out :string :err :string} "crontab" "-l")) (catch Exception e e))
        cron-count (section "Cron" [["crontab" cron #(cron-lines % read-cron)]])
        extra (host-footprint home (= "Mac OS X" (System/getProperty "os.name")))]
    (println (str "footprint: " (host-name #(java.net.InetAddress/getLocalHost)) " " (java.time.Instant/now)
                  " entries=" entries-count " cron=" cron-count extra))))
(deftest quoted-toml-keys (doseq [key ["clj-surgeon" "'clj-surgeon'" "\"clj-surgeon\""]]
    (is (= [(str "mcp_servers." key " required=true command='bb'")]
           (vec (entries (str "[mcp_servers." key "]\nrequired=true # needed\ncommand='bb'") true)))))
  (is (= 1 (count (entries "['mcp_servers'.'cclsp']\ncommand='bun'" true))))
  (is (= 1 (count (entries "[\"mcp_servers\" . \"cclsp\"]" true))))
  (is (empty? (entries "[unrelated]\ncommand='cclsp'" true))))
(deftest toml-comments-and-arrays
  (let [s "[mcp_servers.other]\nargs = [ # cclsp\n 'clj-surgeon',\n '--stdio',\n]\n"]
    (is (= ["mcp_servers.other required=unspecified command=[   'clj-surgeon',  '--stdio', ]"] (entries s true))))
  (is (empty? (entries "[mcp_servers.other]\ncommand = 'echo' # formerly cclsp" true)))
  (is (= "'a#b'" (get-in (into {} (toml "[x]\nvalue='a#b' # comment")) ["x" "value"])))
  (is (= "\"a\\\"#b\"" (get-in (into {} (toml "[x]\nvalue=\"a\\\"#b\" # cclsp")) ["x" "value"])))
  (is (= 1 (count (entries "[mcp_servers.cclsp]\n[mcp_servers.cclsp.env]\nX='x'" true))))
  (is (empty? (toml nil))) (is (= [["x" {}]] (toml "[x]"))))
(deftest json-project-paths
  (let [s (json/generate-string {"mcpServers" {"cclsp" {"command" "bun" "required" true}}
                                 "projects" {"/r" {"mcpServers" {"lsp" {"command" "clojure-lsp"}}}}})]
    (is (= ["cclsp required=true command=bun" "project=/r lsp required=unspecified command=clojure-lsp"]
           (vec (entries s false)))))
  (doseq [s ["{}" "{\"mcpServers\":{\"x\":{\"command\":\"echo\"}}}"]] (is (empty? (entries s false))))
  (is (= ["x required=false command=http://host/clj-surgeon"]
         (vec (entries "{\"mcpServers\":{\"x\":{\"url\":\"http://host/clj-surgeon\",\"required\":false}}}" false)))))
(deftest cron-script-content
  ;; A disabled weekly verb sentinel must be found through its script, without a tool name in the cron line.
  (let [line "# 0 3 * * 0 /bin/bash /home/forge/bin/verb-sentinel" path "/home/forge/bin/verb-sentinel"]
    (doseq [marker ["7906" "7888" "7890" "surgeon-call" "/mcp" "clj-surgeon" "cclsp" "clojure-lsp"]]
      (is (= [(str line " scripts=" path)] (vec (cron-lines line {path marker}))))))
  (is (= ["@daily bin/check.sh scripts=bin/check.sh"]
         (vec (cron-lines "@daily bin/check.sh" {"bin/check.sh" "surgeon-call"}))))
  (is (= ["@daily 'a b.sh' /second scripts=a b.sh,/second"]
         (vec (cron-lines "@daily 'a b.sh' /second" {"a b.sh" "7906" "/second" "/mcp"}))))
  (is (= ["@daily cclsp"] (vec (cron-lines "@daily cclsp\n# cclsp disabled" {}))))
  (is (empty? (cron-lines "@daily /missing\n@daily /unrelated" {"/unrelated" "echo ok"})))
  (is (empty? (cron-lines nil {}))))
(deftest per-file-parse-errors-continue (let [result (atom nil) output (with-out-str
        (reset! result (section "test" [["broken.json" "{" #(entries % false)]
                                       ["next.toml" "[mcp_servers.cclsp]" #(entries % true)]])))]
    (is (= 1 @result))
    (is (str/includes? output "broken.json: parse error:"))
    (is (str/includes? output "next.toml: mcp_servers.cclsp required=unspecified command="))))
(deftest missing-versus-unreadable (doseq [[error expected] [[(java.nio.file.NoSuchFileException. "config") "absent"]
                          [(java.io.IOException. "Permission denied") "unreadable: Permission denied"]]]
    (with-redefs [io/file (fn [_] (throw error))]
      (is (= (str "section: test\nconfig: " expected "\n")
             (with-out-str (section "test" [["config" (read-file "config") lines]])))))))
(deftest census-edge (let [config "[mcp_servers.cclsp]\ncommand='bun'"
        home (or (System/getenv "HOME") (System/getProperty "user.home"))
        files {"./.codex/config.toml" config (str home "/bin/check.sh") "curl localhost:7906/mcp"}
        output (with-redefs [read-file (fn [p & _] (files p))
                     process/shell (fn [_ & args]
                        (when (= ["crontab" "-l"] (vec args)) {:out "@daily bin/check.sh"}))]
                 (with-out-str (census)))]
    (is (str/includes? output "~/.claude.json: absent"))
    (is (str/includes? output "./.codex/config.toml: mcp_servers.cclsp"))
    (is (str/includes? output "crontab: @daily bin/check.sh scripts=bin/check.sh"))
    (is (str/includes? output "entries=1 cron=1"))))
(deftest review-three-inline-tables (doseq [s ["[mcp_servers]\ncclsp = { command = 'bun' }"
            "[mcp_servers]\n'cclsp' = { command = 'bun', required = true }"]]
    (is (= ["unsupported: inline table at line 2"] (vec (entries s true)))))
  (is (= 1 (count (entries "[mcp_servers.cclsp]\ncommand='bun'" true))))
  (is (= 2 (count (entries "[mcp_servers.cclsp]\n[mcp_servers.cclsp]" true))))
  (doseq [q ["'''" "\"\"\""]]
    (is (thrown-with-msg? Exception #"unsupported: multiline TOML string" (entries (str "s=" q) true)))))
(deftest review-three-file-boundary
  (doseq [[kind regular?] [[:file true] [:fifo false] [:device false] [:directory false]
                           [:symlink-to-fifo false] [:symlink-to-device false] [:symlink-to-file true]]]
    (is (= regular? (regular-token? {:regular? regular?})) (name kind))
    (when-not regular?
      (with-redefs [file-probe (constantly {:regular? regular?})
                    io/input-stream (fn [_] (throw (ex-info "must not open" {})))]
        (is (empty? (cron-lines "@daily test -p /tmp/job.fifo" #(read-file % 65536))) (name kind)))))
  (let [f (java.io.File/createTempFile "footprint-" ".txt")]
    (try (spit f "cclsp") (doseq [limit [nil 65536]] (is (= "cclsp" (read-file f limit))))
         (spit f (str (apply str (repeat 65536 "x")) "cclsp"))
         (is (= 65536 (count (read-file f 65536))))
         (finally (.delete f)))))
(deftest unreadable-cron-script (is (= ["@daily /private scripts=/private (unreadable)"]
        (vec (cron-lines "@daily /private" {"/private" (java.io.IOException. "denied")})))))
(deftest listener-literals
  ;; Anvil's cross-account listener and the reviewer's macOS netstat fixtures.
  (doseq [[prefix separator tail] [["LISTEN" ":" ""] ["tcp" ":" "LISTEN"] ["tcp4" "." "LISTEN"]
                                   ["tcp6" ":" "LISTEN"]]
          address ["127.0.0.1" "[::ffff:127.0.0.1]" "::" "*"] port ["7888" "7890" "7906"]]
    (is (= {:address address :port port :owner ""}
           (listener (str prefix " 0 0 " address separator port " *.* " tail)))))
  (doseq [line ["LISTEN 0 0 *:78880 *:*" "State Recv-Q Send-Q Local Address:Port Peer Address:PortProcess"
                "ESTAB 0 0 *:7888 *:*" "tcp 0 0 *:7888 *:* ESTABLISHED"]] (is (nil? (listener line))))
  (doseq [tool ["clj-surgeon" "cclsp" "clojure-lsp"]]
    (let [owner (str "users:((\"" tool "\",pid=12,fd=3))")]
      (is (= {:address "0.0.0.0" :port "9000" :owner owner}
             (listener (str "LISTEN 0 128 0.0.0.0:9000 *:* " owner)))))))
(deftest mayor-lsof-literals
  ;; Mayor's macOS field case: ss absent; lsof checked 7888 by hand.
  (doseq [[line address port owner]
          [["node 812 forge 23u IPv4 0x123 0t0 TCP 127.0.0.1:7888 (LISTEN)" "127.0.0.1" "7888" "node pid=812"]
           ["java 913 forge 45u IPv6 0x456 0t0 TCP *:7890 (LISTEN)" "*" "7890" "java pid=913"]
           ["java 914 forge 46u IPv6 0x789 0t0 TCP [::1]:7906 (LISTEN)" "[::1]" "7906" "java pid=914"]]]
    (is (= {:address address :port port :owner owner} (listener line))))
  (doseq [line ["node 812 forge 23u IPv4 0x123 0t0 TCP 127.0.0.1:78880 (LISTEN)"
               "node 812 forge 23u IPv4 0x123 0t0 TCP 127.0.0.1:7888 (ESTABLISHED)"
               "COMMAND PID USER FD TYPE DEVICE SIZE/OFF NODE NAME"]]
    (is (nil? (listener line)))))
(deftest process-literals
  (doseq [args ["/bin/cclsp --stdio" "clojure-lsp listen" "clj-surgeon --port 7906 mcp-serve"
                "X=1 /usr/bin/env Y=2 /bin/cclsp" "env X=1 clojure-lsp"
                "java -Xmx512m -cp /lib/x.jar clj_surgeon.mcp_server" "bb /bin/clj-surgeon mcp-serve"
                "java clojure.main -m clj-surgeon.mcp-server" "clojure -M -m clj-surgeon.mcp-server"]]
    (is (= {:kind :server :pid "42" :uptime "123" :command args} (process-line (str "42 123 " args)))))
  (doseq [args ["vim /src/cclsp/main.ts" "rg clojure-lsp /tmp/log" "clj-surgeon --help"
                "java -cp /repo/clj-surgeon OtherMain" "cat /tmp/clj_surgeon.mcp_server"
                "java --module-path /opt/clojure-lsp com.example.Main" "java clj_surgeon.mcp_server_other"
                "bb -cp mcp-serve /bin/clj-surgeon" "clj-surgeon x-mcp-serve"
                "bb --eval clj_surgeon.mcp_server" "java -jar clj_surgeon.mcp_server"
                "echo clj_surgeon.mcp_server" "echo clj-surgeon mcp-serve" "bash -c clojure-lsp"]]
    (is (= :mention (:kind (process-line (str "42 123 " args))))))
  (doseq [line ["PID ELAPSED COMMAND" "1 5 sleep 100"]] (is (nil? (process-line line))))
  (doseq [[elapsed seconds] [["01:02" "62"] ["01:02:03" "3723"] ["2-01:02:03" "176523"]]]
    (is (= seconds (:uptime (process-line (str "42 " elapsed " cclsp"))))))
  (is (= 100 (count (:command (process-line (str "1 2 cclsp " (apply str (repeat 200 "x")))))))))
(deftest unit-literals
  (is (= ["org.cclsp"] (units ["123 0 org.cclsp" "org.cclsp.plist"])))
  (is (= ["clj-surgeon.service" "cclsp.service" "clojure-lsp.socket"]
         (units ["clj-surgeon.service loaded active running MCP\ncclsp.service loaded inactive dead"
                 "clj-surgeon.service enabled enabled\nclojure-lsp.socket disabled enabled\nother.service enabled"])))
  (is (= ["org.cclsp" "org.clojure-lsp"]
         (units ["PID Status Label\n- 0 org.cclsp\n42 0 org.cclsp" "org.clojure-lsp.plist"])))
  (is (empty? (units [nil "" "other.service enabled"]))))
(deftest routing-literals
  (let [doctrine "*Derived from doctrine commit abc123.*"
        block (str routing/managed-begin "\nλ\n" doctrine "\n" routing/managed-end "\n")
        expected (str (#'routing/sha256 block) " " doctrine)]
    (doseq [s [block (str "preface\n" block "\nsuffix")]] (is (= [expected] (routing-block s))))
    (is (= [(str (#'routing/sha256 (str/trimr block)) " " doctrine)] (routing-block (str/trimr block))))
    (doseq [s [nil "ordinary CLAUDE.md"]] (is (= ["absent"] (routing-block s))))
    (doseq [s [routing/managed-begin routing/managed-end (str block block)
              (str routing/managed-end routing/managed-begin)]] (is (= ["malformed"] (routing-block s))))))
(deftest census-footprint-wiring
  (doseq [mac? [false true] missing? [false true]]
    (let [calls (atom []) file io/file read read-file reads (atom []) output
          (with-redefs [file-probe (constantly {:regular? false})
                        io/input-stream (fn [_] (throw (ex-info "must not open" {})))
                        io/file (fn [p & more] (if (seq more) (throw (ex-info "denied" {})) (file p)))
                        read-file (fn [p cap] (swap! reads conj [p cap]) (read p cap))
                        process/shell (fn [_ & args] (swap! calls conj (vec args))
                          (case (vec args)
                            ["ss" "-ltnp"] {:err "denied"}
                            ["lsof" "-nP" "-iTCP" "-sTCP:LISTEN"] {:exit 2 :err "missing"}
                            ["ss" "-ltn"] (if missing? (throw (ex-info "missing" {})) {:out "LISTEN 0 1 *:7888 *:*"})
                            ["netstat" "-ltn"] {:out "tcp 0 0 *:7888 *:* LISTEN"}
                            ["netstat" "-an" "-p" "tcp"] {:out "tcp4 0 0 *.7888 *.* LISTEN"}
                            ["ps" "-eo" "pid,etimes,args"] {:out "1 2 cclsp\n2 3 cat /cclsp/log"}
                            ["ps" "-eo" "pid,etime,args"] {:out "1 00:02 cclsp\n2 00:03 cat /cclsp/log"}
                            {:out ""}))] (with-out-str (println (host-footprint "/home/test" mac?))))]
      (doseq [s ["unavailable: denied" " listeners=1 servers=1 units=0" ":uptime \"2\""
                  "/.claude/CLAUDE.md: not-regular" "/.codex/AGENTS.md: not-regular"]]
        (is (str/includes? output s)))
      (is (= [["/home/test/.claude/CLAUDE.md" 65536] ["/home/test/.codex/AGENTS.md" 65536]] @reads))
      (is (= missing? (boolean (some #(= "netstat" (first %)) @calls))))
      (is (some #{["ps" "-eo" (if mac? "pid,etime,args" "pid,etimes,args")]} @calls))
      (if mac? (is (str/includes? output "~/Library/LaunchAgents: unavailable: denied"))
          (doseq [op ["list-units" "list-unit-files"]] (is (some #(= ["systemctl" "--user" op] (take 3 %)) @calls))))
      (is (every? #{"ss" "lsof" "netstat" "ps" "systemctl" "launchctl"} (map first @calls))))))
(deftest listener-source-matrix
  (doseq [mac? [false true] winner [0 1 2 3 nil] empty? [false true]]
    (let [calls (atom []) result (atom nil)
          commands [["ss" "-ltnp"] ["ss" "-ltn"] ["lsof" "-nP" "-iTCP" "-sTCP:LISTEN"]
                    (if mac? ["netstat" "-an" "-p" "tcp"] ["netstat" "-ltn"])]
          output (with-redefs [process/shell (fn [_ & args]
                   (let [i (dec (count (swap! calls conj (vec args))))]
                     (if (= i winner)
                       {:exit (if (and (= i 2) empty?) 1 0) :out (if empty? ""
                          (case i 2 "node 812 forge 23u IPv4 0x1 0t0 TCP 127.0.0.1:7888 (LISTEN)"
                                  3 "tcp4 0 0 127.0.0.1.7888 *.* LISTEN" "LISTEN 0 0 *:7888 *:*"))}
                       {:exit 2 :err "missing"})))] (with-out-str (reset! result (listeners mac?))))]
      (is (= (take (if winner (inc winner) 4) commands) @calls))
      (is (= (if (and winner (not empty?)) 1 0) @result))
      (is (str/includes? output (str "listeners-source: " (if winner (first (commands winner)) "none"))))
      (is (= (boolean (and winner empty?)) (str/includes? output "listen: none")))
      (is (= (nil? winner) (str/includes? output "listen: unavailable: no ss, lsof or netstat"))))))
(deftest mayor-profile-map
  ;; Laptop profiles omitted by the original census; builder has no server registration.
  (let [files {"/h/.claude-kanban/.claude.json" "{\"mcpServers\":{\"clj-surgeon\":{\"command\":\"bb\"}}}"
               "/h/.claude-builder/settings.json" "{}"}
        rows (vec (profile-sources ["/h/.claude-builder" "/h/.claude-kanban"] files))]
    (is (= ["/h/.claude-builder/settings.json" "/h/.claude-kanban/.claude.json"] (mapv first rows)))
    (is (= [[] ["clj-surgeon required=unspecified command=bb"]] (mapv (fn [[_ s f]] (vec (f s))) rows)))
    (is (empty? (profile-sources ["/missing"] files)))
    (is (empty? (profile-sources [] files)))
    (is (= ["/h/settings.json"] (map first (profile-sources ["/h"] {"/h/settings.json" ""})))))
  (let [error (java.io.IOException. "denied") rows (profile-sources ["/h"] {"/h/.claude.json" error})]
    (is (identical? error (second (first rows))))
    (is (str/includes? (with-out-str (section "MCP entries" rows)) "/h/.claude.json: unreadable: denied"))))
(deftest config-dir-options
  (doseq [[args expected] [[[] []] [["--config-dir" "/a"] ["/a"]]
                          [["--config-dir" "/a" "--config-dir" "/b c"] ["/a" "/b c"]]]]
    (is (= expected (config-dirs args))))
  (doseq [args [["--config-dir"] ["--config-dir" ""] ["--config-dir" "--help"] ["--unknown" "/a"]
               ["--config-dir" "/a" "stray"] ["stray"]]] (is (nil? (config-dirs args)))))
(deftest extra-profile-census-wiring
  (let [default (str (or (System/getenv "HOME") (System/getProperty "user.home")) "/.claude")
        files {"/a/.claude.json" "{\"mcpServers\":{\"clj-surgeon\":{}}}" "/b/settings.json" "{}"
               (str default "/.claude.json") "{}"}
        seen (atom nil) output
        (with-redefs [profile-dirs (fn [_ _ dirs] (reset! seen dirs) [default "/a" "/b"])
                      read-file (fn [p & _] (files p)) host-footprint (constantly "")
                      process/shell (fn [& _] {:out ""})]
          (with-out-str (census ["/a" "/b"])))]
    (is (= ["/a" "/b"] @seen))
    (is (str/includes? output (str default "/.claude.json: none")))
    (doseq [s ["profiles: 2 extra (/a, /b)" "~/.claude.json: absent" "/a/.claude.json: clj-surgeon"
               "/b/settings.json: none" "entries=1 cron=0"]] (is (str/includes? output s)))
    (doseq [s ["/a/settings.json:" "/b/.claude.json:" (str default "/settings.json:")]]
      (is (not (str/includes? output s))))))
(deftest option-cli-boundary
  (doseq [[args exit] [[["--help"] 0] [["--config-dir"] 2] [["--unknown"] 2]]]
    (let [r (apply process/shell {:out :string :err :string :continue true}
                   "bb" *file* args)]
      (is (= exit (:exit r)))
      (is (str/includes? (:out r) "[--config-dir <dir>]..."))
      (is (str/blank? (:err r))))))
(deftest profile-directory-boundary
  (let [home (str (fs/create-temp-dir {:prefix "footprint-home-"}))
        a (str home "/.claude-kanban") b (str home "/.claude-builder") c (str home "/external")]
    (try (doseq [dir [a b c]] (fs/create-dir dir))
      (spit (str a "/.claude.json") "{\"mcpServers\":{\"clj-surgeon\":{}}}")
      (spit (str b "/.claude.json") "{\"mcpServers\":{\"clj-surgeon\":{\"disabled\":true}}}")
      (spit (str c "/settings.json") "{\"mcpServers\":{\"clj-surgeon\":{}}}")
      (fs/create-sym-link (str home "/.claude-link") a)
      (is (= [b a] (profile-dirs home nil [])))
      (is (= [b a] (profile-dirs home (str a "/") [a (str b "/../.claude-builder")])))
      (let [{:keys [exit out]} (process/shell {:out :string :err :string :continue true
                                            :extra-env {"HOME" home "CLAUDE_CONFIG_DIR" ""}}
                                           "bb" *file* "--config-dir" c)] (is (zero? exit))
        (doseq [s [(str "profiles: 3 extra (" b ", " a ", " c ")")
                   (str a "/.claude.json: clj-surgeon required=unspecified command=")
                   (str b "/.claude.json: clj-surgeon required=unspecified command= disabled=true")
                   (str c "/settings.json: clj-surgeon required=unspecified command=")]]
          (is (str/includes? out s)))
        (is (not (str/includes? out ".claude-link"))))
      (finally (fs/delete-tree home)))))
(deftest hostname-boundary
  (is (= "unknown-host" (host-name #(throw (ex-info "unresolved" {})))))
  (is (= "localhost" (host-name #(java.net.InetAddress/getByAddress "localhost" (byte-array [127 0 0 1]))))))
(cond (= ["--self-test"] (vec *command-line-args*)) (let [r (run-tests 'surgeon-footprint)]
                    (System/exit (if (and (pos? (:test r)) (zero? (+ (:fail r) (:error r)))) 0 1)))
      (config-dirs *command-line-args*) (census (config-dirs *command-line-args*))
      :else (do (println "usage: surgeon-footprint [--config-dir <dir>]... | --self-test | --help")
                (System/exit (if (= ["--help"] (vec *command-line-args*)) 0 2))))
