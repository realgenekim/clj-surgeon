diff --git a/src/fixture/util.clj b/src/fixture/util.clj
index 63ed97d..5db5f1d 100644
--- a/src/fixture/util.clj
+++ b/src/fixture/util.clj
@@ -2,7 +2,13 @@
   "Path helpers shared by the scope expander."
   (:require [clojure.string :as str]))
 
-(defn normalize
-  "Trim a path and drop any trailing slash."
-  [p]
-  (str/replace (str/trim p) #"/+$" ""))
+(defn normalize-path
+  "Trim a path and drop any trailing slash.
+
+  With `{:strict? true}` also collapse repeated inner slashes."
+  ([p] (normalize-path p nil))
+  ([p opts]
+   (let [t (str/replace (str/trim p) #"/+$" "")]
+     (if (:strict? opts)
+       (str/replace t #"/{2,}" "/")
+       t))))
