{:paths ["src"]

 :deps
 {org.clojure/clojure {:mvn/version "1.12.1"}
  cheshire/cheshire {:mvn/version "5.13.0"}
  org.babashka/sci {:mvn/version "0.10.47"}
  rewrite-clj/rewrite-clj {:mvn/version "1.2.50"}}

 :aliases
 {:clj-surgeon/mcp
  {:extra-deps
   {io.github.bhauman/clojure-mcp
    {:git/tag "v0.2.6"
     :git/sha "35a660b"}
    nrepl/nrepl {:mvn/version "1.3.1"}
    org.eclipse.jetty.ee10/jetty-ee10-servlet {:mvn/version "12.0.13"}
    org.slf4j/slf4j-nop {:mvn/version "2.0.17"}}
   :exec-fn clj-surgeon.mcp-http-server/start}

  :clj-surgeon/mcp-stdio
  {:extra-deps
   {io.github.bhauman/clojure-mcp
    {:git/tag "v0.2.6"
     :git/sha "35a660b"}
    nrepl/nrepl {:mvn/version "1.3.1"}
    org.eclipse.jetty.ee10/jetty-ee10-servlet {:mvn/version "12.0.13"}
    org.slf4j/slf4j-nop {:mvn/version "2.0.17"}}
   :exec-fn clj-surgeon.mcp-server/start}

  :clj-surgeon/mcp-test
  {:extra-paths ["test" "dev/experiments"]
   :extra-deps
   {babashka/fs {:mvn/version "0.5.30"}
    babashka/process {:mvn/version "0.6.23"}
    io.github.bhauman/clojure-mcp
    {:git/tag "v0.2.6"
     :git/sha "35a660b"}
    nrepl/nrepl {:mvn/version "1.3.1"}
    org.eclipse.jetty.ee10/jetty-ee10-servlet {:mvn/version "12.0.13"}
    org.slf4j/slf4j-nop {:mvn/version "2.0.17"}}
   :main-opts ["-m" "clj-surgeon.mcp-test-runner"]}

  :clj-surgeon/memory-test
  {:extra-paths ["test"]
   :main-opts ["-m" "clj-surgeon.memory.memory-test-runner"]}

  ;; Tree-scale memory battery (MCP-OP-MEM-011). Deliberately separate from the
  ;; test aliases: `make memory-battery` is a minutes-scale measurement gate and
  ;; is never a prerequisite of test/test-fast/mcp-test. The heap flag is
  ;; supplied by the Make target, not here, so MEMBAT_XMX is the only knob.
  :clj-surgeon/memory-battery
  {:extra-deps {babashka/fs {:mvn/version "0.5.30"}
                babashka/process {:mvn/version "0.6.23"}}
   :main-opts ["-m" "clj-surgeon.memory-battery-runner"]}

  :clj-surgeon/analyzer-contract-test
  {:extra-paths ["test"]
   :extra-deps {babashka/fs {:mvn/version "0.5.30"}
                nrepl/nrepl {:mvn/version "1.3.1"}}
   :main-opts ["-m" "analyzer-contract-test-runner"]}

  :clj-surgeon/nrepl
  {:extra-paths ["test"]
   :extra-deps {babashka/fs {:mvn/version "0.5.30"}
                babashka/process {:mvn/version "0.6.23"}
                nrepl/nrepl {:mvn/version "1.3.1"}}
   :main-opts ["-m" "nrepl.cmdline" "--port" "0"]}}}
